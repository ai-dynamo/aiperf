flowchart TD
  %% Document-analysis agent — extraction with up to 3 rounds

  start([START]):::stad --> plan["draft plan · llm · out=plan"]:::llm

  plan --> loop(["extraction rounds · loop ×3"]):::loop

  %% ---- round body: fan-out parallel extraction workers (each = a model call)
  loop -->|round| w1["worker A · llm · @plan · out=secA"]:::llm
  loop -->|round| w2["worker B · llm · @plan · out=secB"]:::llm
  loop -->|round| w3["worker C · llm · @plan · out=secC"]:::llm

  %% ---- non-model knowledge-base lookup (~50ms), part of each round
  loop -->|round| kb["kb lookup · tool_exec · replay · tool=50ms · out=kb"]:::replay

  %% ---- fan-in: wait for ALL workers + kb before merging
  w1 --> join{{"join · barrier · in=[secA,secB,secC,kb] · join=all"}}:::barrier
  w2 --> join
  w3 --> join
  kb --> join

  join --> merge["merge results · llm · @secA · @secB · @secC · @kb · out=merged"]:::llm

  %% ---- judge completeness
  merge --> judge{"judge complete? · router"}:::gate
  judge -->|incomplete| loop
  judge -->|complete| summary["final summary · llm · @merged · ★terminal"]:::term

  summary --> done([END]):::stad

