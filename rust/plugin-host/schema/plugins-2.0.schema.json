{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/aiperf/plugin-manifest/2.0/schema.json",
  "title": "AIPerf Native Plugin Manifest v2.0",
  "description": "Schema for the native AIPerf plugin manifest format.",
  "type": "object",
  "required": ["schema_version", "packages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "description": "Must be exactly '2.0'. Version '1.0' is the Python format and is rejected."
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginPackageManifestV2"
      }
    }
  },
  "$defs": {
    "PluginPackageManifestV2": {
      "type": "object",
      "required": ["id", "version", "categories"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string", "description": "Canonical SemVer X.Y.Z" },
        "description": { "type": ["string", "null"] },
        "baseline": { "$ref": "#/$defs/BaselineRequirementV2" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRecordV2" }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PluginCategoryEntryV2" }
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {},
        "priority": { "type": "integer", "default": 0 },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/DependencyEdgeV2" }
        }
      }
    },
    "BaselineRequirementV2": {
      "type": "object",
      "required": ["aiperf_version"],
      "additionalProperties": false,
      "properties": {
        "aiperf_version": { "type": "string" },
        "allocator_digest": { "type": ["string", "null"] }
      }
    },
    "ArtifactRecordV2": {
      "type": "object",
      "required": ["target", "path", "digest"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string" },
        "path": { "type": "string", "description": "Relative path, no '..' or absolute prefix" },
        "digest": { "type": "string", "description": "BLAKE3 hex digest" },
        "build_id": { "type": ["string", "null"] }
      }
    },
    "PluginCategoryEntryV2": {
      "type": "object",
      "required": ["category", "id"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["exporter", "endpoint", "transport", "workload", "dataset", "sampler", "actuator"]
        },
        "id": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "DependencyEdgeV2": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
