#
# MLflow exporter candidate plugin manifest template.
#
# `{{VERSION}}` and `{{ARTIFACT_DIGEST}}` are substituted by the Task 37a
# assembler before the manifest is locked.
format_version: "1.0"

packages:
  - package_id: "nvidia/export-mlflow"
    version: "{{VERSION}}"
    category: export
    artifact: "libaiperf_plugin_export_mlflow.so"
    artifact_digest: "{{ARTIFACT_DIGEST}}"
    description: >
      MLflow exporter candidate: MLflow REST and artifact-proxy exporter
      as a plugin package. Static production exporter authority remains
      until Task 39b.
    capabilities:
      - canonical_id: "export.mlflow"
        aliases: ["mlflow", "mlflow_rest"]
