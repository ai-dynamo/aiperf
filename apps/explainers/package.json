{
  "name": "aiperf-explainers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:manifest",
    "dev": "vite",
    "prebuild": "npm run precompile:decks",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:manifest": "vite-node scripts/build-deck-artifacts.mjs",
    "precompile:decks": "vite-node scripts/build-deck-artifacts.mjs --full",
    "assert:no-mentalmodel-registry": "node scripts/assert-no-mentalmodel-registry.mjs",
    "assert:sdk-authoring": "node scripts/assert-sdk-authoring.mjs",
    "flow-verifier": "node scripts/flow-verifier.mjs --ir-only",
    "flow-verifier:ir": "node scripts/flow-verifier.mjs --ir-only",
    "flow-verifier:extended": "node scripts/flow-verifier.mjs",
    "deploy:pages": "bash scripts/deploy-pages.sh"
  },
  "dependencies": {
    "chevrotain": "^12.0.0",
    "js-sha256": "^0.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
