explainer "SLURM + Velo from scratch" {
  id: "slurm-velo"
  route: "/slurm-velo"
  topic: "distributed-execution"
  storagePrefix: "slurm-explainer"
  classPrefix: "slurm101"
  eyebrowLabel: "SLURM + VELO FROM SCRATCH"
  startGateTitle: "SLURM + Velo from scratch"

  hub: {
    highlight: "SLURM + Velo"
    title: "from scratch"
    description: "Step-by-step slideshow for how SLURM launches cellular AIPerf runs and how Velo wires the control plane."
  }

  slide "You want to load-test a big AI server" {
    eyebrow: "The problem"
    title: "You want to load-test a big AI server"
    lede: "AIPerf sends many requests to an inference server and measures how fast it answers. To push a really large server hard, one computer sending traffic is not enough — you need many computers sending at once."
    narration: "Large AI servers need many load generators acting together as one benchmark."
    term: {
      word: "Inference server"
      meaning: "The service that runs an AI model and answers requests (for example, a chat completion endpoint)."
    }
    points: [
      "One laptop can only send so many requests per second.",
      "To stress a large server you need a fleet of machines generating load together.",
      "That fleet has to act like one coordinated test, not many disconnected ones."
    ]
    caption: "Goal: many machines, one benchmark, one result."

    render: @scene {
      roots: [
{
          id: "s0-hdr"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
          children: [
            {
              id: "s0-hdr-l"
              capability: "core.text"
              text: "BENCHMARK GOAL"
              layout: { x: 38, y: 28, width: 320, height: 20 }
              style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
            },
            {
              id: "s0-hdr-n"
              capability: "core.text"
              text: "many machines generate one combined load"
              layout: { x: 360, y: 28, width: 300, height: 20 }
              style: { fontSize: 12, fontWeight: "normal", fill: @theme.ink.secondary, textAnchor: "end" }
            }
          ]
        },
{
          id: "s0-gens"
          capability: "core.rect"
          layout: { x: 74, y: 138, width: 220, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1.3, radius: 10, pulse: true }
          children: [
            {
              id: "s0-gens-t"
              capability: "core.text"
              text: "Many load generators"
              layout: { x: 84, y: 160, width: 200, height: 20 }
              style: { fontSize: 16, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            },
            {
              id: "s0-gens-s"
              capability: "core.text"
              text: "more machines = more traffic"
              layout: { x: 84, y: 183, width: 200, height: 16 }
              style: { fontSize: 12, fontWeight: "normal", fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        },
{
          id: "s0-req"
          capability: "core.path"
          d: "M294 186 H418"
          layout: { x: 0, y: 0, width: 700, height: 400 }
          style: { fill: "none", stroke: @theme.accent.primary, strokeWidth: 2.4 }
        },
            {
              id: "s0-req-l"
              capability: "core.text"
              text: "REQUESTS"
              layout: { x: 311, y: 160, width: 90, height: 14 }
              style: { fontSize: 11, fontWeight: "bold", fill: @theme.accent.primary, textAnchor: "middle" }
            },
{
          id: "s0-srv"
          capability: "core.rect"
          layout: { x: 418, y: 138, width: 210, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.6, radius: 36, pulse: true }
          children: [
            {
              id: "s0-srv-t"
              capability: "core.text"
              text: "Inference server"
              layout: { x: 433, y: 162, width: 180, height: 20 }
              style: { fontSize: 16, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            },
            {
              id: "s0-srv-s"
              capability: "core.text"
              text: "the AI model endpoint"
              layout: { x: 433, y: 185, width: 180, height: 16 }
              style: { fontSize: 12, fontWeight: "normal", fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        },
{
          id: "s0-motion"
          capability: "core.path"
          d: "M294 186 H418"
          layout: { x: 0, y: 0, width: 700, height: 400 }
          style: { fill: "none", stroke: @theme.accent.primary, strokeWidth: 2.4, opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s0-enter-s0-hdr", at: 0, duration: 260, target: "s0-hdr", action: "enter" }
        { id: "s0-enter-s0-gens", at: 200, duration: 260, target: "s0-gens", action: "enter" }
        { id: "s0-draw-s0-req", at: 420, duration: 360, target: "s0-req", action: "draw" }
        { id: "s0-enter-s0-req-l", at: 520, duration: 260, target: "s0-req-l", action: "enter" }
        { id: "s0-enter-s0-srv", at: 560, duration: 260, target: "s0-srv", action: "enter" }
        { id: "s0-emphasis-s0-srv", at: 900, duration: 340, target: "s0-srv", action: "emphasis" }
        { id: "s0-motion-0", at: 900, duration: 1100, target: "s0-motion", action: "draw" }
      ]
    }
  }

  slide "SLURM hands you a cluster of machines" {
    eyebrow: "The tool"
    title: "SLURM hands you a cluster of machines"
    lede: "SLURM is the software that shares a big cluster among many people. You ask it for machines; it finds free ones, reserves them for you, and runs your command on every one of them at the same time."
    narration: "SLURM reserves cluster machines and launches your program across all of them."
    term: {
      word: "SLURM"
      meaning: "A job scheduler for compute clusters. You submit a request for N machines; SLURM grants an allocation and launches your program on each task."
    }
    points: [
      "`sbatch` submits a batch job; `srun` launches tasks right now.",
      "An allocation is your reserved set of machines for this job.",
      "SLURM runs the exact same command on every task in the allocation."
    ]
    caption: "SLURM = the landlord that lends you machines for a while."

    render: @scene {
      roots: [
{
          id: "s1-hdr"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
          children: [
            {
              id: "s1-hdr-l"
              capability: "core.text"
              text: "SLURM RESERVES RESOURCES"
              layout: { x: 38, y: 28, width: 320, height: 20 }
              style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
            },
            {
              id: "s1-hdr-n"
              capability: "core.text"
              text: "the scheduler lends your job a set of machines"
              layout: { x: 360, y: 28, width: 300, height: 20 }
              style: { fontSize: 12, fontWeight: "normal", fill: @theme.ink.secondary, textAnchor: "end" }
            }
          ]
        },
{
          id: "s1-slurm"
          capability: "core.rect"
          layout: { x: 64, y: 128, width: 190, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.6, radius: 10, pulse: true }
          children: [
