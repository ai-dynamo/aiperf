        },
{
          id: "s6-step-1"
          capability: "core.rect"
          layout: { x: 196, y: 128, width: 140, height: 100 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.6, radius: 9 }
          children: [
            {
              id: "s6-step-1-t"
              capability: "core.text"
