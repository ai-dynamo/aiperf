explainer "SLURM + Velo from scratch" {
  id: "slurm-velo"
  route: "/slurm-velo"
  topic: "distributed-execution"
  storagePrefix: "slurm-explainer"
  classPrefix: "slurm101"
  eyebrowLabel: "SLURM + VELO FROM SCRATCH"
  startGateTitle: "SLURM + Velo from scratch"

  hub: {
    highlight: "SLURM + Velo"
    title: "from scratch"
    description: "Step-by-step slideshow for how SLURM launches cellular AIPerf runs and how Velo wires the control plane."
  }

  slide "You want to load-test a big AI server" {
    eyebrow: "The problem"
    title: "You want to load-test a big AI server"
    lede: "AIPerf sends many requests to an inference server and measures how fast it answers. To push a really large server hard, one computer sending traffic is not enough — you need many computers sending at once."
    narration: "Large AI servers need many load generators acting together as one benchmark."
    term: {
      word: "Inference server"
      meaning: "The service that runs an AI model and answers requests (for example, a chat completion endpoint)."
    }
    points: [
      "One laptop can only send so many requests per second.",
      "To stress a large server you need a fleet of machines generating load together.",
      "That fleet has to act like one coordinated test, not many disconnected ones."
    ]
    caption: "Goal: many machines, one benchmark, one result."

    render: @scene {
      sdk.Header(
        id = "s0-hdr",
        title = "BENCHMARK GOAL",
        caption = "many machines generate one combined load",
        x = 63.6,
        y = 43.2,
        width = 1792.8,
        height = 118.8,
        surfaceRole = theme(surface.primary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s0-gens",
        title = "Many load generators",
        detail = "more machines = more traffic",
        x = 214.8,
        y = 372.6,
        width = 594,
        height = 259.2,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )
      sdk.Edge(
        id = "s0-req",
        mode = "route",
        from = { nodeId: "s0-gens", anchor: "e" },
        to = { nodeId: "s0-srv", anchor: "w" },
        style = { fill: "none", stroke: theme(accent.primary), strokeWidth: 6.48 }
      )
      sdk.Label(
        id = "s0-req-l",
        text = "REQUESTS",
        x = 854.7,
        y = 432,
        width = 243,
        height = 37.8,
        fontSize = 29.7,
        weight = "bold",
        align = "middle",
        inkRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s0-srv",
        title = "Inference server",
        detail = "the AI model endpoint",
        x = 1143.6,
        y = 372.6,
        width = 567,
        height = 259.2,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Signal(
        id = "s0-motion",
        from = { nodeId: "s0-gens", anchor: "center" },
        to = { nodeId: "s0-srv", anchor: "center" },
        x = 15,
        y = 0,
        width = 1890,
        height = 1080,
        opacity = 0.55,
        strokeWidth = 6.48,
        style = { fill: "none", stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 reveal s0-hdr duration 260
        after s0-hdr reveal s0-gens duration 260
        after s0-gens trace s0-req duration 360
        after s0-req reveal s0-req-l duration 260
        after s0-req-l reveal s0-srv duration 260
        after s0-srv trace s0-motion duration 1100
      }
  }
  }

  slide "SLURM hands you a cluster of machines" {
    eyebrow: "The tool"
    title: "SLURM hands you a cluster of machines"
    lede: "SLURM is the software that shares a big cluster among many people. You ask it for machines; it finds free ones, reserves them for you, and runs your command on every one of them at the same time."
    narration: "SLURM reserves cluster machines and launches your program across all of them."
    term: {
      word: "SLURM"
      meaning: "A job scheduler for compute clusters. You submit a request for N machines; SLURM grants an allocation and launches your program on each task."
    }
    points: [
      "`sbatch` submits a batch job; `srun` launches tasks right now.",
      "An allocation is your reserved set of machines for this job.",
      "SLURM runs the exact same command on every task in the allocation."
    ]
    caption: "SLURM = the landlord that lends you machines for a while."

    render: @scene {
      sdk.Header(
        id = "s1-hdr",
        title = "SLURM RESERVES RESOURCES",
        caption = "the scheduler lends your job a set of machines",
        x = 63.6,
        y = 43.2,
        width = 1792.8,
        height = 118.8,
        surfaceRole = theme(surface.primary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s1-slurm",
        title = "SLURM scheduler",
        detail = "finds and reserves machines",
        x = 187.8,
        y = 345.6,
        width = 513,
        height = 259.2,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s1-arr",
        mode = "path",
        from = { x: 0, y: 0 },
        to = { x: 0, y: 0 },
        path = "M254 176 H330",
        style = { fill: "none", stroke: theme(accent.primary), strokeWidth: 5.94 }
      )
      sdk.Card(
        id = "s1-alloc",
        title = "Your allocation",
        x = 906,
        y = 264.6,
        width = 820.8,
        height = 351,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )
      sdk.Panel(id = "s1-task-0", title = "Task 0", detail = "machine", x = 960, y = 642.6, width = 145.8, height = 118.8, surfaceRole = theme(surface.elevated), strokeRole = theme(ink.secondary))
      sdk.Panel(id = "s1-task-1", title = "Task 1", detail = "machine", x = 1143.6, y = 642.6, width = 145.8, height = 118.8, surfaceRole = theme(surface.elevated), strokeRole = theme(ink.secondary))
      sdk.Panel(id = "s1-task-2", title = "Task 2", detail = "machine", x = 1327.2, y = 642.6, width = 145.8, height = 118.8, surfaceRole = theme(surface.elevated), strokeRole = theme(ink.secondary))
      sdk.Panel(id = "s1-task-3", title = "Task 3", detail = "machine", x = 1510.8, y = 642.6, width = 145.8, height = 118.8, surfaceRole = theme(surface.elevated), strokeRole = theme(ink.secondary))
      sdk.Signal(
        id = "s1-motion",
        path = "M254 176 H330",
        x = 15,
        y = 0,
        width = 1890,
        height = 1080,
        opacity = 0.55,
        strokeWidth = 6.48,
        style = { fill: "none", stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 reveal s1-hdr duration 260
        after s1-hdr reveal s1-slurm duration 260
        after s1-slurm trace s1-arr duration 360
        after s1-arr reveal s1-alloc duration 260
        after s1-alloc reveal s1-task-0 duration 260
        after s1-task-0 reveal s1-task-1 duration 260
        after s1-task-1 reveal s1-task-2 duration 260
        after s1-task-2 reveal s1-task-3 duration 260
        after s1-task-3 trace s1-motion duration 1100
      }
  }
  }

  slide "Every machine runs the identical command" {
    eyebrow: "The key trick"
    title: "Every machine runs the identical command"
    lede: "This is the part that surprises newcomers. SLURM does not run a different program on each machine. It launches the very same line — `aiperf slurm run` — on all of them at once."
    narration: "Every task runs the same AIPerf command, then its rank determines its role."
    term: {
      word: "Task"
      meaning: "One running copy of your command inside the allocation. A 4-machine job has 4 tasks."
    }
    points: [
      "So how does each copy know what to do differently?",
      "SLURM gives each task a numbered identity called its rank.",
      "The program reads that number and decides its own job."
    ]
    caption: "Same command everywhere — the rank number breaks the tie."

    render: @scene {
      sdk.Header(
        id = "s2-hdr",
        title = "ONE COMMAND, MANY TASKS",
        caption = "SLURM_PROCID gives each copy a unique rank",
        x = 63.6,
        y = 43.2,
        width = 1792.8,
        height = 118.8,
        surfaceRole = theme(surface.primary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s2-cmd",
        title = "aiperf slurm run --config benchmark.yaml",
        detail = "one identical command on every task",
        x = 528,
        y = 210.6,
        width = 864,
        height = 156.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Card(
        id = "s2-task-0",
        title = "Task 0",
        detail = "SLURM_PROCID = 0",
        subtitle = "rank decides the role",
        x = 209.4,
        y = 534.6,
        width = 421.2,
        height = 237.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )
      sdk.Card(
        id = "s2-task-1",
        title = "Task 1",
        detail = "SLURM_PROCID = 1",
        subtitle = "rank decides the role",
        x = 749.4,
        y = 534.6,
        width = 421.2,
        height = 237.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )
      sdk.Card(
        id = "s2-task-2",
        title = "Task 2",
        detail = "SLURM_PROCID = 2",
        subtitle = "rank decides the role",
        x = 1289.4,
        y = 534.6,
        width = 421.2,
        height = 237.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )
      sdk.FanOut(
        id = "s2-fan",
        from = { nodeId: "s2-cmd", anchor: "s" },
        to = [{ nodeId: "s2-task-0", anchor: "n" }, { nodeId: "s2-task-1", anchor: "n" }, { nodeId: "s2-task-2", anchor: "n" }],
        axis = "y",
        junction = { x: 350, y: 168 },
        style = { fill: "none", stroke: theme(accent.primary), strokeWidth: 6.75 }
      )

      timeline main {
        at 0 reveal s2-hdr duration 260
        after s2-hdr reveal s2-cmd duration 260
        after s2-cmd reveal s2-task-0 duration 260
        after s2-task-0 reveal s2-task-1 duration 260
        after s2-task-1 reveal s2-task-2 duration 260
        after s2-task-2 trace s2-fan duration 1460
      }
  }
  }

  slide "Rank 0 leads; everyone else does the work" {
    eyebrow: "Splitting the roles"
    title: "Rank 0 leads; everyone else does the work"
    lede: "AIPerf reads the rank SLURM assigned. Rank 0 becomes the controller — the coordinator. Every other rank becomes a cell — a worker that actually sends load to the server."
    narration: "Rank zero coordinates the benchmark. Every other rank becomes a load-generating cell."
    term: {
      word: "Rank"
      meaning: "Each task's index in the allocation, from 0 up. AIPerf uses it to pick controller vs. cell."
    }
    points: [
      "Rank 0 → the single controller (it coordinates, it does not send benchmark load).",
      "Ranks 1, 2, 3, … → cells, numbered cell_id = rank − 1.",
      "So a 4-task job = 1 controller + 3 cells."
    ]
    caption: "controller = rank 0 · cell_id = rank − 1 · cell_count = tasks − 1."

    render: @scene {
      sdk.Header(
        id = "s3-hdr",
        title = "RANKS BECOME AIPERF ROLES",
        caption = "rank 0 coordinates · ranks 1…N generate load",
        x = 63.6,
        y = 43.2,
        width = 1792.8,
        height = 118.8,
        surfaceRole = theme(surface.primary),
        inkRole = theme(ink.secondary)
      )
      sdk.Card(
        id = "s3-r0",
        title = "Rank 0",
        detail = "CONTROLLER",
        subtitle = "coordinates the benchmark",
        x = 209.4,
        y = 329.4,
        width = 594,
        height = 302.4,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s3-link",
        mode = "path",
        from = { x: 0, y: 0 },
        to = { x: 0, y: 0 },
        path = "M292 178 H408",
        style = { fill: "none", stroke: theme(ink.secondary), strokeWidth: 5.4, markerEnd: "none" }
      )
      sdk.Label(
        id = "s3-link-l",
        text = "SAME RUN",
        x = 838.5,
        y = 410.4,
        width = 243,
        height = 37.8,
        fontSize = 29.7,
        weight = "bold",
        align = "middle",
        inkRole = theme(ink.secondary)
      )
      sdk.Card(
        id = "s3-cells",
        title = "Ranks 1, 2, 3…",
        detail = "LOAD CELLS",
        subtitle = "cell 0 · cell 1 · cell 2… · send benchmark requests",
        x = 1116.6,
        y = 264.6,
        width = 594,
        height = 432,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Signal(
        id = "s3-motion",
        path = "M292 178 H408",
        x = 15,
        y = 0,
        width = 1890,
        height = 1080,
        opacity = 0.55,
        strokeWidth = 6.48,
        style = { fill: "none", stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 reveal s3-hdr duration 260
        after s3-hdr reveal s3-r0 duration 260
        after s3-r0 trace s3-link duration 360
        after s3-link reveal s3-link-l duration 260
        after s3-link-l reveal s3-cells duration 260
        after s3-r0 trace s3-motion duration 1100
      }
  }
  }

  slide "Cells dial the controller with one shared fact" {
    eyebrow: "Finding each other"
    title: "Cells dial the controller with one shared fact"
    lede: "The cells need to talk to the controller, but nobody set up a directory service. Instead, every task computes the same address from the SLURM environment: the first machine in the allocation, on a known port."
    narration: "Each cell derives the rank-zero controller address from the shared SLURM allocation."
    term: {
      word: "Coordinate"
      meaning: "The controller's address, like tcp://node01:9500, derived identically on every task from SLURM_* variables."
    }
    points: [
      "SLURM tells every task the list of machines and its own rank.",
      "All tasks agree rank 0 lives on the first machine in that list.",
      "Default connection port is 9500, so every cell knows exactly where to call."
    ]
    caption: "One fact, computed the same everywhere — no discovery service needed."

    render: @scene {
      sdk.Header(
        id = "s4-hdr",
        title = "EVERY CELL FINDS RANK 0",
        caption = "the controller address is derived, not discovered",
        x = 63.6,
        y = 43.2,
        width = 1792.8,
        height = 118.8,
        surfaceRole = theme(surface.primary),
        inkRole = theme(ink.secondary)
      )
      sdk.Card(
        id = "s4-nodes",
        title = "SLURM nodelist",
        detail = "node01, node02…",
        subtitle = "+ port 9500",
        x = 117.6,
        y = 313.2,
        width = 383.4,
        height = 259.2,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )
      sdk.Edge(
