  slide "A cell connects once, then Velo learns the peer" {
    eyebrow: "Velo bootstrap"
    title: "A cell connects once, then Velo learns the peer"
    lede: "Each cell calls Velo with the one known address: tcp://HOST:9500. Velo's hello handshake discovers the controller's real peer identity, then the two sides can send named messages to each other."
    narration: "Each cell connects once, allowing Velo to establish the peer relationship."
    term: {
      word: "Handshake"
      meaning: "Velo's connect step that turns a host:port into a live, mutually registered peer connection."
    }
    points: [
      "The cell only needs AIPERF_CELL_CONTROLLER_ADDR.",
      "Velo connects, shakes hands, and registers both peers.",
      "After that, named handlers like register / heartbeat / partition work."
    ]
    caption: "Address in → peer connection out. No service discovery backend."

    render: @scene {
      sdk.Header(
        id = "s6-hdr",
        title = "VELO HANDSHAKE",
        caption = "address in · peer connection out",
        x = 63.6,
        y = 43.2,
        width = 1792.8,
        height = 118.8,
        surfaceRole = theme(surface.primary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s6-step-0",
        title = "Cell knows",
        detail = "tcp://node01:9500",
        x = 90.6,
        y = 345.6,
        width = 378,
        height = 270,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s6-step-1",
        title = "velo.connect",
        detail = "hello handshake",
        x = 544.2,
        y = 345.6,
        width = 378,
        height = 270,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s6-step-2",
