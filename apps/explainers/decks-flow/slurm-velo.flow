        style = { fill: "none", stroke: theme(accent.primary), strokeWidth: 5.94 }
      )
      sdk.Card(
        id = "s4-cells",
        title = "Every cell dials",
        detail = "the same address",
        subtitle = "and reaches rank 0 · no discovery service",
        x = 1224.6,
        y = 275.4,
        width = 567,
        height = 297,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Signal(
        id = "s4-motion",
        path = "M572 164 H331 H572",
        x = 15,
        y = 0,
        width = 1890,
        height = 1080,
