      )

      timeline main {
        at 0 reveal s4-hdr duration 260
        after s4-hdr reveal s4-nodes duration 260
        after s4-nodes trace s4-a1 duration 360
        after s4-a1 reveal s4-coord duration 260
        after s4-coord trace s4-a2 duration 360
        after s4-a2 reveal s4-cells duration 260
        after s4-cells trace s4-motion duration 1100
