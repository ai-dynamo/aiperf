explainer "Cellular algorithm workbook" {
  id: "cellular-algorithms"
  route: "/cellular-algorithms"
  topic: "cellular-algorithms"
  storagePrefix: "cellular-algorithms-explainer"
  classPrefix: "deck-algorithm"
  eyebrowLabel: "CELLULAR ALGORITHM WORKBOOK"
  startGateTitle: "Cellular algorithm workbook"

  hub: {
    highlight: "Cellular algorithms"
    title: "compose · compare · trace evidence"
    description: "Sixteen-slide maintainer map of the cellular algorithm workbook: eight evidence chapters, representative built/partial/feature-gated algorithms, route composition, and the decisions that change ownership, fidelity, topology, and shipping."
  }

  slide "algorithm-route" {
    eyebrow: "Workbook · 1 of 16"
    title: "Read the algorithm workbook as a route"
    lede: "The workbook is not a second architecture atlas. It is an evidence-indexed catalog of executable decisions, ordered from admission through terminal artifacts. This deck follows that route while selecting representative algorithms from the exhaustive catalog."
    narration: "The cellular algorithm workbook is an evidence-indexed catalog, not another architecture atlas. Read it as a route through eight chapters: eligibility, ownership, control, distribution, execution, capture, merge, and artifacts. This deck picks representative algorithms; the source canvas remains the exhaustive lookup."
    term: {
      word: "algorithm route"
      meaning: "The ordered algorithms selected by one cellular run shape."
    }
    points: [
      "Eight chapters: eligibility, ownership, control, distribution, execution, capture, merge, artifacts.",
      "Each entry records inputs, outputs, state, invariants, gates, failures, pseudocode, and evidence.",
      "This 16-slide deck is a maintainer map, not the full catalog."
    ]
    caption: "eight chapters · one derived route."

    render: @scene {
      sdk.Header(id = "header", title = "WORKBOOK · CHAPTER MAP", caption = "eight chapters · one derived route.")
      sdk.Band(id = "map-band", x = 18, y = 90, width = 664, height = 230)
      sdk.Panel(id = "ch-eligibility", title = "eligibility", x = 25, y = 104, width = 145, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "ch-ownership", title = "ownership", x = 193, y = 104, width = 145, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "ch-control", title = "control", x = 361, y = 104, width = 145, height = 72, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "ch-distribution", title = "distribution", x = 529, y = 104, width = 145, height = 72, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "ch-execution", title = "execution", x = 25, y = 232, width = 145, height = 72, strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "ch-capture", title = "capture", x = 193, y = 232, width = 145, height = 72, strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "ch-merge", title = "merge", x = 361, y = 232, width = 145, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "ch-artifacts", title = "artifacts", x = 529, y = 232, width = 145, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "ch-link-0", mode = "route", from = { nodeId: "ch-eligibility", anchor: "e" }, to = { nodeId: "ch-ownership", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Label(id = "footer", text = "route order is evidence order", x = 100, y = 318, width = 500, height = 24, fontSize = 12, align = "middle")
      sdk.Signal(id = "motion-sig", from = { nodeId: "ch-eligibility", anchor: "e" }, to = { nodeId: "ch-artifacts", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      timeline primary {
        at 0 reveal header duration 260
        at 160 reveal map-band duration 260
        at 320 reveal ch-eligibility duration 260
        at 480 reveal ch-ownership duration 260
        at 640 reveal ch-control duration 260
        at 800 reveal ch-distribution duration 260
        at 960 reveal ch-execution duration 260
        at 1120 reveal ch-capture duration 260
        at 1280 reveal ch-merge duration 260
        at 1440 reveal ch-artifacts duration 260
        at 1600 trace ch-link-0 duration 420
        at 1760 reveal footer duration 260
        at 1920 trace motion-sig duration 900
      }
    }
  }

  slide "evidence-vocabulary" {
    eyebrow: "Workbook · 2 of 16"
    title: "Status and evidence are part of the contract"
    lede: "A colored node is never enough to communicate implementation state. Built means the path exists on the ordinary route, feature-gated means code exists behind build or runtime admission, and partial means a known fidelity or lifecycle boundary remains. Every status stays visible as text."
    narration: "Status is part of the contract and must be readable without color. Built means the path executes on an admitted route. Feature-gated means code exists behind a build or runtime gate. Partial names a real limitation. Each algorithm also links boundary, unit, integration, or end-to-end evidence."
    term: {
      word: "evidence vocabulary"
      meaning: "Boundary, unit, integration, and end-to-end references attached to an algorithm."
    }
    points: [
      "Built — executable on the admitted route.",
      "Feature-gated — executable only when its explicit gate is present.",
      "Partial — implemented with a named limitation or omitted fidelity."
    ]
    caption: "status labels · source-backed evidence."

    render: @scene {
      sdk.Header(id = "header", title = "WORKBOOK · STATUS & EVIDENCE", caption = "status labels · source-backed evidence.")
      sdk.Panel(id = "algo-built", title = "modulo-cell-ownership", x = 35, y = 132, width = 190, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-built", label = "BUILT", x = 155, y = 120, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "algo-partial", title = "final-report-assembly", x = 255, y = 132, width = 190, height = 72, strokeRole = "@theme.accent.tertiary")
      sdk.Chip(id = "st-partial", label = "PARTIAL", x = 375, y = 120, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "algo-gated", title = "phaser-start", x = 475, y = 132, width = 190, height = 72, strokeRole = "@theme.accent.secondary")
      sdk.Chip(id = "st-gated", label = "FEATURE-GATED", x = 549, y = 120, width = 116, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "evidence", title = "Evidence", x = 110, y = 275, width = 480, height = 54, strokeRole = "@theme.accent.primary")
      timeline primary {
        at 0 reveal header duration 260
        at 160 reveal algo-built duration 260
        at 320 reveal st-built duration 260
        at 480 reveal algo-partial duration 260
        at 640 reveal st-partial duration 260
        at 800 reveal algo-gated duration 260
        at 960 reveal st-gated duration 260
        at 1120 reveal evidence duration 260
      }
    }
  }

  slide "fail-closed-eligibility" {
    eyebrow: "Eligibility · 3 of 16"
    title: "Fail closed before cells launch"
    lede: "Eligibility begins at execution-mode-dispatch, promotes a multi-cell request with controller-promotion, then requires the Velo transport before any cellular role runs. Only a Velo-bearing build reaches run-kind, budget, storage, and artifact validation. velo-feature-admission is explicitly feature-gated: a lean binary reports an unsupported role instead of silently running direct."
    narration: "Eligibility fails closed before any cell launches. execution-mode-dispatch enters the private protocol, and controller-promotion recognizes a multi-cell request. velo-feature-admission gates every cellular role next, so a lean build reports an error rather than silently degrading. Only then do the run-shape and budget validators admit only supported combinations."
    term: {
      word: "cellular-run-shape-validation"
      meaning: "Pre-launch admission for supported transport, dataset, workload, and ownership combinations."
    }
    points: [
      "execution-mode-dispatch and controller-promotion are built.",
      "velo-feature-admission is feature-gated.",
      "execution-merge-backstops revalidates the payload actually returned by cells."
    ]
    caption: "dispatch → promote → admit → validate."

    render: @scene {
      sdk.Header(id = "header", title = "ELIGIBILITY · FAIL-CLOSED GATES", caption = "dispatch → promote → admit → validate.")
      sdk.Panel(id = "dispatch", title = "execution-mode-dispatch", x = 22, y = 150, width = 150, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-d", label = "BUILT", x = 102, y = 138, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "promote", title = "controller-promotion", x = 205, y = 150, width = 150, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-p", label = "BUILT", x = 285, y = 138, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "validate", title = "velo-feature-admission", x = 388, y = 150, width = 150, height = 72, strokeRole = "@theme.accent.secondary")
      sdk.Chip(id = "st-v", label = "FEATURE-GATED", x = 422, y = 138, width = 116, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "velo", title = "run-shape-validation", x = 570, y = 150, width = 108, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-velo", label = "BUILT", x = 608, y = 138, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a1", mode = "connector", from = { nodeId: "dispatch", anchor: "e" }, to = { nodeId: "promote", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Edge(id = "a2", mode = "connector", from = { nodeId: "promote", anchor: "e" }, to = { nodeId: "validate", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      sdk.Edge(id = "a3", mode = "connector", from = { nodeId: "validate", anchor: "e" }, to = { nodeId: "velo", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Signal(id = "motion-sig", from = { nodeId: "dispatch", anchor: "e" }, to = { nodeId: "velo", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      timeline primary {
        at 0 reveal header duration 260
        at 160 reveal dispatch duration 260
        at 320 reveal st-d duration 260
        at 640 reveal promote duration 260
        at 800 reveal st-p duration 260
        at 900 trace a1 duration 420
        at 1120 reveal validate duration 260
        at 1280 reveal st-v duration 260
        at 1380 trace a2 duration 420
        at 1600 reveal velo duration 260
        at 1760 reveal st-velo duration 260
        at 1860 trace a3 duration 420
        at 1920 trace motion-sig duration 900
      }
    }
  }

  slide "disjoint-ownership" {
    eyebrow: "Ownership · 4 of 16"
    title: "Tile work without gaps or collisions"
    lede: "modulo-cell-ownership assigns each global position to exactly one cell, while owned-positions-tiling proves the uneven slices still cover the whole budget. conversation-ownership advances a shared deterministic draw sequence and yields only the positions owned by that cell."
    narration: "Ownership tiles the authored budget deterministically. modulo-cell-ownership gives every position exactly one cell, and owned-positions-tiling accounts for uneven slices. conversation-ownership uses the same deterministic draw sequence while returning only owned conversations, so no turn crosses a cell boundary."
    term: {
      word: "modulo-cell-ownership"
      meaning: "Cell k owns global position i exactly when i modulo cell_count equals k."
    }
    points: [
      "Request, graph-instance, and conversation ownership remain disjoint.",
      "cellular-issuance-authority stamps interleaved global ordinals.",
      "A conversation remains wholly owned; turns never split across cells."
    ]
    caption: "one position · exactly one owner."

    render: @scene {
      sdk.Header(id = "header", title = "OWNERSHIP · DISJOINT TILING", caption = "one position · exactly one owner.")
      sdk.Panel(id = "modulo", title = "modulo-cell-ownership", x = 30, y = 145, width = 210, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-mod", label = "BUILT", x = 170, y = 133, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "c0", title = "cell 0", x = 290, y = 105, width = 170, height = 58, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "c1", title = "cell 1", x = 290, y = 181, width = 170, height = 58, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "c2", title = "cell 2", x = 290, y = 257, width = 170, height = 58, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "conv", title = "conversation-ownership", x = 500, y = 145, width = 170, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-conv", label = "BUILT", x = 554, y = 133, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.FanOut(id = "o1", from = { nodeId: "modulo", anchor: "e" }, to = [{ nodeId: "c0", anchor: "w" }, { nodeId: "c1", anchor: "w" }, { nodeId: "c2", anchor: "w" }], axis = "x", style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.FanIn(id = "ownership-merge", from = [{ nodeId: "c0", anchor: "e" }, { nodeId: "c1", anchor: "e" }, { nodeId: "c2", anchor: "e" }], to = { nodeId: "conv", anchor: "w" }, axis = "x", style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Label(id = "inv", text = "disjoint + complete", x = 100, y = 340, width = 500, height = 20, fontSize = 12, align = "middle")
      timeline primary {
        at 0 reveal header duration 260
        at 160 reveal modulo duration 260
        at 320 reveal st-mod duration 260
        at 480 reveal c0 duration 260
        at 640 reveal c1 duration 260
        at 800 reveal c2 duration 260
        at 960 trace o1 duration 420
        at 1120 reveal conv duration 260
        at 1280 reveal st-conv duration 260
        at 1440 trace ownership-merge duration 420
        at 1600 reveal inv duration 260
      }
    }
  }

  slide "control-plane" {
    eyebrow: "Control · 5 of 16"
    title: "Coordinate generations and process state"
    lede: "broadcast-attach-replay closes the replay-plus-live race, and phaser-generation-advance makes progress monotonic. synchronized-start is the default Velo-gated rendezvous; phaser-start is an opt-in feature-gated path. The gate changes coordination, never ownership."
    narration: "The control plane joins replay and live delivery without a race, then advances monotonic generations. synchronized-start is the default Velo-gated rendezvous, while phaser-start is an opt-in feature-gated branch. These choices change coordination timing, never which cell owns the work."
    term: {
      word: "broadcast-attach-replay"
      meaning: "Attach under the broadcast seam so concurrent data appears in replay or live delivery, never neither."
    }
    points: [
      "Replay and live delivery meet at one locked seam.",
      "phaser-await-generation uses a greater-than-or-equal gate.",
      "controller-child-arbitration surfaces hard child failure."
    ]
    caption: "replay seam · generations · START."

    render: @scene {
      sdk.Header(id = "header", title = "CONTROL · REPLAY + LIVE + START", caption = "replay seam · generations · START.")
      sdk.Panel(id = "replay", title = "broadcast-attach-replay", x = 22, y = 150, width = 185, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-r", label = "BUILT", x = 137, y = 138, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "gen", title = "phaser-generation-advance", x = 250, y = 150, width = 195, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-g", label = "BUILT", x = 375, y = 138, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "start", title = "phaser-start", x = 488, y = 150, width = 190, height = 72, strokeRole = "@theme.accent.secondary")
      sdk.Chip(id = "st-s", label = "FEATURE-GATED", x = 562, y = 138, width = 116, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "c1", mode = "line", from = { nodeId: "replay", anchor: "e" }, to = { nodeId: "gen", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Edge(id = "c2", mode = "line", from = { nodeId: "gen", anchor: "e" }, to = { nodeId: "start", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      sdk.Label(id = "ctrl-note", text = "coordination changes · ownership does not", x = 80, y = 292, width = 540, height = 24, fontSize = 12, align = "middle")
      sdk.Signal(id = "motion-sig", from = { nodeId: "replay", anchor: "e" }, to = { nodeId: "start", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      timeline primary {
        at 0 reveal header duration 260
        at 160 reveal replay duration 260
        at 320 reveal st-r duration 260
        at 640 reveal gen duration 260
        at 800 reveal st-g duration 260
        at 900 trace c1 duration 420
        at 1120 reveal start duration 260
        at 1280 reveal st-s duration 260
        at 1380 trace c2 duration 420
        at 1440 reveal ctrl-note duration 260
        at 1600 trace motion-sig duration 900
      }
    }
  }

  slide "distribution-path" {
    eyebrow: "Distribution · 6 of 16"
    title: "Deliver or regenerate only owned work"
    lede: "canonical-dataset-regeneration remains the measured path. controller-fanout-generation is a feature-gated verification overlay that publishes chunks and builds owned indexes; it never replaces canonical execution data. distribution-miss counts and surfaces an unindexed issue instead of skipping it."
    narration: "Canonical regeneration remains the measured data path. The feature-gated controller fan-out is a verification overlay that publishes compressed chunks and builds owned indexes. It never becomes measurement authority. If dispatch asks for an unindexed request, distribution-miss counts and surfaces it rather than silently skipping."
    term: {
      word: "distribution-miss"
      meaning: "A counted DispatchDecision::Miss that leaves ownership state recoverable."
    }
    points: [
      "dataset-velo-replay-live provides compressed replay plus live chunks.",
      "dataset-http-zstd-reconstruct handles cross-host Stage G inputs.",
      "A verification overlay proves delivery without becoming measurement authority."
    ]
    caption: "canonical path · optional verification overlay."

    render: @scene {
      sdk.Header(id = "header", title = "DISTRIBUTION · CANONICAL + OVERLAY", caption = "canonical path · optional verification overlay.")
      sdk.Panel(id = "canon", title = "canonical-regeneration", x = 35, y = 122, width = 220, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-canon", label = "BUILT", x = 185, y = 110, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "fanout", title = "controller-fanout-generation", x = 35, y = 245, width = 220, height = 72, strokeRole = "@theme.accent.secondary")
      sdk.Chip(id = "st-fan", label = "FEATURE-GATED", x = 139, y = 233, width = 116, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "miss", title = "distribution-miss", x = 440, y = 174, width = 225, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-miss", label = "BUILT", x = 595, y = 162, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "d1", mode = "line", from = { nodeId: "canon", anchor: "e" }, to = { nodeId: "miss", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Edge(id = "d2", mode = "path", from = { nodeId: "fanout", anchor: "e" }, to = { nodeId: "miss", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      sdk.Signal(id = "motion-sig", from = { nodeId: "canon", anchor: "e" }, to = { nodeId: "miss", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      timeline primary {
        at 0 reveal header duration 260
        at 160 reveal canon duration 260
        at 320 reveal st-canon duration 260
        at 640 reveal fanout duration 260
        at 800 reveal st-fan duration 260
        at 1120 reveal miss duration 260
        at 1280 reveal st-miss duration 260
        at 1380 trace d1 duration 420
        at 1380 trace d2 duration 420
        at 1440 trace motion-sig duration 900
      }
    }
  }

  slide "two-level-execution" {
    eyebrow: "Execution · 7 of 16"
    title: "Nest cell and worker shards"
    lede: "two-level-partition first assigns work to cells and then to thread-per-core workers. issuance-dispatch-injection then stamps that same nested partition into each worker's sampler and issuer before scheduled-shard-runtime dispatches through its worker-local sink. Graph and scheduled programs branch only after the owned envelope arrives."
    narration: "Execution nests two deterministic partitions. First the controller assigns a slice to each cell; then thread-per-core workers divide that slice again. Issuance-dispatch-injection stamps the same nested partition into each worker's sampler and issuer, and only then does the worker-local runtime dispatch through the ordinary sink, carrying that stable global identity into record capture and later merge."
    term: {
      word: "two-level-partition"
      meaning: "Deterministic cell ownership followed by disjoint worker ownership inside each cell."
    }
    points: [
      "partitioned-scheduled-sampler and partitioned-graph-source preserve workload semantics.",
      "cell-envelope-fetch hands an autonomous cell its resolved slice.",
      "Only execution workers dispatch inference load."
    ]
    caption: "global run → cell slice → worker shard."

    render: @scene {
      sdk.Header(id = "header", title = "EXECUTION · TWO-LEVEL PARTITION", caption = "global run → cell slice → worker shard.")
      sdk.Panel(id = "tlp", title = "two-level-partition", x = 30, y = 150, width = 175, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-tlp", label = "BUILT", x = 135, y = 138, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "iss", title = "issuance-dispatch-injection", x = 260, y = 150, width = 170, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-iss", label = "BUILT", x = 314, y = 138, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "w0", title = "worker 0", x = 500, y = 108, width = 180, height = 64, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "w1", title = "worker 1", x = 500, y = 225, width = 180, height = 64, strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "e1", mode = "line", from = { nodeId: "tlp", anchor: "e" }, to = { nodeId: "iss", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Edge(id = "e2", mode = "line", from = { nodeId: "iss", anchor: "e" }, to = { nodeId: "w0", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      sdk.Edge(id = "e3", mode = "line", from = { nodeId: "iss", anchor: "e" }, to = { nodeId: "w1", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      sdk.Signal(id = "motion-sig", from = { nodeId: "tlp", anchor: "e" }, to = { nodeId: "w0", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      timeline primary {
        at 0 reveal header duration 260
        at 160 reveal tlp duration 260
        at 320 reveal st-tlp duration 260
        at 640 reveal iss duration 260
        at 800 reveal st-iss duration 260
        at 900 trace e1 duration 420
        at 1120 reveal w0 duration 260
        at 1380 trace e2 duration 420
        at 1440 reveal w1 duration 260
        at 1600 trace motion-sig duration 900
        at 1700 trace e3 duration 420
      }
    }
  }

  slide "capture-modes" {
    eyebrow: "Capture · 8 of 16"
    title: "Choose retain, exact fold, or sketch"
    lede: "terminal-record-finalization closes one observation stream. retain-record-capture keeps rows in dispatch order; streaming-exact-fold appends exact aggregates and drops rows; tagged-sketch-merge bounds distribution memory while retaining exact counts and moments. Storage choice determines later artifact authority."
    narration: "Capture begins only after terminal record finalization. Retain keeps every row and its artifact authority. Exact fold appends exact record-derived aggregates and drops the row. Sketch also drops rows and bounds memory, while preserving exact counts and moments and approximating percentile interiors."
    term: {
      word: "terminal-record-finalization"
      meaning: "The point where observations become one complete CapturedRecord."
    }
    points: [
      "Retain preserves row-level artifacts.",
      "Exact fold drops rows but preserves exact record-derived aggregates.",
      "Sketch bounds memory; percentile interiors are approximate."
    ]
    caption: "finalize once · select storage fidelity."

    render: @scene {
      sdk.Header(id = "header", title = "CAPTURE · STORAGE MODES", caption = "finalize once · select storage fidelity.")
      sdk.Panel(id = "term", title = "terminal-record-finalization", x = 20, y = 150, width = 165, height = 72, strokeRole = "@theme.accent.primary")
      sdk.Chip(id = "st-term", label = "BUILT", x = 115, y = 138, width = 70, height = 22, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "retain", title = "retain-record-capture", x = 225, y = 92, width = 210, height = 60, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "fold", title = "streaming-exact-fold", x = 225, y = 170, width = 210, height = 60, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "sketch", title = "tagged-sketch-merge", x = 225, y = 248, width = 210, height = 60, strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "compat", title = "storage compatibility", x = 485, y = 150, width = 190, height = 72, strokeRole = "@theme.accent.primary")
