      sdk.Panel(id = "left", title = "exact fold · requests", x = 45, y = 245, width = 240, height = 70, strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "right", title = "sketch · conversations", x = 415, y = 245, width = 240, height = 70, strokeRole = "@theme.accent.tertiary")
