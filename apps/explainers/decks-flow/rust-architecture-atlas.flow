explainer "Rust Architecture Atlas" {
  id: "rust-architecture-atlas"
  route: "/rust-architecture-atlas"
  topic: "architecture"
  storagePrefix: "rust-arch-atlas-explainer"
  classPrefix: "deck-rust-atlas"
  eyebrowLabel: "RUST ARCHITECTURE ATLAS"
  startGateTitle: "Rust architecture atlas"

  hub: {
    highlight: "Rust architecture atlas"
    title: "source-oriented map"
    description: "Eleven-slide companion to the overview deck: system landscape, crate graph, hot path, protocol v2, scheduled and graph execution, endpoints, metrics, cellular, features, and extension seams."
  }
  slide "System landscape" {
    eyebrow: "1 · System"
    title: "Product landscape: author, execute, target"
    lede: "The atlas starts at product boundaries. `aiperf` from `aiperf-cli` authors Config v2, re-execs itself as `--execute`, and optionally launches `--cell` children. Load targets are real servers, `aiperf-mock-server`, or in-process Dynosim."
    narration: "The atlas opens at product boundaries. One aiperf binary authors the run, re-executes itself to dispatch load, and targets a real server, the mock server, or Dynosim."
    term: {
      word: "execute child"
      meaning: "Same `aiperf` binary started with hidden `--execute` flags; the only process that dispatches measured load."
    }
    points: [
      "`rust/cli/src/dispatch.rs` routes public commands.",
      "`rust/cli/src/execute_mode.rs` intercepts internal modes before clap.",
      "Mock server is a separate target; Dynosim is a transport feature, not a command."
    ]
    caption: "Author → execute → target · artifacts fan out after the run."
    render: @scene {
      roots: [
        {
          id: "hdr0"
          capability: "core.header"
          title: "SYSTEM LANDSCAPE"
          caption: "Author → execute → target · artifacts fan out after the run."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
        }
        {
          id: "config"
          capability: "core.panel"
          title: "Config v2"
          detail: "cli flags"
          layout: { x: 60, y: 90, width: 160, height: 70 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1.8 }
        }
        {
          id: "a0a"
          capability: "core.route"
          from: { nodeId: "config", anchor: "e" }
          to: { nodeId: "aiperf", anchor: "w" }
          style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none" }
        }
        {
          id: "aiperf"
          capability: "core.panel"
          title: "aiperf"
          detail: "cli/src/main.rs"
          layout: { x: 270, y: 80, width: 180, height: 90 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1.8 }
        }
        {
          id: "a0b"
          capability: "core.route"
          from: { nodeId: "aiperf", anchor: "s" }
          to: { nodeId: "execute", anchor: "n" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none" }
        }
        {
          id: "execute"
          capability: "core.panel"
          title: "aiperf --execute"
          detail: "protocol v2 child"
          layout: { x: 250, y: 210, width: 220, height: 80 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.primary, strokeWidth: 1.8 }
        }
        {
          id: "a0c"
          capability: "core.route"
          from: { nodeId: "execute", anchor: "e" }
          to: { nodeId: "cell", anchor: "w" }
          style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" }
        }
        {
          id: "cell"
          capability: "core.panel"
          title: "--cell N"
          detail: "optional"
          layout: { x: 520, y: 210, width: 140, height: 80 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.warning, strokeWidth: 1.8 }
        }
        {
          id: "real"
          capability: "core.panel"
          title: "real server"
          detail: "HTTP / gRPC"
          layout: { x: 60, y: 310, width: 150, height: 60 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1.3 }
        }
        {
          id: "mock"
          capability: "core.panel"
          title: "mock-server"
          detail: "standalone"
          layout: { x: 250, y: 310, width: 170, height: 60 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.tertiary, strokeWidth: 1.8 }
        }
        {
          id: "dyno"
          capability: "core.panel"
          title: "Dynosim"
          detail: "feature gate"
          layout: { x: 460, y: 310, width: 180, height: 60 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.primary, strokeWidth: 1.8 }
        }
        {
          id: "motion-sig-0"
          capability: "motion.signal"
          d: "M350 120 V200"
          layout: { x: 0, y: 0, width: 700, height: 400 }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s0-hdr" at: 0 duration: 280 target: "hdr0" action: "enter" }
        { id: "s0-config" at: 200 duration: 280 target: "config" action: "enter" }
        { id: "s0-a0a" at: 420 duration: 420 target: "a0a" action: "draw" }
        { id: "s0-aiperf" at: 700 duration: 280 target: "aiperf" action: "enter" }
        { id: "s0-a0b" at: 920 duration: 420 target: "a0b" action: "draw" }
        { id: "s0-execute" at: 1200 duration: 280 target: "execute" action: "enter" }
        { id: "s0-a0c" at: 1420 duration: 420 target: "a0c" action: "draw" }
        { id: "s0-cell" at: 1700 duration: 280 target: "cell" action: "enter" }
        { id: "s0-real" at: 1920 duration: 280 target: "real" action: "enter" }
        { id: "s0-mock" at: 2140 duration: 280 target: "mock" action: "enter" }
        { id: "s0-dyno" at: 2360 duration: 280 target: "dyno" action: "enter" }
        { id: "s0-motion" at: 2580 duration: 900 target: "motion-sig-0" action: "draw" }
        { id: "s0-emph" at: 3080 duration: 480 target: "dyno" action: "emphasis" }
      ]
    }
  }

  slide "Crate graph" {
    eyebrow: "2 · Processes"
    title: "Crate graph and process roles"
    lede: "Compile-time capability flows `aiperf-cli` → `aiperf-runtime` → `loadgen-core`. The entry process and its `--execute` child share one binary; `aiperf-mock-server` links runtime independently; `pyext` and `e2e` stay off the hot path."
    narration: "Capability flows from aiperf-cli into aiperf-runtime and then loadgen-core. Mock server and packaging crates stay outside that execute dependency edge."
    term: {
      word: "aiperf-runtime"
      meaning: "Library crate that owns clocks, transports, datasets, engine, cellular, and metrics composition."
    }
    points: [
      "Workspace members: loadgen-core, runtime, cli, mock-server, e2e, pyext.",
      "Solid edges are Cargo deps or self re-exec; dashed edges are network or optional features.",
      "Evidence: `rust/cli/Cargo.toml`, `rust/runtime/Cargo.toml`, `rust/loadgen-core/`."
    ]
    caption: "cli → runtime → loadgen-core · mock-server is peer, not child."
    render: @scene {
      roots: [
        {
          id: "hdr1"
          capability: "core.header"
          title: "PROCESS / CRATE GRAPH"
          caption: "cli → runtime → loadgen-core · mock-server is peer, not child."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
        }
        {
          id: "cli"
          capability: "core.panel"
          title: "aiperf-cli"
          detail: "binary + commands"
          layout: { x: 40, y: 100, width: 160, height: 90 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1.8 }
        }
        {
