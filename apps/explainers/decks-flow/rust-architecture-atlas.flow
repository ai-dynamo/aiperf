  slide "Crate graph" {
    eyebrow: "2 · Processes"
    title: "Crate graph and process roles"
    lede: "Compile-time capability flows `aiperf-cli` → `aiperf-runtime` → `loadgen-core`. The entry process and its `--execute` child share one binary; `aiperf-mock-server` links runtime independently; `pyext` and `e2e` stay off the hot path."
    narration: "Capability flows from aiperf-cli into aiperf-runtime and then loadgen-core. Mock server and packaging crates stay outside that execute dependency edge."
    term: {
      word: "aiperf-runtime"
      meaning: "Library crate that owns clocks, transports, datasets, engine, cellular, and metrics composition."
    }
    points: [
      "Workspace members: loadgen-core, runtime, cli, mock-server, e2e, pyext.",
      "Solid edges are Cargo deps or self re-exec; dashed edges are network or optional features.",
      "Evidence: `rust/cli/Cargo.toml`, `rust/runtime/Cargo.toml`, `rust/loadgen-core/`."
    ]
    caption: "cli → runtime → loadgen-core · mock-server is peer, not child."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
        }
        {
          id: "label"
          capability: "core.text"
          text: "PROCESS / CRATE GRAPH"
          layout: { x: 38, y: 28, width: 360, height: 24 }
          style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
        }
        {
          id: "note"
          capability: "core.text"
          text: "cli → runtime → loadgen-core · mock-server is peer, not child."
          layout: { x: 360, y: 28, width: 300, height: 24 }
          style: { fontSize: 12, fill: @theme.ink.secondary, textAnchor: "end" }
        }
        {
          id: "cli"
          capability: "core.rect"
          layout: { x: 40, y: 100, width: 160, height: 90 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1.8 }
