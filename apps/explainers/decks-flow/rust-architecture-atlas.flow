explainer "Rust Architecture Atlas" {
  id: "rust-architecture-atlas"
  route: "/rust-architecture-atlas"
  topic: "architecture"
  storagePrefix: "rust-arch-atlas-explainer"
  classPrefix: "deck-rust-atlas"
  eyebrowLabel: "RUST ARCHITECTURE ATLAS"
  startGateTitle: "Rust architecture atlas"

  hub: {
    highlight: "Rust architecture atlas"
    title: "source-oriented map"
    description: "Eleven-slide companion to the overview deck: system landscape, crate graph, hot path, protocol v2, scheduled and graph execution, endpoints, metrics, cellular, features, and extension seams."
  }
  slide "System landscape" {
    eyebrow: "1 · System"
    title: "Product landscape: author, execute, target"
    lede: "The atlas starts at product boundaries. `aiperf` from `aiperf-cli` authors Config v2, re-execs itself as `--execute`, and optionally launches `--cell` children. Load targets are real servers, `aiperf-mock-server`, or in-process Dynosim."
    narration: "The atlas opens at product boundaries. One aiperf binary authors the run, re-executes itself to dispatch load, and targets a real server, the mock server, or Dynosim."
    term: {
      word: "execute child"
      meaning: "Same `aiperf` binary started with hidden `--execute` flags; the only process that dispatches measured load."
    }
    points: [
      "`rust/cli/src/dispatch.rs` routes public commands.",
      "`rust/cli/src/execute_mode.rs` intercepts internal modes before clap.",
      "Mock server is a separate target; Dynosim is a transport feature, not a command."
    ]
    caption: "Author → execute → target · artifacts fan out after the run."
    render: @scene {
      sdk.Header(id = "hdr0", title = "SYSTEM LANDSCAPE", caption = "Author → execute → target · artifacts fan out after the run.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "config", title = "Config v2", detail = "cli flags", x = 60, y = 90, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a0a", mode = "route", from = { nodeId: "config", anchor: "e" }, to = { nodeId: "aiperf", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "aiperf", title = "aiperf", detail = "cli/src/main.rs", x = 270, y = 80, width = 180, height = 90, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a0b", mode = "route", from = { nodeId: "aiperf", anchor: "s" }, to = { nodeId: "execute", anchor: "n" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "execute", title = "aiperf --execute", detail = "protocol v2 child", x = 250, y = 210, width = 220, height = 80, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a0c", mode = "route", from = { nodeId: "execute", anchor: "e" }, to = { nodeId: "cell", anchor: "w" }, style = { stroke: "@theme.accent.warning", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "cell", title = "--cell N", detail = "optional", x = 520, y = 210, width = 140, height = 80, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Panel(id = "real", title = "real server", detail = "HTTP / gRPC", x = 60, y = 240, width = 150, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "mock", title = "mock-server", detail = "standalone", x = 250, y = 240, width = 170, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "dyno", title = "Dynosim", detail = "feature gate", x = 460, y = 240, width = 180, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Signal(id = "motion-sig-0", from = { nodeId: "aiperf", anchor: "s" }, to = { nodeId: "execute", anchor: "n" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr0 duration 280
        after hdr0 reveal config duration 280
        after config reveal aiperf duration 280
        after aiperf trace a0a duration 420
        after a0a reveal execute duration 280
        after execute trace a0b duration 420
        after a0b reveal cell duration 280
        after cell reveal real duration 280
        after cell trace a0c duration 420
        after a0c reveal mock duration 280
        after mock reveal dyno duration 280
        after execute trace motion-sig-0 duration 900
      }
    }
  }

  slide "Crate graph" {
    eyebrow: "2 · Processes"
    title: "Crate graph and process roles"
    lede: "Compile-time capability flows `aiperf-cli` → `aiperf-runtime` → `loadgen-core`. The entry process and its `--execute` child share one binary; `aiperf-mock-server` links runtime independently; `pyext` and `e2e` stay off the hot path."
    narration: "Capability flows from aiperf-cli into aiperf-runtime and then loadgen-core. Mock server and packaging crates stay outside that execute dependency edge."
    term: {
      word: "aiperf-runtime"
      meaning: "Library crate that owns clocks, transports, datasets, engine, cellular, and metrics composition."
    }
    points: [
      "Workspace members: loadgen-core, runtime, cli, mock-server, e2e, pyext.",
      "Solid edges are Cargo deps or self re-exec; dashed edges are network or optional features.",
      "Evidence: `rust/cli/Cargo.toml`, `rust/runtime/Cargo.toml`, `rust/loadgen-core/`."
    ]
    caption: "cli → runtime → loadgen-core · mock-server is peer, not child."
    render: @scene {
      sdk.Header(id = "hdr1", title = "PROCESS / CRATE GRAPH", caption = "cli → runtime → loadgen-core · mock-server is peer, not child.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "cli", title = "aiperf-cli", detail = "binary + commands", x = 40, y = 100, width = 160, height = 90, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a1a", mode = "connector", from = { nodeId: "cli", anchor: "e" }, to = { nodeId: "runtime", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "runtime", title = "aiperf-runtime", detail = "engine + transports", x = 250, y = 100, width = 180, height = 90, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a1b", mode = "connector", from = { nodeId: "runtime", anchor: "e" }, to = { nodeId: "loadgen", anchor: "w" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "loadgen", title = "loadgen-core", detail = "sink · observer", x = 480, y = 100, width = 180, height = 90, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "mock1", title = "mock-server", detail = "→ runtime", x = 250, y = 240, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "pyext", title = "pyext / e2e", detail = "off hot path", x = 450, y = 240, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Signal(id = "motion-sig-1", from = { nodeId: "cli", anchor: "e" }, to = { nodeId: "loadgen", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr1 duration 280
        after hdr1 reveal cli duration 280
        after cli reveal runtime duration 280
        after runtime trace a1a duration 420
        after a1a reveal loadgen duration 280
        after loadgen reveal mock1 duration 280
        after loadgen trace a1b duration 420
        after a1b reveal pyext duration 280
        after loadgen trace motion-sig-1 duration 900
      }
    }
  }

  slide "One-run hot path" {
    eyebrow: "3 · Runtime"
    title: "One request from bootstrap to commit"
    lede: "Startup freezes registries in `Application`, then `Coordinator` validates and prepares factories. Phase runtime paces work; `RequestSink` dispatches transport-native requests; observers accumulate; exporters commit `native-v2.json`."
    narration: "One request path freezes registries, validates through Coordinator, paces phases, dispatches on RequestSink, observes tokens, and commits native-v2.json."
    term: {
      word: "Coordinator"
      meaning: "Engine composition root: validate → prepare → execute → persist for one BenchmarkRun."
    }
    points: [
      "`rust/runtime/src/engine/application.rs` freezes factories once.",
      "`rust/runtime/src/engine/coordinator.rs` owns the run spine.",
      "`rust/loadgen-core/src/sink.rs` defines RequestSink and RequestObserver."
    ]
    caption: "Registries at startup · Clock + sink on the hot path · merge after drain."
    render: @scene {
      sdk.Header(id = "hdr2", title = "ONE-RUN HOT PATH", caption = "Registries at startup · Clock + sink on the hot path · merge after drain.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "app", title = "Application", detail = "freeze registry", x = 30, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a2a", mode = "connector", from = { nodeId: "app", anchor: "e" }, to = { nodeId: "coord", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "coord", title = "Coordinator", detail = "validate/prepare", x = 210, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a2b", mode = "connector", from = { nodeId: "coord", anchor: "e" }, to = { nodeId: "phase", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "phase", title = "Phase runtime", detail = "warmup→profile", x = 390, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Edge(id = "a2c", mode = "connector", from = { nodeId: "phase", anchor: "e" }, to = { nodeId: "sink", anchor: "w" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "sink", title = "Sink", detail = "dispatch", x = 570, y = 90, width = 110, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "clock", title = "Clock", detail = "Real / Sim", x = 120, y = 220, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "obs", title = "Observer", detail = "token · usage", x = 320, y = 220, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Panel(id = "nv2", title = "native-v2", detail = "report commit", x = 520, y = 220, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Signal(id = "motion-sig-2", from = { nodeId: "app", anchor: "e" }, to = { nodeId: "sink", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr2 duration 280
        after hdr2 reveal app duration 280
        after app reveal coord duration 280
        after coord trace a2a duration 420
        after a2a reveal phase duration 280
        after phase trace a2b duration 420
        after a2b reveal sink duration 280
        after sink reveal clock duration 280
        after sink trace a2c duration 420
        after a2c reveal obs duration 280
        after obs reveal nv2 duration 280
        after sink trace motion-sig-2 duration 900
      }
    }
  }

  slide "Protocol v2 child" {
    eyebrow: "4 · Protocol"
    title: "Self-exec protocol v2 lifecycle"
    lede: "Profile resolves `current_exe()`, spawns `aiperf --execute`, writes one strict protocol-v2 envelope to stdin, and waits for exactly one terminal JSONL line on stdout. stderr stays diagnostics-only."
    narration: "Protocol version two is a fresh process boundary: parent writes one envelope to stdin and reads one terminal JSONL line from stdout."
    term: {
      word: "protocol v2"
      meaning: "Strict serde envelope wrapping the authored BenchmarkRun; unknown fields fail closed."
    }
    points: [
      "`rust/cli/src/exec_bin.rs` resolves the child binary override.",
      "`rust/cli/src/execute.rs` is the parent protocol client.",
      "Child bootstrap composes Application, then Coordinator validate|execute."
    ]
    caption: "stdin: one envelope · stdout: one terminal · parent stays the shell."
    render: @scene {
      sdk.Header(id = "hdr3", title = "PROTOCOL V2 CHILD", caption = "stdin: one envelope · stdout: one terminal · parent stays the shell.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "profile", title = "profile", detail = "parent shell", x = 40, y = 90, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a3a", mode = "connector", from = { nodeId: "profile", anchor: "e" }, to = { nodeId: "req", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "req", title = "BenchmarkRun", detail = "protocol v2", x = 230, y = 90, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a3b", mode = "connector", from = { nodeId: "req", anchor: "e" }, to = { nodeId: "execbin", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "execbin", title = "exec_bin", detail = "current_exe", x = 430, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a3c", mode = "connector", from = { nodeId: "execbin", anchor: "e" }, to = { nodeId: "spawn", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "spawn", title = "spawn", detail = "--execute", x = 610, y = 90, width = 70, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "stdin", title = "stdin JSON", detail = "to EOF", x = 80, y = 210, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "app3", title = "Application", detail = "frozen catalog", x = 280, y = 210, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "stdout", title = "stdout JSONL", detail = "one terminal", x = 500, y = 210, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Signal(id = "motion-sig-3", from = { nodeId: "profile", anchor: "e" }, to = { nodeId: "spawn", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr3 duration 280
        after hdr3 reveal profile duration 280
        after profile reveal req duration 280
        after req trace a3a duration 420
        after a3a reveal execbin duration 280
        after execbin trace a3b duration 420
        after a3b reveal spawn duration 280
        after spawn reveal stdin duration 280
        after spawn trace a3c duration 420
        after a3c reveal app3 duration 280
        after app3 reveal stdout duration 280
        after spawn trace motion-sig-3 duration 900
      }
    }
  }

  slide "Scheduled workload" {
    eyebrow: "5 · Scheduled"
    title: "Paced workload path"
    lede: "Scheduled runs load conversations, apply arrival policy, admit through SlotPool, and dispatch PreparedTurns over HTTP, gRPC, or Dynosim. Worker topology is one LocalSet co-located sink or OS-thread sub-cells."
    narration: "Scheduled work loads conversations, applies arrival policy, admits through SlotPool, and places PreparedTurns on worker-local sinks."
    term: {
      word: "phase_runtime"
      meaning: "Shared warmup → profiling lifecycle with ramp, grace, cancellation, and drain."
    }
    points: [
      "`rust/runtime/src/phase_runtime.rs` and `scheduled.rs` bridge policy to turns.",
      "Request-rate, concurrency, user-centric, and fixed-schedule share one path.",
      "Transport choice does not fork separate workload registrations."
    ]
    caption: "dataset → phase → admit → TurnDispatcher → RequestSink."
    render: @scene {
      sdk.Header(id = "hdr4", title = "SCHEDULED WORKLOAD", caption = "dataset → phase → admit → TurnDispatcher → RequestSink.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "dataset", title = "dataset", detail = "loader", x = 30, y = 90, width = 130, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a4a", mode = "connector", from = { nodeId: "dataset", anchor: "e" }, to = { nodeId: "orch", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "orch", title = "PhaseOrchestrator", detail = "lifecycle", x = 200, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Edge(id = "a4b", mode = "connector", from = { nodeId: "orch", anchor: "e" }, to = { nodeId: "slot", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "slot", title = "SlotPool", detail = "admission", x = 380, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Edge(id = "a4c", mode = "connector", from = { nodeId: "slot", anchor: "e" }, to = { nodeId: "turn", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "turn", title = "TurnDispatcher", detail = "place turn", x = 560, y = 90, width = 120, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "w1", title = "workers=1", detail = "co-located LocalSet", x = 120, y = 220, width = 180, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "wn", title = "workers>1", detail = "OS thread sub-cells", x = 400, y = 220, width = 200, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Signal(id = "motion-sig-4", from = { nodeId: "dataset", anchor: "e" }, to = { nodeId: "turn", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr4 duration 280
        after hdr4 reveal dataset duration 280
        after dataset reveal orch duration 280
        after orch trace a4a duration 420
        after a4a reveal slot duration 280
        after slot trace a4b duration 420
        after a4b reveal turn duration 280
        after turn reveal w1 duration 280
        after turn trace a4c duration 420
        after a4c reveal wn duration 280
        after turn trace motion-sig-4 duration 900
      }
    }
  }

  slide "Graph trace path" {
    eyebrow: "6 · Graph"
    title: "Trace compile, phase rewrite, execute"
    lede: "Graph inputs (`dag_jsonl`, WEKA, Dynamo) compile once into a program plus SegmentStore. Warmup and profiling derive phase programs around a seeded frontier, then the graph executor fires nodes through the same RequestSink seam."
    narration: "Graph traces compile once into a program and segment store, derive warmup and profiling programs, then fire nodes through the same sink seam."
    term: {
      word: "GraphInputBundle"
      meaning: "Compiled program plus shared SegmentStore produced by the graph input resolver."
    }
    points: [
      "`rust/runtime/src/engine/graph_input.rs` selects and strictly decodes sources.",
      "`rust/runtime/src/engine/graph_phase_runtime.rs` derives warmup/profiling programs.",
      "`rust/runtime/src/graph/executor.rs` owns firing gates and dependencies."
    ]
    caption: "Compile once · rewrite phases · dispatch per node."
    render: @scene {
      sdk.Header(id = "hdr5", title = "GRAPH TRACE PATH", caption = "Compile once · rewrite phases · dispatch per node.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "trace", title = "trace source", detail = "dag · WEKA · Dynamo", x = 30, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a5a", mode = "connector", from = { nodeId: "trace", anchor: "e" }, to = { nodeId: "gin", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "gin", title = "graph_input", detail = "strict decode", x = 210, y = 90, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a5b", mode = "connector", from = { nodeId: "gin", anchor: "e" }, to = { nodeId: "comp", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "comp", title = "compiler", detail = "LCP + intern", x = 410, y = 90, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a5c", mode = "connector", from = { nodeId: "comp", anchor: "e" }, to = { nodeId: "bundle", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "bundle", title = "bundle", detail = "program", x = 600, y = 90, width = 80, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "warm", title = "warmup rewrite", detail = "prime prefixes", x = 80, y = 210, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Panel(id = "chop", title = "profiling chop", detail = "from t*", x = 280, y = 210, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "gexec", title = "graph executor", detail = "RequestSink", x = 480, y = 210, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Signal(id = "motion-sig-5", from = { nodeId: "trace", anchor: "e" }, to = { nodeId: "bundle", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr5 duration 280
        after hdr5 reveal trace duration 280
        after trace reveal gin duration 280
        after gin trace a5a duration 420
        after a5a reveal comp duration 280
        after comp trace a5b duration 420
        after a5b reveal bundle duration 280
        after bundle reveal warm duration 280
        after bundle trace a5c duration 420
        after a5c reveal chop duration 280
        after chop reveal gexec duration 280
        after bundle trace motion-sig-5 duration 900
      }
    }
  }

  slide "Endpoint dialects" {
    eyebrow: "7 · Endpoints"
    title: "Dialect preparation and wire binding"
    lede: "Endpoint registries validate authored profiles into dense EndpointKeys. Each worker calls prepare_worker once to build a local table; dialects format BodyPlans and bind HTTP or gRPC wire forms without per-token registry lookups."
    narration: "Endpoint dialects validate once, prepare a dense worker table, and format BodyPlans into HTTP or gRPC bindings without registry churn on the hot path."
    term: {
      word: "PreparedEndpointTable"
      meaning: "Worker-local dense lookup from EndpointKey to tokenizer, binder, and parser state."
    }
    points: [
      "`rust/runtime/src/endpoints/` owns dialect factories and traits.",
      "OpenAI, Anthropic, KServe, Riva, and specialized families register as factories.",
      "HTTP and gRPC share identity, prepare different bindings."
    ]
    caption: "validate once · prepare per worker · format per turn."
    render: @scene {
      sdk.Header(id = "hdr6", title = "ENDPOINT DIALECTS", caption = "validate once · prepare per worker · format per turn.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "profiles", title = "profiles", detail = "EndpointId", x = 40, y = 90, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a6a", mode = "connector", from = { nodeId: "profiles", anchor: "e" }, to = { nodeId: "ereg", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "ereg", title = "EndpointRegistry", detail = "factory lookup", x = 230, y = 90, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a6b", mode = "connector", from = { nodeId: "ereg", anchor: "e" }, to = { nodeId: "prep", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
