  slide "Cellular scale-out" {
    eyebrow: "9 · Cellular"
    title: "Controller, cells, hierarchical merge"
    lede: "`cells > 1` promotes the execute child into a controller. Cells fetch sliced envelopes over Velo, run the ordinary engine, and return records or folded stores. Optional aggregators merge subtrees; the controller commits once."
    narration: "Cellular mode promotes the execute child into a controller. Cells run ordinary execute on sliced envelopes and return mergeable partitions over Velo."
    term: {
      word: "cellular feature"
      meaning: "Cargo feature that enables Velo-backed cross-host cell transport (`aiperf-runtime/cellular`)."
    }
    points: [
      "`rust/runtime/src/engine/cellular_controller.rs` owns launch and merge.",
      "`rust/runtime/src/engine/cellular_cell.rs` runs the sliced execute path.",
      "SLURM and Kubernetes launchers reuse the same controller/cell model."
    ]
    caption: "promote → slice → ordinary execute → merge → one commit."
    render: @scene {
      sdk.Header(id = "hdr8", title = "CELLULAR SCALE-OUT", caption = "promote → slice → ordinary execute → merge → one commit.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "exec8", title = "--execute", detail = "cells > 1", x = 40, y = 90, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a8a", mode = "connector", from = { nodeId: "exec8", anchor: "e" }, to = { nodeId: "ctrl", anchor: "w" }, style = { stroke: "@theme.accent.warning", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "ctrl", title = "controller", detail = "partition + Velo", x = 240, y = 90, width = 170, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Edge(id = "a8b", mode = "connector", from = { nodeId: "ctrl", anchor: "e" }, to = { nodeId: "launch", anchor: "w" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "launch", title = "cell launcher", detail = "sliced envelope", x = 450, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "c0", title = "--cell 0", detail = "ordinary exec", x = 60, y = 210, width = 130, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "cn", title = "--cell N", detail = "ordinary exec", x = 230, y = 210, width = 130, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "agg", title = "aggregators", detail = "optional", x = 400, y = 210, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "merge8", title = "merge", detail = "one commit", x = 560, y = 210, width = 120, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.FanOut(id = "cell-fan", from = { nodeId: "launch", anchor: "s" }, to = [
            { nodeId: "c0", anchor: "n" },
            { nodeId: "cn", anchor: "n" },
            { nodeId: "agg", anchor: "n" }
          ], axis = "y", style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.FanIn(id = "result-fan", from = [
            { nodeId: "c0", anchor: "e" },
            { nodeId: "cn", anchor: "e" },
            { nodeId: "agg", anchor: "e" }
          ], to = { nodeId: "merge8", anchor: "w" }, axis = "x", style = { stroke: "@theme.accent.tertiary", strokeWidth: 2.2, fill: "none" })
      timeline primary {
        at 0 reveal hdr8 duration 280
        after hdr8 reveal exec8 duration 280
        after exec8 reveal ctrl duration 280
        after ctrl trace a8a duration 420
        after a8a reveal launch duration 280
        after launch trace cell-fan duration 620
        after cell-fan reveal c0 duration 280
        after launch trace a8b duration 420
        after a8b trace cell-fan duration 900
        after cell-fan reveal cn duration 280
        after cn reveal agg duration 280
        after agg trace result-fan duration 620
        after result-fan reveal merge8 duration 280
