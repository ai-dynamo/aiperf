  slide "Extension seams" {
    eyebrow: "11 · Seams"
    title: "Extensions and execution substitution"
    lede: "AIPerfExtension registers datasets, endpoints, transports, workloads, and exporters into a frozen AIPerfRegistry. Execution substitutes Clock and RequestSink implementations; cellular mode scales by wrapping the same single-run core."
    narration: "The open seams are AIPerfExtension registration at bootstrap and Clock plus RequestSink substitution on the hot path. Cellular wraps that same core."
    term: {
      word: "AIPerfRegistry"
      meaning: "Transactional, frozen capability table composed once per Application bootstrap."
    }
    points: [
      "`rust/runtime/src/extensions/` owns registration contracts.",
      "loadgen-core RequestObserver stays transport-neutral and !Send-friendly.",
      "Workloads resolve an execution factory from the prepared transport—no pair matrix."
    ]
    caption: "compile-time composition · Clock/Sink substitution · cellular wraps the core."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
        }
        {
          id: "label"
          capability: "core.text"
          text: "EXTENSION SEAMS"
          layout: { x: 38, y: 28, width: 360, height: 24 }
          style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
        }
        {
          id: "note"
          capability: "core.text"
          text: "compile-time composition · Clock/Sink substitution · cellular wraps the core."
          layout: { x: 360, y: 28, width: 300, height: 24 }
          style: { fontSize: 12, fill: @theme.ink.secondary, textAnchor: "end" }
        }
        {
          id: "ext"
          capability: "core.rect"
          layout: { x: 240, y: 80, width: 200, height: 60 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1.8 }
          children: [
            {
              id: "ext-title"
              capability: "core.text"
              text: "AIPerfExtension"
              layout: { x: 240, y: 92, width: 200, height: 24 }
              style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            }
            {
              id: "ext-detail"
              capability: "core.text"
