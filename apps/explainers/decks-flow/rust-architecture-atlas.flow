  slide "Metrics plane" {
    eyebrow: "8 · Metrics"
    title: "Observer stream to exporters"
    lede: "Transports emit RequestObserver events; worker-local collectors and metrics observers accumulate exact rows or t-digest sketches. After drain, MetricsAccumulator merges stores, joins side channels, commits the report, and exporters fan out."
    narration: "Measurement is an observer event stream. Workers accumulate locally, merge after drain, join side channels, and exporters fan out from the committed report."
    term: {
      word: "native-v2.json"
      meaning: "Authoritative typed report commit before optional exporter side outputs."
    }
    points: [
      "`rust/runtime/src/metrics.rs` adapts observers into the catalog.",
      "`rust/runtime/src/metrics_core/` accumulates and folds.",
      "`rust/runtime/src/export/` registers JSON, CSV, Parquet, OTLP, MLflow, W&B sinks."
    ]
    caption: "hot-path events · post-drain merge · durable report + fan-out."
    render: @scene {
      sdk.Header(id = "hdr7", title = "METRICS PLANE", caption = "hot-path events · post-drain merge · durable report + fan-out.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "rsink", title = "RequestSink", detail = "complete request", x = 40, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a7a", mode = "connector", from = { nodeId: "rsink", anchor: "e" }, to = { nodeId: "robs", anchor: "w" }, style = { stroke: "@theme.accent.warning", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "robs", title = "RequestObserver", detail = "arrival→terminal", x = 220, y = 90, width = 180, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Edge(id = "a7b", mode = "connector", from = { nodeId: "robs", anchor: "e" }, to = { nodeId: "wstore", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "wstore", title = "worker store", detail = "exact / sketch", x = 440, y = 90, width = 140, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Edge(id = "a7c", mode = "connector", from = { nodeId: "wstore", anchor: "e" }, to = { nodeId: "merge", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "merge", title = "merge", detail = "drain", x = 610, y = 90, width = 70, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "nv7", title = "native-v2.json", detail = "commit", x = 100, y = 220, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Panel(id = "compat", title = "compat exports", detail = "JSON · CSV", x = 300, y = 220, width = 150, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "otlp", title = "OTLP · MLflow", detail = "network sinks", x = 500, y = 220, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.FanOut(id = "export-fan", from = { nodeId: "merge", anchor: "s" }, to = [
            { nodeId: "nv7", anchor: "n" },
            { nodeId: "compat", anchor: "n" },
            { nodeId: "otlp", anchor: "n" }
          ], axis = "y", junction = { x: 645, y: 190 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr7 duration 280
        after hdr7 reveal rsink duration 280
        after rsink reveal robs duration 280
        after robs trace a7a duration 420
        after a7a reveal wstore duration 280
        after wstore trace a7b duration 420
