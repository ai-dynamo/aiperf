  slide "Feature builds" {
    eyebrow: "10 · Builds"
    title: "Feature graph defines capability"
    lede: "Default `aiperf-cli` enables `grpc` and `cellular`. Orthogonal features add `parquet`, `dynosim`, `pyo3-embed`, and `search-pyo3`. `full` unions dynosim + parquet + cellular + grpc. Missing capabilities fail closed at validation."
    narration: "Cargo features define the linked universe. Default builds include gRPC and cellular; parquet, dynosim, and pyo3-embed opt in and fail closed when missing."
    term: {
      word: "fail closed"
      meaning: "Authored transports, artifacts, or cell counts unavailable in the linked image are rejected during validation."
    }
    points: [
      "Evidence: `rust/cli/Cargo.toml` and `rust/runtime/Cargo.toml`.",
      "Dynosim pulls the pinned Dynamo mocker git dep when the feature is on.",
      "No runtime plugin discovery—capabilities are statically linked factories."
    ]
    caption: "Cargo features freeze the implementation universe."
    render: @scene {
      sdk.Header(id = "hdr9", title = "FEATURE BUILDS", caption = "Cargo features freeze the implementation universe.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "def", title = "default", detail = "grpc + cellular", x = 40, y = 90, width = 180, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "parquet", title = "parquet", detail = "columnar", x = 260, y = 90, width = 130, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Panel(id = "dynosim", title = "dynosim", detail = "Dynamo mocker", x = 420, y = 90, width = 130, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "pyo3", title = "pyo3", detail = "embed", x = 580, y = 90, width = 100, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Panel(id = "search", title = "search-pyo3", detail = "planners", x = 120, y = 220, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "full", title = "full", detail = "dynosim+parquet+…", x = 340, y = 220, width = 160, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "fail", title = "fail closed", detail = "validate", x = 540, y = 220, width = 120, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Signal(id = "motion-sig-9", from = { nodeId: "def", anchor: "w" }, to = { nodeId: "fail", anchor: "e" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr9 duration 280
        after hdr9 reveal def duration 280
        after def reveal parquet duration 280
        after parquet reveal dynosim duration 280
        after dynosim reveal pyo3 duration 280
        after pyo3 reveal search duration 280
        after search reveal full duration 280
        after full reveal fail duration 280
        after fail trace motion-sig-9 duration 900
      }
    }
  }

  slide "Extension seams" {
    eyebrow: "11 · Seams"
    title: "Extensions and execution substitution"
    lede: "AIPerfExtension registers datasets, endpoints, transports, workloads, and exporters into a frozen AIPerfRegistry. Execution substitutes Clock and RequestSink implementations; cellular mode scales by wrapping the same single-run core."
    narration: "The open seams are AIPerfExtension registration at bootstrap and Clock plus RequestSink substitution on the hot path. Cellular wraps that same core."
    term: {
      word: "AIPerfRegistry"
      meaning: "Transactional, frozen capability table composed once per Application bootstrap."
    }
    points: [
      "`rust/runtime/src/extensions/` owns registration contracts.",
      "loadgen-core RequestObserver stays transport-neutral and !Send-friendly.",
      "Workloads resolve an execution factory from the prepared transport—no pair matrix."
    ]
    caption: "compile-time composition · Clock/Sink substitution · cellular wraps the core."
    render: @scene {
      sdk.Header(id = "hdr10", title = "EXTENSION SEAMS", caption = "compile-time composition · Clock/Sink substitution · cellular wraps the core.", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "ext", title = "AIPerfExtension", detail = "transactional register", x = 240, y = 80, width = 200, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a10a", mode = "path", from = { x: 340, y: 140 }, to = { x: 340, y: 170 }, path = "M340 140 V170", x = 0, y = 0, width = 700, height = 400, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "reg", title = "AIPerfRegistry", detail = "frozen once", x = 230, y = 170, width = 220, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "ds", title = "datasets", detail = "loaders", x = 40, y = 270, width = 110, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "ep", title = "endpoints", detail = "dialects", x = 170, y = 270, width = 110, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "tr", title = "transports", detail = "HTTP·gRPC", x = 300, y = 270, width = 110, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "wl", title = "workloads", detail = "sched·graph", x = 430, y = 270, width = 110, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "ex", title = "exporters", detail = "sinks", x = 560, y = 270, width = 110, height = 60, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Signal(id = "motion-sig-10", from = { nodeId: "ext", anchor: "s" }, to = { nodeId: "ep", anchor: "s" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none", opacity: 0.55, role: "motion" })
      timeline primary {
        at 0 reveal hdr10 duration 280
        after hdr10 reveal ext duration 280
        after ext trace a10a duration 420
        after a10a reveal reg duration 280
        after reg reveal ds duration 280
        after ds reveal ep duration 280
        after ep reveal tr duration 280
        after tr reveal wl duration 280
        after wl reveal ex duration 280
        after ex trace motion-sig-10 duration 900
      }
    }
  }
