          layout: { x: 250, y: 240, width: 160, height: 70 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1.3 }
        }
        {
          id: "pyext"
          capability: "core.panel"
          title: "pyext / e2e"
          detail: "off hot path"
          layout: { x: 450, y: 240, width: 140, height: 70 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1.3 }
        }
        {
          id: "motion-sig-1"
          capability: "motion.signal"
          d: "M140 178 H560"
