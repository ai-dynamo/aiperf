  slide "Content-addressed interning" {
    eyebrow: "SegmentPool"
    title: "Content-addressed interning"
    lede: "SegmentPool is a mutable arena plus HashMap of SegmentId to Handle. A child's identity folds the parent's content hash, so identical prefixes across conversations collapse to the same handle even when load order differs."
    narration: "SegmentPool interns by blake3 content identity. Parent hashes fold into children, so shared prefixes collapse to the same dense handle across conversations."
    term: {
      word: "prefix-dependent id"
      meaning: "Child SegmentId hashes parent SegmentId plus domain payload bytes, not insertion index."
    }
    points: [
      "`Segment { id, parent, payload }` lives in a dense Vec arena.",
      "Dedup hits reuse handles; only novel content allocates.",
      "`freeze()` yields `InMemorySegmentStore` with `Box<[Segment]>`."
    ]
    caption: "Same parent chain + same bytes → same Handle."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
          children: [
            { id: "label" capability: "core.text" text: "SEGMENT POOL INTERN" layout: { x: 38, y: 28, width: 340, height: 24 } style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary } },
            { id: "hdr-caption" capability: "core.text" text: "Same parent chain + same bytes → same Handle." layout: { x: 340, y: 28, width: 320, height: 20 } style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "end" } }
          ]
        },
        {
