            }
          ]
        },
        {
          id: "domain-text"
          capability: "core.rect"
          layout: { x: 145, y: 110, width: 100, height: 90 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
