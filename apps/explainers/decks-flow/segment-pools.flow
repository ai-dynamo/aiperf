  slide "Shape now, splice bytes later" {
    eyebrow: "BodyPlan"
    title: "Shape now, splice bytes later"
    lede: "BodyPlan declares which JSON fields are literals versus segment handles. JsonBodyMaterializer walks the plan once: literals are the only hot-path serde work; segment slots clone pre-serialized wire bytes from the store."
    narration: "BodyPlan shapes the JSON object. JsonBodyMaterializer serializes only literals and clones prebuilt segment wires from the store."
    term: {
      word: "JsonBodyMaterializer"
      meaning: "Shared walker that turns a BodyPlan plus SegmentStore into dispatch Bytes."
    }
    points: [
      "Endpoints format BodyPlans in `rust/runtime/src/endpoints/`.",
      "Dataset precomputes plans for static turns where possible.",
      "Overrides merge stream flags and limits without rewriting message wires."
    ]
    caption: "literals serialize · segment wires clone · Overrides patch the tail."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.header"
          title: "BODYPLAN SPLICE"
          caption: "literals serialize · segment wires clone · Overrides patch the tail."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "plan"
          capability: "core.panel"
          title: "BodyPlan"
          detail: "shape + slots"
          layout: { x: 40, y: 100, width: 160, height: 80 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
        },
