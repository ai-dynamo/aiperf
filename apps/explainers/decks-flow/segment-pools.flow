        },
        {
          id: "domain-media"
          capability: "core.panel"
          title: "Media"
          detail: "multimodal"
          layout: { x: 490, y: 110, width: 100, height: 90 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.orange, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "domain-trace"
          capability: "core.panel"
          title: "TraceHash"
          detail: "sim identity"
          layout: { x: 605, y: 110, width: 100, height: 90 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.orange, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "hash-recipe"
          capability: "core.panel"
          title: "HASH_VERSION + domain + parent id"
          detail: "blake3 → SegmentId([u8;32])"
          layout: { x: 150, y: 250, width: 400, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "motion-sig"
          capability: "motion.signal"
          d: "M100 200 H600"
          layout: { x: 0, y: 0, width: 700, height: 400 }
