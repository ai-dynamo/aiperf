explainer "Segment Pools" {
  id: "segment-pools"
  route: "/segment-pools"
  topic: "dataset"
  storagePrefix: "segment-pools-explainer"
  classPrefix: "deck-segment-pools"
  eyebrowLabel: "SEGMENT POOLS"
  startGateTitle: "Segment pools & body plans"

  hub: {
    highlight: "Segment pools"
    title: "intern → freeze → splice"
    description: "How dataset rows become content-addressed handles and wire Bytes: SegmentPool, six payload domains, BodyPlan materialization, prefix chains, and Turn.body dispatch precedence."
  }

  slide "Rows in → wire bytes out" {
    eyebrow: "Overview"
    title: "Rows in → wire bytes out"
    lede: "Every request body starts as a dataset row. SegmentPool interns content-addressed segments; freeze drops the hash map into InMemorySegmentStore; BodyPlan plus JsonBodyMaterializer splice handles into Bytes on the hot path."
    narration: "Dataset rows become wire bytes through SegmentPool, a frozen segment store, and BodyPlan splicing. Content serializes once; the hot path clones handles."
    term: {
      word: "serialize once"
      meaning: "Content is serialized at intern time; dispatch clones prebuilt wire bytes instead of re-encoding payloads."
    }
    points: [
      "`Handle(u32)` is the dense public address; `SegmentId([u8;32])` is the blake3 dedup key.",
      "Freeze discards the id→handle map; handles remain valid in the store.",
      "Evidence: `rust/runtime/src/dataset/segment.rs`, `body_plan.rs`."
    ]
    caption: "BUILD → FREEZE → DISPATCH · zero content re-serialize on the hot path."

    render: @scene {
      sdk.Header(
        id = "header",
        title = "BUILD · FREEZE · DISPATCH",
        caption = "BUILD → FREEZE → DISPATCH · zero content re-serialize on the hot path.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Stepper(
        id = "phases",
        steps = ["BUILD", "FREEZE", "DISPATCH"],
        linked = true,
        gap = 24,
        x = 90, y = 95, width = 540, height = 28
      )
      sdk.Panel(
        id = "composer",
        title = "Composer",
        detail = "intern rows",
        x = 30, y = 130, width = 150, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
        id = "arrow-composer-pool",
        mode = "route",
        from = { nodeId: "composer", anchor: "e" },
        to = { nodeId: "segment-pool", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "segment-pool",
        title = "SegmentPool",
        detail = "arena + ids map",
        x = 230, y = 120, width = 160, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Callout(
        id = "pool-callout",
        text = "serialize once",
        x = 300, y = 66, width = 120, height = 22,
        target = { x: 360, y: 95 },
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "arrow-pool-freeze",
        mode = "route",
        from = { nodeId: "segment-pool", anchor: "e" },
        to = { nodeId: "freeze", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "freeze",
        title = ".freeze()",
        detail = "drop ids",
        x = 430, y = 130, width = 110, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "arrow-freeze-dispatch",
        mode = "route",
        from = { nodeId: "freeze", anchor: "e" },
        to = { nodeId: "dataset", anchor: "w" },
        style = { stroke: theme(accent.green), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "dataset",
        title = "Dataset",
        detail = "Arc store",
        x = 570, y = 110, width = 110, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Panel(
        id = "body-plan",
        title = "BodyPlan",
        detail = "precompute",
        x = 570, y = 190, width = 110, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Panel(
        id = "materializer",
        title = "Materializer",
        detail = "→ Bytes",
        x = 570, y = 270, width = 110, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Bracket(
        id = "dispatch-bracket",
        side = "left",
        x = 555, y = 105, width = 18, height = 230,
        strokeRole = theme(accent.green),
        strokeWidth = 1.5
      )
      sdk.Panel(
        id = "in-memory-store",
        title = "InMemoryStore",
        detail = "Box<[Segment]>",
        x = 230, y = 230, width = 160, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Signal(
        id = "motion-sig",
        from = { nodeId: "composer", anchor: "e" },
        to = { nodeId: "dataset", anchor: "w" },
        opacity = 0.55,
        strokeWidth = 2.4,
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal header duration 220
        after header stagger targets [phases-step-0, phases-step-1, phases-step-2] step 80 duration 160
        after phases-step-2 reveal pool-callout duration 200
        after pool-callout reveal composer duration 280
        after composer trace arrow-composer-pool duration 220
        after arrow-composer-pool trace motion-sig duration 900
        after motion-sig reveal segment-pool duration 300
        after segment-pool trace arrow-pool-freeze duration 220
        after arrow-pool-freeze reveal freeze duration 280
        after freeze trace arrow-freeze-dispatch duration 200
        after arrow-freeze-dispatch stagger targets [dataset, body-plan, materializer] step 160 duration 220
        after materializer reveal dispatch-bracket duration 220
        after dispatch-bracket reveal in-memory-store duration 260
      }
    }
  }

  slide "Content-addressed interning" {
    eyebrow: "SegmentPool"
    title: "Content-addressed interning"
    lede: "SegmentPool is a mutable arena plus HashMap of SegmentId to Handle. A child's identity folds the parent's content hash, so identical prefixes across conversations collapse to the same handle even when load order differs."
    narration: "SegmentPool interns by blake3 content identity. Parent hashes fold into children, so shared prefixes collapse to the same dense handle across conversations."
    term: {
      word: "prefix-dependent id"
      meaning: "Child SegmentId hashes parent SegmentId plus domain payload bytes, not insertion index."
    }
    points: [
      "`Segment { id, parent, payload }` lives in a dense Vec arena.",
      "Dedup hits reuse handles; only novel content allocates.",
      "`freeze()` yields `InMemorySegmentStore` with `Box<[Segment]>`."
    ]
    caption: "Same parent chain + same bytes → same Handle."

    render: @scene {
      sdk.Header(
        id = "header",
        title = "SEGMENT POOL INTERN",
        caption = "Same parent chain + same bytes → same Handle.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "intern",
        title = "intern(msg)",
        detail = "parent + bytes",
        x = 40, y = 100, width = 160, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
        id = "arrow-intern-pool",
        mode = "route",
        from = { nodeId: "intern", anchor: "e" },
        to = { nodeId: "pool", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "pool",
        title = "SegmentPool",
        detail = "HashMap → Handle",
        x = 250, y = 90, width = 200, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "arrow-pool-dedup",
        mode = "route",
        from = { nodeId: "pool", anchor: "e" },
        to = { nodeId: "dedup", anchor: "w" },
        style = { stroke: theme(accent.green), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "dedup",
        title = "dedup hit?",
        detail = "reuse Handle",
        x = 500, y = 100, width = 160, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Panel(
        id = "h0",
        title = "H0 system",
        detail = "shared",
        x = 120, y = 240, width = 140, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "h1",
        title = "H1 user",
        detail = "shared",
        x = 300, y = 240, width = 140, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "h23",
        title = "H2 / H3",
        detail = "novel replies",
        x = 480, y = 240, width = 140, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.orange)
      )
      sdk.Signal(
        id = "motion-sig",
        from = { nodeId: "intern", anchor: "e" },
        to = { nodeId: "dedup", anchor: "w" },
        opacity = 0.55,
        strokeWidth = 2.4,
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal header duration 220
        after header reveal intern duration 280
        after intern trace arrow-intern-pool duration 220
        after arrow-intern-pool reveal pool duration 320
        after pool trace motion-sig duration 900
        after motion-sig trace arrow-pool-dedup duration 220
        after arrow-pool-dedup reveal dedup duration 280
        after dedup stagger targets [h0, h1, h23] step 160 duration 240
      }
    }
  }

  slide "Six disjoint blake3 domains" {
    eyebrow: "Payloads"
    title: "Six disjoint blake3 domains"
    lede: "Payload is one of Message, Text, Raw, TokenIds, Media, or TraceHashIds. Each hashes under its own domain prefix framed by `aiperf-dataset-segment-v1` and the parent id, so identical bytes in different domains never collide."
    narration: "Six payload domains hash under disjoint prefixes. Message, text, raw, token ids, media, and trace hashes never collide even when the bytes look identical."
    term: {
      word: "SegmentDomain"
      meaning: "Discriminant that drives dispatch formatting: Message array, Raw complete body, or TokenIds native path."
    }
    points: [
      "Message carries role, wire Bytes, and token ids.",
      "Raw is a complete JSON body or field; TokenIds stay token-native.",
      "TraceHashIds retain simulator cache identity without prompt bytes."
    ]
    caption: "HASH_VERSION · domain prefix · parent id · payload recipe → SegmentId."

    render: @scene {
      sdk.Header(
        id = "header",
        title = "PAYLOAD DOMAINS",
        caption = "HASH_VERSION · domain prefix · parent id · payload recipe → SegmentId.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "domain-message",
        title = "Message",
        detail = "wire + tokens",
        x = 30, y = 110, width = 100, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "domain-text",
        title = "Text",
        detail = "text-only",
        x = 145, y = 110, width = 100, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "domain-raw",
        title = "Raw",
        detail = "complete body",
        x = 260, y = 110, width = 100, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Panel(
        id = "domain-token",
        title = "TokenIds",
        detail = "native path",
        x = 375, y = 110, width = 100, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Panel(
        id = "domain-media",
        title = "Media",
        detail = "multimodal",
        x = 490, y = 110, width = 100, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.orange)
      )
      sdk.Panel(
        id = "domain-trace",
        title = "TraceHash",
        detail = "sim identity",
        x = 605, y = 110, width = 100, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.orange)
      )
      sdk.Panel(
        id = "hash-recipe",
        title = "HASH_VERSION + domain + parent id",
        detail = "blake3 → SegmentId([u8;32])",
        x = 150, y = 250, width = 400, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Signal(
        id = "motion-sig",
        from = { nodeId: "domain-message", anchor: "s" },
        to = { nodeId: "hash-recipe", anchor: "n" },
        opacity = 0.55,
        strokeWidth = 2.4,
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal header duration 220
        after header stagger targets [domain-message, domain-text, domain-raw, domain-token, domain-media, domain-trace] step 120 duration 200
        after domain-trace trace motion-sig duration 900
        after motion-sig reveal hash-recipe duration 320
      }
    }
  }

  slide "Shape now, splice bytes later" {
    eyebrow: "BodyPlan"
    title: "Shape now, splice bytes later"
    lede: "BodyPlan declares which JSON fields are literals versus segment handles. JsonBodyMaterializer walks the plan once: literals are the only hot-path serde work; segment slots clone pre-serialized wire bytes from the store."
    narration: "BodyPlan shapes the JSON object. JsonBodyMaterializer serializes only literals and clones prebuilt segment wires from the store."
    term: {
      word: "JsonBodyMaterializer"
      meaning: "Shared walker that turns a BodyPlan plus SegmentStore into dispatch Bytes."
    }
    points: [
      "Endpoints format BodyPlans in `rust/runtime/src/endpoints/`.",
      "Dataset precomputes plans for static turns where possible.",
      "Overrides merge stream flags and limits without rewriting message wires."
    ]
    caption: "literals serialize · segment wires clone · Overrides patch the tail."

    render: @scene {
      sdk.Header(
        id = "header",
        title = "BODYPLAN SPLICE",
        caption = "literals serialize · segment wires clone · Overrides patch the tail.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "plan",
        title = "BodyPlan",
        detail = "shape + slots",
        x = 40, y = 100, width = 160, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Edge(
        id = "arrow-plan-mat",
        mode = "route",
        from = { nodeId: "plan", anchor: "e" },
        to = { nodeId: "mat", anchor: "w" },
        style = { stroke: theme(accent.warning), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "mat",
        title = "JsonBodyMaterializer",
        detail = "walk once",
        x = 250, y = 90, width = 200, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
