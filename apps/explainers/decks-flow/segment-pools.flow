            { id: "hdr-caption" capability: "core.text" text: "Same parent chain + same bytes → same Handle" layout: { x: 340, y: 28, width: 320, height: 20 } style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "end" } }
