  slide "Shared prefixes and LCP lowering" {
    eyebrow: "Prefix trie"
    title: "Shared prefixes and LCP lowering"
    lede: "Composers keep a running parent Handle per conversation so each turn extends a chain. Recorded WEKA and Dynamo traces lower through an LCP trie over block hashes, reusing interned handles for the longest shared prefix."
    narration: "Conversation composers and recorded-trace LCP tries keep shared prefixes stored once. Branches allocate only the novel suffix handles."
    term: {
      word: "rebase"
      meaning: "Re-intern conversation handles under a new system/user context root so blake3 ids reflect the injected prefix."
    }
    points: [
      "Format composers in `dataset/loader/` build each chain; `dataset/compose.rs` owns rebase.",
      "`graph/recorded/trie/` resolves content parents from hash_ids.",
      "Shared system and user turns store once; branches allocate only novel replies."
    ]
    caption: "One shared prefix · many conversation branches by handle."

    render: @scene {
      sdk.Header(
        id = "header",
        title = "PREFIX CHAINS",
        caption = "One shared prefix · many conversation branches by handle.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "h0",
        title = "H0 system",
        detail = "shared once",
        x = 40, y = 140, width = 140, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
        id = "arrow-h0-h1",
        mode = "route",
        from = { nodeId: "h0", anchor: "e" },
        to = { nodeId: "h1", anchor: "w" },
        style = { stroke: theme(accent.secondary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "h1",
        title = "H1 user",
        detail = "shared once",
        x = 220, y = 140, width = 140, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.FanOut(
        id = "arrow-h1-branches",
        from = { nodeId: "h1", anchor: "e" },
        to = [{ nodeId: "h2", anchor: "w" }, { nodeId: "h3", anchor: "w" }],
        axis = "x",
        style = { stroke: theme(accent.green), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "h2",
        title = "H2 assistant",
        detail = "C1 \"4\"",
        x = 460, y = 100, width = 150, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "h3",
        title = "H3 assistant",
        detail = "C2 novel",
        x = 460, y = 220, width = 150, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Label(
        id = "footnote",
        text = "LCP trie / compose parent chains reuse H0·H1",
        x = 150, y = 330, width = 400, height = 20,
        fontSize = 12,
        align = "middle",
        inkRole = theme(ink.secondary)
      )

      timeline main {
        at 0 reveal header duration 220
        after header reveal h0 duration 260
        after h0 trace arrow-h0-h1 duration 200
        after arrow-h0-h1 reveal h1 duration 260
        after h1 reveal h2 duration 240
        after h2 reveal h3 duration 240
        after h3 trace arrow-h1-branches duration 900
        after arrow-h1-branches reveal footnote duration 200
      }
    }
  }

  slide "Turn.body precedence is domain-driven" {
    eyebrow: "Dispatch"
    title: "Turn.body precedence is domain-driven"
    lede: "`Turn.dispatch_body` builds one SmallVec of handles: raw payload first, then token ids, else the message list. The domain of the leading handle decides whether materialization takes the complete-body, token-native, or message-array path."
    narration: "Turn.body is one precedence vector. Raw leads, token ids follow, otherwise messages fill the body, and SegmentDomain selects the materializer path."
    term: {
      word: "dispatch_body"
      meaning: "Precedence helper in `dataset/model.rs` that replaces the old multi-field body selection."
    }
    points: [
      "Raw + TokenIds may coexist as `[raw, token]` for validation backends.",
      "Messages fill the body only when neither raw nor token ids are set.",
      "Graph HTTP can splice message wires directly; scheduled paths use BodyPlan."
    ]
    caption: "Raw → TokenIds → Messages · domain chooses the materializer path."

    render: @scene {
      sdk.Header(
        id = "header",
        title = "DISPATCH PRECEDENCE",
        caption = "Raw → TokenIds → Messages · domain chooses the materializer path.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "turn-body",
        title = "Turn.body",
        detail = "SmallVec handles",
        x = 30, y = 140, width = 150, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.FanOut(
        id = "arrow-precedence",
        from = { nodeId: "turn-body", anchor: "e" },
        to = [{ nodeId: "raw", anchor: "w" }, { nodeId: "token", anchor: "w" }, { nodeId: "messages", anchor: "w" }],
        axis = "x",
        style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "raw",
        title = "Raw first?",
        detail = "complete body",
        x = 280, y = 70, width = 170, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Panel(
        id = "token",
        title = "TokenIds?",
        detail = "native / validate",
        x = 280, y = 155, width = 170, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Panel(
        id = "messages",
        title = "Messages",
        detail = "format array",
        x = 280, y = 240, width = 170, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
        id = "arrow-out",
        mode = "route",
        from = { nodeId: "token", anchor: "e" },
        to = { nodeId: "out", anchor: "w" },
        style = { stroke: theme(accent.warning), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "out",
        title = "BodyPlan → Bytes",
        detail = "domain path",
        x = 500, y = 140, width = 160, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Signal(
        id = "motion-sig",
        from = { nodeId: "token", anchor: "e" },
        to = { nodeId: "out", anchor: "w" },
        opacity = 0.55,
        strokeWidth = 2.4,
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal header duration 220
        after header reveal turn-body duration 280
        after turn-body reveal raw duration 220
        after raw reveal token duration 220
        after token reveal messages duration 220
        after messages trace arrow-precedence duration 900
        after arrow-precedence reveal out duration 260
        after out trace arrow-out duration 200
      }
    }
  }

  finalCard: @scene {
    sdk.Header(
      id = "final-hdr",
      title = "Live evidence files",
