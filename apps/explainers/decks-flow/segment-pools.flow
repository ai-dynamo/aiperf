explainer "Segment Pools" {
  id: "segment-pools"
  route: "/segment-pools"
  topic: "dataset"
  storagePrefix: "segment-pools-explainer"
  classPrefix: "deck-segment-pools"
  eyebrowLabel: "SEGMENT POOLS"
  startGateTitle: "Segment pools & body plans"

  hub: {
    highlight: "Segment pools"
    title: "intern → freeze → splice"
    description: "How dataset rows become content-addressed handles and wire Bytes: SegmentPool, six payload domains, BodyPlan materialization, prefix chains, and Turn.body dispatch precedence."
  }

  slide "Rows in → wire bytes out" {
    eyebrow: "Overview"
    title: "Rows in → wire bytes out"
    lede: "Every request body starts as a dataset row. SegmentPool interns content-addressed segments; freeze drops the hash map into InMemorySegmentStore; BodyPlan plus JsonBodyMaterializer splice handles into Bytes on the hot path."
    narration: "Dataset rows become wire bytes through SegmentPool, a frozen segment store, and BodyPlan splicing. Content serializes once; the hot path clones handles."
    term: {
      word: "serialize once"
      meaning: "Content is serialized at intern time; dispatch clones prebuilt wire bytes instead of re-encoding payloads."
    }
    points: [
      "`Handle(u32)` is the dense public address; `SegmentId([u8;32])` is the blake3 dedup key.",
      "Freeze discards the id→handle map; handles remain valid in the store.",
      "Evidence: `rust/runtime/src/dataset/segment.rs`, `body_plan.rs`."
    ]
    caption: "BUILD → FREEZE → DISPATCH · zero content re-serialize on the hot path."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
          children: [
            { id: "label" capability: "core.text" text: "BUILD · FREEZE · DISPATCH" layout: { x: 38, y: 28, width: 340, height: 24 } style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary } },
            { id: "hdr-caption" capability: "core.text" text: "BUILD → FREEZE → DISPATCH · zero content re-serialize on the hot path." layout: { x: 340, y: 28, width: 320, height: 20 } style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "end" } }
          ]
        },
        { id: "phase-build" capability: "core.text" text: "BUILD" layout: { x: 90, y: 76, width: 80, height: 16 } style: { fontSize: 11, fontWeight: "bold", fill: @theme.ink.tertiary } },
        { id: "phase-freeze" capability: "core.text" text: "FREEZE" layout: { x: 320, y: 76, width: 80, height: 16 } style: { fontSize: 11, fontWeight: "bold", fill: @theme.ink.tertiary } },
        { id: "phase-dispatch" capability: "core.text" text: "DISPATCH" layout: { x: 530, y: 76, width: 100, height: 16 } style: { fontSize: 11, fontWeight: "bold", fill: @theme.ink.tertiary } },
        {
          id: "composer"
          capability: "core.rect"
          layout: { x: 30, y: 110, width: 150, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
          children: [
            { id: "composer-title" capability: "core.text" text: "Composer" layout: { x: 38, y: 132, width: 134, height: 18 } style: { fontSize: 12, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" } },
            { id: "composer-detail" capability: "core.text" text: "intern rows" layout: { x: 38, y: 154, width: 134, height: 16 } style: { fontSize: 10, fill: @theme.ink.secondary, textAnchor: "middle" } }
          ]
