        x = 480, y = 240, width = 160, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.orange)
      )
      sdk.Signal(
        id = "motion-sig",
        from = { nodeId: "plan", anchor: "e" },
        to = { nodeId: "bytes", anchor: "w" },
        opacity = 0.55,
        strokeWidth = 2.4,
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal header duration 220
        after header reveal plan duration 280
        after plan trace arrow-plan-mat duration 220
        after arrow-plan-mat reveal mat duration 320
        after mat trace motion-sig duration 900
        after motion-sig trace arrow-mat-bytes duration 220
        after arrow-mat-bytes reveal bytes duration 280
