explainer "Segment Pools" {
  id: "segment-pools"
  route: "/segment-pools"
  topic: "dataset"
  storagePrefix: "segment-pools-explainer"
  classPrefix: "deck-segment-pools"
  eyebrowLabel: "SEGMENT POOLS"
  startGateTitle: "Segment pools & body plans"

  hub: {
    highlight: "Segment pools"
    title: "intern → freeze → splice"
    description: "How dataset rows become content-addressed handles and wire Bytes: SegmentPool, six payload domains, BodyPlan materialization, prefix chains, and Turn.body dispatch precedence."
  }

  slide "Rows in → wire bytes out" {
    eyebrow: "Overview"
    title: "Rows in → wire bytes out"
    lede: "Every request body starts as a dataset row. SegmentPool interns content-addressed segments; freeze drops the hash map into InMemorySegmentStore; BodyPlan plus JsonBodyMaterializer splice handles into Bytes on the hot path."
    narration: "Dataset rows become wire bytes through SegmentPool, a frozen segment store, and BodyPlan splicing. Content serializes once; the hot path clones handles."
    term: {
      word: "serialize once"
      meaning: "Content is serialized at intern time; dispatch clones prebuilt wire bytes instead of re-encoding payloads."
    }
    points: [
      "`Handle(u32)` is the dense public address; `SegmentId([u8;32])` is the blake3 dedup key.",
      "Freeze discards the id→handle map; handles remain valid in the store.",
      "Evidence: `rust/runtime/src/dataset/segment.rs`, `body_plan.rs`."
    ]
    caption: "BUILD → FREEZE → DISPATCH · zero content re-serialize on the hot path."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.header"
          title: "BUILD · FREEZE · DISPATCH"
          caption: "BUILD → FREEZE → DISPATCH · zero content re-serialize on the hot path."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "phases"
          capability: "core.stepper"
          steps: ["BUILD", "FREEZE", "DISPATCH"]
          linked: true
          layout: { x: 90, y: 70, width: 540, height: 28 }
          style: { gap: 24 }
        },
        {
          id: "composer"
          capability: "core.panel"
          title: "Composer"
          detail: "intern rows"
          layout: { x: 30, y: 110, width: 150, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "arrow-composer-pool"
          capability: "core.route"
          from: { nodeId: "composer", anchor: "e" }
          to: { nodeId: "segment-pool", anchor: "w" }
          style: { fill: "none", stroke: @theme.accent.tertiary, strokeWidth: 2.2 }
        },
        {
          id: "segment-pool"
          capability: "core.panel"
          title: "SegmentPool"
          detail: "arena + ids map"
          layout: { x: 230, y: 100, width: 160, height: 90 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "pool-pulse"
          capability: "motion.pulse"
          layout: { x: 230, y: 100, width: 160, height: 90 }
          style: { fill: "none", stroke: @theme.accent.tertiary, strokeWidth: 2.2, opacity: 0.45 }
          accessibility: { label: "SegmentPool pulse" }
        },
        {
          id: "pool-callout"
          capability: "core.callout"
          text: "serialize once"
          layout: { x: 250, y: 40, width: 120, height: 22 }
          target: { x: 310, y: 100 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.tertiary, strokeWidth: 1 }
        },
        {
          id: "arrow-pool-freeze"
          capability: "core.route"
          from: { nodeId: "segment-pool", anchor: "e" }
          to: { nodeId: "freeze", anchor: "w" }
          style: { fill: "none", stroke: @theme.accent.tertiary, strokeWidth: 2.2 }
        },
        {
          id: "freeze"
          capability: "core.panel"
          title: ".freeze()"
          detail: "drop ids"
          layout: { x: 430, y: 110, width: 110, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "arrow-freeze-dispatch"
          capability: "core.route"
          from: { nodeId: "freeze", anchor: "e" }
          to: { nodeId: "dataset", anchor: "w" }
          style: { fill: "none", stroke: @theme.accent.green, strokeWidth: 2.2 }
        },
        {
          id: "dataset"
          capability: "core.panel"
          title: "Dataset"
          detail: "Arc store"
          layout: { x: 570, y: 90, width: 110, height: 60 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "body-plan"
          capability: "core.panel"
          title: "BodyPlan"
          detail: "precompute"
          layout: { x: 570, y: 170, width: 110, height: 60 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "materializer"
          capability: "core.panel"
          title: "Materializer"
          detail: "→ Bytes"
          layout: { x: 570, y: 250, width: 110, height: 60 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "dispatch-bracket"
          capability: "core.bracket"
          layout: { x: 555, y: 85, width: 18, height: 230 }
          side: "left"
          style: { stroke: @theme.accent.green, strokeWidth: 1.5, fill: "none" }
          accessibility: { label: "dispatch stack brace" }
        },
        {
          id: "in-memory-store"
          capability: "core.panel"
          title: "InMemoryStore"
          detail: "Box<[Segment]>"
          layout: { x: 230, y: 250, width: 160, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "motion-sig"
          capability: "motion.signal"
          d: "M120 200 H580"
          layout: { x: 0, y: 0, width: 700, height: 400 }
          style: { fill: "none", stroke: @theme.accent.tertiary, strokeWidth: 2.4, opacity: 0.55, role: "motion" }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "t-header", at: 0, duration: 220, target: "header", action: "enter" },
        { id: "t-phases", at: 120, duration: 160, action: "stagger", targets: ["phases-step-0", "phases-step-1", "phases-step-2"], step: 80 },
        { id: "t-callout", at: 280, duration: 200, target: "pool-callout", action: "enter" },
        { id: "t-composer", at: 400, duration: 280, target: "composer", action: "enter" },
        { id: "t-arrow1", at: 640, duration: 220, target: "arrow-composer-pool", action: "draw" },
        { id: "t-pool", at: 800, duration: 300, target: "segment-pool", action: "enter" },
        { id: "t-pulse", at: 820, duration: 300, target: "pool-pulse", action: "enter" },
        { id: "t-arrow2", at: 1060, duration: 220, target: "arrow-pool-freeze", action: "draw" },
        { id: "t-freeze", at: 1220, duration: 280, target: "freeze", action: "enter" },
        { id: "t-arrow3", at: 1460, duration: 200, target: "arrow-freeze-dispatch", action: "draw" },
        { id: "t-dispatch-stack", at: 1600, duration: 220, action: "stagger", targets: ["dataset", "body-plan", "materializer"], step: 160 },
        { id: "t-bracket", at: 1680, duration: 220, target: "dispatch-bracket", action: "draw" },
        { id: "t-store", at: 2120, duration: 260, target: "in-memory-store", action: "enter" },
        { id: "t-motion", at: 700, duration: 900, target: "motion-sig", action: "draw" },
        { id: "t-emphasis", at: 2400, duration: 420, target: "segment-pool", action: "emphasize" }
      ]
    }
  }

  slide "Content-addressed interning" {
    eyebrow: "SegmentPool"
    title: "Content-addressed interning"
    lede: "SegmentPool is a mutable arena plus HashMap of SegmentId to Handle. A child's identity folds the parent's content hash, so identical prefixes across conversations collapse to the same handle even when load order differs."
    narration: "SegmentPool interns by blake3 content identity. Parent hashes fold into children, so shared prefixes collapse to the same dense handle across conversations."
    term: {
      word: "prefix-dependent id"
      meaning: "Child SegmentId hashes parent SegmentId plus domain payload bytes, not insertion index."
    }
    points: [
      "`Segment { id, parent, payload }` lives in a dense Vec arena.",
      "Dedup hits reuse handles; only novel content allocates.",
      "`freeze()` yields `InMemorySegmentStore` with `Box<[Segment]>`."
    ]
    caption: "Same parent chain + same bytes → same Handle."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.header"
          title: "SEGMENT POOL INTERN"
          caption: "Same parent chain + same bytes → same Handle."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "intern"
          capability: "core.panel"
          title: "intern(msg)"
          detail: "parent + bytes"
          layout: { x: 40, y: 100, width: 160, height: 80 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "arrow-intern-pool"
          capability: "core.route"
          from: { nodeId: "intern", anchor: "e" }
          to: { nodeId: "pool", anchor: "w" }
          style: { fill: "none", stroke: @theme.accent.tertiary, strokeWidth: 2.2 }
        },
        {
          id: "pool"
          capability: "core.panel"
          title: "SegmentPool"
          detail: "HashMap → Handle"
          layout: { x: 250, y: 90, width: 200, height: 100 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "arrow-pool-dedup"
          capability: "core.route"
          from: { nodeId: "pool", anchor: "e" }
          to: { nodeId: "dedup", anchor: "w" }
          style: { fill: "none", stroke: @theme.accent.green, strokeWidth: 2.2 }
        },
        {
          id: "dedup"
          capability: "core.panel"
          title: "dedup hit?"
          detail: "reuse Handle"
          layout: { x: 500, y: 100, width: 160, height: 80 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "h0"
          capability: "core.panel"
          title: "H0 system"
          detail: "shared"
          layout: { x: 120, y: 240, width: 140, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "h1"
          capability: "core.panel"
          title: "H1 user"
          detail: "shared"
          layout: { x: 300, y: 240, width: 140, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "h23"
          capability: "core.panel"
          title: "H2 / H3"
          detail: "novel replies"
          layout: { x: 480, y: 240, width: 140, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.orange, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "motion-sig"
          capability: "motion.signal"
          d: "M200 180 H500"
          layout: { x: 0, y: 0, width: 700, height: 400 }
          style: { fill: "none", stroke: @theme.accent.tertiary, strokeWidth: 2.4, opacity: 0.55, role: "motion" }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "t-header", at: 0, duration: 220, target: "header", action: "enter" },
        { id: "t-intern", at: 200, duration: 280, target: "intern", action: "enter" },
        { id: "t-arrow1", at: 440, duration: 220, target: "arrow-intern-pool", action: "draw" },
        { id: "t-pool", at: 600, duration: 320, target: "pool", action: "enter" },
        { id: "t-arrow2", at: 880, duration: 220, target: "arrow-pool-dedup", action: "draw" },
        { id: "t-dedup", at: 1040, duration: 280, target: "dedup", action: "enter" },
        { id: "t-handles", at: 1280, duration: 240, action: "stagger", targets: ["h0", "h1", "h23"], step: 160 },
        { id: "t-motion", at: 700, duration: 900, target: "motion-sig", action: "draw" },
        { id: "t-emphasis", at: 1900, duration: 420, target: "pool", action: "emphasize" }
      ]
    }
  }

  slide "Six disjoint blake3 domains" {
    eyebrow: "Payloads"
    title: "Six disjoint blake3 domains"
    lede: "Payload is one of Message, Text, Raw, TokenIds, Media, or TraceHashIds. Each hashes under its own domain prefix framed by `aiperf-dataset-segment-v1` and the parent id, so identical bytes in different domains never collide."
    narration: "Six payload domains hash under disjoint prefixes. Message, text, raw, token ids, media, and trace hashes never collide even when the bytes look identical."
    term: {
      word: "SegmentDomain"
      meaning: "Discriminant that drives dispatch formatting: Message array, Raw complete body, or TokenIds native path."
    }
    points: [
      "Message carries role, wire Bytes, and token ids.",
      "Raw is a complete JSON body or field; TokenIds stay token-native.",
      "TraceHashIds retain simulator cache identity without prompt bytes."
    ]
    caption: "HASH_VERSION · domain prefix · parent id · payload recipe → SegmentId."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.header"
          title: "PAYLOAD DOMAINS"
          caption: "HASH_VERSION · domain prefix · parent id · payload recipe → SegmentId."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "domain-message"
          capability: "core.panel"
          title: "Message"
          detail: "wire + tokens"
          layout: { x: 30, y: 110, width: 100, height: 90 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
