      ]
      timeline: [
        { id: "t-header", at: 0, duration: 220, target: "header", action: "enter" },
        { id: "t-domains", at: 180, duration: 200, action: "stagger", targets: ["domain-message", "domain-text", "domain-raw", "domain-token", "domain-media", "domain-trace"], step: 120 },
        { id: "t-hash", at: 1000, duration: 320, target: "hash-recipe", action: "enter" },
        { id: "t-motion", at: 700, duration: 900, target: "motion-sig", action: "draw" },
