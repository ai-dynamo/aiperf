  slide "Locust: the per-user loop" {
    eyebrow: "Locust architecture"
    title: "Execute a task, yield, execute the next one — forever"
    lede: "Starting a virtual user spawns a real cooperative green thread. Inside it, a simple loop runs: pick a task, execute it, then pause. With no configured think-time, that pause reduces to a bare cooperative yield — no time actually passes."

    narration: "Execute a task, then pause for think-time. At think-time zero, the pause is a bare yield — so the loop never really stops."

    term: {
      word: "cooperative yield"
      meaning: "A scheduling primitive that hands control back to the event loop without a wall-clock delay. Used as the pause between tasks when think-time is configured to zero, making a virtual user's loop effectively continuous rather than throttled."
    }

    points: [
      "Starting a virtual user spawns a real, individually-scheduled cooperative green thread.",
      "The per-user loop: pick a task, execute it, pause — then repeat, for the life of the run.",
      "The pause between tasks is implemented as a cooperative sleep for however long think-time says.",
      "With think-time fixed at zero, that sleep call is a zero-duration yield, not a real delay."
    ]

    caption: "One green thread, one loop: execute, yield, execute again."

    render: @scene {
      sdk.Header(
        id = "s2-hdr",
        title = "THE PER-USER LOOP",
        caption = "One green thread, one loop: execute, yield, execute again.",
        x = 63.6, y = 43.2, width = 1792.8, height = 118.8,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s2-exec1",
        title = "Execute task A",
        detail = "runs the simulated request",
        x = 123, y = 243, width = 432, height = 210.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Edge(
        id = "s2-e1",
        mode = "connector",
        from = { nodeId: "s2-exec1", anchor: "e" },
        to = { nodeId: "s2-wait1", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 5.4 }
      )
      sdk.Panel(
        id = "s2-wait1",
        title = "Pause",
        detail = "sleep(think_time)",
        x = 636, y = 243, width = 351, height = 210.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s2-e2",
        mode = "connector",
        from = { nodeId: "s2-wait1", anchor: "e" },
        to = { nodeId: "s2-exec2", anchor: "w" },
        style = { stroke: theme(accent.primary), strokeWidth: 5.4 }
      )
      sdk.Panel(
        id = "s2-exec2",
        title = "Execute task B",
        detail = "next queued task",
        x = 1068, y = 243, width = 432, height = 210.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Edge(
        id = "s2-e3",
        mode = "connector",
        from = { nodeId: "s2-exec2", anchor: "e" },
        to = { nodeId: "s2-wait2", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 5.4 }
      )
      sdk.Panel(
        id = "s2-wait2",
        title = "Pause",
        detail = "sleep(think_time)",
        x = 1527, y = 243, width = 243, height = 210.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s2-loop",
        mode = "connector",
        from = { nodeId: "s2-wait2", anchor: "s" },
        to = { nodeId: "s2-exec1", anchor: "s" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 4.32, dash: [4, 3] }
      )
      sdk.Label(
        id = "s2-looplabel",
        text = "repeats forever, for the life of the run",
        x = 609, y = 480.6, width = 756, height = 54,
        fontSize = 32.4,
        inkRole = theme(ink.tertiary)
      )
      sdk.Divider(
        id = "s2-div",
        axis = "x",
        x = 123, y = 567, length = 610,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s2-zero",
        title = "think_time = 0",
        detail = "sleep(0) → cooperative yield, no delay",
        x = 123, y = 621, width = 756, height = 210.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Panel(
        id = "s2-nonzero",
        title = "think_time = t > 0",
        detail = "sleep(t) → real wall-clock delay",
        x = 1041, y = 621, width = 756, height = 210.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Note(
        id = "s2-note",
        text = "No other delay mechanism exists in this loop — the pause is only ever this one sleep call",
        x = 150, y = 864, width = 1566, height = 81
      )
      sdk.Signal(
        id = "s2-motion",
        from = { nodeId: "s2-zero", anchor: "center" },
        to = { nodeId: "s2-nonzero", anchor: "center" },
        opacity = 0.4,
        strokeWidth = 5.4,
        label = "same code path, different delay",
        style = { stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 reveal s2-hdr duration 240
        after s2-hdr reveal s2-exec1 duration 220
        after s2-exec1 trace s2-e1 duration 220
        after s2-e1 reveal s2-wait1 duration 220
        after s2-wait1 trace s2-e2 duration 220
        after s2-e2 reveal s2-exec2 duration 220
        after s2-exec2 trace s2-e3 duration 220
        after s2-e3 reveal s2-wait2 duration 220
        after s2-wait2 trace s2-loop duration 300
        after s2-loop reveal s2-looplabel duration 200
        after s2-looplabel reveal s2-div duration 180
        after s2-div reveal s2-zero duration 240
        after s2-zero reveal s2-nonzero duration 240
        after s2-nonzero reveal s2-note duration 240
        after s2-note trace s2-motion duration 800
      }
    }
  }

  slide "Locust: master/worker distribution" {
    eyebrow: "Locust architecture"
    title: "A coordinator distributes users; a scheduler decides how"
    lede: "The coordinator process spawns no simulated users itself — it directs separate worker processes over a request-routing message channel. A distribution scheduler places users on workers round robin, and interleaves which user type comes next by configured weight."

    narration: "The coordinator directs worker processes, never spawning users itself. Placement is round robin; user-type mix is weighted interleaving."

    term: {
      word: "distribution scheduler"
      meaning: "The coordinator's algorithm for deciding, during ramp-up, which worker process and which simulated-user type receives the next spawned user: round-robin placement across workers, and weighted interleaving across user types."
    }

    points: [
      "The coordinator process spawns no simulated-user threads itself — it directs worker processes instead.",
      "Coordination uses a routing-style message channel that can address one specific connected worker.",
      "Worker placement is plain round robin across the currently connected workers.",
      "User-type placement is weighted interleaving, spreading configured ratios evenly rather than clustering them."
    ]

    caption: "Addressed messages to specific workers; round-robin placement, weighted interleaving."

    render: @scene {
      sdk.Header(
        id = "s3-hdr",
        title = "COORDINATOR → ROUTED MESSAGES → WORKERS",
