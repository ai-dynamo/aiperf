explainer "AIPerf vs Locust" {
  id: "aiperf-vs-locust"
  route: "/aiperf-vs-locust"
  topic: "architecture"
  storagePrefix: "aiperf-vs-locust-explainer"
  classPrefix: "deck-aiperf-vs-locust"
  eyebrowLabel: "AIPERF VS LOCUST"
  startGateTitle: "Two load-generation architectures, explained by concept"

  hub: {
    highlight: "aiperf vs locust"
    title: "cooperative green threads vs ledger-admitted tasks"
    description: "Locust's concurrency unit is a cooperative green thread, one per simulated user. AIPerf's concurrency unit is an admitted credit, realized as a lightweight task — and many of those run concurrently inside a single worker process."
  }

  slide "Two architectures" {
    eyebrow: "Overview"
    title: "Cooperative green threads vs ledger-admitted tasks"
    lede: "Locust's unit of concurrency is a lightweight cooperative thread, one per simulated user. AIPerf's unit of concurrency is an admitted credit, realized as a lightweight task — a single worker process hosts many of these running at once."

    narration: "Locust's concurrency unit is a green thread. AIPerf's is a credit, realized as a task inside a worker process. One worker hosts many credits at once."

    term: {
      word: "concurrency unit"
      meaning: "The thing a load-testing tool multiplies to reach a target in-flight-request count. For Locust that unit is a cooperative green thread. For AIPerf it is an admitted credit — a worker process is an execution host that runs many credits concurrently, not one concurrency unit per process."
    }

    points: [
      "Locust: a virtual user is a cooperative green thread — one thread, at most one in-flight request.",
      "AIPerf: a credit is the concurrency unit — one credit, one in-flight request, realized as a lightweight task inside a worker.",
      "A single AIPerf worker process normally runs many credits concurrently, with no internal cap of its own.",
      "The fair comparison is green thread to credit, not green thread to worker process — a worker hosts many concurrency units at once."
    ]

    caption: "One green thread per request vs one admitted credit per request — not one process per request."

    render: @scene {
      sdk.Header(
        id = "s1-hdr",
        title = "GREEN THREADS vs ADMITTED CREDITS",
        caption = "One green thread per request vs one admitted credit per request — not one process per request.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s1-locust",
        title = "Locust",
        detail = "N virtual users",
        x = 40, y = 80, width = 260, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s1-t1",
        title = "thread 1",
        detail = "1 in-flight request",
        x = 50, y = 150, width = 75, height = 50,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s1-t2",
        title = "thread 2",
        detail = "1 in-flight request",
        x = 135, y = 150, width = 75, height = 50,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s1-t3",
        title = "thread 3",
        detail = "1 in-flight request",
        x = 220, y = 150, width = 75, height = 50,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.secondary)
      )
      sdk.Label(
        id = "s1-tdots",
        text = "... thread N",
        x = 60, y = 208, width = 220, height = 20,
        fontSize = 12,
        inkRole = theme(ink.tertiary)
      )
      sdk.Edge(
        id = "s1-lt1",
        mode = "route",
        from = { nodeId: "s1-locust", anchor: "s" },
        to = { nodeId: "s1-t1", anchor: "n" },
        style = { stroke: theme(accent.secondary), strokeWidth: 1.4 }
      )
      sdk.Edge(
        id = "s1-lt2",
        mode = "route",
        from = { nodeId: "s1-locust", anchor: "s" },
        to = { nodeId: "s1-t2", anchor: "n" },
        style = { stroke: theme(accent.secondary), strokeWidth: 1.4 }
      )
      sdk.Edge(
        id = "s1-lt3",
        mode = "route",
        from = { nodeId: "s1-locust", anchor: "s" },
        to = { nodeId: "s1-t3", anchor: "n" },
        style = { stroke: theme(accent.secondary), strokeWidth: 1.4 }
      )
      sdk.Label(
        id = "s1-lcount",
        text = "concurrency = N threads",
        x = 50, y = 235, width = 250, height = 20,
        fontSize = 12,
        weight = "bold",
        inkRole = theme(accent.secondary)
      )
      sdk.Divider(
        id = "s1-div",
        axis = "y",
        x = 335, y = 80, length = 260,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s1-aiperf",
        title = "AIPerf",
        detail = "1 worker process",
        x = 380, y = 80, width = 260, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s1-c1",
        title = "credit → task",
        detail = "1 in-flight request",
        x = 390, y = 150, width = 75, height = 50,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s1-c2",
        title = "credit → task",
        detail = "1 in-flight request",
        x = 475, y = 150, width = 75, height = 50,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s1-c3",
        title = "credit → task",
        detail = "1 in-flight request",
        x = 560, y = 150, width = 75, height = 50,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.primary)
      )
      sdk.Label(
        id = "s1-cdots",
        text = "... many more credits, one process",
        x = 390, y = 208, width = 260, height = 20,
        fontSize = 12,
        inkRole = theme(ink.tertiary)
      )
      sdk.Edge(
        id = "s1-ac1",
        mode = "route",
        from = { nodeId: "s1-aiperf", anchor: "s" },
        to = { nodeId: "s1-c1", anchor: "n" },
        style = { stroke: theme(accent.primary), strokeWidth: 1.4 }
      )
      sdk.Edge(
        id = "s1-ac2",
        mode = "route",
        from = { nodeId: "s1-aiperf", anchor: "s" },
        to = { nodeId: "s1-c2", anchor: "n" },
        style = { stroke: theme(accent.primary), strokeWidth: 1.4 }
      )
      sdk.Edge(
        id = "s1-ac3",
        mode = "route",
        from = { nodeId: "s1-aiperf", anchor: "s" },
        to = { nodeId: "s1-c3", anchor: "n" },
        style = { stroke: theme(accent.primary), strokeWidth: 1.4 }
      )
      sdk.Label(
        id = "s1-acount",
        text = "concurrency = credits, not processes",
        x = 390, y = 235, width = 260, height = 20,
        fontSize = 12,
        weight = "bold",
        inkRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s1-host",
        title = "One process hosts many units",
        detail = "the process is an execution host, not the unit itself",
        x = 60, y = 285, width = 580, height = 50,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Signal(
        id = "s1-motion",
        from = { nodeId: "s1-locust", anchor: "e" },
        to = { nodeId: "s1-aiperf", anchor: "w" },
        opacity = 0.4,
        strokeWidth = 2,
        label = "thread vs credit, not process",
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal s1-hdr duration 240
        after s1-hdr reveal s1-locust duration 240
        after s1-locust trace s1-lt1 duration 160
        after s1-lt1 reveal s1-t1 duration 160
        after s1-t1 trace s1-lt2 duration 160
        after s1-lt2 reveal s1-t2 duration 160
        after s1-t2 trace s1-lt3 duration 160
        after s1-lt3 reveal s1-t3 duration 160
        after s1-t3 reveal s1-tdots duration 180
        after s1-tdots reveal s1-lcount duration 200
        after s1-lcount reveal s1-div duration 200
        after s1-div reveal s1-aiperf duration 240
        after s1-aiperf trace s1-ac1 duration 160
        after s1-ac1 reveal s1-c1 duration 160
        after s1-c1 trace s1-ac2 duration 160
        after s1-ac2 reveal s1-c2 duration 160
        after s1-c2 trace s1-ac3 duration 160
        after s1-ac3 reveal s1-c3 duration 160
        after s1-c3 reveal s1-cdots duration 180
        after s1-cdots reveal s1-acount duration 200
        after s1-acount reveal s1-host duration 260
        after s1-host trace s1-motion duration 900
      }
    }
  }

  slide "Locust: the per-user loop" {
    eyebrow: "Locust architecture"
    title: "Execute a task, yield, execute the next one — forever"
    lede: "Starting a virtual user spawns a real cooperative green thread. Inside it, a simple loop runs: pick a task, execute it, then pause. With no configured think-time, that pause reduces to a bare cooperative yield — no time actually passes."

    narration: "Execute a task, then pause for think-time. At think-time zero, the pause is a bare yield — so the loop never really stops."

    term: {
      word: "cooperative yield"
      meaning: "A scheduling primitive that hands control back to the event loop without a wall-clock delay. Used as the pause between tasks when think-time is configured to zero, making a virtual user's loop effectively continuous rather than throttled."
    }

    points: [
      "Starting a virtual user spawns a real, individually-scheduled cooperative green thread.",
      "The per-user loop: pick a task, execute it, pause — then repeat, for the life of the run.",
      "The pause between tasks is implemented as a cooperative sleep for however long think-time says.",
      "With think-time fixed at zero, that sleep call is a zero-duration yield, not a real delay."
    ]

    caption: "One green thread, one loop: execute, yield, execute again."

    render: @scene {
      sdk.Header(
        id = "s2-hdr",
        title = "THE PER-USER LOOP",
        caption = "One green thread, one loop: execute, yield, execute again.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s2-exec1",
        title = "Execute task A",
        detail = "runs the simulated request",
        x = 40, y = 90, width = 160, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Edge(
        id = "s2-e1",
        mode = "connector",
        from = { nodeId: "s2-exec1", anchor: "e" },
        to = { nodeId: "s2-wait1", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2 }
      )
      sdk.Panel(
        id = "s2-wait1",
        title = "Pause",
        detail = "sleep(think_time)",
        x = 230, y = 90, width = 130, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s2-e2",
        mode = "connector",
        from = { nodeId: "s2-wait1", anchor: "e" },
        to = { nodeId: "s2-exec2", anchor: "w" },
        style = { stroke: theme(accent.primary), strokeWidth: 2 }
      )
      sdk.Panel(
        id = "s2-exec2",
        title = "Execute task B",
        detail = "next queued task",
        x = 390, y = 90, width = 160, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Edge(
        id = "s2-e3",
        mode = "connector",
        from = { nodeId: "s2-exec2", anchor: "e" },
        to = { nodeId: "s2-wait2", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2 }
      )
      sdk.Panel(
        id = "s2-wait2",
        title = "Pause",
        detail = "sleep(think_time)",
        x = 560, y = 90, width = 90, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s2-loop",
        mode = "route",
        from = { nodeId: "s2-wait2", anchor: "s" },
        to = { nodeId: "s2-exec1", anchor: "s" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 1.6, dash: [4, 3] }
      )
      sdk.Label(
        id = "s2-looplabel",
        text = "repeats forever, for the life of the run",
        x = 220, y = 178, width = 280, height = 20,
        fontSize = 12,
        inkRole = theme(ink.tertiary)
      )
      sdk.Divider(
        id = "s2-div",
        axis = "x",
        x = 40, y = 210, length = 610,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s2-zero",
        title = "think_time = 0",
        detail = "sleep(0) → cooperative yield, no delay",
        x = 40, y = 230, width = 280, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Panel(
        id = "s2-nonzero",
        title = "think_time = t > 0",
        detail = "sleep(t) → real wall-clock delay",
        x = 380, y = 230, width = 280, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Note(
        id = "s2-note",
        text = "No other delay mechanism exists in this loop — the pause is only ever this one sleep call",
        x = 60, y = 320, width = 580, height = 30
      )
      sdk.Signal(
        id = "s2-motion",
        from = { nodeId: "s2-zero", anchor: "center" },
        to = { nodeId: "s2-nonzero", anchor: "center" },
        opacity = 0.4,
        strokeWidth = 2,
        label = "same code path, different delay",
        style = { stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 reveal s2-hdr duration 240
        after s2-hdr reveal s2-exec1 duration 220
        after s2-exec1 trace s2-e1 duration 220
        after s2-e1 reveal s2-wait1 duration 220
        after s2-wait1 trace s2-e2 duration 220
        after s2-e2 reveal s2-exec2 duration 220
        after s2-exec2 trace s2-e3 duration 220
        after s2-e3 reveal s2-wait2 duration 220
        after s2-wait2 trace s2-loop duration 300
        after s2-loop reveal s2-looplabel duration 200
        after s2-looplabel reveal s2-div duration 180
        after s2-div reveal s2-zero duration 240
        after s2-zero reveal s2-nonzero duration 240
        after s2-nonzero reveal s2-note duration 240
        after s2-note trace s2-motion duration 800
      }
    }
  }

  slide "Locust: master/worker distribution" {
    eyebrow: "Locust architecture"
    title: "A coordinator distributes users; a scheduler decides how"
    lede: "The coordinator process spawns no simulated users itself — it directs separate worker processes over a request-routing message channel. A distribution scheduler places users on workers round robin, and interleaves which user type comes next by configured weight."

    narration: "The coordinator directs worker processes, never spawning users itself. Placement is round robin; user-type mix is weighted interleaving."

    term: {
      word: "distribution scheduler"
      meaning: "The coordinator's algorithm for deciding, during ramp-up, which worker process and which simulated-user type receives the next spawned user: round-robin placement across workers, and weighted interleaving across user types."
    }

    points: [
      "The coordinator process spawns no simulated-user threads itself — it directs worker processes instead.",
      "Coordination uses a routing-style message channel that can address one specific connected worker.",
      "Worker placement is plain round robin across the currently connected workers.",
      "User-type placement is weighted interleaving, spreading configured ratios evenly rather than clustering them."
    ]

    caption: "Addressed messages to specific workers; round-robin placement, weighted interleaving."

    render: @scene {
      sdk.Header(
        id = "s3-hdr",
        title = "COORDINATOR → ROUTED MESSAGES → WORKERS",
        caption = "Addressed messages to specific workers; round-robin placement, weighted interleaving.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s3-master",
        title = "Coordinator process",
        detail = "round-robin cursor: → B next",
