      )
      sdk.Edge(
        id = "s7-e1",
        mode = "connector",
        from = { nodeId: "s7-t1", anchor: "e" },
        to = { nodeId: "s7-wb", anchor: "w" },
        style = { stroke: theme(accent.warning), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "s7-map",
