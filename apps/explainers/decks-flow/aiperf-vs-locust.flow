        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Label(
        id = "s4-t2",
        text = "t=6s",
        x = 1041, y = 243, width = 162, height = 48.6,
        fontSize = 29.7,
        inkRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s4-r2",
        title = "report",
        detail = "worker → coordinator",
        x = 919.5, y = 291.6, width = 297, height = 135,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
        id = "s4-e01",
        mode = "route",
        from = { nodeId: "s4-r0", anchor: "e" },
        to = { nodeId: "s4-r1", anchor: "w" },
        style = { stroke: theme(ink.tertiary), strokeWidth: 3.78, dash: [3, 3] }
      )
