explainer "AIPerf vs Locust" {
  id: "aiperf-vs-locust"
  route: "/aiperf-vs-locust"
  topic: "architecture"
  storagePrefix: "aiperf-vs-locust-explainer"
  classPrefix: "deck-aiperf-vs-locust"
  eyebrowLabel: "AIPERF VS LOCUST"
  startGateTitle: "Two concurrency models: virtual users vs distributed synchronized workers"

  hub: {
    highlight: "aiperf vs locust"
    title: "greenlet virtual users vs process-per-worker credit dispatch"
    description: "Locust simulates concurrency with cooperative greenlets inside a process. AIPerf achieves concurrency with real OS processes synchronized by a central credit-issuing coordinator."
  }

  slide "Two concurrency models" {
    eyebrow: "Two concurrency models"
    title: "Simulated users vs synchronized worker processes"
    lede: "Locust's concurrency primitive is the virtual user: one cooperative greenlet per simulated client, many sharing a single OS thread. AIPerf's concurrency primitive is the worker: a real OS process, admitted into flight by a central coordinator."

    narration: "Both tools drive load at a target concurrency, but they get there by fundamentally different means. Locust spawns one gevent greenlet per virtual user and lets gevent's cooperative scheduler interleave them on however many OS threads it's given — concurrency is simulated by yielding at I/O boundaries, not by parallel execution. AIPerf spawns a fixed pool of real OS processes as workers, and a separate coordinator process centrally decides which worker gets to send the next request by handing out an admission token called a credit. Every slide after this one is source-verified detail on one side of that split."

    term: {
      word: "concurrency primitive"
      meaning: "The unit a load-testing tool multiplies to reach a target in-flight-request count. Locust multiplies greenlets; AIPerf multiplies OS processes coordinated by credit admission."
    }

    points: [
      "Locust: N virtual users = N gevent greenlets, cooperatively scheduled on shared OS threads.",
      "AIPerf: concurrency = number of credits in flight, admitted across a fixed pool of worker OS processes.",
      "Locust's unit of concurrency is a green thread; AIPerf's is a real process plus an admission token.",
      "Evidence: locust/user/users.py (User.start → group.spawn); aiperf/controller/multiprocess_service_manager.py (multiprocessing.Process)."
    ]

    caption: "Greenlets simulate concurrency; processes plus credits synchronize it."

    render: @scene {
      sdk.Header(
        id = "s1-hdr",
        title = "SIMULATED vs SYNCHRONIZED",
        caption = "Greenlets simulate concurrency; processes plus credits synchronize it.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s1-locust",
        title = "Locust",
        detail = "virtual users = greenlets",
        x = 60, y = 110, width = 240, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s1-aiperf",
        title = "AIPerf",
        detail = "workers = OS processes + credits",
        x = 400, y = 110, width = 240, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Divider(
        id = "s1-div",
        axis = "y",
        x = 350, y = 90, length = 220,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Note(
        id = "s1-note",
        text = "Same target concurrency, two different mechanisms to reach it",
        x = 60, y = 250, width = 580, height = 32
      )
      sdk.Signal(
        id = "s1-motion",
        from = { nodeId: "s1-locust", anchor: "e" },
        to = { nodeId: "s1-aiperf", anchor: "w" },
        opacity = 0.45,
        strokeWidth = 2.2,
        label = "two mechanisms",
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal s1-hdr duration 260
        after s1-hdr reveal s1-locust duration 280
        after s1-locust reveal s1-div duration 220
        after s1-div reveal s1-aiperf duration 280
        after s1-aiperf reveal s1-note duration 260
        after s1-note trace s1-motion duration 900
      }
    }
  }

  slide "Locust: the virtual user" {
    eyebrow: "Locust architecture"
    title: "A User is a class; a virtual user is that class's greenlet"
    lede: "Locust's User.start() spawns a gevent.Greenlet running run_user(self) inside a Group. Every virtual user is cooperative: it runs until it yields at an I/O wait, then gevent switches to the next greenlet."

    narration: "In Locust, you author a User subclass whose tasks describe one simulated client's behavior. Calling start() does not create a thread or a process — it calls group.spawn(run_user, self), which asks gevent to schedule a new greenlet. Gevent monkey-patches the standard library's blocking calls so that whenever a greenlet would block on network I/O, it yields control back to the scheduler instead, and another greenlet runs in the gap. Thousands of virtual users can exist because each one is cheap — a stack and a state machine, not an OS thread — but only one greenlet is actually executing Python bytecode at any instant, on one CPU core, within one OS process."

    term: {
      word: "greenlet"
      meaning: "A gevent cooperative, single-threaded green thread. Cheap to create in large numbers because it has no OS-level thread or process backing it, but true parallelism across greenlets in one process is not possible — they interleave, they don't run simultaneously."
    }

    points: [
      "User.start(group) calls group.spawn(run_user, self) — a gevent.Greenlet, not an OS thread or process.",
      "With wait_time=0, each greenlet loops immediately after its request completes — at most one in-flight request per user.",
      "N users spawned at once means exactly N in flight at steady state — concurrency is exact, just not centrally counted.",
      "Evidence: locust/user/users.py — `self._greenlet = group.spawn(run_user, self)`; locust_user_concurrency_num_requests.py — `wait_time = constant(0)`."
    ]

    caption: "One OS process, many greenlets, cooperative interleaving."

    render: @scene {
      sdk.Header(
        id = "s2-hdr",
        title = "USER.START() → GREENLET",
        caption = "One OS process, many greenlets, cooperative interleaving.",
