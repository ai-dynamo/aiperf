        detail = "ZMQ ROUTER socket",
        x = 260, y = 190, width = 200, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s5-e0",
        mode = "route",
        from = { nodeId: "s5-tm", anchor: "s" },
