  slide "AIPerf: reproducing overshoot on purpose" {
    eyebrow: "AIPerf architecture"
    title: "Reproducing Locust's semantics needed two independent bypasses"
    lede: "The request-count condition disables itself when overshoot-style stopping is on — but that alone wasn't enough. A separate internal cap, used for other bookkeeping, had to be told to stand down too."

    narration: "Two independent request-count limits had to be disabled at once, not one — then every in-flight credit is cancelled immediately."

    term: {
      word: "dual bypass"
      meaning: "Reproducing Locust's overshoot-then-abandon stop semantics inside AIPerf required disabling two independent request-count limits simultaneously — one in the general stop-condition logic, one in separate internal bookkeeping — because one alone was documented as insufficient."
    }

    points: [
      "The request-count condition excludes itself when overshoot-style stopping is configured.",
      "A second, independent internal cap exists elsewhere and had to be told to stand down too.",
      "One mode polls on a fixed interval; the other fires a callback instantly, with no polling loop.",
      "Either way it ends by cancelling every in-flight credit immediately — abandon, not drain, on purpose."
    ]

    caption: "Two independent limits, one target — both had to stand down."

    render: @scene {
      sdk.Header(
        id = "s9-hdr",
        title = "TWO LIMITS, ONE TARGET",
        caption = "Two independent limits, one target — both had to stand down.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s9-gate1",
        title = "Request-count condition",
        detail = "disabled when overshoot mode is on",
        x = 40, y = 70, width = 260, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s9-gate2",
        title = "Separate internal cap",
        detail = "also had to be disabled",
        x = 380, y = 70, width = 260, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
