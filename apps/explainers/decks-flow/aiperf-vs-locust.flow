      )
      sdk.Panel(
        id = "s3-w4",
        title = "Worker D",
        detail = "connected",
        x = 520, y = 180, width = 140, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
        id = "s3-e1",
        mode = "route",
        from = { nodeId: "s3-master", anchor: "s" },
        to = { nodeId: "s3-w1", anchor: "n" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 1.6 }
      )
      sdk.Edge(
        id = "s3-e2",
        mode = "route",
        from = { nodeId: "s3-master", anchor: "s" },
        to = { nodeId: "s3-w2", anchor: "n" },
        style = { stroke: theme(accent.primary), strokeWidth: 2.4 }
      )
      sdk.Edge(
        id = "s3-e3",
        mode = "route",
        from = { nodeId: "s3-master", anchor: "s" },
        to = { nodeId: "s3-w3", anchor: "n" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 1.6 }
      )
      sdk.Edge(
        id = "s3-e4",
        mode = "route",
        from = { nodeId: "s3-master", anchor: "s" },
        to = { nodeId: "s3-w4", anchor: "n" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 1.6 }
      )
      sdk.Label(
        id = "s3-cycle",
        text = "round robin: A → B → C → D → A → ...",
        x = 60, y = 255, width = 560, height = 20,
