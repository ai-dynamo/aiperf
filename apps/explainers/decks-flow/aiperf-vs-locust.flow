        fontSize = 11,
        inkRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s4-r1",
        title = "report",
        detail = "worker → coordinator",
        x = 200, y = 92, width = 110, height = 50,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Label(
        id = "s4-t2",
        text = "t=6s",
        x = 380, y = 74, width = 60, height = 18,
        fontSize = 11,
        inkRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s4-r2",
        title = "report",
        detail = "worker → coordinator",
        x = 360, y = 92, width = 110, height = 50,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
        id = "s4-e01",
        mode = "route",
        from = { nodeId: "s4-r0", anchor: "e" },
        to = { nodeId: "s4-r1", anchor: "w" },
        style = { stroke: theme(ink.tertiary), strokeWidth: 1.4, dash: [3, 3] }
      )
      sdk.Edge(
        id = "s4-e12",
        mode = "route",
        from = { nodeId: "s4-r1", anchor: "e" },
        to = { nodeId: "s4-r2", anchor: "w" },
        style = { stroke: theme(ink.tertiary), strokeWidth: 1.4, dash: [3, 3] }
      )
      sdk.Panel(
        id = "s4-merge",
        title = "Running total",
        detail = "extended, not recomputed, each tick",
        x = 530, y = 85, width = 130, height = 65,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
