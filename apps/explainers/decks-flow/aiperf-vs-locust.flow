  slide "Locust: stats merge and stop semantics" {
    eyebrow: "Locust architecture"
    title: "Stats push every few seconds; stop drains only between tasks"
    lede: "Every worker pushes its own already-aggregated stats to the coordinator on a fixed, short interval, and the coordinator merges them into a running total. Stopping is a real drain, but only if a grace period is configured, and only up to the next task boundary."

    narration: "Stats merge in every few seconds. Stopping drains only up to a task boundary, and only with a grace period configured — otherwise it's an instant kill."

    term: {
      word: "bounded drain"
      meaning: "Locust's core graceful-stop mechanism: when a grace period is configured, a stopping user finishes its current task before exiting, bounded by that period. It does not protect a user that is currently paused between tasks when the stop signal arrives — that green thread is terminated immediately regardless."
    }

    points: [
      "Each worker reports its own aggregated stats on a fixed, short cadence — a few seconds, not per-request.",
      "The coordinator merges incrementally into a running total rather than recomputing from raw samples.",
      "With a grace period configured: the stop signal is checked at the next task boundary, not mid-request.",
      "Without a grace period, or if paused between tasks when stopped: immediate termination, no drain at all."
    ]

    caption: "Report every few seconds, merge incrementally; drain protects the task, not the pause."

    render: @scene {
      sdk.Header(
        id = "s4-hdr",
        title = "PERIODIC STATS PUSH · BOUNDED DRAIN",
        caption = "Report every few seconds, merge incrementally; drain protects the task, not the pause.",
        x = 63.6, y = 43.2, width = 1792.8, height = 118.8,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Label(
        id = "s4-t0",
        text = "t=0s",
        x = 177, y = 243, width = 162, height = 48.6,
        fontSize = 29.7,
        inkRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s4-r0",
