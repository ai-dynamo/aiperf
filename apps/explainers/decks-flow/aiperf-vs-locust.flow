        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s9-poller",
        title = "Overshoot mechanism",
        detail = "polling or instant-callback mode",
        x = 200, y = 220, width = 260, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s9-e1",
