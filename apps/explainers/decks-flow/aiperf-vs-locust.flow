        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s7-e1",
        mode = "connector",
        from = { nodeId: "s7-t1", anchor: "e" },
        to = { nodeId: "s7-wb", anchor: "w" },
        style = { stroke: theme(accent.warning), strokeWidth: 5.94 }
      )
      sdk.Panel(
