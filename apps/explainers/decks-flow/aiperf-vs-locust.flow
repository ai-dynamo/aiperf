  slide "AIPerf: inside one worker" {
    eyebrow: "AIPerf architecture"
    title: "One event loop, one lightweight task per in-flight credit"
    lede: "A worker doesn't throttle itself — no internal limit on how much it runs at once. Every credit it receives becomes an independent task on its one LocalSet event loop, sharing one pooled HTTP or gRPC sink. Concurrency admission happens entirely upstream, at credit issuance."

    narration: "Every credit becomes its own task, no worker-side limit. The real gate is upstream, at slot acquisition before dispatch."

    term: {
      word: "task-per-credit"
      meaning: "AIPerf's worker concurrency model: every admitted credit becomes its own lightweight task on the worker's single LocalSet event loop, with no internal limit — the worker executes whatever concurrency it's handed, because admission was already decided upstream by the credit ledger."
    }

    points: [
      "A received credit becomes an independent task on the worker's one event loop — no worker-side limit.",
      "Outbound calls share the worker-local transport sink and connection pool.",
      "The worker makes zero admission decisions — it runs exactly whatever concurrency it's been handed.",
      "Real concurrency enforcement lives entirely upstream, at slot acquisition before a credit is ever issued."
    ]

    caption: "Worker doesn't gate — the ledger already did."

    render: @scene {
      sdk.Header(
        id = "s10-hdr",
        title = "WORKER: NO SELF-THROTTLING",
