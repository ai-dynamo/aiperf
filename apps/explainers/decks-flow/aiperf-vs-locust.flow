  slide "Side by side" {
    eyebrow: "Side by side"
    title: "Simulated concurrency vs synchronized concurrency"
    lede: "Locust's concurrency is an emergent property of how gevent schedules greenlets. AIPerf's concurrency is an explicit invariant the timing_manager enforces by counting outstanding credits."

    narration: "Put next to each other, the contrast is at the level of what 'concurrency' even means to each tool. For Locust, concurrency is however many virtual-user greenlets happen to be alive and not currently blocked — a consequence of the scheduler's behavior, distributed at coarse grain across worker processes if you scale out. For AIPerf, concurrency is a number the timing_manager process actively tracks and enforces, one credit per permitted in-flight request, dispatched to real OS-process workers over ZMQ. Neither model is right or wrong on its own — they're different answers to the same question of how to keep N requests in flight at once, and that difference in mechanism is the fact this deck exists to state plainly."

    term: {
      word: "emergent vs enforced concurrency"
      meaning: "Emergent: the in-flight count falls out of how a scheduler happens to interleave many cheap units (Locust's greenlets). Enforced: the in-flight count is a variable a coordinator explicitly tracks and gates admission against (AIPerf's credits)."
    }

    points: [
      "Locust: User → greenlet → gevent cooperative scheduler → emergent concurrency.",
      "AIPerf: timing_manager → credit → ZMQ ROUTER-DEALER → worker OS process → enforced concurrency.",
      "Locust scales out via master/worker OS processes; the greenlet model is unchanged inside each.",
      "AIPerf's workers are always OS processes, from concurrency=1 upward — there's no cooperative-greenlet tier.",
      "Consequence: AIPerf's credit ledger can gate admission exactly; Locust's stop-at-N is necessarily poll-then-kill."
    ]

    caption: "Same goal, different machinery: gevent scheduling vs credit-gated processes."

    render: @scene {
      sdk.Header(
        id = "s6-hdr",
        title = "TWO ANSWERS, ONE QUESTION",
        caption = "Same goal, different machinery: gevent scheduling vs credit-gated processes.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s6-locust",
        title = "Locust",
        detail = "User → greenlet → gevent scheduler",
        x = 40, y = 100, width = 280, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Label(
        id = "s6-locust-l",
        text = "emergent concurrency",
        x = 60, y = 210, width = 240, height = 22,
        fontSize = 13,
        inkRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s6-aiperf",
        title = "AIPerf",
        detail = "timing_manager → credit → worker process",
        x = 380, y = 100, width = 280, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Label(
        id = "s6-aiperf-l",
        text = "enforced concurrency",
        x = 400, y = 210, width = 240, height = 22,
        fontSize = 13,
        inkRole = theme(accent.primary)
      )
      sdk.Divider(
        id = "s6-div",
        axis = "y",
        x = 350, y = 90, length = 160,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Note(
        id = "s6-note",
        text = "Neither is wrong — they are different mechanisms for the same target: N requests in flight",
        x = 60, y = 260, width = 580, height = 32
      )
      sdk.Signal(
        id = "s6-motion",
        from = { nodeId: "s6-locust", anchor: "e" },
        to = { nodeId: "s6-aiperf", anchor: "w" },
        opacity = 0.45,
        strokeWidth = 2.2,
        label = "same target, different mechanism",
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal s6-hdr duration 260
        after s6-hdr reveal s6-locust duration 280
        after s6-locust reveal s6-locust-l duration 220
        after s6-locust-l reveal s6-div duration 220
        after s6-div reveal s6-aiperf duration 280
        after s6-aiperf reveal s6-aiperf-l duration 220
        after s6-aiperf-l reveal s6-note duration 260
        after s6-note trace s6-motion duration 900
      }
    }
  }
