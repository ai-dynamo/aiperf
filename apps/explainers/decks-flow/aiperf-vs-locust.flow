  slide "AIPerf: the overshoot poller" {
    eyebrow: "AIPerf architecture"
    title: "Reproducing Locust's semantics needed two independent bypasses"
    lede: "RequestCountStopCondition disables itself when overshoot-poll mode is on — but that alone wasn't enough. CreditCounter has its own, separate cap check used to compute is_final_credit, and it had to be told to stand down too."

    narration: "Getting AIPerf to behave like Locust's poll-then-kill wasn't a matter of just turning off the request-count stop condition — there were two independent gates enforcing the same limit from different places, and both had to bypass simultaneously. RequestCountStopCondition's should_use already excludes itself when overshoot_poll_interval_sec is set. But CreditCounter._request_count_cap_reached is a completely separate check, used to compute is_final_credit during increment_sent, and its own docstring says plainly that this cap is disabled here as well as in RequestCountStopCondition — because RequestCountStopCondition alone would not be enough. Once both are bypassed, OvershootAbandonPoller takes over entirely: in poll mode it sleeps a fixed interval, checks completed count against target, and repeats; in exact mode there's no polling loop at all, a synchronous callback fires the instant the completed counter crosses target. Either way, once triggered, abandon_now cancels every in-flight credit across every worker through the router and marks the phase complete immediately — no grace period, matching Locust's runner.quit() semantics on purpose."

    term: {
      word: "dual bypass"
      meaning: "Reproducing Locust's overshoot-then-abandon stop semantics inside AIPerf required disabling two independent request-count gates simultaneously: RequestCountStopCondition (in the stop-condition list) and CreditCounter's own internal cap check (used separately to compute is_final_credit) — one alone was documented as insufficient."
    }

    points: [
      "RequestCountStopCondition.should_use excludes itself when overshoot_poll_interval_sec is set.",
      "CreditCounter._request_count_cap_reached is a second, independent cap check — its docstring says it must ALSO be disabled.",
      "Poll mode (interval > 0): sleep, check completed >= target, repeat. Exact mode (interval == 0): a synchronous callback, no loop.",
      "Either mode ends in cancel_all_credits() across every worker — abandon, not drain, deliberately matching Locust's quit()."
    ]

    caption: "Two independent caps, one target — both had to stand down."

    render: @scene {
      sdk.Header(
        id = "s9-hdr",
        title = "TWO GATES, ONE TARGET",
        caption = "Two independent caps, one target — both had to stand down.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s9-gate1",
        title = "RequestCountStopCondition",
        detail = "should_use → False",
        x = 40, y = 100, width = 260, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s9-gate2",
        title = "CreditCounter cap check",
        detail = "_request_count_cap_reached → False",
        x = 380, y = 100, width = 260, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s9-poller",
        title = "OvershootAbandonPoller",
        detail = "poll or exact-cutoff mode",
        x = 200, y = 220, width = 260, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s9-e1",
        mode = "route",
        from = { nodeId: "s9-gate1", anchor: "s" },
        to = { nodeId: "s9-poller", anchor: "w" },
        style = { stroke: theme(accent.warning), strokeWidth: 2 }
      )
      sdk.Edge(
        id = "s9-e2",
        mode = "route",
        from = { nodeId: "s9-gate2", anchor: "s" },
        to = { nodeId: "s9-poller", anchor: "e" },
        style = { stroke: theme(accent.warning), strokeWidth: 2 }
      )
      sdk.Panel(
        id = "s9-abandon",
        title = "cancel_all_credits()",
        detail = "no grace period — matches Locust quit()",
        x = 200, y = 330, width = 260, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s9-e3",
        mode = "route",
        from = { nodeId: "s9-poller", anchor: "s" },
        to = { nodeId: "s9-abandon", anchor: "n" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 }
      )
      sdk.Signal(
        id = "s9-motion",
        from = { nodeId: "s9-gate1", anchor: "center" },
        to = { nodeId: "s9-gate2", anchor: "center" },
        opacity = 0.4,
        strokeWidth = 2,
        label = "one alone is not enough",
        style = { stroke: theme(accent.secondary) }
      )

      timeline main {
        at 0 reveal s9-hdr duration 260
        after s9-hdr reveal s9-gate1 duration 260
        after s9-gate1 reveal s9-gate2 duration 260
        after s9-gate2 trace s9-motion duration 700
        after s9-motion trace s9-e1 duration 260
        after s9-e1 trace s9-e2 duration 260
        after s9-e2 reveal s9-poller duration 260
        after s9-poller trace s9-e3 duration 260
        after s9-e3 reveal s9-abandon duration 260
      }
    }
  }

  slide "AIPerf: inside one worker process" {
    eyebrow: "AIPerf architecture"
    title: "One event loop, one asyncio.Task per in-flight credit"
    lede: "A worker doesn't throttle itself — no semaphore, no gather-with-limit. Every credit it receives becomes an independent asyncio.Task on its one event loop, sharing one aiohttp connection pool. Concurrency admission is entirely upstream, at credit issuance."

    narration: "Inside a single worker process, receiving a Credit over the DEALER socket schedules self.execute_async on _on_credit_drop_message_task as an independent asyncio.Task, tracked in a plain dict keyed by credit id. There's no semaphore inside the worker limiting how many of these run at once — the worker will happily run however many tasks it's been handed. The actual HTTP calls share one aiohttp.ClientSession backed by a TCPConnector whose size is set by a connection-limit config, defaulting to 2500 — high enough that it's essentially never the constraint. So a worker's own code makes no admission decisions at all; every constraint on how much is running at once was already applied upstream, at the moment timing_manager decided whether a credit could be issued in the first place. Whatever a worker is handed, it runs — which is exactly why the credit ledger, not the worker, is where AIPerf's concurrency guarantee actually lives."

    term: {
      word: "task-per-credit"
      meaning: "AIPerf worker concurrency model: every received Credit becomes its own asyncio.Task on the worker's single event loop, with no internal semaphore or gather-limit — the worker executes whatever concurrency it's handed, because admission was already decided upstream by the credit ledger."
    }

    points: [
      "Credit received on DEALER → asyncio.Task per credit, tracked in self.credit_tasks — no worker-side semaphore.",
      "Shared aiohttp.ClientSession + TCPConnector, sized by Environment.HTTP.CONNECTION_LIMIT (default 2500).",
      "The worker makes zero admission decisions — it runs exactly whatever concurrency it's been handed.",
      "Real concurrency enforcement lives entirely upstream, in CreditIssuer's slot acquisition before a credit is ever sent."
    ]

    caption: "The worker doesn't gate anything — the ledger already did."

    render: @scene {
      sdk.Header(
        id = "s10-hdr",
        title = "WORKER: NO SELF-THROTTLING",
        caption = "The worker doesn't gate anything — the ledger already did.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s10-recv",
        title = "Credit received",
        detail = "on DEALER socket",
        x = 40, y = 100, width = 180, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s10-e1",
        mode = "connector",
        from = { nodeId: "s10-recv", anchor: "e" },
        to = { nodeId: "s10-task", anchor: "w" },
        style = { stroke: theme(accent.primary), strokeWidth: 2 }
      )
      sdk.Panel(
        id = "s10-task",
        title = "asyncio.Task",
        detail = "one per credit, no limit here",
        x = 260, y = 100, width = 200, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Edge(
        id = "s10-e2",
        mode = "connector",
        from = { nodeId: "s10-task", anchor: "e" },
        to = { nodeId: "s10-pool", anchor: "w" },
        style = { stroke: theme(accent.secondary), strokeWidth: 2 }
      )
      sdk.Panel(
        id = "s10-pool",
        title = "aiohttp pool",
        detail = "CONNECTION_LIMIT = 2500",
        x = 500, y = 100, width = 160, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s10-upstream",
        title = "Real gate: CreditIssuer slot acquisition",
        detail = "happens before dispatch, not inside the worker",
        x = 140, y = 240, width = 420, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s10-e3",
        mode = "route",
        from = { nodeId: "s10-recv", anchor: "s" },
        to = { nodeId: "s10-upstream", anchor: "w" },
        style = { stroke: theme(accent.warning), strokeWidth: 2.2, dash: [4, 3] }
      )
      sdk.Signal(
        id = "s10-motion",
        from = { nodeId: "s10-task", anchor: "center" },
        to = { nodeId: "s10-upstream", anchor: "center" },
        opacity = 0.4,
        strokeWidth = 2,
        label = "gate is upstream",
        style = { stroke: theme(accent.warning) }
      )

      timeline main {
        at 0 reveal s10-hdr duration 260
        after s10-hdr reveal s10-recv duration 260
        after s10-recv trace s10-e1 duration 260
        after s10-e1 reveal s10-task duration 260
        after s10-task trace s10-e2 duration 260
        after s10-e2 reveal s10-pool duration 260
        after s10-pool reveal s10-upstream duration 260
        after s10-upstream trace s10-e3 duration 280
        after s10-e3 trace s10-motion duration 800
      }
    }
  }

  slide "Side by side" {
    eyebrow: "Side by side"
    title: "Where the two architectures actually diverge"
    lede: "Both reach exact steady-state concurrency. Locust does it structurally, one greenlet per user with a zero-delay loop; AIPerf does it with an explicit credit ledger that a worker never even sees the gating logic for. The ledger is also what makes AIPerf's stop-at-N exact where Locust's is necessarily poll-then-kill."

    narration: "Tracing both all the way from source lands on one real divergence, not several. Locust's concurrency is exact once you account for wait_time=0 and simultaneous spawn — N greenlets, each with at most one in-flight request, is a structural guarantee of the loop itself, no coordinator required. AIPerf's concurrency is exact too, but for a different reason: CreditIssuer explicitly acquires a slot before every dispatch, and the worker that eventually runs the request never makes an admission decision at all. That difference is invisible until you need to stop at an exact total count. Locust has no counter a stop condition could check against — worker_report only fires every three seconds, so stopping at N is necessarily poll, then kill every greenlet, in-flight work included. AIPerf's stop condition reads the exact same counter the credit ledger already maintains, so it can gate the cutoff synchronously and then genuinely drain, waiting on an event that fires exactly when the last credit returns. AIPerf can also deliberately disable that advantage — the overshoot poller reproduces Locust's poll-then-kill on purpose, for direct comparison, which took bypassing two independent internal gates to pull off cleanly."

    term: {
      word: "the actual divergence"
      meaning: "Not 'exact vs approximate concurrency' — both are exact in steady state. The real difference is whether a central, checkable counter exists at all: AIPerf's credit ledger is that counter, and its existence is what makes an exact stop-at-N gate and a real drain possible; Locust's loop structure gives it exact concurrency without ever needing such a counter, which is exactly why it has none to check for stopping."
    }

    points: [
      "Locust: wait_time=0, N users spawned at once → exactly N in flight, self-limiting, no coordinator.",
      "AIPerf: CreditIssuer acquires a slot per dispatch; the worker that runs the request makes no admission decision.",
      "Locust's stop-at-N has nothing to poll but worker_report (3.0s cadence) → poll-then-kill, no drain by default.",
      "AIPerf's stop-at-N reads the same counter the ledger already maintains → exact gate + real event-driven drain."
    ]

    caption: "Same steady-state concurrency; the ledger is what makes the cutoff exact."

    render: @scene {
      sdk.Header(
        id = "s11-hdr",
        title = "THE COUNTER IS THE DIFFERENCE",
        caption = "Same steady-state concurrency; the ledger is what makes the cutoff exact.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s11-locust",
        title = "Locust",
        detail = "exact via loop structure · no counter",
        x = 40, y = 100, width = 280, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s11-aiperf",
        title = "AIPerf",
        detail = "exact via credit ledger · has a counter",
        x = 380, y = 100, width = 280, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Divider(
        id = "s11-div",
        axis = "y",
        x = 350, y = 90, length = 160,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s11-stop-l",
        title = "Stop at N",
        detail = "poll every 3.0s, then kill",
        x = 60, y = 240, width = 240, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Panel(
        id = "s11-stop-a",
        title = "Stop at N",
        detail = "synchronous gate, real drain",
        x = 400, y = 240, width = 240, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Edge(
        id = "s11-e1",
        mode = "route",
        from = { nodeId: "s11-locust", anchor: "s" },
        to = { nodeId: "s11-stop-l", anchor: "n" },
        style = { stroke: theme(accent.warning), strokeWidth: 2 }
      )
      sdk.Edge(
        id = "s11-e2",
        mode = "route",
        from = { nodeId: "s11-aiperf", anchor: "s" },
        to = { nodeId: "s11-stop-a", anchor: "n" },
        style = { stroke: theme(accent.green), strokeWidth: 2 }
      )
      sdk.Signal(
        id = "s11-motion",
        from = { nodeId: "s11-locust", anchor: "center" },
        to = { nodeId: "s11-aiperf", anchor: "center" },
        opacity = 0.45,
        strokeWidth = 2.2,
        label = "the counter is the difference",
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal s11-hdr duration 260
        after s11-hdr reveal s11-locust duration 280
        after s11-locust reveal s11-div duration 220
        after s11-div reveal s11-aiperf duration 280
        after s11-aiperf trace s11-e1 duration 260
        after s11-e1 reveal s11-stop-l duration 260
        after s11-aiperf trace s11-e2 duration 260
        after s11-e2 reveal s11-stop-a duration 260
        after s11-stop-a trace s11-motion duration 900
      }
    }
  }
}
