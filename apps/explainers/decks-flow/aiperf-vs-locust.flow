  slide "AIPerf: the credit lifecycle" {
    eyebrow: "AIPerf architecture"
    title: "Created, gated, dispatched, stuck to a conversation, returned"
    lede: "A credit is built and admitted before a worker runs it. Multi-turn conversations stick to whichever worker handled the first turn, so session state and cache locality survive the whole conversation. Completion observes the request and releases the admission slot in-process."

    narration: "Turn one goes to the least-loaded worker; every later turn sticks to that same worker. Completion releases the slot in-process."

    term: {
      word: "sticky routing"
      meaning: "Policy of routing every subsequent turn of a multi-turn conversation to the same worker that handled its first turn, so per-conversation session state and any resulting inference-server cache locality persist for the conversation's duration. Only first turns use least-loaded worker selection."
    }

    points: [
      "Admission blocks issuance until the run is ready to dispatch work to workers.",
      "First turn of a conversation: least-loaded worker selection. Later turns: routed back to the same worker.",
      "The sticky mapping exists only while more turns are expected, and is torn down on the conversation's final turn.",
      "Credit completion observes the request and releases the admission slot in-process, then frees it for reuse."
    ]

    caption: "First turn picks the worker; every later turn goes back to the same one."

    render: @scene {
      sdk.Header(
        id = "s7-hdr",
        title = "CREATE → GATE → STICK → RETURN",
        caption = "First turn picks the worker; every later turn goes back to the same one.",
        x = 63.6, y = 43.2, width = 1792.8, height = 118.8,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Stepper(
        id = "s7-steps",
        steps = ["credit created", "readiness gate", "sticky or least-loaded", "returned"],
        linked = true,
        gap = 37.8,
        x = 123, y = 232.2, width = 1620, height = 64.8
      )
      sdk.Panel(
        id = "s7-t1",
        title = "Turn 1",
