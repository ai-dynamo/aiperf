    }
  }

  slide "AIPerf: internal message topology" {
    eyebrow: "AIPerf architecture"
    title: "A different message-passing pattern for each different job"
    lede: "A broadcast-style status bus for general messaging, an addressed request/reply channel for on-demand dataset lookups, a fire-and-forget streaming channel for raw results — all hosted inside the coordinator process — plus a dedicated credit-dispatch channel and a separate credit-return channel, both bound directly by the timing/dispatch process."

    narration: "AIPerf doesn't use one message-passing pattern for everything — it picks the pattern that matches each job. Broadcast-style status and lifecycle messages ride a publish/subscribe bus that every process publishes to and listens on. Workers occasionally need to ask the dataset process for a conversation on demand, so that's an addressed request/reply channel. Raw inference results stream from workers toward the results-processing tier as fire-and-forget pushes. Credit dispatch specifically is not routed through the shared proxies at all — the timing/dispatch process binds its own addressed channel directly, and each worker connects to it with its own identity, so a credit can be sent to one specific worker by name. Credit returns ride a completely separate one-way channel rather than going back over the same connection, so the dispatch direction never has to double as a return path."

    term: {
      word: "addressed dispatch"
      meaning: "A message-passing pattern where the sender can direct a message to one specific, identified recipient rather than broadcasting to everyone — used for credit dispatch specifically so a credit can be sent to exactly the worker that should receive it."
    }

    points: [
      "Status bus: broadcast-style, hosted inside the coordinator — every process publishes and every process can listen.",
      "Dataset lookups: an addressed request/reply channel — a worker's fallback path to ask for a conversation on demand.",
      "Raw results: a fire-and-forget streaming channel from workers toward the results-processing tier.",
      "Credit dispatch and credit return are NOT routed through the shared proxies — bound directly by the timing/dispatch process."
    ]

    caption: "The credit channels bypass the shared proxy layer entirely."

    render: @scene {
      sdk.Header(
        id = "s6-hdr",
        title = "ONE PATTERN PER JOB",
        caption = "The credit channels bypass the shared proxy layer entirely.",
