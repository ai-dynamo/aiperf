        x = 400, y = 150, width = 150, height = 45,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s7-e2",
        mode = "connector",
        from = { nodeId: "s7-wb", anchor: "e" },
