      )
      sdk.Edge(
        id = "s3-e2",
        mode = "connector",
        from = { nodeId: "s3-master", anchor: "s" },
        to = { nodeId: "s3-w2", anchor: "n" },
        style = { stroke: theme(accent.primary), strokeWidth: 6.48 }
      )
      sdk.Edge(
        id = "s3-e3",
        mode = "connector",
        from = { nodeId: "s3-master", anchor: "s" },
