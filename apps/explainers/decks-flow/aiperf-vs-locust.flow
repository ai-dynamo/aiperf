        detail = "always forked",
        x = 550, y = 200, width = 150, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s5-e1",
        mode = "route",
        from = { nodeId: "s5-sc", anchor: "s" },
        to = { nodeId: "s5-dm", anchor: "n" },
        style = { stroke: theme(accent.warning), strokeWidth: 1.6 }
      )
      sdk.Edge(
