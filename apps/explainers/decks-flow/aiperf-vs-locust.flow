        strokeRole = theme(accent.tertiary)
      )
      sdk.Panel(
        id = "s5-tm",
        title = "Timing/dispatch process",
        detail = "always forked",
        x = 210, y = 200, width = 150, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Panel(
        id = "s5-wm",
