  slide "Side by side" {
    eyebrow: "Side by side"
    title: "Self-limiting by loop structure vs centrally enforced by ledger"
    lede: "Both tools hit an exact target concurrency in steady state — that part is not the difference. Locust gets there structurally (N users, wait_time=0, one request per user at a time); AIPerf gets there because a coordinator explicitly counts and gates every admission."

    narration: "Put next to each other, the honest contrast is not 'exact vs approximate' — both land on exactly the configured concurrency once the run reaches steady state. With wait_time set to zero and every user spawned at once, N Locust greenlets structurally maintain at most one in-flight request each, so N users means N in flight, self-limiting by the shape of the loop itself with no coordinator required. AIPerf reaches the same exact number by the opposite route: a coordinator process, timing_manager, explicitly counts outstanding credits and only admits a new request when the count allows it. The two mechanisms diverge somewhere else entirely — at the stop condition. Locust's greenlets have no shared counter to check a total-requests target against, so stopping at N total requires the poll-then-kill pattern from three slides back. AIPerf's coordinator already has the exact counter a stop condition needs, so it can gate the cutoff with the same synchronous check it uses for admission, and drain exactly rather than killing anything."

    term: {
      word: "self-limiting vs centrally enforced"
      meaning: "Self-limiting: an invariant that holds because of how a unit's own loop is shaped (Locust — one greenlet, one in-flight request at a time, by construction). Centrally enforced: an invariant a separate coordinator actively counts and gates admission against (AIPerf — timing_manager's credit ledger)."
    }

    points: [
      "Locust: N users, wait_time=0, one in-flight request per greenlet — concurrency = N by construction, no coordinator needed.",
      "AIPerf: timing_manager counts outstanding credits and gates new admissions against that count explicitly.",
      "Both hit exact steady-state concurrency; they diverge at the stop condition, not the concurrency mechanism.",
      "Consequence: AIPerf's admission counter doubles as an exact stop-at-N gate; Locust has no counter to check, so it polls and kills."
    ]

    caption: "Same steady-state concurrency, different stop-condition consequences."

    render: @scene {
      sdk.Header(
        id = "s6-hdr",
        title = "SAME CONCURRENCY, DIFFERENT MECHANISM",
        caption = "Same steady-state concurrency, different stop-condition consequences.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s6-locust",
        title = "Locust",
        detail = "N users · wait_time=0 · 1 in-flight each",
        x = 40, y = 100, width = 280, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Label(
        id = "s6-locust-l",
        text = "self-limiting by loop structure",
        x = 60, y = 210, width = 240, height = 22,
        fontSize = 13,
        inkRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s6-aiperf",
        title = "AIPerf",
        detail = "timing_manager → credit → worker process",
        x = 380, y = 100, width = 280, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Label(
        id = "s6-aiperf-l",
        text = "centrally enforced by ledger",
        x = 400, y = 210, width = 240, height = 22,
        fontSize = 13,
        inkRole = theme(accent.primary)
      )
      sdk.Divider(
        id = "s6-div",
        axis = "y",
        x = 350, y = 90, length = 160,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Note(
        id = "s6-note",
        text = "Both hit the exact target concurrency — the counter that makes AIPerf's cutoff exact is what Locust's loop never needed to have",
        x = 60, y = 260, width = 580, height = 32
      )
      sdk.Signal(
        id = "s6-motion",
        from = { nodeId: "s6-locust", anchor: "e" },
        to = { nodeId: "s6-aiperf", anchor: "w" },
        opacity = 0.45,
        strokeWidth = 2.2,
        label = "same concurrency, different mechanism",
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal s6-hdr duration 260
        after s6-hdr reveal s6-locust duration 280
        after s6-locust reveal s6-locust-l duration 220
        after s6-locust-l reveal s6-div duration 220
        after s6-div reveal s6-aiperf duration 280
        after s6-aiperf reveal s6-aiperf-l duration 220
        after s6-aiperf-l reveal s6-note duration 260
        after s6-note trace s6-motion duration 900
      }
    }
  }
