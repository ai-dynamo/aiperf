  slide "AIPerf: stop conditions are ANDed" {
    eyebrow: "AIPerf architecture"
    title: "Several independent stop conditions; every applicable one must agree"
    lede: "A checker builds only the subset of stop conditions that apply to the current run, then combines them with AND — every active condition has to independently permit continuing, every time, before the next request goes out."

    narration: "Only the configured conditions activate, and they combine with AND, never OR — every active one must agree."

    term: {
      word: "condition checker"
      meaning: "AIPerf's aggregator over every stop condition that applies to the current run. Combines them with a plain logical AND, so every applicable condition must independently permit continuing before the run sends another request."
    }

    points: [
      "Always active: general lifecycle conditions covering cancellation and completion.",
      "Conditionally active: request-count, session-count, and duration conditions — only when configured.",
      "Combination logic is a plain AND — every applicable condition must agree, never an OR.",
      "The request-count condition disables itself entirely when overshoot-style stopping is configured."
    ]

    caption: "Every applicable condition votes; any one no-vote stops the run."

    render: @scene {
      sdk.Header(
        id = "s8-hdr",
        title = "AND — NOT OR",
        caption = "Every applicable condition votes; any one no-vote stops the run.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s8-c1",
        title = "Lifecycle",
        detail = "always active · vote: yes",
        x = 30, y = 80, width = 130, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Panel(
        id = "s8-c2",
        title = "DAG lifecycle",
        detail = "always active · vote: yes",
        x = 175, y = 80, width = 130, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Panel(
        id = "s8-c3",
        title = "Request count",
        detail = "if configured · vote: yes",
        x = 320, y = 80, width = 130, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s8-c4",
        title = "Session count",
        detail = "if configured · vote: yes",
        x = 465, y = 80, width = 130, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s8-c5",
        title = "Duration",
        detail = "if configured · vote: no",
        x = 610, y = 80, width = 55, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Panel(
        id = "s8-and",
        title = "AND",
        detail = "one \"no\" is enough to stop",
        x = 260, y = 190, width = 200, height = 60,
        surfaceRole = theme(surface.elevated),
