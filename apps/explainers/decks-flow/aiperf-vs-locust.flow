        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Panel(
        id = "s9-instant",
        title = "Instant-callback mode",
        detail = "no polling loop, fires the moment target crosses",
        x = 360, y = 170, width = 220, height = 55,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s9-e1",
        mode = "route",
        from = { nodeId: "s9-gate1", anchor: "s" },
        to = { nodeId: "s9-poll", anchor: "n" },
        style = { stroke: theme(accent.secondary), strokeWidth: 1.6 }
      )
      sdk.Edge(
        id = "s9-e2",
        mode = "route",
        from = { nodeId: "s9-gate2", anchor: "s" },
        to = { nodeId: "s9-instant", anchor: "n" },
        style = { stroke: theme(accent.secondary), strokeWidth: 1.6 }
      )
      sdk.Panel(
        id = "s9-abandon",
        title = "Cancel every in-flight credit",
        detail = "no grace period — matches poll-then-kill",
        x = 190, y = 260, width = 300, height = 55,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s9-e3",
