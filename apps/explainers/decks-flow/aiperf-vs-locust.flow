explainer "AIPerf vs Locust" {
  id: "aiperf-vs-locust"
  route: "/aiperf-vs-locust"
  topic: "architecture"
  storagePrefix: "aiperf-vs-locust-explainer"
  classPrefix: "deck-aiperf-vs-locust"
  eyebrowLabel: "AIPERF VS LOCUST"
  startGateTitle: "Two load-generation architectures, explained by concept"

  hub: {
    highlight: "aiperf vs locust"
    title: "cooperative green threads vs ledger-admitted tasks"
    description: "Locust's concurrency unit is a cooperative green thread, one per simulated user. AIPerf's concurrency unit is an admitted credit, realized as a lightweight task — and many of those run concurrently inside a single worker process."
  }

  slide "Two architectures" {
    eyebrow: "Overview"
    title: "Cooperative green threads vs ledger-admitted tasks"
    lede: "Locust's unit of concurrency is a lightweight cooperative thread running one simulated user's loop. AIPerf's unit of concurrency is an admitted credit — not a worker process. A single worker process can, and normally does, run many credits at once."

    narration: "Both tools are built around message-passing between processes — Locust for coordinating its master and worker processes, AIPerf for coordinating essentially everything it runs. But the actual unit of concurrency each tool multiplies is different, and it's easy to state incorrectly. Locust's concurrency unit really is one process-lightweight thing per user: a green thread, cheap and cooperatively scheduled. AIPerf's concurrency unit is NOT the worker process — it's the credit, an individually admitted in-flight request, realized inside a worker as its own lightweight task. A worker process is just an execution host: it can run, and normally does run, many credits concurrently on its one event loop, with no cap of its own. So the fair comparison is green thread to credit, not green thread to process — a worker process is closer to what a whole fleet of Locust worker processes would be, since it's hosting many concurrent units of work at once, not one."

    term: {
      word: "concurrency unit"
      meaning: "The thing a load-testing tool multiplies to reach a target in-flight-request count. For Locust that unit is a cooperative green thread. For AIPerf it is an admitted credit — a worker process is an execution host that runs many credits concurrently, not one concurrency unit per process."
    }

    points: [
      "Locust: a virtual user is a cooperative green thread — one thread, at most one in-flight request.",
      "AIPerf: a credit is the concurrency unit — one credit, one in-flight request, realized as a lightweight task inside a worker.",
      "A single AIPerf worker process normally runs many credits concurrently, with no internal cap of its own.",
      "The fair comparison is green thread to credit, not green thread to worker process — a worker hosts many concurrency units at once."
    ]

    caption: "One green thread per request vs one admitted credit per request — not one process per request."

    render: @scene {
      sdk.Header(
        id = "s1-hdr",
        title = "GREEN THREADS vs ADMITTED CREDITS",
        caption = "One green thread per request vs one admitted credit per request — not one process per request.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s1-locust",
        title = "Locust",
        detail = "virtual user → cooperative green thread",
        x = 60, y = 100, width = 240, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s1-aiperf",
        title = "AIPerf",
        detail = "admitted credit → lightweight task",
        x = 400, y = 100, width = 240, height = 90,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Divider(
        id = "s1-div",
        axis = "y",
        x = 350, y = 90, length = 200,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s1-host",
        title = "One worker process",
        detail = "hosts many credits at once — not one",
        x = 380, y = 220, width = 280, height = 60,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s1-e1",
        mode = "route",
        from = { nodeId: "s1-aiperf", anchor: "s" },
        to = { nodeId: "s1-host", anchor: "n" },
        style = { stroke: theme(accent.warning), strokeWidth: 2 }
      )
      sdk.Note(
        id = "s1-note",
        text = "The worker process is an execution host, not the concurrency unit itself",
        x = 60, y = 300, width = 580, height = 30
      )
      sdk.Signal(
        id = "s1-motion",
        from = { nodeId: "s1-locust", anchor: "e" },
        to = { nodeId: "s1-aiperf", anchor: "w" },
        opacity = 0.45,
        strokeWidth = 2.2,
        label = "thread vs credit, not process",
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal s1-hdr duration 260
        after s1-hdr reveal s1-locust duration 280
        after s1-locust reveal s1-div duration 220
        after s1-div reveal s1-aiperf duration 280
        after s1-aiperf trace s1-e1 duration 260
        after s1-e1 reveal s1-host duration 260
        after s1-host reveal s1-note duration 260
        after s1-note trace s1-motion duration 900
      }
    }
  }

  slide "Locust: the per-user loop" {
    eyebrow: "Locust architecture"
    title: "Execute a task, yield, execute the next one — forever"
    lede: "Starting a virtual user spawns a real cooperative green thread. Inside it, a simple loop runs: pick a task, execute it, then pause. With no configured think-time, that pause reduces to a bare cooperative yield — no time actually passes."

    narration: "The loop inside a virtual user is plain: while running, pick the next task if none is queued, execute it, then call a wait step. That wait step is implemented as a cooperative sleep for however many seconds the user's think-time function returns — nothing else. When a simulated user's think-time is configured to always return zero, that sleep call becomes a zero-duration sleep. A zero-duration cooperative sleep does not block for any wall-clock time — it performs exactly one hand-off to the scheduler, letting other ready green threads run, then resumes immediately. So the effective behavior with no think-time configured is: fire a request, and the instant it completes, loop back and fire the next one, paced only by request latency and scheduling fairness, not by any artificial delay."

    term: {
      word: "cooperative yield"
      meaning: "A scheduling primitive that hands control back to the event loop without a wall-clock delay. Used as the pause between tasks when think-time is configured to zero, making a virtual user's loop effectively continuous rather than throttled."
    }

    points: [
      "Starting a virtual user spawns a real, individually-scheduled cooperative green thread.",
      "The per-user loop: pick a task, execute it, pause — then repeat, for the life of the run.",
      "The pause between tasks is implemented as a cooperative sleep for however long think-time says.",
      "With think-time fixed at zero, that sleep call is a zero-duration yield, not a real delay."
    ]

    caption: "One green thread, one loop: execute, yield, execute again."

    render: @scene {
      sdk.Header(
        id = "s2-hdr",
        title = "THE PER-USER LOOP",
        caption = "One green thread, one loop: execute, yield, execute again.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s2-exec",
        title = "Execute task",
        detail = "runs the simulated request",
        x = 80, y = 100, width = 220, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Edge(
        id = "s2-e1",
        mode = "connector",
        from = { nodeId: "s2-exec", anchor: "e" },
        to = { nodeId: "s2-wait", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "s2-wait",
        title = "Pause",
        detail = "cooperative sleep for think-time",
        x = 380, y = 100, width = 220, height = 80,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s2-loop",
        mode = "route",
        from = { nodeId: "s2-wait", anchor: "s" },
        to = { nodeId: "s2-exec", anchor: "s" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2, dash: [4, 3] }
      )
      sdk.Panel(
        id = "s2-zero",
        title = "Think-time = zero",
        detail = "the pause becomes a bare yield, 0 delay",
        x = 160, y = 240, width = 400, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Edge(
        id = "s2-e2",
        mode = "route",
        from = { nodeId: "s2-wait", anchor: "s" },
        to = { nodeId: "s2-zero", anchor: "n" },
        style = { stroke: theme(accent.green), strokeWidth: 2 }
      )
      sdk.Note(
        id = "s2-note",
        text = "No other delay mechanism exists in this loop — the pause is only ever this one sleep call",
        x = 60, y = 335, width = 580, height = 30
      )
      sdk.Signal(
        id = "s2-motion",
        from = { nodeId: "s2-exec", anchor: "center" },
        to = { nodeId: "s2-wait", anchor: "center" },
        opacity = 0.45,
        strokeWidth = 2.2,
        label = "continuous loop",
        style = { stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 reveal s2-hdr duration 260
        after s2-hdr reveal s2-exec duration 260
        after s2-exec trace s2-e1 duration 280
        after s2-e1 reveal s2-wait duration 260
        after s2-wait trace s2-loop duration 320
        after s2-loop reveal s2-zero duration 260
        after s2-zero trace s2-e2 duration 240
        after s2-e2 reveal s2-note duration 260
        after s2-note trace s2-motion duration 900
      }
    }
  }

  slide "Locust: master/worker distribution" {
    eyebrow: "Locust architecture"
    title: "A coordinator distributes users; a scheduler decides how"
    lede: "The coordinator process spawns no simulated users itself — it directs separate worker processes over a request-routing message channel. A distribution scheduler places users on workers round robin, and interleaves which user type comes next by configured weight."

    narration: "The coordinator process doesn't spawn any simulated-user threads itself — it expects worker processes to connect, then directs them to start and stop simulated users on its behalf. The channel underneath is a routing-style socket: the coordinator can address a message to one specific connected worker, each worker is uniquely identified, and every message is a small structured envelope. To decide which worker gets the next simulated user, the distribution scheduler just cycles through the connected workers in order — plain round robin. Which simulated-user type to place next, independent of which worker, comes from a weighted interleaving scheme, so a configured 5:1 ratio between two user types produces an evenly spread pattern rather than five in a row followed by one."

    term: {
      word: "distribution scheduler"
      meaning: "The coordinator's algorithm for deciding, during ramp-up, which worker process and which simulated-user type receives the next spawned user: round-robin placement across workers, and weighted interleaving across user types."
    }

    points: [
      "The coordinator process spawns no simulated-user threads itself — it directs worker processes instead.",
      "Coordination uses a routing-style message channel that can address one specific connected worker.",
      "Worker placement is plain round robin across the currently connected workers.",
      "User-type placement is weighted interleaving, spreading configured ratios evenly rather than clustering them."
    ]

    caption: "Addressed messages to specific workers; round-robin placement, weighted interleaving."

    render: @scene {
      sdk.Header(
        id = "s3-hdr",
        title = "COORDINATOR → ROUTED MESSAGES → WORKERS",
        caption = "Addressed messages to specific workers; round-robin placement, weighted interleaving.",
