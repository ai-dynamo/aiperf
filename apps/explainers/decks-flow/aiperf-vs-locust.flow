explainer "AIPerf vs Locust" {
  id: "aiperf-vs-locust"
  route: "/aiperf-vs-locust"
  topic: "architecture"
  storagePrefix: "aiperf-vs-locust-explainer"
  classPrefix: "deck-aiperf-vs-locust"
  eyebrowLabel: "AIPERF VS LOCUST"
  startGateTitle: "Two load-generation architectures, explained by concept"

  hub: {
    highlight: "aiperf vs locust"
    title: "cooperative green threads vs ledger-admitted tasks"
    description: "Locust's concurrency unit is a cooperative green thread, one per simulated user. AIPerf's concurrency unit is an admitted credit, realized as a lightweight task — and many of those run concurrently inside a single thread-per-core worker."
  }

  slide "Two architectures" {
    eyebrow: "Overview"
    title: "Cooperative green threads vs ledger-admitted tasks"
    lede: "Locust's unit of concurrency is a lightweight cooperative thread, one per simulated user. AIPerf's unit of concurrency is an admitted credit, realized as a lightweight task — a single thread-per-core worker hosts many of these running at once."

    narration: "Locust's concurrency unit is a green thread. AIPerf's is a credit, realized as a task inside a worker. One worker hosts many credits at once."

    term: {
      word: "concurrency unit"
      meaning: "The thing a load-testing tool multiplies to reach a target in-flight-request count. For Locust that unit is a cooperative green thread. For AIPerf it is an admitted credit — a worker is an execution host (co-located sink or OS-thread sub-cell) that runs many credits concurrently, not one concurrency unit per worker."
    }

    points: [
      "Locust: a virtual user is a cooperative green thread — one thread, at most one in-flight request.",
      "AIPerf: a credit is the concurrency unit — one credit, one in-flight request, realized as a lightweight task inside a worker.",
      "A single AIPerf worker normally runs many credits concurrently, with no internal cap of its own.",
      "The fair comparison is green thread to credit, not green thread to worker — a worker hosts many concurrency units at once."
    ]

    caption: "One green thread per request vs one admitted credit per request — not one worker per request."

    render: @scene {
      sdk.Header(
        id = "s1-hdr",
        title = "GREEN THREADS vs ADMITTED CREDITS",
        caption = "One green thread per request vs one admitted credit per request — not one worker per request.",
        x = 63.6, y = 43.2, width = 1792.8, height = 118.8,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s1-locust",
        title = "Locust",
        detail = "N virtual users",
        x = 123, y = 232.2, width = 702, height = 183.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s1-t1",
        title = "thread 1",
        detail = "1 in-flight",
        x = 150, y = 464.4, width = 232.2, height = 167.4,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s1-t2",
        title = "thread 2",
        detail = "1 in-flight",
        x = 403.8, y = 464.4, width = 232.2, height = 167.4,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s1-t3",
        title = "thread 3",
        detail = "1 in-flight",
        x = 657.6, y = 464.4, width = 232.2, height = 167.4,
        surfaceRole = theme(surface.base),
        strokeRole = theme(accent.secondary)
      )
      sdk.Label(
        id = "s1-tdots",
        text = "... thread N",
        x = 177, y = 680.4, width = 594, height = 54,
        fontSize = 32.4,
        inkRole = theme(ink.tertiary)
      )
      sdk.Edge(
        id = "s1-lt1",
        mode = "connector",
        from = { nodeId: "s1-locust", anchor: "s" },
        to = { nodeId: "s1-t1", anchor: "n" },
        style = { stroke: theme(accent.secondary), strokeWidth: 3.78 }
      )
      sdk.Edge(
        id = "s1-lt2",
        mode = "connector",
        from = { nodeId: "s1-locust", anchor: "s" },
        to = { nodeId: "s1-t2", anchor: "n" },
        style = { stroke: theme(accent.secondary), strokeWidth: 3.78 }
      )
      sdk.Edge(
        id = "s1-lt3",
        mode = "connector",
        from = { nodeId: "s1-locust", anchor: "s" },
        to = { nodeId: "s1-t3", anchor: "n" },
        style = { stroke: theme(accent.secondary), strokeWidth: 3.78 }
      )
      sdk.Label(
        id = "s1-lcount",
        text = "concurrency = N threads",
        x = 150, y = 756, width = 675, height = 54,
        fontSize = 32.4,
        weight = "bold",
        inkRole = theme(accent.secondary)
      )
      sdk.Divider(
        id = "s1-div",
        axis = "y",
        x = 919.5, y = 232.2, length = 260,
        strokeRole = theme(ink.tertiary)
      )
      sdk.Panel(
        id = "s1-aiperf",
        title = "AIPerf",
        detail = "1 worker (thread-per-core)",
        x = 1041, y = 232.2, width = 702, height = 183.6,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s1-c1",
