      sdk.Paragraph(id = "ms-lat", text = "an analytic curve vs a queue-threshold model — goodput batch-collapses past the queue threshold", x = 123, y = 340.2, width = 1728, height = 54, inkRole = theme(ink.secondary))
      sdk.Caption(id = "ms-feat-label", text = "SERVER FEATURES", x = 123, y = 426.6, width = 1728, height = 43.2, inkRole = theme(accent.primary))
