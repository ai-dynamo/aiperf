      sdk.Paragraph(id = "ts-sub", text = "ScheduledRuntime bridges a Workload schedule generator to a transport-neutral TurnDispatcher", x = 123, y = 216, width = 1728, height = 54, inkRole = theme(ink.secondary))
      sdk.TagList(id = "ts-pipe-1", items = ["Workload →", "IntervalGenerator →", "SlotPool"], gap = 27, x = 123, y = 286.2, width = 1728, height = 75.6)
      sdk.TagList(id = "ts-pipe-2", items = ["→ TurnDispatcher →", "Observer · records"], gap = 27, x = 123, y = 367.2, width = 1728, height = 75.6)
      sdk.CardGrid(id = "ts-cards", columns = 2, cards = [{ title: "SlotPool · debt-drain", detail: "effective = available − debt · SlotGuard frees prefill at TTFT", accent: "green" }, { title: "StopChecker chain", detail: "Lifecycle→RequestCount→SessionCount→Duration", accent: "green" }, { title: "Ramp · Bernoulli", detail: "Linear/Exp/Poisson exact target · one draw at issuance", accent: "gray" }, { title: "Workloads", detail: "RequestRate · UserCentric · FixedSchedule · SingleTurn", accent: "gray" }], x = 128.4, y = 459)
      timeline main {
