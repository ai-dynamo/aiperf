  slide "Flow diagram" {
    eyebrow: "COMMAND LINE TO RESULTS"
    title: "Command line to results"
    lede: "One JSON envelope down stdin; one terminal line back up stdout."
    narration: "Command line to results. A vertical pipeline chains six boxes top to bottom: Python emits Config-v2 → BenchmarkRun → one protocol-v2 JSON envelope; over stdin the aiperf-runner · main.rs box does mimalloc, stderr tracing, arg dispatch, catch_unwind; RunnerV2Coordinator::handle runs its 10-step pipeline validate → lower → select pair → prepare → execute; execute.rs performs the native run on current_thread + LocalSet; persist + export writes native-v2.json atomically; and finally Python reads the terminal line and opens native-v2.json and the artifact files."
    caption: "One envelope down stdin, one terminal line up stdout."
    render: @scene {
      // The source is a 6-box vertical pipeline. A column sdk.StepChain (fixed
      // 132px stride → ~752px for six boxes) overruns the 700×400 scene
      // viewport, so the same ordered top-to-bottom flow is carried by
      // sdk.NumberedSequence (68px stride), matching the "Observer sequence"
      // slide's proven vertical-stack shape. stdin/stdout hand-offs are noted
      // inline in the stage details.
      sdk.Caption(id = "flow-title", text = "Command line to results", x = 34, y = 8, width = 640, height = 22, inkRole = theme(ink.primary))
      sdk.NumberedSequence(id = "flow-chain", items = [{ number: "PY", title: "Python", detail: "Config-v2 → BenchmarkRun → protocol-v2 JSON envelope", emphasis: true }, { number: "01", title: "aiperf-runner · main.rs", detail: "stdin · mimalloc · tracing · catch_unwind → JSONL + exit code" }, { number: "02", title: "RunnerV2Coordinator::handle", detail: "10-step: validate → lower → select → prepare → execute" }, { number: "03", title: "execute.rs · native run", detail: "current_thread + LocalSet; graph or scheduled phases", emphasis: true }, { number: "04", title: "persist + export", detail: "atomic native-v2.json · best-effort exporters · commit once" }, { number: "PY", title: "Python reads back", detail: "stdout terminal line → opens native-v2.json + artifacts", emphasis: true }], x = 150, y = 34)
      timeline main {
        at 0 reveal flow-title duration 200
        after flow-title reveal flow-chain duration 360
      }
    }
  }

  slide "Failure funnel" {
    eyebrow: "EVERY FAILURE IS TYPED"
    title: "Every failure is typed"
    lede: "A caught panic becomes a typed failure, never a bare crash — Python always sees exactly one JSONL line."
    narration: "Every failure is typed. A green RunnerFailureStageV2 label sits over a five-column row of stage cells — Protocol, Validation, Preparation, Execution, Reporting. Below, a three-column outcome row maps exit codes to meaning: 0 success, 1 validated failure, 2 protocol failure. A closing line notes each failure carries a redacted diagnostic, with credentials scrubbed before anything reaches stdout."
    caption: "Five failure stages, three typed exit codes."
    render: @scene {
      sdk.Title(id = "fail-title", text = "Every failure is typed", x = 40, y = 12, width = 620, height = 28, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "fail-sub", text = "A caught panic becomes a typed failure, never a bare crash — Python always sees exactly one JSONL line", x = 40, y = 44, width = 620, height = 22, inkRole = theme(ink.secondary))
