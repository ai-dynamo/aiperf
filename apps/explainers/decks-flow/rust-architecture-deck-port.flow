  slide "Config catalog" {
    eyebrow: "THE CONFIGURATION SURFACE"
    title: "The configuration surface"
    lede: "Transport and workload are chosen independently; only validated pairs run."
    narration: "The configuration surface: transport and workload are chosen independently, and only validated pairs run. A supported-pairs matrix crosses transport against workload — http runs scheduled and graph, grpc runs scheduled only, and both dynosim_offline and dynosim_online (feature-gated) run scheduled and graph. Workload is derived from the dataset format: dag_jsonl, weka_trace, and dynamo_trace select graph; everything else is scheduled. Six labeled parameter families round out the surface — phase types, arrivals, ramps, adaptive controllers, sequence-length distributions, and failure policy."
    caption: "Transport × workload · only validated pairs run · six parameter families."
    render: @scene {
      sdk.Title(id = "cfg-title", text = "The configuration surface", x = 106.8, y = 54, width = 1728, height = 81, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "cfg-sub", text = "Transport and workload are chosen independently; only validated pairs run", x = 106.8, y = 151.2, width = 1728, height = 54, inkRole = theme(ink.secondary))
      sdk.Caption(id = "cfg-matrix-label", text = "SUPPORTED PAIRS · TRANSPORT × WORKLOAD", x = 106.8, y = 237.6, width = 837, height = 43.2, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "cfg-m1", text = "http · scheduled ✓ · graph ✓", x = 106.8, y = 291.6, width = 864, height = 48.6, inkRole = theme(ink.secondary))
      sdk.Paragraph(id = "cfg-m2", text = "grpc · scheduled ✓ · graph —", x = 106.8, y = 351, width = 864, height = 48.6, inkRole = theme(ink.secondary))
      sdk.Paragraph(id = "cfg-m3", text = "dynosim_offline (feature) · scheduled ✓ · graph ✓", x = 106.8, y = 410.4, width = 864, height = 48.6, inkRole = theme(ink.secondary))
      sdk.Paragraph(id = "cfg-m4", text = "dynosim_online (feature) · scheduled ✓ · graph ✓", x = 106.8, y = 469.8, width = 864, height = 48.6, inkRole = theme(ink.secondary))
      sdk.Paragraph(id = "cfg-derive", text = "Workload is derived from the dataset format — dag_jsonl / weka_trace / dynamo_trace select graph, everything else scheduled.", x = 106.8, y = 545.4, width = 864, height = 129.6, inkRole = theme(ink.tertiary))
      sdk.Caption(id = "cfg-f1-l", text = "PHASE TYPES", x = 976.2, y = 226.8, width = 907.2, height = 37.8, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "cfg-f1-v", text = "concurrency · poisson · gamma · constant · user_centric · fixed_schedule", x = 976.2, y = 270, width = 907.2, height = 81, inkRole = theme(ink.secondary))
      sdk.Caption(id = "cfg-f2-l", text = "ARRIVALS", x = 976.2, y = 361.8, width = 907.2, height = 37.8, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "cfg-f2-v", text = "Constant · Poisson · Gamma · ConcurrencyBurst", x = 976.2, y = 405, width = 907.2, height = 48.6, inkRole = theme(ink.secondary))
      sdk.Caption(id = "cfg-f3-l", text = "RAMPS", x = 976.2, y = 464.4, width = 432, height = 37.8, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "cfg-f3-v", text = "Linear · Exponential · Poisson", x = 976.2, y = 507.6, width = 432, height = 81, inkRole = theme(ink.secondary))
      sdk.Caption(id = "cfg-f4-l", text = "ADAPTIVE", x = 1440.6, y = 464.4, width = 442.8, height = 37.8, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "cfg-f4-v", text = "concurrency · prefill · request_rate · users", x = 1440.6, y = 507.6, width = 442.8, height = 81, inkRole = theme(ink.secondary))
      sdk.Caption(id = "cfg-f5-l", text = "SEQ LENGTHS", x = 976.2, y = 610.2, width = 907.2, height = 37.8, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "cfg-f5-v", text = "Fixed · Normal · LogNormal · Multimodal · Empirical", x = 976.2, y = 653.4, width = 907.2, height = 48.6, inkRole = theme(ink.secondary))
      sdk.Caption(id = "cfg-f6-l", text = "FAILURE", x = 976.2, y = 712.8, width = 907.2, height = 37.8, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "cfg-f6-v", text = "continue (scheduled) · abort (graph)", x = 976.2, y = 756, width = 907.2, height = 48.6, inkRole = theme(ink.secondary))
      timeline main {
        at 0 reveal cfg-title duration 200
        after cfg-title reveal cfg-sub duration 160
        after cfg-sub reveal cfg-matrix-label duration 140
        after cfg-matrix-label stagger targets [cfg-m1, cfg-m2, cfg-m3, cfg-m4] step 70 duration 150
