      sdk.Caption(id = "le-fmt-label", text = "TRACE FORMATS", x = 123, y = 723.6, width = 1080, height = 43.2, inkRole = theme(accent.primary))
      sdk.TagList(id = "le-formats-1", items = ["WEKA — recursive JSON · honors max_osl", "Dynamo — sessions→chains→trees · depth guard"], gap = 21.6, x = 123, y = 772.2, width = 1782, height = 70.2)
      sdk.TagList(id = "le-formats-2", items = ["aiperf_trace — strict v1, ground-truth tags + block_lens"], gap = 21.6, x = 123, y = 853.2, width = 1782, height = 70.2)
      timeline main {
