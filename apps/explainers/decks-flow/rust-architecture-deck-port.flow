      sdk.Paragraph(id = "close-lede", text = "Specs are design intent; code is truth. Every variation\npoint is a trait with at least one concrete impl.", x = 160.8, y = 540, width = 1512, height = 151.2, inkRole = theme(ink.secondary))
      sdk.IconLabel(id = "close-byline", label = "Anthony Casagrande · AIPerf Rust Runtime", icon = "user", x = 160.8, y = 810, width = 1134, height = 97.2, inkRole = theme(ink.primary), strokeRole = theme(accent.primary))
      timeline main {
