  slide "J · Agentic replay" {
    eyebrow: "GRAPH · AGENTIC TRACE REPLAY"
    title: "An agent session replays as a DAG of turns"
    lede: "The Dynamo adapter lowers JSONL sessions into chains, then trees — replayed node-by-node on one worker."
    narration: "Component J, agentic trace replay — an agent session replays as a DAG of turns. The Dynamo adapter lowers JSONL sessions into chains, then trees: an orchestrator at depth zero spawns subagents — a researcher and a coder at depth one — which may spawn deeper tools before a final turn joins with AddMessages, all replayed node-by-node on one worker. The whole tree is one GraphTracePlan placed on a single worker, so node turns never cross a boundary. A subagent depth guard caps recursion; deeper spawns are clamped. Virtual negative hashes stand in for non-replay turns so the DAG stays complete. Firing-gate delays fire each node after its predecessor's first token, so replay preserves the original spawn timing."
    caption: "sessions → chains → trees · one GraphTracePlan · depth guard."
    render: @scene {
      sdk.Shape(id = "ar-badge", variant = "rect", label = "J", x = 123, y = 32.4, width = 86.4, height = 86.4, surfaceRole = theme(accent.primary))
      sdk.Label(id = "ar-badge-l", text = "J", x = 123, y = 48.6, width = 86.4, height = 54, inkRole = theme(ink.primary))
      sdk.Caption(id = "ar-kicker", text = "GRAPH · AGENTIC TRACE REPLAY", x = 236.4, y = 54, width = 1458, height = 48.6, inkRole = theme(accent.primary))
      sdk.Title(id = "ar-title", text = "An agent session replays as a DAG of turns", x = 123, y = 124.2, width = 1728, height = 70.2, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "ar-sub", text = "The Dynamo adapter lowers JSONL sessions into chains, then trees — replayed node-by-node on one worker", x = 123, y = 205.2, width = 1728, height = 86.4, inkRole = theme(ink.secondary))
      sdk.NodeTree(id = "ar-graph", root = { label: "orchestrator · d0", emphasis: true }, children = [{ label: "researcher · d1" }, { label: "coder · d1" }], orderNote = "d2 web_tool (guard) · final turn JOIN · AddMessages", x = 123, y = 318.6)
      sdk.TagList(id = "ar-adapter", items = ["sessions →", "chains →", "trees"], gap = 27, x = 987, y = 318.6, width = 864, height = 70.2)
      sdk.NumberedSequence(id = "ar-notes", items = [{ number: "1", title: "one GraphTracePlan", detail: "placed on a single worker · node turns never cross a boundary" }, { number: "2", title: "subagent depth guard", detail: "caps recursion; deeper spawns are clamped" }, { number: "3", title: "virtual negative hashes", detail: "stand in for non-replay turns so the DAG stays complete" }], x = 987, y = 405)
      timeline main {
        at 0 reveal ar-badge duration 160
        at 0 reveal ar-badge-l duration 160
