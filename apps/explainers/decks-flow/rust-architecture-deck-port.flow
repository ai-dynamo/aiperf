      sdk.NumberedSequence(id = "ir-seq", items = [{ number: "1", title: "Graph adapter", detail: "dag_jsonl · weka · dynamo · aiperf → GraphInputBundle (bypasses loader registry)", emphasis: true }, { number: "2", title: "Dataset adapter", detail: "synthetic · file · public → PreparedDatasetInput (materialized vs hash-identity)" }, { number: "3", title: "Sidecar adapter", detail: "5 sidecars → PreparedSidecarInputs (type-erased store)" }], x = 40, y = 130)
      timeline main {
