  slide "J · Graph-IR engine" {
    eyebrow: "GRAPH-IR ENGINE"
    title: "A DAG of LlmNodes over named channels"
    lede: "Thread-per-core dataflow — a whole trace is placed on one worker; node turns never cross a boundary."
    narration: "Component J — the Graph-IR engine: a DAG of LlmNodes over named channels. It is thread-per-core dataflow, a whole trace placed on one worker, so node turns never cross a boundary. A root LlmNode fans out to node A, which FORKs, and node B, which SPAWNs, then both join at an AddMessages node before the output. Each edge carries four firing-gate delays — after-predecessor-completion, min-start, after-predecessor-start, and after-predecessor-first-token. ChannelType is Text or Messages; the Reducer is Overwrite or AddMessages."
    caption: "DAG of LlmNodes · four firing-gate delays per edge."
    render: @scene {
      sdk.Shape(id = "gi-badge", variant = "rect", label = "J", x = 123, y = 32.4, width = 86.4, height = 86.4, surfaceRole = theme(accent.primary))
      sdk.Label(id = "gi-badge-l", text = "J", x = 123, y = 48.6, width = 86.4, height = 54, inkRole = theme(ink.primary))
      sdk.Caption(id = "gi-kicker", text = "GRAPH-IR ENGINE", x = 236.4, y = 54, width = 1350, height = 48.6, inkRole = theme(accent.primary))
      sdk.Title(id = "gi-title", text = "A DAG of LlmNodes over named channels", x = 123, y = 129.6, width = 1728, height = 70.2, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "gi-sub", text = "Thread-per-core dataflow — a whole trace is placed on one worker; node turns never cross a boundary", x = 123, y = 216, width = 1728, height = 54, inkRole = theme(ink.secondary))
      sdk.NodeTree(id = "gi-graph", root = { label: "root · LlmNode", emphasis: true }, children = [{ label: "node A · FORK" }, { label: "node B · SPAWN" }], orderNote = "both join at join · AddMessages → out", x = 123, y = 318.6)
      sdk.Caption(id = "gi-gate-label", text = "FOUR FIRING-GATE DELAYS PER EDGE", x = 987, y = 318.6, width = 864, height = 43.2, inkRole = theme(accent.primary))
      sdk.TagList(id = "gi-gates-1", items = ["after-predecessor-completion", "min-start"], gap = 21.6, x = 987, y = 372.6, width = 918, height = 70.2)
      sdk.TagList(id = "gi-gates-2", items = ["after-predecessor-start", "after-predecessor-first-token"], gap = 21.6, x = 987, y = 459, width = 918, height = 70.2)
      sdk.Caption(id = "gi-chan-label", text = "CHANNELTYPE · REDUCER", x = 987, y = 567, width = 864, height = 43.2, inkRole = theme(accent.primary))
      sdk.TagList(id = "gi-chan", items = ["Text · Messages", "Overwrite · AddMessages"], gap = 21.6, x = 987, y = 615.6, width = 918, height = 70.2)
      timeline main {
