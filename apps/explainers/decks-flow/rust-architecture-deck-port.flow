      sdk.Caption(id = "ce-topo", text = "controller (--cells N) → cell k where i%N==k → merged report · byte-identical", x = 123, y = 286.2, width = 1728, height = 43.2, inkRole = theme(accent.primary))
      sdk.CardGrid(id = "ce-cards", columns = 2, cards = [{ title: "Partition", detail: "ModuloCellPartition · isolated stream roots", accent: "green" }, { title: "Issuance", detail: "global ordinal, never a shared atomic", accent: "green" }, { title: "Shard", detail: "raw RecordIngest over MessagePack (NaN/+inf)", accent: "green" }, { title: "Heartbeat", detail: "live t-digest percentiles for a progress lane", accent: "green" }], x = 123, y = 345.6)
      sdk.Caption(id = "ce-note", text = "Fail-closed: HTTP transport only, synthetic single-turn, request-bounded phases, requests ≥ cell_count — rejects duration, sessions, adaptive and multi-turn", x = 123, y = 988.2, width = 1728, height = 81, inkRole = theme(ink.secondary))
      timeline main {
