      sdk.CompareGrid(id = "dy-modes", columns = 2, items = [{ label: "dynosim_offline", detail: "Sim clock · drive_sim_with_source · enforced byte-exact parity vs Dynamo" }, { label: "dynosim_online", detail: "Real clock · drive_real_with_source · relaxed parity" }], x = 123, y = 334.8)
      sdk.Caption(id = "dy-axis", text = "The two modes differ only in the clock / driver axis", x = 123, y = 669.6, width = 1728, height = 43.2, inkRole = theme(ink.secondary))
