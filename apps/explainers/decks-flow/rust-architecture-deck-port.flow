//! Native port of the reference NVIDIA "AIPerf Rust Runtime" architecture deck.
//! Chapter 1 (Open): Cover, Thesis, Orientation. Later chapters appended by
//! Tasks 5-10. Every visual is a registered `sdk.*` component — no freeform SVG.

explainer "Rust Architecture — Deck Port" {
  id: "rust-architecture-deck-port"
  route: "/rust-architecture-deck-port"
  topic: "architecture"
  storagePrefix: "rust-architecture-deck-port-explainer"
  classPrefix: "deck-rust-architecture-deck-port"
  eyebrowLabel: "ARCHITECTURE DEEP DIVE"
  startGateTitle: "AIPerf Rust Runtime"

  hub: {
    highlight: "Rust runtime"
    title: "AIPerf Rust Runtime · 49-slide deck port"
    description: "A native port of the reference NVIDIA architecture deck — every slide rebuilt from composable SDK primitives."
  }

  slide "Cover" {
    eyebrow: "ARCHITECTURE DEEP DIVE"
    title: "AIPerf Rust Runtime"
    lede: "From the command line to results — every component on the product path, and the two seams that hold it together."
    narration: "The cover opens the deck: a green monospace kicker over the huge title 'AIPerf Rust Runtime', the one-line thesis subtitle, and a green-barred byline reading 'Anthony Casagrande · 2026'."
    caption: "Architecture Deep Dive · AIPerf Rust Runtime."
    render: @scene {
      sdk.Caption(id = "cover-eyebrow", text = "ARCHITECTURE DEEP DIVE", x = 160.8, y = 178.2, width = 1242, height = 54, inkRole = theme(accent.primary))
      sdk.Title(id = "cover-title", text = "AIPerf Rust Runtime", x = 160.8, y = 280.8, width = 1620, height = 172.8, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "cover-lede", text = "From the command line to results — every\ncomponent on the product path, and the two\nseams that hold it together", x = 160.8, y = 523.8, width = 1458, height = 226.8, inkRole = theme(ink.secondary))
      sdk.IconLabel(id = "cover-byline", label = "Anthony Casagrande · 2026", icon = "user", x = 160.8, y = 847.8, width = 918, height = 97.2, inkRole = theme(ink.primary), strokeRole = theme(accent.primary))
      timeline main {
        at 0 reveal cover-eyebrow duration 200
        after cover-eyebrow reveal cover-title duration 260
        after cover-title reveal cover-lede duration 240
        after cover-lede reveal cover-byline duration 200
      }
    }
  }

  slide "Thesis" {
    eyebrow: "THE WHOLE IDEA IN ONE SLIDE"
    title: "AIPerf is Python-orchestrated, Rust-executed"
    lede: "One protocol-v2 envelope in, one authoritative report out."
    narration: "The whole idea in one slide: Python orchestrates, Rust executes. A four-box pipeline runs Python → protocol-v2 envelope → aiperf-runner → native-v2.json, with the envelope box highlighted green as the single hand-off. Three green-topped takeaway cells restate the split: Python owns config, aiperf-runner is the only Rust exe, and two trait seams make one codebase run three ways."
    caption: "Python-orchestrated, Rust-executed · one envelope in, one report out."
    render: @scene {
      sdk.Caption(id = "thesis-eyebrow", text = "THE WHOLE IDEA IN ONE SLIDE", x = 123, y = 59.4, width = 1242, height = 48.6, inkRole = theme(accent.primary))
      sdk.Title(id = "thesis-title", text = "AIPerf is Python-orchestrated, Rust-executed", x = 123, y = 124.2, width = 1701, height = 91.8, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "thesis-sub", text = "one protocol-v2 envelope in, one authoritative report out", x = 123, y = 232.2, width = 1701, height = 64.8, inkRole = theme(ink.secondary))

      sdk.Shape(id = "thesis-p1", variant = "rounded", label = "Python", x = 106.8, y = 345.6, width = 324, height = 118.8, strokeRole = theme(ink.tertiary))
      sdk.Caption(id = "thesis-p1-sub", text = "Config-v2", x = 106.8, y = 475.2, width = 324, height = 43.2, inkRole = theme(ink.tertiary))
      sdk.Arrow(id = "thesis-a1", label = "to envelope", from = { nodeId: "thesis-p1", anchor: "e" }, to = { nodeId: "thesis-p2", anchor: "w" }, x = 430.8, y = 405, width = 108, height = 0, strokeRole = theme(accent.primary))
      sdk.Shape(id = "thesis-p2", variant = "rounded", label = "protocol-v2 envelope", x = 538.8, y = 345.6, width = 421.2, height = 118.8, surfaceRole = theme(surface.secondary), strokeRole = theme(accent.primary))
      sdk.Caption(id = "thesis-p2-sub", text = "one JSON line", x = 538.8, y = 475.2, width = 421.2, height = 43.2, inkRole = theme(ink.tertiary))
      sdk.Arrow(id = "thesis-a2", label = "to runner", from = { nodeId: "thesis-p2", anchor: "e" }, to = { nodeId: "thesis-p3", anchor: "w" }, x = 960, y = 405, width = 108, height = 0, strokeRole = theme(accent.primary))
      sdk.Shape(id = "thesis-p3", variant = "rounded", label = "aiperf-runner", x = 1068, y = 345.6, width = 378, height = 118.8, strokeRole = theme(ink.primary))
      sdk.Caption(id = "thesis-p3-sub", text = "the only Rust exe", x = 1068, y = 475.2, width = 378, height = 43.2, inkRole = theme(ink.tertiary))
      sdk.Arrow(id = "thesis-a3", label = "to output", from = { nodeId: "thesis-p3", anchor: "e" }, to = { nodeId: "thesis-p4", anchor: "w" }, x = 1446, y = 405, width = 108, height = 0, strokeRole = theme(accent.primary))
      sdk.Shape(id = "thesis-p4", variant = "rounded", label = "native-v2.json", x = 1554, y = 345.6, width = 324, height = 118.8, strokeRole = theme(ink.tertiary))
      sdk.Caption(id = "thesis-p4-sub", text = "+ terminal line", x = 1554, y = 475.2, width = 324, height = 43.2, inkRole = theme(ink.tertiary))

      sdk.CompareGrid(id = "thesis-takeaways", columns = 3, items = [{ label: "Python owns config", detail: "one envelope to a fresh child" }, { label: "aiperf-runner", detail: "the only Rust exe on path" }, { label: "Two trait seams", detail: "one codebase, three modes" }], x = 25.8, y = 615.6)

      timeline main {
        at 0 reveal thesis-eyebrow duration 180
        after thesis-eyebrow reveal thesis-title duration 220
        after thesis-title reveal thesis-sub duration 180
        after thesis-sub stagger targets [thesis-p1, thesis-p2, thesis-p3, thesis-p4] step 90 duration 160
        after thesis-p4 stagger targets [thesis-p1-sub, thesis-p2-sub, thesis-p3-sub, thesis-p4-sub] step 60 duration 120
        after thesis-p4-sub trace thesis-a1 duration 140
        after thesis-a1 trace thesis-a2 duration 140
        after thesis-a2 trace thesis-a3 duration 140
        after thesis-a3 reveal thesis-takeaways duration 260
      }
    }
  }

  slide "Orientation" {
    eyebrow: "ORIENTATION"
    title: "What the runner does, in order"
    lede: "Everything from a single envelope arriving on stdin to a terminal line on stdout."
    narration: "Orientation walks the runner's six ordered stages left to right: 01 VALIDATE the envelope against frozen registries, 02 SELECT a transport and workload, 03 DRIVE a phased load test over the injected Clock, 04 MEASURE lock-free per worker, 05 REPORT the authoritative native-v2.json, and 06 EMIT one terminal JSONL line."
    caption: "Six stages · from stdin envelope to stdout line."
    render: @scene {
      sdk.Title(id = "orient-title", text = "What the runner does, in order", x = 123, y = 81, width = 1674, height = 97.2, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "orient-sub", text = "Everything from a single envelope arriving on stdin to a terminal line on stdout", x = 123, y = 205.2, width = 1674, height = 64.8, inkRole = theme(ink.secondary))
      // The 6-stage pipeline is split across two rows of three: the composite's
      // fixed step-box width overflows the 700×400 scene viewport at six-in-a-row,
      // so 01→03 and 04→06 stack, each an sdk.StepChain that fits cleanly.
      sdk.StepChain(id = "orient-chain-a", direction = "row", steps = [{ number: "01", label: "VALIDATE", detail: "frozen registries" }, { number: "02", label: "SELECT", detail: "transport + workload" }, { number: "03", label: "DRIVE", detail: "phased over Clock" }], x = 155.4, y = 318.6)
      sdk.StepChain(id = "orient-chain-b", direction = "row", steps = [{ number: "04", label: "MEASURE", detail: "lock-free per worker" }, { number: "05", label: "REPORT", detail: "write native-v2.json" }, { number: "06", label: "EMIT", detail: "one JSONL line on stdout" }], x = 155.4, y = 696.6)
      timeline main {
        at 0 reveal orient-title duration 200
        after orient-title reveal orient-sub duration 180
        after orient-sub reveal orient-chain-a duration 300
        after orient-chain-a reveal orient-chain-b duration 300
      }
    }
  }

  // ---- Chapter 2 — Two Seams (Task 5) ----

  slide "Divider 01" {
    eyebrow: "CHAPTER 01"
    title: "The Two Seams"
    lede: "If you understand these, the rest is composition."
    narration: "Chapter-break slide 01: a huge green monospace '01' over the bold title 'The Two Seams' and the gray subtitle 'If you understand these, the rest is composition', right-aligned."
    caption: "Chapter 01 · The Two Seams."
    render: @scene {
      sdk.SectionDivider(id = "div01", number = "01", title = "The Two Seams", subtitle = "If you understand these, the rest is composition", x = 106.8, y = 156.6, width = 1755)
      timeline main {
        at 0 reveal div01 duration 320
      }
    }
  }

  slide "Seams overview" {
    eyebrow: "TWO SEAMS"
    title: "Two trait seams carry the architecture"
    lede: "Everything passes through the waist — run modes above, runtime concerns below, neither branches on the other."
    narration: "Two trait seams carry the architecture. A row of run-mode pills — online-real, online-mock, offline co-sim — funnels down into a two-box waist, {clock} and {transport}, which then fans back out to the runtime-concern pills scheduling, pacing, admission, reporting. The modes above and concerns below never branch on each other."
    caption: "Two seams · the waist everything passes through."
    render: @scene {
      sdk.Title(id = "seams-title", text = "Two trait seams carry the architecture", x = 106.8, y = 54, width = 1728, height = 86.4, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "seams-sub", text = "Everything passes through the waist — modes above, runtime concerns below, neither branches on the other", x = 106.8, y = 151.2, width = 1728, height = 64.8, inkRole = theme(ink.secondary))
      sdk.TagList(id = "seams-modes", items = ["online-real", "online-mock", "offline co-sim"], gap = 32.4, x = 420, y = 248.4, width = 1080, height = 91.8)
      sdk.CompareGrid(id = "seams-waist", columns = 2, items = [{ label: "{clock}", detail: "wall-vs-virtual time · RealClock · SimClock" }, { label: "{transport}", detail: "dispatch + measure · Dispatchable · RequestSink · RequestObserver" }], x = 344.4, y = 361.8)
      sdk.TagList(id = "seams-concerns", items = ["scheduling", "pacing", "admission", "reporting"], gap = 32.4, x = 366, y = 745.2, width = 1188, height = 91.8)
      timeline main {
        at 0 reveal seams-title duration 200
        after seams-title reveal seams-sub duration 180
        after seams-sub reveal seams-modes duration 200
        after seams-modes reveal seams-waist duration 260
        after seams-waist reveal seams-concerns duration 200
      }
    }
  }

  slide "Clock" {
    eyebrow: "{CLOCK}"
    title: "One Clock trait, two implementations"
    lede: "now_ns · sleep · is_virtual — dispatch on is_virtual() and nothing above the seam cares."
    narration: "One Clock trait, two implementations. On the left RealClock is a timeline: ticks at 0/1/2/3 ms, a dashed green target deadline, a filled-green 'timerfd exact' marker at the deadline and a hollow-gray 'wheel late' marker past it. On the right SimClock is a BinaryHeap: the popped root (100,0) fills green over its two children (140,1) and (140,2), with the pop order noted beneath."
    caption: "RealClock timeline vs SimClock heap."
    render: @scene {
      sdk.Caption(id = "clock-eyebrow", text = "{clock}", x = 106.8, y = 48.6, width = 810, height = 48.6, inkRole = theme(accent.primary))
      sdk.Title(id = "clock-title", text = "One Clock trait, two implementations", x = 106.8, y = 108, width = 1728, height = 81, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "clock-sub", text = "now_ns · sleep · is_virtual — dispatch on is_virtual() and nothing above the seam cares", x = 106.8, y = 199.8, width = 1728, height = 59.4, inkRole = theme(ink.secondary))
      sdk.Caption(id = "clock-real-name", text = "RealClock — timerfd (ns) vs tokio 1ms wheel", x = 69, y = 291.6, width = 864, height = 43.2, inkRole = theme(ink.primary))
      sdk.TimelineAxis(id = "clock-real", start = 0, end = 3, ticks = [{ at: 0, label: "0ms" }, { at: 1, label: "1ms" }, { at: 2, label: "2ms" }, { at: 3, label: "3ms" }], target = { at: 1.6, label: "target" }, markers = [{ at: 1.6, label: "timerfd exact" }, { at: 2, label: "wheel late", style: "late" }], x = 69, y = 356.4, width = 810)
      sdk.Caption(id = "clock-sim-name", text = "SimClock — BinaryHeap<Sleeper>, reversed Ord pops earliest", x = 976.2, y = 291.6, width = 918, height = 43.2, inkRole = theme(ink.primary))
      sdk.NodeTree(id = "clock-sim", root = { label: "(100, 0)", emphasis: true }, children = [{ label: "(140, 1)" }, { label: "(140, 2)" }], orderNote = "pop order → (100,0) → (140,1) → (140,2)", x = 976.2, y = 356.4)
      timeline main {
        at 0 reveal clock-eyebrow duration 160
        after clock-eyebrow reveal clock-title duration 220
        after clock-title reveal clock-sub duration 180
        after clock-sub reveal clock-real-name duration 140
        after clock-real-name reveal clock-real duration 260
        after clock-real reveal clock-sim-name duration 140
        after clock-sim-name reveal clock-sim duration 260
      }
    }
  }

  slide "Drivers" {
    eyebrow: "{CLOCK} · DRIVERS"
    title: "Same executor, two ways to drive it"
    lede: "The driver dispatches on is_virtual() — real time yields to the reactor, virtual time is pumped by hand."
    narration: "Same executor, two ways to drive it. drive_real is a wall-clock timeline whose reactor fires futures at three green deadlines. drive_sim is an idle-pump loop: poll the LocalSet to quiescence, advance_to the next event time, wake sleepers in heap order, then repeat — an idle heap with no clock event panics as a deadlock."
    caption: "drive_real fires; drive_sim pumps."
    render: @scene {
      sdk.Caption(id = "drv-eyebrow", text = "{clock} · drivers", x = 106.8, y = 48.6, width = 810, height = 48.6, inkRole = theme(accent.primary))
      sdk.Title(id = "drv-title", text = "Same executor, two ways to drive it", x = 106.8, y = 108, width = 1728, height = 81, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "drv-sub", text = "The driver dispatches on is_virtual() — real time yields to the reactor, virtual time is pumped by hand", x = 106.8, y = 199.8, width = 1728, height = 59.4, inkRole = theme(ink.secondary))
      sdk.Caption(id = "drv-real-name", text = "drive_real — reactor fires at wall-clock deadlines", x = 69, y = 291.6, width = 864, height = 43.2, inkRole = theme(ink.primary))
      sdk.TimelineAxis(id = "drv-real", start = 0, end = 3, markers = [{ at: 0.6, label: "fire" }, { at: 1.5, label: "fire" }, { at: 2.4, label: "fire" }], x = 69, y = 356.4, width = 810)
      sdk.Caption(id = "drv-real-note", text = "real wall-clock time →", x = 69, y = 675, width = 810, height = 43.2, inkRole = theme(ink.tertiary))
      sdk.Caption(id = "drv-sim-name", text = "drive_sim · idle-pump loop", x = 987, y = 291.6, width = 891, height = 43.2, inkRole = theme(accent.primary))
      sdk.ProcessStep(id = "drv-poll", title = "poll", detail = "LocalSet", x = 987, y = 405, width = 270, height = 156.6)
      sdk.ProcessStep(id = "drv-adv", title = "advance_to", detail = "next event", x = 1297.5, y = 405, width = 270, height = 156.6)
      sdk.ProcessStep(id = "drv-wake", title = "wake", detail = "sleepers", x = 1608, y = 405, width = 270, height = 156.6)
      sdk.Edge(id = "drv-e1", mode = "route", from = ref("drv-poll.output"), to = ref("drv-adv.input"), style = { stroke: theme(accent.green), strokeWidth: 5.94, fill: "none" })
      sdk.Edge(id = "drv-e2", mode = "route", from = ref("drv-adv.output"), to = ref("drv-wake.input"), style = { stroke: theme(accent.green), strokeWidth: 5.94, fill: "none" })
      sdk.Edge(id = "drv-back", mode = "route", from = ref("drv-wake.output"), to = ref("drv-poll.input"), via = { x: 475, y: 240 }, style = { stroke: theme(accent.warning), strokeWidth: 5.4, fill: "none" })
      sdk.Caption(id = "drv-repeat", text = "repeat — idle with no clock event → panic", x = 987, y = 675, width = 891, height = 43.2, inkRole = theme(ink.tertiary))
      sdk.Paragraph(id = "drv-foot", text = "The graph engine's drive_*_with_source variants also merge an external SimEventSource — e.g. the in-process dynosim engine.", x = 106.8, y = 799.2, width = 1728, height = 97.2, inkRole = theme(ink.secondary))
      timeline main {
        at 0 reveal drv-eyebrow duration 160
        after drv-eyebrow reveal drv-title duration 220
        after drv-title reveal drv-sub duration 180
        after drv-sub reveal drv-real-name duration 140
        after drv-real-name reveal drv-real duration 220
        after drv-real reveal drv-real-note duration 120
        after drv-real-note reveal drv-sim-name duration 140
        after drv-sim-name reveal drv-poll duration 160
        after drv-poll trace drv-e1 duration 160
        after drv-e1 reveal drv-adv duration 160
        after drv-adv trace drv-e2 duration 160
        after drv-e2 reveal drv-wake duration 160
        after drv-wake trace drv-back duration 200
        after drv-back reveal drv-repeat duration 120
        after drv-repeat reveal drv-foot duration 200
      }
    }
  }

  slide "Transport seam" {
    eyebrow: "{TRANSPORT}"
    title: "Three traits, no concrete request types"
    lede: "Real HTTP, native gRPC, mock HTTP and in-process co-sim all feed the same observer."
    narration: "Three traits, no concrete request types. Three cards — Dispatchable (Send + Sync, uuid/input_length/max_output_tokens), RequestSink<R> (?Send, !Send hyper/gRPC sinks on a LocalSet), and RequestObserver (no Send/Sync, worker-local Rc/RefCell). Below, a pill row real HTTP / native gRPC / mock HTTP / co-sim arrows into one RequestObserver."
    caption: "Three transport traits, one observer."
    render: @scene {
      sdk.Caption(id = "trans-eyebrow", text = "{transport}", x = 106.8, y = 48.6, width = 810, height = 48.6, inkRole = theme(accent.primary))
      sdk.Title(id = "trans-title", text = "Three traits, no concrete request types", x = 106.8, y = 108, width = 1728, height = 81, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "trans-sub", text = "Real HTTP, native gRPC, mock HTTP and in-process co-sim all feed the same observer", x = 106.8, y = 199.8, width = 1728, height = 59.4, inkRole = theme(ink.secondary))
      sdk.CompareGrid(id = "trans-cards", columns = 3, items = [{ label: "Dispatchable", detail: "Send + Sync · no concrete type" }, { label: "RequestSink<R>", detail: "?Send · !Send on a LocalSet" }, { label: "RequestObserver", detail: "no Send/Sync · Rc/RefCell" }], x = 25.8, y = 291.6)
      sdk.TagList(id = "trans-tags", items = ["real HTTP", "native gRPC", "mock HTTP", "co-sim"], gap = 21.6, x = 106.8, y = 810, width = 1026, height = 86.4)
      sdk.Caption(id = "trans-arrow", text = "→ one RequestObserver · backend never leaks up", x = 1176, y = 826.2, width = 675, height = 108, inkRole = theme(ink.primary))
      timeline main {
        at 0 reveal trans-eyebrow duration 160
        after trans-eyebrow reveal trans-title duration 220
        after trans-title reveal trans-sub duration 180
        after trans-sub reveal trans-cards duration 300
        after trans-cards reveal trans-tags duration 200
        after trans-tags reveal trans-arrow duration 160
      }
    }
  }

  slide "Observer sequence" {
    eyebrow: "{TRANSPORT} · CALLBACK SEQUENCE"
    title: "The life of one request, in callbacks"
    lede: "Six observer callbacks, in order, from arrival to terminal."
    narration: "The life of one request, in callbacks. Six numbered rows with alternating green and black index chips: on_arrival, on_admit, on_token (first token derives TTFT), on_usage (terminal authoritative server usage), on_endpoint_metrics (default no-op), and on_terminal (Completed · Rejected · Canceled · Failed)."
    caption: "Six observer callbacks in order."
    render: @scene {
      sdk.Caption(id = "seq-title", text = "The life of one request, in callbacks", x = 106.8, y = 21.6, width = 1728, height = 59.4, inkRole = theme(ink.primary))
      sdk.NumberedSequence(id = "seq-list", items = [{ number: "1", title: "on_arrival", detail: "arrival_ms, input_length, requested_output_length", emphasis: true }, { number: "2", title: "on_admit", detail: "admit_ms, reused_input_tokens", emphasis: true }, { number: "3", title: "on_token", detail: "on_classified_token / batch — first token derives TTFT" }, { number: "4", title: "on_usage", detail: "terminal server usage, 13 optional fields; absent stays absent", emphasis: true }, { number: "5", title: "on_endpoint_metrics", detail: "image/video facts; default no-op", emphasis: true }, { number: "6", title: "on_terminal", detail: "Completed · Rejected · Canceled · Failed" }], x = 106.8, y = 91.8)
      timeline main {
        at 0 reveal seq-title duration 200
        after seq-title reveal seq-list duration 320
      }
    }
  }

  slide "Three modes" {
    eyebrow: "THE PAYOFF OF TWO SEAMS"
    title: "3 interchangeable run modes from one codebase"
    lede: "Online-real, online-mock, and offline co-sim — same codebase, three ways."
    narration: "The payoff of two seams: a giant green 3 beside 'interchangeable run modes from one codebase', over a three-column row — online-real (real clock, real HTTP/gRPC against a live server), online-mock (real clock against the standalone mock server), and offline co-sim (virtual clock, deterministic dynosim, byte-exact)."
    caption: "Three interchangeable run modes."
    render: @scene {
      sdk.Caption(id = "modes-eyebrow", text = "The payoff of two seams", x = 987, y = 27, width = 864, height = 54, inkRole = theme(ink.secondary))
      sdk.BigStat(id = "modes-stat", value = "3", title = "interchangeable run modes from one codebase", x = 96, y = 16.2, width = 1728)
      sdk.CompareGrid(id = "modes-grid", columns = 3, items = [{ label: "online-real", detail: "Real clock · real HTTP/gRPC" }, { label: "online-mock", detail: "Real clock · mock server" }, { label: "offline co-sim", detail: "Virtual clock · dynosim" }], x = 25.8, y = 750.6)
      timeline main {
        at 0 reveal modes-eyebrow duration 160
        after modes-eyebrow reveal modes-stat duration 320
        after modes-stat reveal modes-grid duration 260
      }
    }
  }

  // ---- Chapter 3 — Crate Topology & Flow (Task 6) ----

  slide "Divider 02" {
    eyebrow: "CHAPTER 02"
    title: "Crate Topology and the End-to-End Flow"
    lede: "Four crates, one product path, one typed outcome."
    narration: "Chapter-break slide 02: a huge green monospace '02' over the bold title 'Crate Topology and the End-to-End Flow' and the gray subtitle 'Four crates, one product path, one typed outcome', right-aligned."
    caption: "Chapter 02 · Crate Topology and the End-to-End Flow."
    render: @scene {
      sdk.SectionDivider(id = "div02", number = "02", title = "Crate Topology and the End-to-End Flow", subtitle = "Four crates, one product path, one typed outcome", x = 106.8, y = 156.6, width = 1755)
      timeline main {
        at 0 reveal div02 duration 320
      }
    }
  }

  slide "Crate topology" {
    eyebrow: "FOUR CRATES"
    title: "Four crates"
    lede: "16 former aiperf-* crates are now modules inside one library crate — no binary of its own."
    narration: "Four crates. A dependency-direction chip row reads loadgen-core ← aiperf ← aiperf-runner, with aiperf-mock-server standing apart as independent. Below, a 2×2 card grid: loadgen-core (green — the {transport} seam plus trace collector, zero engine/HTTP deps), aiperf (green — the library-only runtime, no binary), aiperf-runner (black — the sole strict Rust executable Python launches, protocol-v2 only), and aiperf-mock-server (gray — the standalone online test/benchmark target, not in the runner dep graph)."
    caption: "Four crates · one dependency chain, one independent target."
    render: @scene {
      sdk.Title(id = "crate-title", text = "Four crates", x = 123, y = 48.6, width = 1674, height = 81, inkRole = theme(ink.primary))
