      sdk.TagList(id = "fail-stages", items = ["Protocol", "Validation", "Preparation", "Execution", "Reporting"], gap = 10, x = 40, y = 100, width = 620, height = 40)
      sdk.CompareGrid(id = "fail-codes", columns = 3, items = [{ label: "0", detail: "success" }, { label: "1", detail: "validated failure" }, { label: "2", detail: "protocol failure" }], x = 4, y = 240)
      sdk.Paragraph(id = "fail-foot", text = "Each carries a redacted diagnostic — credentials scrubbed before anything reaches stdout.", x = 40, y = 368, width = 620, height = 20, inkRole = theme(ink.secondary))
      timeline main {
