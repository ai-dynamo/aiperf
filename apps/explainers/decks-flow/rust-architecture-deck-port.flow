  slide "H · RNG substrate" {
    eyebrow: "RNG SUBSTRATE"
    title: "Hash-derived, order-independent randomness"
    lede: "A stream depends only on (root_seed, identifier) — adding a consumer cannot perturb existing streams."
    narration: "Component H — the RNG substrate: hash-derived, order-independent randomness. A stream depends only on the pair of root_seed and identifier, so adding a consumer cannot perturb existing streams. derive_seed is BLAKE3 of the string root colon id, truncated to eight bytes, feeding a per-consumer Pcg64 — dataset.sampler, timing.cancel, graph.synth, and roughly forty-four canonical stream names that are sorted, unique, and collision-free. Order independence means adding a consumer Z leaves streams X and Y unchanged; HashIdRandomGenerator reseeds per trace_id and hash_id. Cross-language parity: AIPERF_RNG_BACKEND=rust_parity swaps Python onto a byte-exact port of this Pcg64 plus BLAKE3 substrate."
    caption: "derive_seed = BLAKE3 · per-stream Pcg64 · order-independent."
    render: @scene {
      sdk.Shape(id = "rng-badge", variant = "rect", label = "H", x = 123, y = 32.4, width = 86.4, height = 86.4, surfaceRole = theme(accent.primary))
      sdk.Label(id = "rng-badge-l", text = "H", x = 123, y = 48.6, width = 86.4, height = 54, inkRole = theme(ink.primary))
      sdk.Caption(id = "rng-kicker", text = "RNG SUBSTRATE", x = 236.4, y = 54, width = 1350, height = 48.6, inkRole = theme(accent.primary))
      sdk.Title(id = "rng-title", text = "Hash-derived, order-independent randomness", x = 123, y = 129.6, width = 1728, height = 70.2, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "rng-sub", text = "A stream depends only on (root_seed, identifier) — adding a consumer cannot perturb existing streams", x = 123, y = 216, width = 1728, height = 54, inkRole = theme(ink.secondary))
      sdk.StepChain(id = "rng-chain", direction = "row", steps = [{ number: "1", label: "root_seed", detail: "run-level entropy" }, { number: "2", label: "derive_seed", detail: "BLAKE3(\"root:id\")[..8]" }, { number: "3", label: "Pcg64 per stream", detail: "~44 canonical names · sorted, unique, collision-free" }], x = 123, y = 291.6)
      sdk.CompareGrid(id = "rng-order", columns = 2, items = [{ label: "stream X, stream Y", detail: "independent Pcg64 streams keyed by identifier" }, { label: "+ add consumer Z", detail: "X, Y unchanged · Z is new · reseed per (trace_id, hash_id)" }], x = 25.8, y = 637.2)
      sdk.Caption(id = "rng-parity", text = "AIPERF_RNG_BACKEND=rust_parity — byte-exact Python port of this Pcg64 + BLAKE3 substrate", x = 123, y = 988.2, width = 1728, height = 43.2, inkRole = theme(ink.secondary))
      timeline main {
        at 0 reveal rng-badge duration 160
        at 0 reveal rng-badge-l duration 160
        after rng-badge reveal rng-kicker duration 140
        after rng-kicker reveal rng-title duration 200
        after rng-title reveal rng-sub duration 160
        after rng-sub reveal rng-chain duration 320
        after rng-chain reveal rng-order duration 280
        after rng-order reveal rng-parity duration 160
      }
    }
  }

  slide "I · Timing and scheduling" {
    eyebrow: "TIMING AND SCHEDULING"
    title: "Paced arrivals into a dispatcher"
    lede: "ScheduledRuntime bridges a Workload schedule generator to a transport-neutral TurnDispatcher."
    narration: "Component I — timing and scheduling: paced arrivals into a dispatcher. ScheduledRuntime bridges a Workload schedule generator to a transport-neutral TurnDispatcher. The pipeline runs Workload to IntervalGenerator to SlotPool to TurnDispatcher to Observer. The SlotPool does debt-drain: when capacity decreases the effective slots equal available minus debt, an RAII SlotGuard releases prefill at TTFT by dropping the guard. A StopChecker chain runs Lifecycle, RequestCount, SessionCount, Duration, first-no wins. RampStrategy is Linear, Exponential, or Poisson and forces the exact target. BernoulliFixedDelay takes one draw at issuance; warmup draws no RNG. Workloads are RequestRate, UserCentric, FixedSchedule, and SingleTurn."
    caption: "ScheduledRuntime → SlotPool debt-drain → TurnDispatcher."
    render: @scene {
      sdk.Shape(id = "ts-badge", variant = "rect", label = "I", x = 123, y = 32.4, width = 86.4, height = 86.4, surfaceRole = theme(accent.primary))
