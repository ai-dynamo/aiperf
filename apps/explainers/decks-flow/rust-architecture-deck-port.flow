  }

  slide "Everything is a trait" {
    eyebrow: "EVERYTHING IS A TRAIT"
    title: "Everything is a trait"
    lede: "Every variation point is an implementable trait with at least one concrete impl."
    narration: "Everything is a trait: every variation point is an implementable trait with at least one concrete impl — object-safe at dyn boundaries, monomorphized on the hot path. There are 115 extension seams across 18 layers, and the seam count per layer spans a wide range: Dataset 15, Scheduling 15, Graph 14, Runner composition 8, Phase lifecycle 8, Adaptive 7, Endpoints 6, HTTP 6, Metrics/report 6, Telemetry 6, Execution 5, Inputs 4, Cellular 4, and Dispatch/gRPC 3."
    caption: "115 extension seams across 18 layers · every variation point a trait."
    render: @scene {
      sdk.Title(id = "trait-title", text = "Everything is a trait", x = 106.8, y = 48.6, width = 1620, height = 75.6, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "trait-sub", text = "Every variation point is an implementable trait with at least one\nconcrete impl — object-safe at dyn boundaries, monomorphized on the hot path", x = 106.8, y = 135, width = 1674, height = 108, inkRole = theme(ink.secondary))
      sdk.Title(id = "trait-headline", text = "115 extension seams across 18 layers", x = 106.8, y = 280.8, width = 1674, height = 81, inkRole = theme(accent.primary))
      sdk.Caption(id = "trait-bars-label", text = "SEAMS PER LAYER", x = 106.8, y = 421.2, width = 810, height = 43.2, inkRole = theme(accent.primary))
      sdk.TagList(id = "trait-bars-1", items = ["Dataset · 15", "Scheduling · 15", "Graph · 14", "Runner comp. · 8", "Phase lifecycle · 8", "Adaptive · 7", "Endpoints · 6"], gap = 21.6, x = 106.8, y = 480.6, width = 1728, height = 75.6)
      sdk.TagList(id = "trait-bars-2", items = ["HTTP · 6", "Metrics/report · 6", "Telemetry · 6", "Execution · 5", "Inputs · 4", "Cellular · 4", "Dispatch/gRPC · 3"], gap = 21.6, x = 106.8, y = 583.2, width = 1728, height = 75.6)
      timeline main {
        at 0 reveal trait-title duration 200
        after trait-title reveal trait-sub duration 180
        after trait-sub reveal trait-headline duration 220
        after trait-headline reveal trait-bars-label duration 140
        after trait-bars-label reveal trait-bars-1 duration 200
        after trait-bars-1 reveal trait-bars-2 duration 200
      }
    }
  }

  slide "Invariants" {
    eyebrow: "CROSS-CUTTING INVARIANTS"
    title: "Cross-cutting invariants"
    lede: "From the source, not the docs — the rules every subsystem holds to."
    narration: "Cross-cutting invariants, read from the source rather than the docs — the rules every subsystem holds to. One, all time flows through Clock: never Instant::now or raw tokio::time for measurement, with virtual time an integer-ns tuple that tie-breaks on (at_ns, seq_no). Two, thread-per-core: N current_thread runtimes, per-trace state in Rc/RefCell, !Send futures, parallelism as many traces across threads rather than work-stealing. Three, no Arc/Mutex on the hot path: accumulate lock-free per worker and merge once at the join. Four, content-addressed: BLAKE3 prefix-dependent segments, materialize by concatenating pre-serialized bytes and never re-serialize. Five, NaN/Inf discipline: every value crossing a serialization boundary is finite or explicitly absent, and the cellular wire uses MessagePack for NaN-sparsity. Six, redaction at the boundary: every diagnostic is credential-scrubbed before stdout, secrets never enter DTOs and zeroize on drop. And one product entry path — Python projects exactly one side-effect-free protocol-v2 request; the runner fails closed on any unregistered id."
    caption: "Six invariants from the source · one fail-closed product entry path."
    render: @scene {
      sdk.Title(id = "inv-title", text = "Cross-cutting invariants", x = 106.8, y = 48.6, width = 1728, height = 75.6, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "inv-sub", text = "From the source, not the docs — the rules every subsystem holds to", x = 106.8, y = 135, width = 1728, height = 54, inkRole = theme(ink.secondary))
      sdk.Label(id = "inv-h1", text = "01 · All time via Clock", x = 106.8, y = 226.8, width = 810, height = 48.6, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "inv-d1", text = "No Instant::now / raw tokio timers;\nvirtual time = integer ns, (at_ns, seq_no) tie-break", x = 106.8, y = 280.8, width = 810, height = 162, inkRole = theme(ink.secondary))
      sdk.Label(id = "inv-h2", text = "02 · Thread-per-core", x = 976.2, y = 226.8, width = 864, height = 48.6, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "inv-d2", text = "N current_thread runtimes; Rc/RefCell !Send\nper-trace state; many traces, not work-stealing", x = 976.2, y = 280.8, width = 864, height = 162, inkRole = theme(ink.secondary))
      sdk.Label(id = "inv-h3", text = "03 · No Arc/Mutex hot-path", x = 106.8, y = 480.6, width = 810, height = 48.6, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "inv-d3", text = "Accumulate lock-free per worker,\nmerge once at the join", x = 106.8, y = 534.6, width = 810, height = 162, inkRole = theme(ink.secondary))
      sdk.Label(id = "inv-h4", text = "04 · Content-addressed", x = 976.2, y = 480.6, width = 864, height = 48.6, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "inv-d4", text = "BLAKE3 prefix-dependent segments; materialize\nby concat of pre-serialized bytes, never re-serialize", x = 976.2, y = 534.6, width = 864, height = 162, inkRole = theme(ink.secondary))
      sdk.Label(id = "inv-h5", text = "05 · NaN/Inf discipline", x = 106.8, y = 734.4, width = 810, height = 48.6, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "inv-d5", text = "Finite or explicitly absent at every serialization\nboundary; MessagePack wire for NaN-sparsity", x = 106.8, y = 788.4, width = 810, height = 162, inkRole = theme(ink.secondary))
      sdk.Label(id = "inv-h6", text = "06 · Redaction at boundary", x = 976.2, y = 734.4, width = 864, height = 48.6, inkRole = theme(accent.primary))
      sdk.Paragraph(id = "inv-d6", text = "Diagnostics credential-scrubbed before stdout;\nsecrets never enter DTOs, zeroize on drop", x = 976.2, y = 788.4, width = 864, height = 162, inkRole = theme(ink.secondary))
      sdk.Paragraph(id = "inv-callout", text = "One product entry path — Python projects exactly one side-effect-free protocol-v2 request; the runner fails closed on any unregistered id.", x = 106.8, y = 972, width = 1728, height = 86.4, inkRole = theme(ink.primary), strokeRole = theme(ink.primary))
      timeline main {
        at 0 reveal inv-title duration 200
        after inv-title reveal inv-sub duration 160
        after inv-sub stagger targets [inv-h1, inv-h2, inv-h3, inv-h4, inv-h5, inv-h6] step 70 duration 130
        after inv-h6 stagger targets [inv-d1, inv-d2, inv-d3, inv-d4, inv-d5, inv-d6] step 40 duration 100
        after inv-d6 reveal inv-callout duration 200
      }
    }
  }

  slide "System map" {
    eyebrow: "THE WHOLE SYSTEM ON ONE SLIDE"
    title: "The whole system on one slide"
    lede: "Eighteen subsystems, two seams, one product path."
    narration: "The whole system on one slide: eighteen subsystems, two seams, one product path. A — the process boundary and protocol v2. B — input resolution. C — execution paths. D — HTTP transport. E — gRPC transport. F — endpoints. G — the dataset pipeline. H — the RNG substrate. I — timing and scheduling. J — the Graph-IR engine. K — metrics core. L — reporting and export. M — adaptive scale. N — accuracy. O — side-channel telemetry. P — cellular multi-process. Q — dynosim co-simulation. R — the mock server."
    caption: "Eighteen subsystems A–R · two seams · one product path."
    render: @scene {
      sdk.Title(id = "map-title", text = "The whole system on one slide", x = 106.8, y = 54, width = 1728, height = 81, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "map-sub", text = "Eighteen subsystems, two seams, one product path", x = 106.8, y = 151.2, width = 1728, height = 54, inkRole = theme(ink.secondary))
      // The HTML source is a flat 6-column grid of lettered cards with no
      // connectors between them — not a networked diagram — so this maps to
      // three non-wrapping sdk.TagList lanes rather than sdk.ProcessStep/Edge.
      sdk.TagList(id = "map-row-1", items = ["A Process boundary", "B Input resolution", "C Execution paths", "D HTTP transport", "E gRPC transport", "F Endpoints"], gap = 21.6, x = 106.8, y = 297, width = 1728, height = 162)
      sdk.TagList(id = "map-row-2", items = ["G Dataset pipeline", "H RNG substrate", "I Timing + sched", "J Graph-IR engine", "K Metrics core", "L Report + export"], gap = 21.6, x = 106.8, y = 513, width = 1728, height = 162)
      sdk.TagList(id = "map-row-3", items = ["M Adaptive scale", "N Accuracy", "O Telemetry", "P Cellular", "Q Dynosim", "R Mock server"], gap = 21.6, x = 106.8, y = 729, width = 1728, height = 162)
      timeline main {
        at 0 reveal map-title duration 200
        after map-title reveal map-sub duration 160
        after map-sub reveal map-row-1 duration 220
        after map-row-1 reveal map-row-2 duration 220
        after map-row-2 reveal map-row-3 duration 220
      }
    }
  }

