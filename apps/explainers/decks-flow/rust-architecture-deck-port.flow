      sdk.Paragraph(id = "rs-b2", text = "Sits beside NumericColumn (NaN = absence) in the same absolute-request-index alignment", x = 987, y = 475.2, width = 864, height = 108, inkRole = theme(ink.secondary))
      sdk.Paragraph(id = "rs-b3", text = "append_store merges worker shards by concatenating buffers and shifting offsets", x = 987, y = 594, width = 864, height = 81, inkRole = theme(ink.secondary))
