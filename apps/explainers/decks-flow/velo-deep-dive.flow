//! Velo deep dive — ten cellular transport mechanisms.
//! Ported from apps/explainers/src/decks/velo-deep-dive/{index.tsx,content.ts,MentalModel.tsx}.

explainer "Velo deep dive" {
  id: "velo-deep-dive"
  route: "/velo-deep-dive"
  topic: "cellular-transport"
  storagePrefix: "velo-deep-dive-explainer"
  classPrefix: "deck-velo-deep"
  eyebrowLabel: "VELO DEEP DIVE"
  startGateTitle: "Velo deep dive"

  hub: {
    title: "cellular transport mechanisms"
    highlight: "Velo deep dive"
    description: "Ten mechanisms behind AIPerf's cellular Velo plane: connection resolve, registration reply, synchronized START, MessagePack, heartbeat, partition shipping, merge, phaser replay, dataset floodgate, and the aggregator tree. Deeper than the beginner SLURM & Velo tour."
  }

  slide "Resolve the controller over Velo" {
    eyebrow: "1 · Connection"
    title: "Resolve the controller over Velo"
    lede: "A cell starts from one known coordinate: a TCP or UDS endpoint. The Velo hello exchange turns that address into routable controller PeerInfo, and the cell registers the peer before any protocol traffic flows."
    narration: "A cell begins from one known coordinate. The Velo hello exchange resolves it into routable controller PeerInfo, and the cell registers that peer before any protocol traffic."
    term: {
      word: "register_peer"
      meaning: "Velo call that records a resolved coordinate as an addressable peer so later unary and active-message calls can route to it."
    }
    points: [
      "SLURM derives the coordinate from `SLURM_*`; Kubernetes from the operator address.",
      "`_hello` establishes the return route before `register_peer(controller)`.",
      "Evidence: `rust/runtime/src/cellular/transport/connect.rs`, `velo_transport.rs`."
    ]
    caption: "endpoint → _hello → register_peer(controller)."

    render: @scene {
      roots: [
        {
          id: "s0-hdr"
          capability: "core.header"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
          accessibility: { label: "CONNECTION RESOLVE" }
          title: "CONNECTION RESOLVE"
          caption: "endpoint → _hello → register_peer(controller)."
        }
        {
          id: "s0-cell"
          capability: "core.panel"
          layout: { x: 40, y: 140, width: 160, height: 80 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "Cell k: known coordinate" }
          title: "Cell k"
          detail: "known coordinate"
        }
        { id: "s0-a1" capability: "core.connector" from: { nodeId: "s0-cell", anchor: "e" } to: { nodeId: "s0-velo", anchor: "w" } style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none" } }
        { id: "s0-hello" capability: "core.text" text: "_hello" layout: { x: 225, y: 152, width: 50, height: 16 } style: { fontSize: 11, fontWeight: "bold", fill: @theme.ink.tertiary, textAnchor: "middle" } }
        {
          id: "s0-velo"
          capability: "core.panel"
          layout: { x: 300, y: 140, width: 170, height: 80 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "Velo transport: resolve PeerInfo" }
          title: "Velo transport"
          detail: "resolve PeerInfo"
        }
        { id: "s0-a2" capability: "core.connector" from: { nodeId: "s0-velo", anchor: "e" } to: { nodeId: "s0-ctrl", anchor: "w" } style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" } }
        {
          id: "s0-ctrl"
          capability: "core.panel"
          layout: { x: 540, y: 140, width: 140, height: 80 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "Controller: register_peer" }
          title: "Controller"
          detail: "register_peer"
        }
        {
          id: "s0-src"
          capability: "core.lane"
          title: "tcp:// · uds:// · SLURM_* · k8s"
          layout: { x: 210, y: 270, width: 280, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
          children: [
            {
              id: "s0-src-detail"
              capability: "core.text"
              text: "coordinate sources"
              layout: { x: 16, y: 36, width: 248, height: 18 }
              style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        }

        {
          id: "s0-motion-sig"
          capability: "motion.signal"
          d: "M110 175 H560"
          style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s0-enter-hdr" at: 0 duration: 260 target: "s0-hdr" action: "enter" }
        { id: "s0-enter-cell" at: 200 duration: 280 target: "s0-cell" action: "enter" }
        { id: "s0-draw-a1" at: 420 duration: 360 target: "s0-a1" action: "draw" }
        { id: "s0-enter-hello" at: 480 duration: 180 target: "s0-hello" action: "enter" }
        { id: "s0-enter-velo" at: 620 duration: 280 target: "s0-velo" action: "enter" }
        { id: "s0-draw-a2" at: 840 duration: 360 target: "s0-a2" action: "draw" }
        { id: "s0-enter-ctrl" at: 1040 duration: 280 target: "s0-ctrl" action: "enter" }
        { id: "s0-enter-src" at: 1280 duration: 260 target: "s0-src" action: "enter" }
        { id: "s0-draw-motion" at: 1600 duration: 700 target: "s0-motion-sig" action: "draw" }
        { id: "s0-emph" at: 2300 duration: 400 target: "s0-ctrl" action: "emphasis" }
      ]
    }
  }

  slide "The controller answers with the run envelope" {
    eyebrow: "2 · Registration"
    title: "The controller answers with the run envelope"
    lede: "Each cell sends a CellRegister carrying its identity. The controller decodes it, registers the cell peer for the return path, looks up the pre-sliced protocol-v2 envelope for that cell id, and returns it inside a RegisterReply alongside the run-wide START handle."
    narration: "Each cell sends a CellRegister. The controller decodes its identity, registers the return route, looks up the pre-sliced protocol-v2 envelope, and replies with it plus the shared START handle."
    term: {
      word: "RegisterReply"
      meaning: "Unary reply carrying the cell's sliced protocol-v2 envelope bytes plus the shared start EventHandle."
    }
    points: [
      "`register_peer(cell)` fixes the controller→cell return route.",
      "`spec_for(cell_id)` is a pure lookup into the pre-partitioned envelopes.",
      "Reply = envelope bytes + start_event EventHandle; identity is `cell_id: u32`."
    ]
    caption: "decode CellRegister → spec_for(cell_id) → RegisterReply."

    render: @scene {
      roots: [
        {
          id: "s1-hdr"
          capability: "core.header"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
          accessibility: { label: "REGISTRATION REPLY" }
          title: "REGISTRATION REPLY"
          caption: "decode CellRegister → spec_for(cell_id) → RegisterReply."
        }
        {
          id: "s1-reg"
          capability: "core.panel"
          layout: { x: 30, y: 150, width: 150, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "CellRegister: cell_id: u32" }
          title: "CellRegister"
          detail: "cell_id: u32"
        }
        { id: "s1-a1" capability: "core.connector" from: { nodeId: "s1-reg", anchor: "e" } to: { nodeId: "s1-peer", anchor: "w" } style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" } }
        {
          id: "s1-peer"
          capability: "core.panel"
          layout: { x: 225, y: 150, width: 150, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "register_peer: return route" }
          title: "register_peer"
          detail: "return route"
        }
        { id: "s1-a2" capability: "core.connector" from: { nodeId: "s1-peer", anchor: "e" } to: { nodeId: "s1-spec", anchor: "w" } style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" } }
        {
          id: "s1-spec"
          capability: "core.panel"
          layout: { x: 420, y: 150, width: 150, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "spec_for(id): pure lookup" }
          title: "spec_for(id)"
          detail: "pure lookup"
        }
        { id: "s1-a3" capability: "core.path" d: "M570 185 H610" style: { stroke: @theme.accent.tertiary, strokeWidth: 2.2, fill: "none" } }
        { id: "s1-a4" capability: "core.connector" from: { nodeId: "s1-spec", anchor: "s" } to: { nodeId: "s1-reply", anchor: "n" } style: { stroke: @theme.accent.tertiary, strokeWidth: 2.2, fill: "none" } }
        {
          id: "s1-reply"
          capability: "core.panel"
          layout: { x: 470, y: 280, width: 200, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "RegisterReply: envelope + start_event" }
          title: "RegisterReply"
          detail: "envelope + start_event"
        }

        {
          id: "s1-motion-sig"
          capability: "motion.signal"
          d: "M110 170 H560"
          style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s1-enter-hdr" at: 0 duration: 260 target: "s1-hdr" action: "enter" }
        { id: "s1-enter-reg" at: 200 duration: 260 target: "s1-reg" action: "enter" }
        { id: "s1-draw-a1" at: 400 duration: 300 target: "s1-a1" action: "draw" }
        { id: "s1-enter-peer" at: 560 duration: 260 target: "s1-peer" action: "enter" }
        { id: "s1-draw-a2" at: 760 duration: 300 target: "s1-a2" action: "draw" }
        { id: "s1-enter-spec" at: 920 duration: 260 target: "s1-spec" action: "enter" }
        { id: "s1-draw-a3" at: 1120 duration: 280 target: "s1-a3" action: "draw" }
        { id: "s1-draw-a4" at: 1240 duration: 300 target: "s1-a4" action: "draw" }
        { id: "s1-enter-reply" at: 1400 duration: 280 target: "s1-reply" action: "enter" }
        { id: "s1-draw-motion" at: 1720 duration: 700 target: "s1-motion-sig" action: "draw" }
        { id: "s1-emph" at: 2420 duration: 400 target: "s1-reply" action: "emphasis" }
      ]
    }
  }

  slide "Asynchronous arrival, one release" {
    eyebrow: "3 · START barrier"
    title: "Asynchronous arrival, one release"
    lede: "Cells register at different times, but synchronized START holds them at a barrier. The Nth registration satisfies the controller's all-registered condition; triggering the shared start event wakes every awaiting cell together, so no cell dispatches early."
    narration: "Cells register asynchronously but wait at the synchronized barrier. The Nth registration releases the controller, and triggering the shared start event wakes every cell together."
    term: {
      word: "all_registered → trigger"
      meaning: "The controller counts registrations and fires the shared start event only when every cell is ready."
    }
    points: [
      "Default START is synchronized; barrier-free and phaser are opt-in policies.",
      "The barrier bounds cross-cell start skew without a shared wall clock.",
      "Evidence: `rust/runtime/src/engine/cellular_controller.rs`."
    ]
    caption: "N registrations → trigger → all awaiters go Ready."

    render: @scene {
      roots: [
        {
          id: "s2-hdr"
          capability: "core.header"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
          accessibility: { label: "SYNCHRONIZED START" }
          title: "SYNCHRONIZED START"
          caption: "N registrations → trigger → all awaiters go Ready."
        }
        {
          id: "s2-c0"
          capability: "core.panel"
          layout: { x: 30, y: 280, width: 80, height: 60 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "c0: register" }
          title: "c0"
          detail: "register"
        }
        {
          id: "s2-c1"
          capability: "core.panel"
          layout: { x: 130, y: 280, width: 80, height: 60 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "c1: register" }
          title: "c1"
          detail: "register"
        }
        {
          id: "s2-c2"
          capability: "core.panel"
          layout: { x: 230, y: 280, width: 80, height: 60 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "c2: register" }
          title: "c2"
          detail: "register"
        }
        {
          id: "s2-c3"
          capability: "core.panel"
          layout: { x: 330, y: 280, width: 80, height: 60 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "c3: register" }
          title: "c3"
          detail: "register"
        }
        { id: "s2-a0" capability: "core.path" d: "M70 280 C70 230 350 220 460 190" style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" } }
        { id: "s2-a1" capability: "core.path" d: "M170 280 C170 230 350 220 460 190" style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" } }
        { id: "s2-a2" capability: "core.path" d: "M270 280 C270 230 350 220 460 190" style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" } }
        { id: "s2-a3" capability: "core.path" d: "M370 280 C370 230 350 220 460 190" style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" } }
        {
          id: "s2-barrier"
          capability: "core.panel"
          layout: { x: 460, y: 150, width: 180, height: 80 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "Barrier: all_registered → trigger" }
          title: "Barrier"
          detail: "all_registered → trigger"
        }
        {
          id: "s2-start"
          capability: "core.panel"
          layout: { x: 210, y: 110, width: 220, height: 54 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "START event: wake all awaiters" }
          title: "START event"
          detail: "wake all awaiters"
        }
        { id: "s2-aw" capability: "core.path" d: "M550 150 C520 120 470 130 430 137" style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" } }

        {
          id: "s2-motion-sig"
          capability: "motion.signal"
          d: "M350 300 V150"
          style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s2-enter-hdr" at: 0 duration: 260 target: "s2-hdr" action: "enter" }
        { id: "s2-enter-c0" at: 200 duration: 220 target: "s2-c0" action: "stagger" targets: ["s2-c0", "s2-c1", "s2-c2", "s2-c3"] step: 100 }
        { id: "s2-draw-a0" at: 620 duration: 360 target: "s2-a0" action: "draw" }
        { id: "s2-draw-a1" at: 740 duration: 360 target: "s2-a1" action: "draw" }
        { id: "s2-draw-a2" at: 860 duration: 360 target: "s2-a2" action: "draw" }
        { id: "s2-draw-a3" at: 980 duration: 360 target: "s2-a3" action: "draw" }
        { id: "s2-enter-barrier" at: 1100 duration: 280 target: "s2-barrier" action: "enter" }
        { id: "s2-draw-aw" at: 1320 duration: 320 target: "s2-aw" action: "draw" }
