          title: "to_vec"
          detail: "rmp_serde"
        }
        { id: "s3-a2" capability: "core.connector" from: { nodeId: "s3-vec", anchor: "e" } to: { nodeId: "s3-raw", anchor: "w" } style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none" } }
        {
          id: "s3-raw"
          capability: "core.panel"
          layout: { x: 400, y: 150, width: 130, height: 80 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.8, radius: 10 }
          accessibility: { label: "raw bytes: Velo payload" }
          title: "raw bytes"
          detail: "Velo payload"
        }
        { id: "s3-a3" capability: "core.path" d: "M530 190 H575" style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none" } }
        { id: "s3-a4" capability: "core.connector" from: { nodeId: "s3-raw", anchor: "s" } to: { nodeId: "s3-from", anchor: "n" } style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none" } }
        {
          id: "s3-from"
