        { id: "s3-enter-msg" at: 200 duration: 260 target: "s3-msg" action: "enter" }
        { id: "s3-draw-a1" at: 400 duration: 300 target: "s3-a1" action: "draw" }
        { id: "s3-enter-vec" at: 560 duration: 260 target: "s3-vec" action: "enter" }
