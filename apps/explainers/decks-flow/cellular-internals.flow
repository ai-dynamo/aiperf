//! Cellular internals explainer — launch · distribute · execute · reduce · scale.
//! Ported from apps/explainers/src/decks/cellular-internals/{index.tsx,content.ts,MentalModel.tsx}.

explainer "Cellular internals" {
  id: "cellular-internals"
  route: "/cellular-internals"
  topic: "cellular-runtime"
  storagePrefix: "cellular-internals-explainer"
  classPrefix: "deck-cellular"
  eyebrowLabel: "CELLULAR INTERNALS"
  startGateTitle: "Cellular internals"

  hub: {
    highlight: "Cellular internals"
    title: "launch · distribute · execute · reduce · scale"
    description: "Twenty-slide walkthrough of AIPerf's cellular runtime in five chapters: promotion and validation, deterministic distribution, autonomous execution, retain/fold/sketch reduction, and flat controller merge to one report. Hierarchy requests are refused before startup."
  }

  slide "One run, many cells, one report" {
    eyebrow: "Launch · 1 of 20"
    title: "One run, many cells, one report"
    lede: "Cellular scale keeps a single benchmark identity while autonomous processes share the work. Scaling changes placement, not the measurement contract: the authored run, the cells, and the one authoritative report frame everything that follows."
    narration: "Cellular scale keeps one benchmark identity while autonomous processes share the work. Scaling changes placement, not the measurement contract: one authored run, many cells, one report."
    term: {
      word: "run_cellular"
      meaning: "Controller entry that partitions one authored run across cell processes and merges their results into one report."
    }
    points: [
      "Invariant: scaling changes placement, not the measurement contract.",
      "Meet the authored run, an autonomous cell, and the final report.",
      "Evidence: `rust/runtime/src/engine/cellular_controller.rs`."
    ]
    caption: "authored run → many cells → one report."

    render: @scene {
      sdk.Header(id = "hdr0", title = "LAUNCH · ONE RUN, MANY CELLS", caption = "authored run → many cells → one report.", x = 63.6, y = 43.2, width = 1792.8, height = 118.8)
      sdk.Stepper(id = "phase0", steps = ["CONTROL", "EXECUTE", "RESULTS"], linked = true, x = 123, y = 232.2, width = 756, height = 70.2, gap = 27)
      sdk.Rail(id = "tags0", x = 933, y = 237.6, width = 920, height = 75, direction = "row", gap = 27) {
        children {
          sdk.Chip(id = "chip0a", label = "one identity", surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.primary")
          sdk.Chip(id = "chip0b", label = "autonomous", surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.secondary")
          sdk.Chip(id = "chip0c", label = "authoritative", surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.tertiary")
        }
      }
      sdk.Card(id = "authored", title = "Authored run", detail = "one identity", subtitle = "Config v2 request", x = 123, y = 378, width = 432, height = 243, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "cell-k", title = "Cell k / N", detail = "autonomous", subtitle = "own runtime", x = 771, y = 378, width = 405, height = 243, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "report", title = "One report", detail = "authoritative", subtitle = "merged result", x = 1392, y = 378, width = 405, height = 243, strokeRole = "@theme.accent.tertiary")
      sdk.Edge(id = "a0a", mode = "connector", from = { nodeId: "authored", anchor: "e" }, to = { nodeId: "cell-k", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 5.94 })
      sdk.Edge(id = "a0b", mode = "connector", from = { nodeId: "cell-k", anchor: "e" }, to = { nodeId: "report", anchor: "w" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 5.94 })
      sdk.Label(id = "note0", text = "placement changes · measurement contract does not", x = 339, y = 810, width = 1350, height = 54, fontSize = 32.4, align = "start")
      sdk.Label(id = "ev0", text = "cellular_controller.rs", x = 1311, y = 891, width = 486, height = 54, fontSize = 27, align = "end")
      timeline primary {
        at 0 reveal hdr0 duration 260
        after hdr0 reveal phase0 duration 260
        after phase0 reveal tags0 duration 260
        after tags0 reveal authored duration 260
        after authored reveal cell-k duration 260
        after cell-k trace a0a duration 420
        after a0a reveal report duration 260
        after report reveal note0 duration 260
        after report trace a0b duration 420
        after a0b reveal ev0 duration 260
      }
    }
  }

  slide "Author the Config v2 run" {
    eyebrow: "Launch · 2 of 20"
    title: "Author the Config v2 run"
    lede: "The human-facing command resolves exactly one strict benchmark request before any child process exists. Every cell later derives from that same resolved request, so there is a single authored source of truth."
    narration: "The human-facing command resolves exactly one strict benchmark request before any child exists. Every cell later derives from that same resolved source of truth."
    term: {
      word: "ProfileFlags"
      meaning: "Config v2 CLI surface resolved into one BenchmarkRun before cellular partitioning."
    }
    points: [
      "Every cell derives from the same resolved request.",
      "Resolution happens once, in the parent, before fan-out.",
      "Evidence: `rust/cli/src/flags.rs`."
    ]
    caption: "one authored Config v2 request · resolved before fan-out."

    render: @scene {
      sdk.Header(id = "hdr1", title = "LAUNCH · CONFIG V2 SOURCE", caption = "one authored Config v2 request · resolved before fan-out.", x = 63.6, y = 43.2, width = 1792.8, height = 118.8)
      sdk.Label(id = "phase1", text = "RESOLVE ONCE · FAN OUT IDENTICALLY", x = 123, y = 210.6, width = 918, height = 54, fontSize = 29.7, align = "start")
      sdk.Card(id = "cfg", title = "Config v2", detail = "ProfileFlags → BenchmarkRun", subtitle = "single source of truth", x = 636, y = 297, width = 648, height = 259.2, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "cell0", title = "cell 0", detail = "same request", subtitle = "slice 0", x = 123, y = 729, width = 391.5, height = 237.6, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "cell1", title = "cell 1", detail = "same request", subtitle = "slice 1", x = 555, y = 729, width = 391.5, height = 237.6, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "cell2", title = "cell 2", detail = "same request", subtitle = "slice 2", x = 987, y = 729, width = 391.5, height = 237.6, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "cell3", title = "cell 3", detail = "same request", subtitle = "slice 3", x = 1419, y = 729, width = 391.5, height = 237.6, strokeRole = "@theme.accent.secondary")
      sdk.FanOut(id = "config-fan", from = { nodeId: "cfg", anchor: "s" }, to = [{ nodeId: "cell0", anchor: "n" }, { nodeId: "cell1", anchor: "n" }, { nodeId: "cell2", anchor: "n" }, { nodeId: "cell3", anchor: "n" }], axis = "y", junction = { x: 350, y: 238 }, style = { stroke: "@theme.accent.primary", strokeWidth: 5.94 })
      sdk.Label(id = "ev1", text = "flags.rs · resolve before children", x = 123, y = 972, width = 810, height = 54, fontSize = 27, align = "start")
      timeline primary {
        at 0 reveal hdr1 duration 260
        after hdr1 reveal phase1 duration 260
        after phase1 reveal cfg duration 260
        after cfg reveal cell0 duration 260
        after cell0 reveal cell1 duration 260
        after cell1 reveal cell2 duration 260
        after cell2 reveal cell3 duration 260
        after cell3 trace config-fan duration 420
        after config-fan reveal ev1 duration 260
      }
    }
  }

  slide "Re-exec the unified binary" {
    eyebrow: "Launch · 3 of 20"
    title: "Re-exec the unified binary"
    lede: "The entry point launches the same aiperf image in a hidden execution mode over stdio. Process isolation is achieved without a second product executable: the protocol-v2 self-exec boundary is the only handoff."
    narration: "The entry point launches the same aiperf image in a hidden execution mode over stdio. Process isolation is achieved through the protocol-v2 self-exec boundary, not a second executable."
    term: {
      word: "exec_bin::resolve"
      meaning: "Resolves current_exe() so the parent can spawn itself as the protocol-v2 --execute child."
    }
    points: [
      "Process isolation survives without a second product executable.",
      "The child receives one protocol-v2 envelope on stdin.",
      "Evidence: `rust/cli/src/exec_bin.rs`, `execute_mode.rs`."
    ]
    caption: "self-exec --execute · protocol-v2 boundary."

    render: @scene {
      sdk.Header(id = "hdr2", title = "LAUNCH · SELF-EXEC BOUNDARY", caption = "self-exec --execute · protocol-v2 boundary.", x = 63.6, y = 43.2, width = 1792.8, height = 118.8)
      sdk.Label(id = "phase2", text = "PARENT SHELL → SELF-EXEC CHILD", x = 123, y = 210.6, width = 810, height = 54, fontSize = 29.7, align = "start")
      sdk.Chip(id = "chip2", label = "protocol-v2", x = 1419, y = 237.6, width = 378, height = 64.8, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "profile", title = "profile", detail = "parent shell", subtitle = "CLI entry", x = 96, y = 378, width = 378, height = 243, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "execbin", title = "exec_bin", detail = "current_exe()", subtitle = "same image", x = 609, y = 378, width = 378, height = 243, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "execute", title = "--execute", detail = "protocol-v2 child", subtitle = "hidden mode", x = 1122, y = 378, width = 405, height = 243, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "stdio", title = "stdin: one envelope", detail = "stdout: one terminal", subtitle = "stdio handoff", x = 636, y = 756, width = 594, height = 237.6, strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a2a", mode = "connector", from = { nodeId: "profile", anchor: "e" }, to = { nodeId: "execbin", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 5.94 })
      sdk.Edge(id = "a2b", mode = "connector", from = { nodeId: "execbin", anchor: "e" }, to = { nodeId: "execute", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 5.94 })
      sdk.Edge(id = "a2c", mode = "route", from = { nodeId: "execute", anchor: "s" }, to = { nodeId: "stdio", anchor: "n" }, style = { stroke: "@theme.accent.primary", strokeWidth: 5.94 })
      timeline primary {
        at 0 reveal hdr2 duration 260
        after hdr2 reveal phase2 duration 260
        after phase2 reveal chip2 duration 260
        after chip2 reveal profile duration 260
        after profile reveal execbin duration 260
        after execbin trace a2a duration 420
        after a2a reveal execute duration 260
        after execute trace a2b duration 420
        after a2b reveal stdio duration 260
        after stdio trace a2c duration 420
      }
    }
  }

  slide "Promote to controller at cells > 1" {
    eyebrow: "Launch · 4 of 20"
    title: "Promote to controller at cells > 1"
    lede: "Single-cell execution stays direct. Multi-cell execution promotes one process into a coordinator that partitions and launches, but never dispatches inference load itself. Native Kubernetes roles reuse the same entry points."
    narration: "Single-cell execution stays direct. At more than one cell, one process is promoted to a coordinator that partitions and launches but never dispatches inference load itself."
    term: {
      word: "controller promotion"
      meaning: "At cells > 1 the execute process becomes a coordinator; the controller coordinates, cells dispatch."
    }
    points: [
      "The controller coordinates but does not dispatch inference load.",
      "Native `controller` and `cell` roles run the model; `aggregator` refuses hierarchy.",
      "Evidence: `rust/runtime/src/engine/cellular_controller.rs`."
    ]
    caption: "cells > 1 → promote one coordinator."

    render: @scene {
      sdk.Header(id = "hdr3", title = "LAUNCH · CONTROLLER PROMOTION", caption = "cells > 1 → promote one coordinator.", x = 63.6, y = 43.2, width = 1792.8, height = 118.8)
      sdk.Label(id = "phase3", text = "CELLS > 1 → COORDINATOR ROLE", x = 123, y = 210.6, width = 810, height = 54, fontSize = 29.7, align = "start")
      sdk.Card(id = "exec3", title = "--execute", detail = "cells > 1", subtitle = "promotion gate", x = 96, y = 378, width = 405, height = 243, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "ctrl", title = "Controller", detail = "coordinate · no load", subtitle = "partition + merge", x = 663, y = 378, width = 486, height = 243, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "single", title = "single cell", detail = "stays direct", subtitle = "no promotion", x = 177, y = 729, width = 405, height = 221.4, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "roles", title = "controller / cell", detail = "native K8s roles", subtitle = "aggregator refuses hierarchy", x = 1284, y = 729, width = 594, height = 237.6, strokeRole = "@theme.accent.tertiary")
      sdk.Edge(id = "a3a", mode = "connector", from = { nodeId: "exec3", anchor: "e" }, to = { nodeId: "ctrl", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 5.94 })
      sdk.Edge(id = "a3b", mode = "route", from = { nodeId: "ctrl", anchor: "s" }, to = { nodeId: "roles", anchor: "n" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 5.94 })
      timeline primary {
        at 0 reveal hdr3 duration 260
        after hdr3 reveal phase3 duration 260
        after phase3 reveal exec3 duration 260
        after exec3 reveal ctrl duration 260
        after ctrl reveal single duration 260
        after ctrl trace a3a duration 420
        after a3a reveal roles duration 260
        after roles trace a3b duration 420
      }
    }
  }

  slide "Validate and fail closed" {
    eyebrow: "Launch · 5 of 20"
    title: "Validate and fail closed"
    lede: "Eligibility is checked before cells launch. Unsupported transport, budget, storage, and workload combinations are rejected up front so a distributed run never degrades silently into a partial or incorrect result."
    narration: "Eligibility is checked before cells launch. Unsupported transport, budget, storage, and workload combinations are rejected up front so a run never degrades silently."
    term: {
      word: "validate_cellular_run_shape"
      meaning: "Pre-launch gate that rejects unsupported cellular combinations instead of degrading silently."
    }
    points: [
      "Unsupported combinations never degrade silently.",
      "Scheduled duration and unbounded runs fail closed.",
      "Evidence: `rust/runtime/src/engine/cellular_controller.rs`."
    ]
    caption: "eligibility gate → reject unsupported shapes."

    render: @scene {
      sdk.Header(id = "hdr4", title = "LAUNCH · VALIDATE / FAIL CLOSED", caption = "eligibility gate → reject unsupported shapes.", x = 63.6, y = 43.2, width = 1792.8, height = 118.8)
      sdk.Label(id = "phase4", text = "FAIL CLOSED BEFORE LAUNCH", x = 123, y = 210.6, width = 756, height = 54, fontSize = 29.7, align = "start")
      sdk.Chip(id = "chip4", label = "eligibility gate", x = 1419, y = 237.6, width = 378, height = 64.8, surfaceRole = "@theme.surface.secondary", strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "ctrl4", title = "Controller", detail = "validate_cellular_run_shape", subtitle = "pre-launch", x = 690, y = 283.5, width = 540, height = 237.6, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "rej1", title = "scheduled infinite", detail = "rejected", subtitle = "unbounded", x = 123, y = 702, width = 459, height = 216, strokeRole = "@theme.accent.tertiary")
      sdk.Card(id = "rej2", title = "DynoSim cellular", detail = "rejected", subtitle = "unsupported", x = 717, y = 702, width = 459, height = 216, strokeRole = "@theme.accent.tertiary")
      sdk.Card(id = "ok4", title = "eligible shape", detail = "launch", subtitle = "proceed", x = 1311, y = 702, width = 486, height = 216, strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a4a", mode = "path", from = { nodeId: "ctrl4", anchor: "s" }, to = { nodeId: "rej1", anchor: "n" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 5.94 })
      sdk.Edge(id = "a4b", mode = "path", from = { nodeId: "ctrl4", anchor: "s" }, to = { nodeId: "rej2", anchor: "n" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 5.94 })
      sdk.Edge(id = "a4c", mode = "path", from = { nodeId: "ctrl4", anchor: "s" }, to = { nodeId: "ok4", anchor: "n" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 5.94 })
      timeline primary {
        at 0 reveal hdr4 duration 260
        after hdr4 reveal phase4 duration 260
        after phase4 reveal chip4 duration 260
        after chip4 reveal ctrl4 duration 260
        after ctrl4 reveal rej1 duration 260
        after rej1 trace a4a duration 420
        after a4a reveal rej2 duration 260
        after rej2 trace a4b duration 420
        after a4b reveal ok4 duration 260
        after ok4 trace a4c duration 420
      }
    }
  }

  slide "Slice the global budget" {
    eyebrow: "Distribute · 6 of 20"
    title: "Slice the global budget"
    lede: "Request and conversation budgets divide across cells without overlap or omission. The union of every cell's owned positions exactly tiles the global budget through a deterministic modulo partition and a stable workload source."
    narration: "Request and conversation budgets divide across cells without overlap or omission. The union of every cell's owned positions exactly tiles the global budget by modulo."
    term: {
      word: "owned_positions"
      meaning: "The set i where i % cells == cell_id; cell-owned global positions that tile the budget."
    }
    points: [
      "The union of cell-owned positions exactly tiles the global budget.",
      "`ModuloCellPartition` assigns i % cells == cell_id.",
      "Evidence: `rust/runtime/src/cellular/partition.rs`, `rust/runtime/src/engine/cell_launcher.rs`."
    ]
    caption: "global budget → disjoint modulo tiles."

    render: @scene {
      sdk.Header(id = "hdr5", title = "DISTRIBUTE · MODULO PARTITION", caption = "global budget → disjoint modulo tiles.", x = 63.6, y = 43.2, width = 1792.8, height = 118.8)
      sdk.Label(id = "phase5", text = "DETERMINISTIC OWNERSHIP TILES", x = 123, y = 210.6, width = 810, height = 54, fontSize = 29.7, align = "start")
      sdk.Card(id = "ctrl5", title = "Controller", detail = "global budget", subtitle = "requests 0…N", x = 96, y = 378, width = 405, height = 243, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "mod", title = "ModuloCellPartition", detail = "i % cells == id", subtitle = "no overlap", x = 636, y = 378, width = 432, height = 243, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "own0", title = "cell 0 owns", detail = "i % 3 == 0", subtitle = "disjoint tile", x = 1203, y = 256.5, width = 594, height = 216, strokeRole = "@theme.accent.tertiary")
      sdk.Card(id = "own1", title = "cell 1 owns", detail = "i % 3 == 1", subtitle = "disjoint tile", x = 1203, y = 499.5, width = 594, height = 216, strokeRole = "@theme.accent.tertiary")
      sdk.Card(id = "own2", title = "cell 2 owns", detail = "i % 3 == 2", subtitle = "disjoint tile", x = 1203, y = 742.5, width = 594, height = 216, strokeRole = "@theme.accent.tertiary")
      sdk.Edge(id = "a5a", mode = "connector", from = { nodeId: "ctrl5", anchor: "e" }, to = { nodeId: "mod", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 5.94 })
      sdk.Edge(id = "a5c0", mode = "path", from = { nodeId: "mod", anchor: "e" }, to = { nodeId: "own0", anchor: "w" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 5.94 })
      sdk.Edge(id = "a5c1", mode = "path", from = { nodeId: "mod", anchor: "e" }, to = { nodeId: "own1", anchor: "w" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 5.94 })
      sdk.Edge(id = "a5c2", mode = "path", from = { nodeId: "mod", anchor: "e" }, to = { nodeId: "own2", anchor: "w" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 5.94 })
      timeline primary {
        at 0 reveal hdr5 duration 260
        after hdr5 reveal phase5 duration 260
        after phase5 reveal ctrl5 duration 260
        after ctrl5 reveal mod duration 260
        after mod reveal own0 duration 260
        after mod trace a5a duration 420
        after own0 trace a5c0 duration 420
        after a5c0 reveal own1 duration 260
        after own1 trace a5c1 duration 420
        after a5c1 reveal own2 duration 260
        after own2 trace a5c2 duration 420
      }
    }
  }

  slide "Register, then release START" {
    eyebrow: "Distribute · 7 of 20"
    title: "Register, then release START"
    lede: "Children become ready before the controller releases synchronized execution. No synchronized cell dispatches before the registration barrier opens, so cross-cell start skew is bounded without a shared wall clock."
    narration: "Children become ready before the controller releases synchronized execution. No synchronized cell dispatches before the registration barrier opens."
    term: {
      word: "await_all_registered → trigger"
      meaning: "Default lifecycle gate: the controller triggers the shared start event only once every cell registers."
    }
    points: [
      "No synchronized cell dispatches before the barrier opens.",
      "This is the default START policy.",
      "Evidence: `rust/runtime/src/engine/cellular_controller.rs`."
    ]
    caption: "register all → trigger → synchronized dispatch."

    render: @scene {
      sdk.Header(id = "hdr6", title = "DISTRIBUTE · START BARRIER", caption = "register all → trigger → synchronized dispatch.", x = 63.6, y = 43.2, width = 1792.8, height = 118.8)
      sdk.Label(id = "phase6", text = "REGISTER → AWAIT_ALL → TRIGGER", x = 123, y = 210.6, width = 864, height = 54, fontSize = 29.7, align = "start")
      sdk.Card(id = "c0", title = "c0", detail = "register", subtitle = "ready", x = 96, y = 729, width = 256.5, height = 237.6, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "c1", title = "c1", detail = "register", subtitle = "ready", x = 379.5, y = 729, width = 256.5, height = 237.6, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "c2", title = "c2", detail = "register", subtitle = "ready", x = 663, y = 729, width = 256.5, height = 237.6, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "c3", title = "c3", detail = "register", subtitle = "ready", x = 946.5, y = 729, width = 256.5, height = 237.6, strokeRole = "@theme.accent.secondary")
      sdk.Card(id = "barrier", title = "Barrier", detail = "await_all → trigger", subtitle = "Velo START", x = 1203, y = 391.5, width = 540, height = 243, strokeRole = "@theme.accent.primary")
      sdk.Card(id = "start", title = "START", detail = "synchronized dispatch", subtitle = "release together", x = 555, y = 297, width = 621, height = 237.6, strokeRole = "@theme.accent.tertiary")
      sdk.Edge(id = "a6a0", mode = "path", from = { nodeId: "c0", anchor: "n" }, to = { nodeId: "barrier", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 5.94 })
      sdk.Edge(id = "a6a1", mode = "path", from = { nodeId: "c1", anchor: "n" }, to = { nodeId: "barrier", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 5.94 })
      sdk.Edge(id = "a6a2", mode = "path", from = { nodeId: "c2", anchor: "n" }, to = { nodeId: "barrier", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 5.94 })
      sdk.Edge(id = "a6a3", mode = "path", from = { nodeId: "c3", anchor: "n" }, to = { nodeId: "barrier", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 5.94 })
      sdk.Edge(id = "a6b", mode = "route", from = { nodeId: "barrier", anchor: "n" }, to = { nodeId: "start", anchor: "e" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 5.94 })
      timeline primary {
        at 0 reveal hdr6 duration 260
        after hdr6 reveal phase6 duration 260
        after phase6 reveal c0 duration 260
        after c0 reveal c1 duration 260
        after c1 reveal c2 duration 260
        after c2 reveal c3 duration 260
