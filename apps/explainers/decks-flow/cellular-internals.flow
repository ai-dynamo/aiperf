  slide "The full cellular system atlas" {
    eyebrow: "Scale · 20 of 20"
    title: "The full cellular system atlas"
    lede: "Every plane assembled: control coordination, data distribution, execution, and results reduction. The complete atlas preserves the measurement contract end to end. For the interactive recipe explorer and ability map, open the source canvas."
    narration: "The full atlas assembles the control, data, execution, and results planes in one view. The complete picture preserves the measurement contract; open the source canvas for the interactive explorer."
    term: {
      word: "measurement contract"
      meaning: "The invariant that scaling to many cells never changes what a single-cell run would have measured."
    }
    points: [
      "Control · data · execution · results planes assembled in one view.",
      "The complete atlas preserves the measurement contract.",
      "Full explorer: `docs/canvases/cellular-architecture.canvas.tsx`."
    ]
    caption: "all planes together · one measurement contract."

