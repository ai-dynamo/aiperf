  slide "Offline mode" {
    eyebrow: "Offline mode"
    title: "dynosim_offline owns SimClock"
    lede: "Offline runs use SimClock: integer-nanosecond virtual time with deterministic event ordering. The sim pump advances virtual time until the workload future completes or the source quiesces."

    narration: "Offline dynosim runs on SimClock. Virtual nanoseconds advance under the sim pump until the workload completes."

    term: {
      word: "SimClock"
      meaning: "Virtual Clock implementation; scheduling and measurement must not call wall-clock APIs on hot paths."
    }

    points: [
      "Arrivals, phase gates, and backoff use SimClock timers.",
      "Engine steps consume virtual time, not wall time.",
      "Runs are reproducible when inputs and seeds are fixed."
    ]

    caption: "Deterministic virtual time drives offline replay."

