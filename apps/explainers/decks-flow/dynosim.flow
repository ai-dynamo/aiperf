  slide "Recap" {
    eyebrow: "Recap"
    title: "Offline vs online parity and artifacts"
    lede: "Both modes write native-v2.json through the same Coordinator persist path. Choose offline for deterministic sweeps and co-simulation; choose online when wall-clock fidelity matters. Artifacts and exporters follow the configured BenchmarkRun."

    narration: "Offline dynosim gives deterministic virtual time. Online dynosim keeps wall clocks. Both produce the same native report and configured artifacts through the coordinator."

    term: {
      word: "native-v2.json"
      meaning: "Authoritative merged report before optional exporter fan-out."
    }

    points: [
      "Offline: SimClock + drive_sim_with_source.",
      "Online: RealClock + drive_real_with_source.",
      "Exporters and cellular modes are orthogonal to dynosim choice."
    ]

    caption: "Pick the clock; keep the rest of AIPerf unchanged."

    render: @scene {
      sdk.Header(
        id = "s17-hdr",
        title = "MODE RECAP",
        caption = "Pick the clock; keep the rest of AIPerf unchanged.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s17-off",
        title = "Offline",
        detail = "SimClock",
        x = 60, y = 130, width = 150, height = 96,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s17-a1",
        mode = "connector",
        from = { nodeId: "s17-off", anchor: "e" },
        to = { nodeId: "s17-on", anchor: "w" },
        style = { stroke: theme(accent.primary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "s17-on",
        title = "Online",
        detail = "RealClock",
        x = 275, y = 130, width = 150, height = 96,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
        id = "s17-a2",
        mode = "connector",
        from = { nodeId: "s17-on", anchor: "e" },
        to = { nodeId: "s17-json", anchor: "w" },
        style = { stroke: theme(accent.primary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "s17-json",
        title = "native-v2.json",
        detail = "same persist",
        x = 490, y = 130, width = 150, height = 96,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Signal(
        id = "s17-motion-sig",
        from = { nodeId: "s17-off", anchor: "center" },
        to = { nodeId: "s17-json", anchor: "center" },
        opacity = 0.55,
        strokeWidth = 2.2,
        style = { stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 reveal s17-hdr duration 260
        at 180 reveal s17-off duration 280
        at 420 trace s17-a1 duration 300
        at 560 reveal s17-on duration 280
        at 800 trace s17-a2 duration 300
        at 940 reveal s17-json duration 280
        at 1200 trace s17-motion-sig duration 900
      }
    }
  }
}
