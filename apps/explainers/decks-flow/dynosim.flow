              capability: "core.text"
              text: "Pick the clock; keep the rest of AIPerf unchanged."
              layout: { x: 360, y: 28, width: 300, height: 24 }
              style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "end" }
            }
          ]
        },
{
          id: "s17-off"
          capability: "core.rect"
          layout: { x: 50, y: 120, width: 150, height: 96 }
          style: { fill: @theme.accent.tertiary, stroke: @theme.ink.secondary, strokeWidth: 2 }
          children: [
            {
              id: "s17-off-title"
