  slide "Routing" {
    eyebrow: "Routing"
    title: "Factory bypasses native HTTP execution"
    lede: "At bootstrap, dynosim registers its own ExecutionSinkBuilder. The coordinator never constructs Hyper or Tonic clients for these runs — preparation builds an EngineHost and DynosimSink instead."

    narration: "Registry routing sends dynosim runs down a dedicated factory path. Native HTTP and gRPC clients are never constructed for these transport identifiers."

    term: {
      word: "ExecutionSinkBuilder"
      meaning: "Transport hook that produces worker-local sinks; dynosim's builder wires the replay engine seam."
    }

    points: [
      "Application freeze includes dynosim factories when feature-gated.",
      "Validate rejects dynosim IDs on builds without the feature.",
      "HTTP/gRPC code paths are not entered for dynosim transport IDs."
    ]

    caption: "Transport ID → dynosim factory, not HTTP stack."

    render: @scene {
      roots: [
        {
          id: "s3-hdr"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
          children: [
            {
              id: "s3-hdr-label"
              capability: "core.text"
              text: "REGISTRY ROUTE"
              layout: { x: 38, y: 28, width: 360, height: 24 }
              style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
            },
            {
              id: "s3-hdr-caption"
              capability: "core.text"
              text: "Transport ID → dynosim factory, not HTTP stack."
              layout: { x: 400, y: 28, width: 260, height: 24 }
              style: { fontSize: 11, fill: @theme.ink.secondary }
            }
          ]
        },
        {
          id: "s3-http"
          capability: "core.rect"
          layout: { x: 90, y: 120, width: 180, height: 110 }
          style: { fill: @theme.accent.secondary, stroke: @theme.ink.secondary, strokeWidth: 2 }
          children: [
