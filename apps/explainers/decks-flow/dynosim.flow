explainer "Dynosim" {
  id: "dynosim"
  route: "/dynosim"
  topic: "architecture"
  storagePrefix: "dynosim-explainer"
  classPrefix: "deck-dynosim"
  eyebrowLabel: "DYNOSIM"
  startGateTitle: "Dynosim co-simulation walkthrough"

  hub: {
    title: "offline & online replay"
    highlight: "Dynosim"
    description: "Concise tour of dynosim transports, SimClock vs RealClock, the sim pump, token flow through RequestObserver, and metric parity with HTTP runs."
  }

  slide "Why Dynosim" {
    eyebrow: "Why Dynosim"
    title: "Co-simulation without a live inference server"
    lede: "Dynosim runs AIPerf's full workload loop, observers, and metrics against Dynamo's passive mock engine in-process. No HTTP sockets, no gRPC wire path — the transport ID selects a simulation driver instead."

    narration: "Dynosim lets AIPerf benchmark without a live inference server. The workload loop and observers stay native; Dynamo's passive engine supplies timing and token events in-process."

    term: {
      word: "dynosim"
      meaning: "Feature-gated transport family (`dynosim_offline`, `dynosim_online`) that replaces native HTTP execution with SteppableReplay-driven co-simulation."
    }

    points: [
      "AIPerf owns scheduling, Clock, RequestObserver, and report merge.",
      "Dynamo mocker owns scheduler and performance-model state behind SteppableReplay.",
      "Same metric vocabulary as online runs when configured for parity."
    ]

    caption: "No serving socket on the hot path."

    render: @scene {
      roots: [
        {
          id: "s0-hdr"
          capability: "core.header"
          title: "NO SERVING SOCKET"
          caption: "No serving socket on the hot path."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s0-band"
          capability: "core.band"
          title: "in-process hot path"
          layout: { x: 60, y: 100, width: 580, height: 140 }
          style: { fill: @theme.surface.secondary, opacity: 0.55 }
        },
        {
          id: "s0-modes"
          capability: "layout.rail"
          layout: { x: 80, y: 78, width: 540, height: 22 }
          style: { direction: "row", gap: 16 }
          children: [
            {
              id: "s0-chip-off"
              capability: "core.chip"
              text: "offline"
              layout: { x: 0, y: 0, width: 100, height: 22 }
              style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.1 }
            },
            {
              id: "s0-chip-on"
              capability: "core.chip"
              text: "online"
              layout: { x: 0, y: 0, width: 100, height: 22 }
              style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.1 }
            },
            {
              id: "s0-chip-sim"
              capability: "core.chip"
              text: "SimClock"
              layout: { x: 0, y: 0, width: 100, height: 22 }
              style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.1 }
            }
          ]
        },
        {
          id: "s0-aiperf"
          capability: "core.panel"
          title: "AIPerf workload"
          detail: "schedule + observe"
          layout: { x: 80, y: 130, width: 160, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s0-a1"
          capability: "core.connector"
          from: { nodeId: "s0-aiperf", anchor: "e" }
          to: { nodeId: "s0-sink", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s0-sink"
          capability: "core.panel"
          title: "DynosimSink"
          detail: "in-process"
          layout: { x: 280, y: 130, width: 160, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s0-a2"
          capability: "core.route"
          from: { nodeId: "s0-sink", anchor: "e" }
          to: { nodeId: "s0-replay", anchor: "w" }
          style: { stroke: @theme.accent.tertiary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s0-replay"
          capability: "core.panel"
          title: "SteppableReplay"
          detail: "Dynamo mocker"
          layout: { x: 480, y: 130, width: 140, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
        },
                {
          id: "s0-divider"
          capability: "core.divider"
          layout: { x: 80, y: 250, width: 540, height: 2 }
          axis: "x"
          style: { stroke: @theme.ink.tertiary, strokeWidth: 1.2, fill: "none", markerEnd: "none" }
          accessibility: { label: "note divider" }
        },
        {
          id: "s0-callout"
          capability: "core.callout"
          text: "no socket I/O"
          layout: { x: 300, y: 70, width: 110, height: 22 }
          target: { x: 355, y: 130 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1 }
        },
        {
          id: "s0-note"
          capability: "core.note"
          caption: "HTTP/gRPC socket omitted on the hot path"
          layout: { x: 80, y: 280, width: 540, height: 28 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 6 }
        },
        {
          id: "s0-motion-sig"
          capability: "motion.signal"
          from: { nodeId: "s0-aiperf", anchor: "e" }
          to: { nodeId: "s0-replay", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s0-enter-hdr", at: 0, duration: 260, target: "s0-hdr", action: "enter" },
        { id: "s0-enter-band", at: 80, duration: 200, target: "s0-band", action: "enter" },
        { id: "s0-enter-modes", at: 120, duration: 200, action: "stagger", targets: ["s0-chip-off", "s0-chip-on", "s0-chip-sim"], step: 60 },
        { id: "s0-enter-aiperf", at: 180, duration: 280, target: "s0-aiperf", action: "enter" },
        { id: "s0-draw-a1", at: 420, duration: 320, target: "s0-a1", action: "draw" },
        { id: "s0-enter-sink", at: 560, duration: 280, target: "s0-sink", action: "enter" },
        { id: "s0-draw-a2", at: 780, duration: 320, target: "s0-a2", action: "draw" },
        { id: "s0-enter-replay", at: 920, duration: 280, target: "s0-replay", action: "enter" },
        { id: "s0-enter-divider", at: 1100, duration: 200, target: "s0-divider", action: "draw" },
        { id: "s0-enter-callout", at: 1140, duration: 200, target: "s0-callout", action: "enter" },
        { id: "s0-enter-note", at: 1180, duration: 280, target: "s0-note", action: "enter" },
        { id: "s0-draw-motion", at: 1400, duration: 900, target: "s0-motion-sig", action: "draw" },
        { id: "s0-emph", at: 2200, duration: 400, target: "s0-sink", action: "emphasis" }
      ]
    }
  }

  slide "Feature gate" {
    eyebrow: "Feature gate"
    title: "Cargo feature dynosim pulls the native crates"
    lede: "Ordinary lean HTTP builds omit dynosim entirely. Enabling the `dynosim` feature links dynamo-mocker and exposes transport IDs `dynosim_offline` and `dynosim_online` in the frozen registry."

    narration: "Dynosim is behind the dynosim Cargo feature. When enabled, the registry exposes dynosim offline and online transport identifiers alongside HTTP and gRPC."

    term: {
      word: "transport ID"
      meaning: "Config v2 transport.type string resolved at Application bootstrap; unknown IDs fail closed."
    }

    points: [
      "`cargo build -p aiperf-cli --features dynosim` enables the path.",
      "Registry registers dynosim transports only when the feature is on.",
      "Missing feature → unknown transport at validate time."
    ]

    caption: "Opt-in at compile time, selected at config time."

    render: @scene {
      roots: [
        {
          id: "s1-hdr"
          capability: "core.header"
          title: "FEATURE GATE"
          caption: "Opt-in at compile time, selected at config time."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s1-feat"
          capability: "core.panel"
          title: "Cargo feature"
          detail: "dynosim"
          layout: { x: 120, y: 120, width: 200, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s1-a1"
          capability: "core.connector"
          from: { nodeId: "s1-feat", anchor: "e" }
          to: { nodeId: "s1-ids", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s1-ids"
          capability: "core.panel"
          title: "Registry IDs"
          detail: "offline · online"
          layout: { x: 380, y: 120, width: 200, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s1-motion-sig"
          capability: "motion.signal"
          from: { nodeId: "s1-feat", anchor: "e" }
          to: { nodeId: "s1-ids", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s1-enter-hdr", at: 0, duration: 260, target: "s1-hdr", action: "enter" },
        { id: "s1-enter-feat", at: 180, duration: 280, target: "s1-feat", action: "enter" },
        { id: "s1-draw-a1", at: 420, duration: 320, target: "s1-a1", action: "draw" },
        { id: "s1-enter-ids", at: 560, duration: 280, target: "s1-ids", action: "enter" },
        { id: "s1-draw-motion", at: 900, duration: 900, target: "s1-motion-sig", action: "draw" },
        { id: "s1-emph", at: 1700, duration: 400, target: "s1-ids", action: "emphasis" }
      ]
    }
  }

  slide "Config seam" {
    eyebrow: "Config seam"
    title: "One BenchmarkRun; transport selects the clock"
    lede: "The same Config v2 envelope describes workload, endpoints, and artifacts. Changing transport.type from http to dynosim_offline swaps the execution driver and clock implementation without rewriting the benchmark plan."

    narration: "You author one benchmark configuration. The transport field chooses offline simulation with a virtual clock, or online replay against wall time."

    term: {
      word: "BenchmarkRun"
      meaning: "Strict protocol-v2 object materialized by profile and passed to the execution child."
    }

    points: [
      "Workload, phases, and artifact settings stay shared.",
      "`dynosim_offline` → SimClock + virtual pump.",
      "`dynosim_online` → RealClock + wall-time replay."
    ]

    caption: "Config is shared; transport picks real vs. virtual time."

    render: @scene {
      roots: [
        {
          id: "s2-hdr"
          capability: "core.header"
          title: "TRANSPORT → CLOCK"
          caption: "Config is shared; transport picks real vs. virtual time."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s2-run"
          capability: "core.panel"
          title: "BenchmarkRun"
          detail: "Config v2"
          layout: { x: 60, y: 130, width: 150, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1.3, radius: 10 }
        },
        {
          id: "s2-a1"
          capability: "core.connector"
          from: { nodeId: "s2-run", anchor: "e" }
          to: { nodeId: "s2-tr", anchor: "w" }
          style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s2-tr"
          capability: "core.panel"
          title: "transport.type"
          detail: "selects driver"
          layout: { x: 260, y: 130, width: 180, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s2-a2"
          capability: "core.connector"
          from: { nodeId: "s2-tr", anchor: "e" }
          to: { nodeId: "s2-clk", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s2-clk"
          capability: "core.panel"
          title: "Clock"
          detail: "Sim or Real"
          layout: { x: 490, y: 130, width: 150, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s2-motion-sig"
          capability: "motion.signal"
          from: { nodeId: "s2-run", anchor: "e" }
          to: { nodeId: "s2-clk", anchor: "w" }
          style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s2-enter-hdr", at: 0, duration: 260, target: "s2-hdr", action: "enter" },
        { id: "s2-enter-run", at: 180, duration: 280, target: "s2-run", action: "enter" },
        { id: "s2-draw-a1", at: 420, duration: 300, target: "s2-a1", action: "draw" },
        { id: "s2-enter-tr", at: 560, duration: 280, target: "s2-tr", action: "enter" },
        { id: "s2-draw-a2", at: 800, duration: 300, target: "s2-a2", action: "draw" },
        { id: "s2-enter-clk", at: 940, duration: 280, target: "s2-clk", action: "enter" },
        { id: "s2-draw-motion", at: 1200, duration: 900, target: "s2-motion-sig", action: "draw" },
        { id: "s2-emph", at: 2000, duration: 400, target: "s2-tr", action: "emphasis" }
      ]
    }
  }

  slide "Routing" {
    eyebrow: "Routing"
    title: "Factory bypasses native HTTP execution"
    lede: "At bootstrap, dynosim registers its own TransportFactory but opts out of native_execution, returning None instead of an ExecutionSinkBuilder. The coordinator never constructs Hyper or Tonic clients for these runs — preparation builds an EngineHost and DynosimSink instead."

    narration: "Registry routing sends dynosim runs down a dedicated factory path that bypasses the shared ExecutionSinkBuilder seam entirely. Native HTTP and gRPC clients are never constructed for these transport identifiers."

    term: {
      word: "TransportFactory::native_execution"
      meaning: "Registry hook returning an optional native execution binding; dynosim returns None and is prepared through its own module instead of the shared ExecutionSinkBuilder/WorkerSink path."
    }

    points: [
      "Application freeze includes dynosim factories when feature-gated.",
      "Validate rejects dynosim IDs on builds without the feature.",
      "HTTP/gRPC code paths are not entered for dynosim transport IDs."
    ]

    caption: "Transport ID → dynosim factory, not HTTP stack."

    render: @scene {
      roots: [
        {
          id: "s3-hdr"
          capability: "core.header"
          title: "REGISTRY ROUTE"
          caption: "Transport ID → dynosim factory, not HTTP stack."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s3-http"
          capability: "core.panel"
          title: "HTTP factory"
          detail: "not used"
          layout: { x: 90, y: 120, width: 180, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1.3, radius: 10 }
        },
        {
          id: "s3-dyno"
          capability: "core.panel"
          title: "Dynosim factory"
          detail: "own module"
          layout: { x: 430, y: 120, width: 180, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s3-note"
          capability: "core.note"
          caption: "transport ID routes before Hyper/Tonic clients build"
          layout: { x: 80, y: 280, width: 540, height: 28 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 6 }
        },
        {
          id: "s3-motion-sig"
          capability: "motion.signal"
          from: { nodeId: "s3-http", anchor: "center" }
          to: { nodeId: "s3-dyno", anchor: "center" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s3-enter", at: 0, duration: 280, target: "s3-hdr", action: "stagger", targets: ["s3-hdr", "s3-http", "s3-dyno", "s3-note"], step: 220 },
        { id: "s3-draw-motion", at: 1000, duration: 900, target: "s3-motion-sig", action: "draw" },
        { id: "s3-emph", at: 1800, duration: 400, target: "s3-dyno", action: "emphasis" }
      ]
    }
  }

  slide "Composition" {
    eyebrow: "Composition"
    title: "EngineHost + DynosimSink share one observer seam"
    lede: "DynosimSink implements RequestSink and forwards token, usage, and terminal events into the same RequestObserver pipeline HTTP uses. EngineHost wraps SteppableReplay and bridges DirectRequest submission."

    narration: "EngineHost wraps the replay engine. DynosimSink implements the same RequestSink and RequestObserver contract as HTTP transports."

    term: {
      word: "DynosimSink"
      meaning: "Worker-local sink that drives replay turns through loadgen-core observation without wire encoding."
    }

    points: [
      "RequestObserver callbacks match online semantics.",
      "TTFT is the first token observation — no separate first-token event.",
      "Terminal coalescing policy matches configured streaming mode."
    ]

    caption: "Same observation vocabulary, different dispatch backend."

    render: @scene {
      roots: [
        {
          id: "s4-hdr"
          capability: "core.header"
          title: "HOST + SINK"
          caption: "Same observation vocabulary, different dispatch backend."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s4-host"
          capability: "core.panel"
          title: "EngineHost"
          detail: "SteppableReplay"
          layout: { x: 70, y: 130, width: 150, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s4-a1"
          capability: "core.connector"
          from: { nodeId: "s4-host", anchor: "e" }
          to: { nodeId: "s4-sink", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s4-sink"
          capability: "core.panel"
          title: "DynosimSink"
          detail: "RequestSink"
          layout: { x: 270, y: 130, width: 150, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s4-a2"
          capability: "core.connector"
          from: { nodeId: "s4-sink", anchor: "e" }
          to: { nodeId: "s4-obs", anchor: "w" }
          style: { stroke: @theme.accent.secondary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s4-obs"
          capability: "core.panel"
          title: "RequestObserver"
          detail: "metrics"
          layout: { x: 470, y: 130, width: 160, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s4-motion-sig"
          capability: "motion.signal"
          from: { nodeId: "s4-host", anchor: "center" }
          to: { nodeId: "s4-obs", anchor: "center" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "s4-enter-hdr", at: 0, duration: 260, target: "s4-hdr", action: "enter" },
        { id: "s4-enter-host", at: 180, duration: 280, target: "s4-host", action: "enter" },
        { id: "s4-draw-a1", at: 420, duration: 300, target: "s4-a1", action: "draw" },
        { id: "s4-enter-sink", at: 560, duration: 280, target: "s4-sink", action: "enter" },
        { id: "s4-draw-a2", at: 800, duration: 300, target: "s4-a2", action: "draw" },
        { id: "s4-enter-obs", at: 940, duration: 280, target: "s4-obs", action: "enter" },
        { id: "s4-draw-motion", at: 1200, duration: 900, target: "s4-motion-sig", action: "draw" },
        { id: "s4-emph", at: 2000, duration: 400, target: "s4-sink", action: "emphasis" }
      ]
    }
  }

  slide "Offline mode" {
    eyebrow: "Offline mode"
    title: "dynosim_offline owns SimClock"
    lede: "Offline runs use SimClock: integer-nanosecond virtual time with deterministic event ordering. The sim pump advances virtual time until the workload future completes or the source quiesces."

    narration: "Offline dynosim runs on SimClock. Virtual nanoseconds advance under the sim pump until the workload completes."

    term: {
      word: "SimClock"
      meaning: "Virtual Clock implementation; scheduling and measurement must not call wall-clock APIs on hot paths."
    }

    points: [
      "Arrivals, phase gates, and backoff use SimClock timers.",
      "Engine steps consume virtual time, not wall time.",
      "Runs are reproducible when inputs and seeds are fixed."
    ]

    caption: "Deterministic virtual time drives offline replay."

    render: @scene {
      roots: [
        {
          id: "s5-hdr"
          capability: "core.header"
          title: "OFFLINE · SIMCLOCK"
          caption: "Deterministic virtual time drives offline replay."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s5-off"
          capability: "core.panel"
          title: "dynosim_offline"
          detail: "SimClock"
          layout: { x: 250, y: 100, width: 200, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.tertiary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s5-a1"
          capability: "core.connector"
          from: { nodeId: "s5-off", anchor: "s" }
          to: { nodeId: "s5-drive", anchor: "n" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s5-drive"
          capability: "core.panel"
          title: "drive_sim_with_source"
          detail: "virtual pump"
          layout: { x: 250, y: 250, width: 200, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s5-motion-sig"
          capability: "motion.signal"
          from: { nodeId: "s5-off", anchor: "center" }
          to: { nodeId: "s5-drive", anchor: "center" }
