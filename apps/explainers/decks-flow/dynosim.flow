        opacity = 0.55,
        strokeWidth = 2.2,
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal s5-hdr duration 260
        at 180 reveal s5-off duration 280
        at 420 trace s5-a1 duration 320
        at 560 reveal s5-drive duration 280
        at 900 trace s5-motion-sig duration 900
      }
    }
  }

  slide "Online mode" {
    eyebrow: "Online mode"
    title: "dynosim_online keeps RealClock"
    lede: "Online replay still uses SteppableReplay but drives it with RealClock — wall time between engine steps. This validates live integration paths while preserving the same observer and metric merge logic."

    narration: "Online dynosim uses RealClock. The same replay engine runs, but virtual scheduling gives way to wall-clock pacing."

    term: {
      word: "RealClock"
      meaning: "Wall-time Clock used for HTTP, gRPC, and dynosim_online execution."
    }

    points: [
      "drive_real_with_source is the wall-clock twin of drive_sim_with_source.",
      "Useful when timing must reflect actual scheduler latency.",
      "Metric merge and artifacts follow the same coordinator path."
    ]

    caption: "Same engine contract; clock switches to wall time."

    render: @scene {
      sdk.Header(
        id = "s6-hdr",
        title = "ONLINE · REALCLOCK",
        caption = "Same engine contract; clock switches to wall time.",
