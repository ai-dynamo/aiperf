  slide "Clock compare" {
    eyebrow: "Clock compare"
    title: "RealClock vs SimClock semantics"
    lede: "Both implement Clock::now_ns and timer registration. SimClock advances only when the driver pumps; RealClock tracks system time. Measurement code must route through Clock in both modes."

    narration: "RealClock tracks wall time. SimClock advances only when the driver pumps events. All measurement must go through the Clock abstraction in both modes."

    term: {
      word: "Clock::is_virtual"
      meaning: "Runtime selector between real-reactor and simulation drivers; hot paths branch on virtual vs. real timers."
    }

    points: [
      "Never call Instant::now on request hot paths.",
      "SimClock tie-breaks favor scheduled arrivals before engine passes at equal t.",
      "RealClock online runs behave like ordinary profile executions."
    ]

    caption: "One Clock trait; two time domains."

    render: @scene {
      sdk.Header(
        id = "s7-hdr",
        title = "CLOCK COMPARE",
        caption = "One Clock trait; two time domains.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s7-real",
        title = "RealClock",
        detail = "wall nanoseconds",
        x = 100, y = 130, width = 200, height = 96,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s7-sim",
        title = "SimClock",
        detail = "virtual nanoseconds",
        x = 400, y = 130, width = 200, height = 96,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Note(
        id = "s7-note",
        text = "Clock::is_virtual() selects reactor vs. simulation driver",
        x = 80, y = 280, width = 540, height = 28,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )
      sdk.Signal(
        id = "s7-motion-sig",
        from = { nodeId: "s7-real", anchor: "center" },
        to = { nodeId: "s7-sim", anchor: "center" },
        opacity = 0.55,
        strokeWidth = 2.2,
        style = { stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 stagger targets [s7-hdr, s7-real, s7-sim, s7-note] step 220 duration 280
        at 1000 trace s7-motion-sig duration 900
      }
    }
  }

  slide "Event queues" {
    eyebrow: "Event queues"
    title: "Virtual timers and external engine events"
    lede: "During offline drive, two queues compete: SimClock's ready timer set and the replay engine's next external event time. The driver always resolves the earliest timestamp, with clock events winning ties."

    narration: "Two virtual queues feed the pump: SimClock timers and the replay engine's next event. The driver always picks the earliest timestamp."

    term: {
      word: "SimEventSource"
      meaning: "Passive engine adapter exposing next_event_ns and step bounds for the graph runtime pump."
    }

    points: [
      "Clock queue: arrivals, phase transitions, grace timers.",
      "Source queue: SteppableReplay engine passes and token timing.",
