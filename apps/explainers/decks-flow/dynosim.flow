  slide "Sim pump" {
    eyebrow: "Sim pump"
    title: "Poll workload to quiescence, then advance time"
    lede: "drive_sim_with_source loops: poll the workload future on a current-thread runtime; if Pending and idle, advance to the earliest clock or source event; repeat until Ready or stall/deadlock detection triggers."

    narration: "The sim pump polls the workload future. When idle, it advances virtual time to the next clock or engine event and repeats until completion."

    term: {
      word: "sim pump"
      meaning: "The drive_sim_with_source loop in graph/runtime.rs that alternates polling and virtual time advancement."
    }

    points: [
      "Wakes during a poll re-enter without advancing time.",
      "Source steps can span [at_ns, end_ns) virtual intervals.",
      "Deadlock returns when neither queue has a future event."
    ]

    caption: "Poll → idle → advance → poll again."

    render: @scene {
      roots: [
        {
          id: "s9-hdr"
