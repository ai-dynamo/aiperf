              style: { fontSize: 11, fill: @theme.ink.secondary }
            }
          ]
        },
        {
          id: "s3-dyno"
          capability: "core.rect"
          layout: { x: 430, y: 120, width: 180, height: 110 }
          style: { fill: @theme.accent.primary, stroke: @theme.ink.secondary, strokeWidth: 2 }
          children: [
            {
              id: "s3-dyno-title"
              capability: "core.text"
              text: "Dynosim factory"
              layout: { x: 438, y: 148, width: 164, height: 22 }
              style: { fontSize: 13, fontWeight: "bold", fill: @theme.ink.primary }
            },
            {
              id: "s3-dyno-detail"
              capability: "core.text"
              text: "ExecutionSinkBuilder"
              layout: { x: 438, y: 172, width: 164, height: 20 }
              style: { fontSize: 11, fill: @theme.ink.secondary }
            }
          ]
        },
        {
          id: "s3-note"
          capability: "core.text"
          text: "transport ID routes before Hyper/Tonic clients build"
          layout: { x: 120, y: 280, width: 460, height: 24 }
          style: { fontSize: 12, fill: @theme.ink.secondary }
        }
      ]
      timeline: [
        {
