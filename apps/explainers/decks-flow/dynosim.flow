explainer "Dynosim" {
  id: "dynosim"
  route: "/dynosim"
  topic: "architecture"
  storagePrefix: "dynosim-explainer"
  classPrefix: "deck-dynosim"
  eyebrowLabel: "DYNOSIM"
  startGateTitle: "Dynosim co-simulation walkthrough"

  hub: {
    title: "offline & online replay"
    highlight: "Dynosim"
    description: "Concise tour of dynosim transports, SimClock vs RealClock, the sim pump, token flow through RequestObserver, and metric parity with HTTP runs."
  }

  slide "Why Dynosim" {
    eyebrow: "Why Dynosim"
    title: "Co-simulation without a live inference server"
    lede: "Dynosim runs AIPerf's full workload loop, observers, and metrics against Dynamo's passive mock engine in-process. No HTTP sockets, no gRPC wire path — the transport ID selects a simulation driver instead."

    narration: "Dynosim lets AIPerf benchmark without a live inference server. The workload loop and observers stay native; Dynamo's passive engine supplies timing and token events in-process."

    term: {
      word: "dynosim"
      meaning: "Feature-gated transport family (`dynosim_offline`, `dynosim_online`) that replaces native HTTP execution with SteppableReplay-driven co-simulation."
    }

    points: [
      "AIPerf owns scheduling, Clock, RequestObserver, and report merge.",
      "Dynamo mocker owns scheduler and performance-model state behind SteppableReplay.",
      "Same metric vocabulary as online runs when configured for parity."
    ]

    caption: "No serving socket on the hot path."

    render: @scene {
      roots: [
        {
          id: "s0-hdr"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
          children: [
            {
              id: "s0-hdr-label"
              capability: "core.text"
              text: "NO SERVING SOCKET"
              layout: { x: 38, y: 28, width: 360, height: 24 }
              style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
            },
            {
              id: "s0-hdr-caption"
              capability: "core.text"
              text: "No serving socket on the hot path."
              layout: { x: 400, y: 28, width: 260, height: 24 }
              style: { fontSize: 11, fill: @theme.ink.secondary }
            }
          ]
        },
        {
          id: "s0-aiperf"
          capability: "core.rect"
          layout: { x: 80, y: 130, width: 160, height: 96 }
          style: { fill: @theme.accent.primary, stroke: @theme.ink.secondary, strokeWidth: 2 }
          children: [
            {
              id: "s0-aiperf-title"
              capability: "core.text"
              text: "AIPerf workload"
              layout: { x: 88, y: 158, width: 144, height: 22 }
              style: { fontSize: 13, fontWeight: "bold", fill: @theme.ink.primary }
            },
            {
              id: "s0-aiperf-detail"
              capability: "core.text"
              text: "schedule + observe"
              layout: { x: 88, y: 182, width: 144, height: 20 }
              style: { fontSize: 11, fill: @theme.ink.secondary }
            }
          ]
        },
        {
          id: "s0-sink"
          capability: "core.rect"
          layout: { x: 280, y: 130, width: 160, height: 96 }
          style: { fill: @theme.accent.secondary, stroke: @theme.ink.secondary, strokeWidth: 2 }
          children: [
            {
              id: "s0-sink-title"
              capability: "core.text"
              text: "DynosimSink"
              layout: { x: 288, y: 158, width: 144, height: 22 }
              style: { fontSize: 13, fontWeight: "bold", fill: @theme.ink.primary }
            },
            {
              id: "s0-sink-detail"
