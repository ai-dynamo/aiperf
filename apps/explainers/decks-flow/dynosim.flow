        { id: "s15-enter", at: 0, duration: 280, target: "s15-hdr", action: "stagger", targets: ["s15-hdr", "s15-inc", "s15-coa"], step: 200 },
        { id: "s15-draw-motion", at: 700, duration: 900, target: "s15-motion-sig", action: "draw" },
        { id: "s15-emph", at: 1500, duration: 400, target: "s15-inc", action: "emphasis" }
