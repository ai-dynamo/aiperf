  slide "Config seam" {
    eyebrow: "Config seam"
    title: "One BenchmarkRun; transport selects the clock"
    lede: "The same Config v2 envelope describes workload, endpoints, and artifacts. Changing transport.type from http to dynosim_offline swaps the execution driver and clock implementation without rewriting the benchmark plan."

    narration: "You author one benchmark configuration. The transport field chooses offline simulation with a virtual clock, or online replay against wall time."

    term: {
      word: "BenchmarkRun"
      meaning: "Strict protocol-v2 object materialized by profile and passed to the execution child."
    }

    points: [
      "Workload, phases, and artifact settings stay shared.",
      "`dynosim_offline` → SimClock + virtual pump.",
      "`dynosim_online` → RealClock + wall-time replay."
    ]

    caption: "Config is shared; transport picks real vs. virtual time."

    render: @scene {
      roots: [
        {
          id: "s2-hdr"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
          children: [
            {
