  slide "Delivery modes" {
    eyebrow: "Delivery modes"
    title: "Incremental tokens vs terminal coalescing"
    lede: "Streaming configuration selects whether token observations arrive incrementally as the engine produces them or coalesce at terminal. Dynosim honors the same policy flags HTTP SSE paths respect."

    narration: "Streaming policy controls incremental token events versus terminal coalescing. Dynosim honors the same flags as HTTP streaming paths."

    term: {
      word: "terminal coalescing"
      meaning: "Delivery mode that emits batched output at terminal instead of per-token streaming observations."
    }

    points: [
      "Incremental: each engine token → observer token event.",
      "Coalesced: sink batches until terminal reduces once.",
      "Policy is endpoint/streaming config, not dynosim-specific."
    ]

    caption: "Delivery shape follows config, not transport family."

    render: @scene {
      roots: [
        {
          id: "s15-hdr"
          capability: "core.header"
          title: "DELIVERY MODE"
          caption: "Delivery shape follows config, not transport family."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s15-inc"
          capability: "core.panel"
          title: "Incremental"
          detail: "token → token"
          layout: { x: 100, y: 130, width: 220, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s15-coa"
          capability: "core.panel"
          title: "Coalesced"
          detail: "terminal batch"
          layout: { x: 380, y: 130, width: 220, height: 96 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
