  slide "Composition" {
    eyebrow: "Composition"
    title: "EngineHost + DynosimSink share one observer seam"
    lede: "DynosimSink implements RequestSink and forwards token, usage, and terminal events into the same RequestObserver pipeline HTTP uses. EngineHost wraps SteppableReplay and bridges DirectRequest submission."

    narration: "EngineHost wraps the replay engine. DynosimSink implements the same RequestSink and RequestObserver contract as HTTP transports."

    term: {
      word: "DynosimSink"
      meaning: "Worker-local sink that drives replay turns through loadgen-core observation without wire encoding."
    }

    points: [
      "RequestObserver callbacks match online semantics.",
      "TTFT is the first token observation — no separate first-token event.",
      "Terminal coalescing policy matches configured streaming mode."
    ]

    caption: "Same observation vocabulary, different dispatch backend."

    render: @scene {
      roots: [
        {
          id: "s4-hdr"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
          children: [
            {
              id: "s4-hdr-label"
              capability: "core.text"
