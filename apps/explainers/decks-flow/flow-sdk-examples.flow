      sdk.Shape(id = "rx1-center-nw-src", variant = "rounded", x = 462, y = 92, width = 7, height = 7, surfaceRole = theme(accent.primary), strokeRole = theme(accent.primary))
      sdk.Shape(id = "rx1-center-nw-dst", variant = "rounded", x = 504, y = 104, width = 7, height = 7, surfaceRole = theme(accent.green), strokeRole = theme(accent.green))
      sdk.Shape(id = "rx1-center-se-src", variant = "rounded", x = 530, y = 92, width = 7, height = 7, surfaceRole = theme(accent.primary), strokeRole = theme(accent.primary))
      sdk.Shape(id = "rx1-center-se-dst", variant = "rounded", x = 572, y = 104, width = 7, height = 7, surfaceRole = theme(accent.green), strokeRole = theme(accent.green))
      sdk.Shape(id = "rx1-center-sw-src", variant = "rounded", x = 598, y = 92, width = 7, height = 7, surfaceRole = theme(accent.primary), strokeRole = theme(accent.primary))
