  //! Slide 15 — sparse cardinal anchor examples.
  slide "Cardinal curves" {
    eyebrow: "Routing cookbook · 6 of 19"
    title: "Cardinal curves"
    lede: "Cardinal anchors force tangential departure and arrival: east/west stay horizontal at the component edge; north/south stay vertical."
    narration: "These four examples isolate cardinal tangents. Each edge leaves and enters perpendicular to its attached side."
    term: { word: "cardinal tangent" meaning: "An axis-aligned endpoint direction derived from n, s, e, or w." }
    points: ["Copy one pair unchanged, then replace ids.", "Anchor names determine endpoint tangents.", "Curvature changes bow, not attachment."]
    caption: "N · S · E · W endpoint tangents."
    render: @scene {
      sdk.Header(id = "rx2-hdr", title = "CARDINAL CURVES", caption = "tangent at both component edges", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "rx2-w-src", title = "west", detail = "from e", x = 70, y = 100, width = 110, height = 54, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx2-w-dst", title = "east", detail = "to w", x = 500, y = 100, width = 110, height = 54, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      sdk.Edge(id = "rx2-ew", mode = "curve", from = { nodeId: "rx2-w-src", anchor: "e" }, to = { nodeId: "rx2-w-dst", anchor: "w" }, style = { stroke: theme(accent.secondary), strokeWidth: 2.2 })
      sdk.Panel(id = "rx2-n-src", title = "north", detail = "from s", x = 235, y = 76, width = 90, height = 48, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx2-n-dst", title = "south", detail = "to n", x = 355, y = 250, width = 90, height = 48, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      sdk.Edge(id = "rx2-sn", mode = "curve", from = { nodeId: "rx2-n-src", anchor: "s" }, to = { nodeId: "rx2-n-dst", anchor: "n" }, style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 })
      sdk.Label(id = "rx2-ew-label", text = "e → w · horizontal terminal legs", x = 190, y = 160, width = 300, height = 20, fontSize = 11, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx2-sn-label", text = "s → n · vertical terminal legs", x = 190, y = 310, width = 300, height = 20, fontSize = 11, align = "middle", inkRole = theme(ink.secondary))
      timeline main {
        at 0 reveal rx2-hdr duration 220
        at 200 stagger targets [rx2-w-src, rx2-w-dst, rx2-n-src, rx2-n-dst] step 70 duration 180
        at 520 trace rx2-ew duration 520
        at 700 trace rx2-sn duration 520
        at 1040 stagger targets [rx2-ew-label, rx2-sn-label] step 80 duration 180
      }
    }
  }

  //! Slide 16 — corner and center anchor examples.
  slide "Corner and center curves" {
    eyebrow: "Routing cookbook · 7 of 19"
    title: "Corner and center curves"
    lede: "Corner anchors leave diagonally; center is soft and points toward its peer. The same curve primitive handles all five."
    narration: "The four corners use diagonal outward normals. Center chooses a peer-facing tangent, so it has no fixed compass direction."
    term: { word: "soft center" meaning: "A center anchor whose outward tangent points toward the peer endpoint." }
    points: ["ne, nw, se, sw use normalized diagonal tangents.", "center follows relative geometry.", "Aliases remain accepted at cardinal anchors."]
    caption: "Four corners · one peer-facing center."
    render: @scene {
      sdk.Header(id = "rx3-hdr", title = "CORNERS + CENTER", caption = "diagonal tangents · peer-facing fallback", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "rx3-center", title = "CENTER", detail = "soft anchor", x = 290, y = 165, width = 120, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      sdk.Panel(id = "rx3-nw", title = "NW", detail = "to se", x = 60, y = 82, width = 90, height = 48, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx3-ne", title = "NE", detail = "to sw", x = 550, y = 82, width = 90, height = 48, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx3-sw", title = "SW", detail = "to ne", x = 60, y = 270, width = 90, height = 48, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx3-se", title = "SE", detail = "to nw", x = 550, y = 270, width = 90, height = 48, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Edge(id = "rx3-a", mode = "curve", from = { nodeId: "rx3-nw", anchor: "se" }, to = { nodeId: "rx3-center", anchor: "nw" }, style = { stroke: theme(accent.secondary), strokeWidth: 2.0, avoidObstacles: false })
      sdk.Edge(id = "rx3-b", mode = "curve", from = { nodeId: "rx3-ne", anchor: "sw" }, to = { nodeId: "rx3-center", anchor: "ne" }, style = { stroke: theme(accent.tertiary), strokeWidth: 2.0, avoidObstacles: false })
      sdk.Edge(id = "rx3-c", mode = "curve", from = { nodeId: "rx3-sw", anchor: "ne" }, to = { nodeId: "rx3-center", anchor: "sw" }, style = { stroke: theme(accent.secondary), strokeWidth: 2.0, avoidObstacles: false })
      sdk.Edge(id = "rx3-d", mode = "curve", from = { nodeId: "rx3-se", anchor: "nw" }, to = { nodeId: "rx3-center", anchor: "se" }, style = { stroke: theme(accent.tertiary), strokeWidth: 2.0, avoidObstacles: false })
      sdk.Edge(id = "rx3-center-edge", mode = "curve", from = { nodeId: "rx3-center", anchor: "center" }, to = { nodeId: "rx3-ne", anchor: "center" }, style = { stroke: theme(accent.green), strokeWidth: 1.5, avoidObstacles: false })
      timeline main {
        at 0 reveal rx3-hdr duration 220
        at 200 stagger targets [rx3-center, rx3-nw, rx3-ne, rx3-sw, rx3-se] step 70 duration 180
        at 600 trace rx3-a duration 420
        at 680 trace rx3-b duration 420
        at 760 trace rx3-c duration 420
        at 840 trace rx3-d duration 420
        at 920 trace rx3-center-edge duration 420
      }
    }
  }

  //! Slide 17 — same-side and self-loop routing.
  slide "Same-side links and self-loops" {
    eyebrow: "Routing cookbook · 8 of 19"
    title: "Same-side links and self-loops"
    lede: "Same-side links bow outside their boxes; self-links choose a perimeter loop. preferredSide makes the author’s intent explicit."
    narration: "North-to-north and west-to-west links stay outside components. A self-edge becomes a perimeter loop rather than collapsing."
    term: { word: "self-loop" meaning: "A curved edge whose source and target node ids are identical." }
    points: ["Same-side links retain both endpoint tangents.", "Self-loops evaluate perimeter candidates.", "preferredSide selects n, s, e, or w."]
    caption: "Outside the box · deterministic perimeter."
    render: @scene {
      sdk.Header(id = "rx4-hdr", title = "SAME SIDE + SELF LOOP", caption = "outside component bounds", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "rx4-a", title = "A", detail = "n → n", x = 70, y = 170, width = 100, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx4-b", title = "B", detail = "same side", x = 245, y = 170, width = 100, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      sdk.Edge(id = "rx4-nn", mode = "curve", from = { nodeId: "rx4-a", anchor: "n" }, to = { nodeId: "rx4-b", anchor: "n" }, style = { stroke: theme(accent.secondary), strokeWidth: 2.2, preferredSide: "n" })
      sdk.Panel(id = "rx4-loop-node", title = "SELF", detail = "w → w", x = 480, y = 170, width = 110, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.tertiary))
      sdk.Edge(id = "rx4-loop", mode = "curve", from = { nodeId: "rx4-loop-node", anchor: "w" }, to = { nodeId: "rx4-loop-node", anchor: "w" }, style = { stroke: theme(accent.tertiary), strokeWidth: 2.2, preferredSide: "w", clearance: 18 })
      sdk.Label(id = "rx4-note-a", text = "same-side arc", x = 135, y = 104, width = 150, height = 20, fontSize = 11, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx4-note-b", text = "perimeter self-loop", x = 455, y = 104, width = 160, height = 20, fontSize = 11, align = "middle", inkRole = theme(ink.secondary))
      timeline main {
        at 0 reveal rx4-hdr duration 220
        at 220 stagger targets [rx4-a, rx4-b, rx4-loop-node] step 100 duration 180
        at 620 trace rx4-nn duration 560
        at 820 trace rx4-loop duration 560
        at 1120 stagger targets [rx4-note-a, rx4-note-b] step 80 duration 180
      }
    }
  }

  //! Slide 18 — automatic and authored obstacle avoidance.
  slide "Obstacle avoidance" {
    eyebrow: "Routing cookbook · 9 of 19"
    title: "Obstacle avoidance"
    lede: "Positive-area scene nodes become inflated obstacles. clearance and preferredSide tune the deterministic detour; avoidance can be disabled explicitly."
    narration: "The router sees blocking component geometry, inflates it by clearance, and chooses a stable route around it."
    term: { word: "clearance" meaning: "Padding added around every routing obstacle before visibility search." }
    points: ["Default avoidance is on.", "preferredSide biases the selected corridor.", "avoidObstacles = false restores direct adaptive geometry."]
    caption: "Automatic detour · optional author controls."
    render: @scene {
      sdk.Header(id = "rx5-hdr", title = "OBSTACLE AVOIDANCE", caption = "visibility graph · stable detour", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "rx5-src", title = "source", detail = "from e", x = 40, y = 165, width = 100, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx5-wall-a", title = "obstacle A", detail = "clearance +12", x = 250, y = 100, width = 100, height = 90, surfaceRole = theme(surface.primary), strokeRole = theme(accent.warning))
      sdk.Panel(id = "rx5-wall-b", title = "obstacle B", detail = "positive area", x = 370, y = 205, width = 100, height = 90, surfaceRole = theme(surface.primary), strokeRole = theme(accent.warning))
      sdk.Panel(id = "rx5-dst", title = "target", detail = "to w", x = 560, y = 165, width = 100, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      sdk.Edge(id = "rx5-default", mode = "curve", from = { nodeId: "rx5-src", anchor: "e" }, to = { nodeId: "rx5-dst", anchor: "w" }, style = { stroke: theme(accent.secondary), strokeWidth: 2.4, clearance: 12 })
      sdk.Edge(id = "rx5-side", mode = "curve", from = { nodeId: "rx5-src", anchor: "se" }, to = { nodeId: "rx5-dst", anchor: "sw" }, style = { stroke: theme(accent.tertiary), strokeWidth: 1.8, clearance: 22, preferredSide: "s", parallelGap: 14 })
      sdk.Edge(id = "rx5-direct", mode = "curve", from = { nodeId: "rx5-src", anchor: "ne" }, to = { nodeId: "rx5-dst", anchor: "nw" }, style = { stroke: theme(accent.warning), strokeWidth: 1.4, avoidObstacles: false, curvature: 0.2 })
      sdk.Label(id = "rx5-key", text = "default · high clearance / south · avoidance off", x = 155, y = 320, width = 390, height = 20, fontSize = 10, align = "middle", inkRole = theme(ink.secondary))
      timeline main {
        at 0 reveal rx5-hdr duration 220
        at 220 stagger targets [rx5-src, rx5-wall-a, rx5-wall-b, rx5-dst] step 90 duration 180
        at 660 trace rx5-default duration 620
        at 820 trace rx5-side duration 620
        at 980 trace rx5-direct duration 620
        at 1260 reveal rx5-key duration 220
      }
    }
  }

  //! Slide 19 — deterministic sibling lane separation.
  slide "Parallel lanes" {
    eyebrow: "Routing cookbook · 10 of 19"
    title: "Parallel lanes"
    lede: "Edges sharing endpoint ids and anchors receive symmetric lane offsets. parallelGap controls the spacing without moving attachments."
    narration: "Three identical endpoint pairs become three stable lanes. Their start and end points remain exact."
    term: { word: "parallelGap" meaning: "Scene-unit spacing between sibling curved-route lanes." }
    points: ["Sibling order is deterministic.", "Offsets are symmetric around the base route.", "Endpoints never drift."]
    caption: "−gap · center · +gap."
    render: @scene {
      sdk.Header(id = "rx6-hdr", title = "PARALLEL LANES", caption = "same endpoints · distinct routes", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "rx6-src", title = "source", detail = "three edges", x = 70, y = 165, width = 120, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
