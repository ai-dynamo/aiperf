//! Flow SDK Examples — copyable authoring patterns for AI agents.
//! Pattern: one self-contained `.flow` file · native `sdk.*` / `aiperf.*` scenes · non-empty timelines.
//! Avoid package-form `@scene { roots: … }` and raw primitives outside `freeform { … }`.
//! Register new decks in `apps/explainers/src/core/deck-registry.ts` (`EXPECTED_DECK_ROUTES`).

explainer "Flow SDK Examples" {
  id: "flow-sdk-examples"
  route: "/flow-sdk-examples"
  topic: "authoring"
  storagePrefix: "flow-sdk-examples-explainer"
  classPrefix: "deck-flow-sdk-examples"
  eyebrowLabel: "FLOW SDK EXAMPLES"
  startGateTitle: "Flow SDK authoring cookbook"

  hub: {
    highlight: "Flow SDK examples"
    title: "copyable patterns · complete routing cookbook"
    description: "Exemplar deck for AI agents: native SDK chrome, layout slots, a complete routing cookbook, motion, timeline choreography, AIPerf domain composites, and the freeform escape hatch. Each slide isolates one reusable pattern you can copy into product explainers."
  }

  //! Slide 1 — deck shell: required metadata, hub card, slide text fields, `term`.
  slide "One file, one deck" {
    eyebrow: "Deck shell · 1 of 19"
    title: "One file, one deck"
    lede: "Every explainer is a single `.flow` file under `decks-flow/`. The top-level `explainer` block declares bookmark-stable `id` and `route`, hub copy, and an ordered slide list. Filename, `id`, and route basename must agree."
    narration: "Every explainer is one flow file. The explainer block declares id, route, hub copy, and slides. Filename, id, and route basename must match."
    term: {
      word: "native @scene"
      meaning: "Slide diagram body authored with sdk.* or aiperf.* component invocations plus a non-empty timeline block — not legacy package-form roots JSON."
    }
    points: [
      "Required slide text: `title`, `lede`, `narration` (all non-empty for registry validation).",
      "Optional: `term`, `points`, `caption`, `render: @scene { … }`, deck-level `finalCard`.",
      "Evidence: `apps/explainers/src/core/deck-registry.ts`, `apps/explainers/src/flow/language/grammar/explainer.ts`."
    ]
    caption: "filename.flow → id → /route → hub card → slides."

    render: @scene {
      sdk.Header(
        id = "s1-hdr",
        title = "DECK SHELL",
        caption = "filename.flow → id → /route → hub card → slides.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Stepper(
        id = "s1-steps",
        steps = ["explainer {", "hub {", "slide …", "finalCard"],
        linked = true,
        gap = 18,
        x = 70, y = 88, width = 560, height = 28
      )
      sdk.Grid(
        id = "s1-grid",
        cols = 2,
        gap = 14,
        x = 70, y = 130, width = 560, height = 170
      ) {
        children {
          sdk.Panel(
            id = "s1-id",
            title = "id + route",
            detail = "flow-sdk-examples",
            x = 0, y = 0, width = 260, height = 72,
            surfaceRole = theme(surface.elevated),
            strokeRole = theme(accent.primary)
          )
          sdk.Panel(
            id = "s1-hub",
            title = "hub metadata",
            detail = "highlight · title · description",
            x = 0, y = 0, width = 260, height = 72,
            surfaceRole = theme(surface.elevated),
            strokeRole = theme(accent.secondary)
          )
          sdk.Panel(
            id = "s1-slide",
            title = "slide copy",
            detail = "lede · narration · term · points",
            x = 0, y = 0, width = 260, height = 72,
            surfaceRole = theme(surface.elevated),
            strokeRole = theme(accent.tertiary)
          )
          sdk.Panel(
            id = "s1-scene",
            title = "render: @scene",
            detail = "sdk.* + timeline main",
            x = 0, y = 0, width = 260, height = 72,
            surfaceRole = theme(surface.elevated),
            strokeRole = theme(accent.green)
          )
        }
      }
      sdk.Note(
        id = "s1-note",
        text = "Register id/route in EXPECTED_DECK_ROUTES before shipping.",
        x = 70, y = 318, width = 560, height = 28,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )

      timeline main {
        at 0 reveal s1-hdr duration 220
        after s1-hdr stagger targets [s1-steps-step-0, s1-steps-step-1, s1-steps-step-2, s1-steps-step-3] step 70 duration 160
        after s1-steps-step-3 stagger targets [s1-id, s1-hub, s1-slide, s1-scene] step 120 duration 200
        after s1-scene reveal s1-note duration 240
      }
    }
  }

  //! Slide 2 — chrome: headers, panels, cards, chips, notes, labels, legends, callouts, dividers, brackets.
  slide "Chrome vocabulary" {
    eyebrow: "Chrome · 2 of 19"
    title: "Chrome vocabulary"
    lede: "Reach for `sdk.header`, `sdk.panel`, and `sdk.card` before raw rects. Annotations (`sdk.callout`, `sdk.bracket`, `sdk.note`, `sdk.label`, `sdk.legend`) carry meaning without bespoke geometry math."
    narration: "Use sdk header, panel, and card for structure. Callouts, brackets, notes, labels, and legends annotate without manual layout math."
    term: {
      word: "theme role"
      meaning: "Semantic paint token such as theme(accent.primary) resolved at compile time — prefer roles over hard-coded hex colors."
    }
    points: [
      "Standard header geometry: x=18, y=16, width=664, height=44.",
      "`sdk.divider` separates regions; `sdk.bracket` groups related panels.",
      "Evidence: `apps/explainers/src/flow/sdk/generic/chrome.ts`."
    ]
    caption: "Structure first · annotate with SDK chrome."

    render: @scene {
      sdk.Header(
        id = "s2-hdr",
        title = "CHROME VOCABULARY",
        caption = "Structure first · annotate with SDK chrome.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Card(
        id = "s2-card",
        title = "sdk.card",
        detail = "title + detail + subtitle",
        subtitle = "elevated surface",
        x = 52, y = 90, width = 184, height = 92,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s2-panel",
        title = "sdk.panel",
        detail = "compact node",
        x = 260, y = 98, width = 156, height = 76,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Rail(
        id = "s2-tags",
        direction = "row",
        gap = 12,
        x = 440, y = 113, width = 192, height = 26
      ) {
        children {
          sdk.Chip(
            id = "s2-chip",
            label = "sdk.chip",
            width = 96, height = 26,
            surfaceRole = theme(surface.elevated),
            strokeRole = theme(accent.tertiary)
          )
          sdk.Label(
            id = "s2-label",
            text = "sdk.label",
            width = 84, height = 20,
            inkRole = theme(ink.primary)
          )
        }
      }
      sdk.Callout(
        id = "s2-callout",
        text = "callout",
        x = 290, y = 68, width = 96, height = 22,
        target = { x: 338, y: 98 },
        strokeRole = theme(accent.warning)
      )
      sdk.Divider(
        id = "s2-div",
        axis = "x",
        x = 52, y = 192, length = 596,
        strokeRole = theme(ink.tertiary),
        strokeWidth = 1.2
      )
      sdk.Bracket(
        id = "s2-bracket",
        side = "left",
        x = 32, y = 84, width = 16, height = 104,
        strokeRole = theme(accent.primary),
        strokeWidth = 1.5
      )
      sdk.Legend(
        id = "s2-legend",
        title = "Legend entries",
        entries = [
          { label: "primary", colorRole: theme(accent.primary) },
          { label: "secondary", colorRole: theme(accent.secondary) },
          { label: "tertiary", colorRole: theme(accent.tertiary) }
        ],
        x = 52, y = 204, width = 204, height = 92
      )
      sdk.Note(
        id = "s2-note",
        text = "sdk.note — footnotes and constraints belong in notes, not stray rects.",
        x = 278, y = 204, width = 370, height = 64,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(ink.secondary)
      )

      timeline main {
        at 0 reveal s2-hdr duration 220
        after s2-hdr reveal s2-bracket duration 180
        after s2-bracket stagger targets [s2-card, s2-panel, s2-chip, s2-label] step 90 duration 200
        after s2-label reveal s2-callout duration 200
        after s2-callout reveal s2-div duration 180
        after s2-div reveal s2-legend duration 240
        after s2-legend reveal s2-note duration 240
      }
    }
  }

  //! Slide 3 — opt-in managed layout: frame, stack, rail, overlay, and slots.
  slide "Layout and slots" {
    eyebrow: "Layout · 3 of 19"
    title: "Layout and slots"
    lede: "Managed layout is opt-in: `sdk.Frame`, `sdk.Stack`, `sdk.Grid`, `sdk.Rail`, and `sdk.Overlay` place slot children. Use `padding`, `align`, and `justify`; authored sizes are minimums unless `fixedWidth` or `fixedHeight` is true."
    narration: "Managed containers are opt-in. Frame reserves its title, stack and rail flow children, grid places cells, and overlay marks overlap as intentional. Padding and alignment replace coordinate arithmetic."
    term: {
      word: "children slot"
      meaning: "Brace block after a layout invocation containing nested sdk.* components positioned by the parent factory."
    }
    points: [
      "`sdk.Frame` reserves title-safe content; `sdk.Overlay` is the explicit intentional-overlap container.",
      "`padding`, `align`, and `justify` control placement; `fixedWidth` and `fixedHeight` opt out of content expansion.",
      "Inside managed containers, `style.position = \"absolute\"` explicitly preserves a child's local x/y and removes it from normal flow.",
      "Evidence: `apps/explainers/decks-flow/dynosim.flow`, `apps/explainers/src/flow/sdk/generic/layout.ts`."
    ]
    caption: "Let layout factories place children."

    render: @scene {
      sdk.Header(
        id = "s3-hdr",
        title = "LAYOUT + SLOTS",
        caption = "Let layout factories place children.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Frame(
        id = "s3-frame",
        title = "sdk.frame — title-safe managed region",
        x = 40, y = 78, width = 620, height = 116,
        padding = 10,
        align = "stretch",
        fixedWidth = true,
        fixedHeight = true
      ) {
        children {
          sdk.Rail(
            id = "s3-rail",
            direction = "row",
            gap = 12,
            width = 600, height = 28,
            align = "center",
            fixedWidth = true
          ) {
            children {
              sdk.Chip(id = "s3-c0", label = "row", surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
              sdk.Chip(id = "s3-c1", label = "of", surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
              sdk.Chip(id = "s3-c2", label = "chips", surfaceRole = theme(surface.elevated), strokeRole = theme(accent.tertiary))
            }
          }
        }
      }
      sdk.Stack(
        id = "s3-stack",
        direction = "column",
        gap = 10,
        x = 40, y = 208, width = 176, height = 128
      ) {
        children {
          sdk.Panel(id = "s3-p0", title = "stack", detail = "column", width = 176, height = 54, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
          sdk.Panel(id = "s3-p1", title = "auto", detail = "gap", width = 176, height = 54, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
        }
      }
      sdk.Overlay(
        id = "s3-overlay",
        x = 228, y = 208, width = 180, height = 128,
        padding = 10,
        align = "center",
        justify = "center",
        fixedWidth = true,
        fixedHeight = true
      ) {
        children {
          sdk.Panel(id = "s3-l0", title = "overlay", detail = "intentional", width = 140, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.tertiary))
          sdk.Chip(id = "s3-l1", label = "centered", width = 92, height = 26, surfaceRole = theme(surface.secondary), strokeRole = theme(accent.green))
        }
      }
      sdk.Stepper(
        id = "s3-stepper",
        steps = ["layout", "slots", "timeline"],
        linked = true,
        gap = 10,
        x = 430, y = 230, width = 228, height = 90
      )

      timeline main {
        at 0 reveal s3-hdr duration 220
        after s3-hdr reveal s3-frame duration 200
        after s3-frame stagger targets [s3-c0, s3-c1, s3-c2] step 60 duration 180
        after s3-c2 stagger targets [s3-p0, s3-p1] step 80 duration 180
        after s3-p1 reveal s3-overlay duration 220
        after s3-overlay reveal s3-stepper duration 220
      }
    }
  }

  //! Slide 4 — topology: connector vs route edges, fan-out/in, pipeline nodes slot.
  slide "Topology patterns" {
    eyebrow: "Topology · 4 of 19"
    title: "Topology patterns"
    lede: "Bind edges with `{ nodeId, anchor }` endpoints. `sdk.Edge` is directed with a visible arrowhead by default; set `arrowhead = false` only for an intentional undirected guide. Route mode auto-routes without an authored path."
    narration: "Anchor edges to node ids. Edges are visibly directed by default, while arrowhead false explicitly creates a guide. Route mode chooses the path automatically."
    term: {
      word: "anchor"
      meaning: "Compass side on a node (`n`, `e`, `s`, `w`) used as an edge endpoint."
    }
    points: [
      "Directed is the safe default for connector, route, curve, path, and line modes.",
      "Fan arrays: `to = [{ nodeId: \"a\", anchor: \"w\" }, …]`.",
      "Pipeline requires at least two `nodes` slot entries.",
      "Evidence: `apps/explainers/decks-flow/segment-pools.flow`, `apps/explainers/src/flow/sdk/generic/topology.ts`."
    ]
    caption: "Anchors · fans · pipelines."

    render: @scene {
      sdk.Header(
        id = "s4-hdr",
        title = "TOPOLOGY",
        caption = "Anchors · fans · pipelines.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s4-src",
        title = "source",
        detail = "fan root",
        x = 40, y = 120, width = 130, height = 78,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.FanOut(
        id = "s4-fan",
        from = { nodeId: "s4-src", anchor: "e" },
        to = [
          { nodeId: "s4-a", anchor: "w" },
          { nodeId: "s4-b", anchor: "w" },
          { nodeId: "s4-c", anchor: "w" }
        ],
        axis = "x",
        style = { stroke: theme(accent.secondary), strokeWidth: 2.2 }
      )
      sdk.Panel(id = "s4-a", title = "A", detail = "target", x = 240, y = 80, width = 100, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.tertiary))
      sdk.Panel(id = "s4-b", title = "B", detail = "target", x = 240, y = 160, width = 100, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.tertiary))
      sdk.Panel(id = "s4-c", title = "C", detail = "target", x = 240, y = 240, width = 100, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.tertiary))
      sdk.Pipeline(
        id = "s4-pipe",
        edgeMode = "route",
        gap = 18,
        x = 380, y = 120
      ) {
        nodes {
          sdk.Panel(id = "s4-n0", title = "1", detail = "stage", x = 0, y = 0, width = 72, height = 68, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
          sdk.Panel(id = "s4-n1", title = "2", detail = "stage", x = 0, y = 0, width = 72, height = 68, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
          sdk.Panel(id = "s4-n2", title = "3", detail = "stage", x = 0, y = 0, width = 72, height = 68, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
        }
      }
      sdk.Edge(
        id = "s4-route",
        mode = "route",
        from = { nodeId: "s4-b", anchor: "e" },
        to = { nodeId: "s4-n0", anchor: "w" },
        style = { stroke: theme(accent.warning), strokeWidth: 2.0 }
      )

      timeline main {
        at 0 reveal s4-hdr duration 220
        after s4-hdr reveal s4-src duration 240
        after s4-src trace s4-fan duration 420
        after s4-fan stagger targets [s4-a, s4-b, s4-c] step 90 duration 180
        after s4-c reveal s4-pipe duration 260
        after s4-pipe trace s4-route duration 360
      }
    }
  }

  //! Slide 14 — exhaustive curved-route source × target anchor matrix.
  slide "Complete 9×9 curve matrix" {
    eyebrow: "Routing cookbook · 5 of 19"
    title: "Complete 9×9 curve matrix"
    lede: "Every ordered pairing of center, cardinal, and corner anchors is a real sdk.Edge(mode = \"curve\"). Rows are source anchors; columns are target anchors."
    narration: "This matrix exercises all eighty-one ordered anchor pairs. Read source anchors down the rows and target anchors across the columns."
    term: {
      word: "9×9"
      meaning: "Nine source anchors multiplied by nine target anchors: 81 deterministic curved routes."
    }
    points: [
      "Rows: source anchor. Columns: target anchor.",
      "Blue starts, green targets; focused pages follow for copyable patterns.",
      "Matrix edges disable obstacle avoidance so neighboring cells do not affect tangent geometry."
    ]
    caption: "81 ordered anchor pairs · one public SDK primitive."

    render: @scene {
      sdk.Header(id = "rx1-hdr", title = "CURVE MATRIX · SOURCE × TARGET", caption = "rows = from · columns = to", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary), inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-center", text = "center", x = 48, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-n", text = "n", x = 116, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-s", text = "s", x = 184, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-e", text = "e", x = 252, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-w", text = "w", x = 320, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-ne", text = "ne", x = 388, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-nw", text = "nw", x = 456, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-se", text = "se", x = 524, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-col-sw", text = "sw", x = 592, y = 70, width = 54, height = 14, fontSize = 8, align = "middle", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-center", text = "center", x = 18, y = 88, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-n", text = "n", x = 18, y = 115, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-s", text = "s", x = 18, y = 142, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-e", text = "e", x = 18, y = 169, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-w", text = "w", x = 18, y = 196, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-ne", text = "ne", x = 18, y = 223, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-nw", text = "nw", x = 18, y = 250, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-se", text = "se", x = 18, y = 277, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Label(id = "rx1-row-sw", text = "sw", x = 18, y = 304, width = 32, height = 14, fontSize = 8, align = "end", inkRole = theme(ink.secondary))
      sdk.Shape(id = "rx1-center-center-src", variant = "rounded", x = 54, y = 92, width = 7, height = 7, surfaceRole = theme(accent.primary), strokeRole = theme(accent.primary))
      sdk.Shape(id = "rx1-center-center-dst", variant = "rounded", x = 96, y = 104, width = 7, height = 7, surfaceRole = theme(accent.green), strokeRole = theme(accent.green))
      sdk.Shape(id = "rx1-center-n-src", variant = "rounded", x = 122, y = 92, width = 7, height = 7, surfaceRole = theme(accent.primary), strokeRole = theme(accent.primary))
