  //! Slide 11 — explicit corridor bundling.
  slide "Bundling" {
    eyebrow: "Routing cookbook · 11 of 19"
    title: "Bundling"
    lede: "bundle = true collapses compatible sibling lanes into one shared corridor while preserving each semantic edge."
    narration: "Bundled edges share their route. The authored edges remain separate ids for timelines and motion."
    term: { word: "bundle" meaning: "An opt-in shared corridor for compatible curved sibling edges." }
    points: ["All compatible siblings opt in.", "Edge ids and actions remain distinct.", "One corridor reduces visual noise."]
    caption: "Separate semantics · shared geometry."
    render: @scene {
      sdk.Header(id = "rx7-hdr", title = "BUNDLED CORRIDOR", caption = "three ids · one path", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "rx7-src", title = "producer", detail = "3 semantic edges", x = 70, y = 165, width = 130, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx7-dst", title = "consumer", detail = "shared corridor", x = 500, y = 165, width = 130, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
