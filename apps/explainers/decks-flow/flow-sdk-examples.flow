      sdk.Edge(id = "rx9-curvature", mode = "curve", from = { nodeId: "rx9-a1", anchor: "e" }, to = { nodeId: "rx9-t1", anchor: "w" }, style = { stroke: theme(accent.secondary), curvature: 0.75, avoidObstacles: false })
