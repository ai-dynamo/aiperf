  //! Slide 12 — anchor-safe orthogonal routes.
  slide "Anchor-safe orthogonal routing" {
    eyebrow: "Routing cookbook · 12 of 19"
    title: "Anchor-safe orthogonal routing"
    lede: "Route mode honors cardinal endpoints: west/east terminal legs are horizontal and north/south terminal legs are vertical."
    narration: "Orthogonal routes approach each cardinal side perpendicularly, so no final segment runs down the connected component edge."
    term: { word: "terminal leg" meaning: "The final orthogonal segment immediately before an anchored target." }
    points: ["e/w → horizontal terminal leg.", "n/s → vertical terminal leg.", "Tall and wide displacements no longer override anchor intent."]
    caption: "terminal leg ⟂ component edge."
    render: @scene {
      sdk.Header(id = "rx8-hdr", title = "ANCHOR-SAFE ORTHOGONAL", caption = "terminal leg ⟂ component edge", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "rx8-left", title = "source", detail = "from e", x = 60, y = 90, width = 110, height = 54, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "rx8-right", title = "target", detail = "to w", x = 510, y = 165, width = 110, height = 54, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      sdk.Edge(id = "rx8-ew", mode = "route", from = { nodeId: "rx8-left", anchor: "e" }, to = { nodeId: "rx8-right", anchor: "w" }, style = { stroke: theme(accent.green), strokeWidth: 2.4 })
      sdk.Panel(id = "rx8-top", title = "source", detail = "from s", x = 300, y = 78, width = 100, height = 48, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
      sdk.Panel(id = "rx8-bottom", title = "target", detail = "to n", x = 400, y = 270, width = 100, height = 48, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.tertiary))
      sdk.Edge(id = "rx8-sn", mode = "route", from = { nodeId: "rx8-top", anchor: "s" }, to = { nodeId: "rx8-bottom", anchor: "n" }, style = { stroke: theme(accent.tertiary), strokeWidth: 2.0 })
      sdk.Note(id = "rx8-note", text = "Before: displacement picked the bend axis. Now: anchors own the terminal direction.", x = 60, y = 330, width = 560, height = 28, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      timeline main {
        at 0 reveal rx8-hdr duration 220
