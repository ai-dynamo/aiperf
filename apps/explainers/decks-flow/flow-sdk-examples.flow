      sdk.FanOut(
        id = "s9-fan",
        from = ref("s9-pipeline.output"),
        to = [
          { nodeId: "s9-json", anchor: "w" },
          { nodeId: "s9-csv", anchor: "w" }
        ],
        axis = "x",
        style = { stroke: theme(accent.green), strokeWidth: 2.2 }
      )
      sdk.Panel(id = "s9-json", title = "JSON", detail = "artifact", x = 430, y = 150, width = 128, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      sdk.Panel(id = "s9-csv", title = "CSV", detail = "artifact", x = 430, y = 236, width = 128, height = 72, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
      sdk.Flow(
        id = "s9-flow",
        edge = true,
        edgeMode = "route",
        from = ref("s9-pipeline.output"),
        to = { nodeId: "s9-csv", anchor: "w" },
        opacity = 0.55,
        strokeWidth = 2.2,
        style = { stroke: theme(accent.primary) }
      )

      timeline main {
        at 0 reveal s9-hdr duration 220
        after s9-hdr reveal s9-band duration 200
        after s9-band stagger targets [s9-t0, s9-t1, s9-t2] step 60 duration 160
        after s9-t2 reveal s9-pipeline duration 260
        after s9-pipeline trace s9-fan duration 400
        after s9-fan stagger targets [s9-json, s9-csv] step 100 duration 180
        after s9-csv trace s9-flow duration 900
      }
    }
  }

  //! Slide 19 — agent checklist (text-first recap).
  slide "Agent checklist" {
    eyebrow: "Checklist · 19 of 19"
    title: "Agent checklist before shipping"
    lede: "Copy patterns from this deck, swap product semantics, register the route, and run the explainer package gates. Never hide authoring environment in upstream PRs — this deck is documentation, not a product surface."
    narration: "Before shipping a new explainer, register the route, keep native SDK scenes, cite evidence paths, and run assert explainer packages."
    term: {
      word: "assert-explainer-packages"
      meaning: "Makefile aggregate gate compiling all decks, enforcing SDK authoring, registry invariants, and flow verifier IR walks."
    }
    points: [
      "1. Add `decks-flow/<id>.flow` with matching `id` and `/route`.",
      "2. Copy the focused routing exemplars; use the 9×9 page for exhaustive anchor lookup.",
      "3. `cd apps/explainers && npm run build`.",
      "4. `make assert-explainer-packages` from repo root.",
      "5. Spot-check `/#/<route>` in dev hub."
    ]
    caption: "Compile · register · verify · preview."

    render: @scene {
      sdk.Header(
        id = "s10-hdr",
        title = "SHIP CHECKLIST",
        caption = "Compile · register · verify · preview.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Stepper(
        id = "s10-steps",
        steps = ["author", "register", "build", "verify", "preview"],
        linked = true,
        gap = 12,
        x = 40, y = 78, width = 620, height = 28
      )
      sdk.Stack(
        id = "s10-stack",
        direction = "column",
        gap = 6,
        x = 40, y = 100, width = 620, height = 200
      ) {
        children {
          sdk.Panel(id = "s10-a", title = "native sdk.* scenes", detail = "no package-form roots", surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
          sdk.Panel(id = "s10-b", title = "non-empty timelines", detail = "reveal → trace polish", surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
          sdk.Panel(id = "s10-c", title = "evidence in points", detail = "cite rust/ or apps/ paths", surfaceRole = theme(surface.elevated), strokeRole = theme(accent.tertiary))
          sdk.Panel(id = "s10-d", title = "make assert-explainer-packages", detail = "CI gate", surfaceRole = theme(surface.elevated), strokeRole = theme(accent.green))
        }
      }

      timeline main {
        at 0 reveal s10-hdr duration 220
        after s10-hdr stagger targets [s10-steps-step-0, s10-steps-step-1, s10-steps-step-2, s10-steps-step-3, s10-steps-step-4] step 70 duration 140
        after s10-steps-step-4 stagger targets [s10-a, s10-b, s10-c, s10-d] step 120 duration 200
      }
    }
  }

  finalCard: @scene {
    sdk.Header(
      id = "final-hdr",
      title = "Copy sources for agents",
      caption = "Flow SDK exemplar references",
      x = 18, y = 16, width = 664, height = 44,
      surfaceRole = theme(surface.secondary),
      inkRole = theme(ink.secondary)
    )
    sdk.Panel(
      id = "f1",
      title = "apps/explainers/decks-flow/flow-sdk-examples.flow",
      detail = "this exemplar deck",
      x = 40, y = 78, width = 620, height = 48,
      surfaceRole = theme(surface.elevated),
      strokeRole = theme(accent.primary)
    )
    sdk.Panel(
      id = "f2",
      title = "apps/explainers/src/flow/sdk/registry.ts",
      detail = "sdk.* component catalog + actions",
      x = 40, y = 136, width = 620, height = 48,
      surfaceRole = theme(surface.elevated),
      strokeRole = theme(accent.secondary)
    )
    sdk.Panel(
      id = "f3",
      title = "apps/explainers/scripts/assert-sdk-authoring.mjs",
      detail = "strict authoring gate",
      x = 40, y = 194, width = 620, height = 48,
      surfaceRole = theme(surface.elevated),
      strokeRole = theme(accent.tertiary)
    )
    sdk.Panel(
      id = "f4",
      title = "apps/explainers/decks-flow/synthetic-dataset-generator.flow",
      detail = "production reference · fans + finalCard",
      x = 40, y = 252, width = 620, height = 48,
      surfaceRole = theme(surface.elevated),
      strokeRole = theme(accent.green)
    )

    timeline main {
      at 0 reveal final-hdr duration 220
      at 200 stagger targets [f1, f2, f3, f4] step 180 duration 220
    }
  }
}
