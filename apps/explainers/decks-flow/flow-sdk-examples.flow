  //! Slide 14 — motion: signal, flow (edge-backed), pulse overlay.
  slide "Motion overlays" {
    eyebrow: "Motion · 14 of 19"
    title: "Motion overlays"
    lede: "Use `sdk.Signal(edge = \"edge-id\")` for edge-associated motion so the animation consumes the edge's resolved route exactly. Standalone `from`/`to`, `path`, or `points` motion remains available for non-edge animation."
    narration: "Bind a signal to an edge id so motion and the visible connector share one resolved path. Use standalone motion geometry only when there is no edge."
    term: {
      word: "trace"
      meaning: "Timeline action that plays a motion overlay along a connector or registered SDK motion instance."
    }
    points: [
      "`edge` is mutually exclusive with `from`, `to`, `path`, and `points` on `sdk.Signal`.",
      "Pair structural reveals with a late `trace` on the motion id for polish.",
      "Evidence: `apps/explainers/decks-flow/slurm-velo.flow`, `apps/explainers/src/flow/sdk/generic/motion.ts`."
