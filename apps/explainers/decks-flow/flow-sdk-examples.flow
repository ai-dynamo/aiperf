      sdk.Edge(id = "rx7-bundle-b", mode = "curve", from = { nodeId: "rx7-src", anchor: "e" }, to = { nodeId: "rx7-dst", anchor: "w" }, style = { stroke: theme(accent.secondary), strokeWidth: 2.8, bundle: true })
