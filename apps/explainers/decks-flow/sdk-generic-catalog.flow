      sdk.SplitPane(id = "split-v2", label = "vertical", direction = "column", gap = 8, x = 450, y = 220, width = 200, height = 90) { children { sdk.Shape(id = "split-v2a", label = "A") sdk.Shape(id = "split-v2b", label = "B") } }
      sdk.Label(id = "split-v1-l", text = "HORIZONTAL", x = 450, y = 204, width = 200, height = 16)
