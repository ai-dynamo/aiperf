    }
  }

  slide "sdk.numberedSequence" {
    eyebrow: "DECK COMPOSITES · SDK.NUMBEREDSEQUENCE"
    title: "Numbered sequence walks an ordered list"
    lede: "Use a numbered sequence for a vertical list where each step has an index and a short explanation."
    narration: "Four rows stack vertically. Each has a square index chip on the left, green where the step is emphasized and black otherwise, beside a bordered box naming the callback and what it records."
    caption: "Chips index the order; emphasis marks the steps that matter."
    render: @scene {
      sdk.Header(id = "seq-h", title = "SDK.NUMBEREDSEQUENCE", caption = "indexed rows", x = 18, y = 16, width = 664, height = 44)
      sdk.NumberedSequence(id = "seq-demo", items = [{ number: "1", title: "on_arrival", detail: "request enters the sink", emphasis: true }, { number: "2", title: "on_admit", detail: "admission gate opens" }, { number: "3", title: "on_token", detail: "first token is TTFT", emphasis: true }, { number: "4", title: "on_usage", detail: "terminal usage recorded" }], x = 54, y = 86)
      timeline main { at 0 reveal seq-h duration 180 after seq-h reveal seq-demo duration 300 }
    }
  }

  slide "sdk.timelineAxis" {
    eyebrow: "DECK COMPOSITES · SDK.TIMELINEAXIS"
    title: "Timeline axis places events on a scale"
    lede: "Use a timeline axis to show marks and a target against a labeled numeric range."
    narration: "A horizontal axis runs from zero to three milliseconds with labeled ticks below it, a filled green marker where a timer fires on time, a hollow gray marker for a late wake, and a dashed green line at the deadline."
    caption: "Ticks label the scale; filled marks are exact, hollow marks are late."
    render: @scene {
      sdk.Header(id = "axis-h", title = "SDK.TIMELINEAXIS", caption = "labeled scale", x = 18, y = 16, width = 664, height = 44)
      sdk.TimelineAxis(id = "axis-demo", start = 0, end = 3, unit = "ms", ticks = [{ at: 0, label: "0ms" }, { at: 1, label: "1ms" }, { at: 2, label: "2ms" }, { at: 3, label: "3ms" }], markers = [{ at: 1, label: "fire" }, { at: 2.4, label: "late wake", style: "late" }], target = { at: 2, label: "deadline" }, x = 60, y = 150, width = 560)
      timeline main { at 0 reveal axis-h duration 180 after axis-h reveal axis-demo duration 300 }
    }
  }

  slide "sdk.nodeTree" {
    eyebrow: "DECK COMPOSITES · SDK.NODETREE"
    title: "Node tree fans a root over its children"
    lede: "Use a node tree for a single parent joined to a row of child nodes."
    narration: "A green root box sits above a row of three child boxes, each joined to the root by a thin line, with a caption underneath explaining the ordering."
    caption: "The root can be filled to mark it; children hang from connecting lines."
    render: @scene {
      sdk.Header(id = "tree-h", title = "SDK.NODETREE", caption = "root over children", x = 18, y = 16, width = 664, height = 44)
      sdk.NodeTree(id = "tree-demo", root = { label: "pop", detail: "min deadline", emphasis: true }, children = [{ label: "t=1ms" }, { label: "t=2ms" }, { label: "t=4ms" }], orderNote = "The heap yields the earliest deadline first", x = 80, y = 90)
      timeline main { at 0 reveal tree-h duration 180 after tree-h reveal tree-demo duration 300 }
    }
  }

  slide "sdk.cardGrid" {
    eyebrow: "DECK COMPOSITES · SDK.CARDGRID"
    title: "Card grid arranges labeled cards"
    lede: "Use a card grid for a set of titled cards, each with a colored left edge that groups it."
    narration: "Four bordered cards form a two-by-two grid. Each card carries a colored left edge, a bold monospace title, and a line of gray detail."
    caption: "Left-edge color groups cards; the grid wraps by column count."
    render: @scene {
      sdk.Header(id = "cards-h", title = "SDK.CARDGRID", caption = "titled cards", x = 18, y = 16, width = 664, height = 44)
      sdk.CardGrid(id = "cards-demo", columns = 2, cards = [{ title: "aiperf-cli", detail: "CLI, routing, self-execution", accent: "green" }, { title: "aiperf-runtime", detail: "clocks, transports, metrics", accent: "green" }, { title: "aiperf-mock-server", detail: "deterministic inference target", accent: "black" }, { title: "pyext", detail: "pyo3 packaging module", accent: "gray" }], x = 80, y = 86)
      timeline main { at 0 reveal cards-h duration 180 after cards-h reveal cards-demo duration 300 }
    }
  }

  slide "A composed benchmark workspace" {
    eyebrow: "FINALE · COMPOSITION"
    title: "Primitives become a believable product surface"
    lede: "Typography, status, data, navigation, indicators, and containers combine without losing their individual contracts."
    narration: "The finale composes six generic families into a benchmark workspace. Every primitive remains production SDK output."
    caption: "Compose from semantic contracts; let hierarchy do the visual work."
    render: @scene {
      sdk.Header(id = "final-h", title = "BENCHMARK · RUN 42", caption = "complete · us-west · Llama 3.1 70B", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary))
      sdk.Breadcrumb(id = "final-bc", items = ["Workspace", "Benchmarks", "Run 42"], x = 32, y = 78, width = 360, height = 26)
      sdk.Toolbar(id = "final-tools", label = "run actions", gap = 8, x = 440, y = 92, width = 228, height = 34) { children { sdk.Badge(id = "final-rerun", label = "RERUN", variant = "info") sdk.Badge(id = "final-export", label = "EXPORT", variant = "success") } }
      sdk.SplitPane(id = "final-split", label = "benchmark workspace", direction = "row", gap = 14, x = 32, y = 138, width = 636, height = 202) {
        children {
          sdk.Section(id = "final-summary", title = "Performance", width = 300, height = 210, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary)) {
            children {
              sdk.Stat(id = "final-stat", title = "Throughput", items = ["1,284 req/s", "+8.2%"])
              sdk.Metric(id = "final-metric", title = "P95 latency", items = ["18.7 ms", "within SLO"])
              sdk.Progress(id = "final-progress", label = "artifact export", value = 1, width = 250, height = 18)
            }
          }
          sdk.Section(id = "final-health", title = "Endpoint health", width = 300, height = 210, surfaceRole = theme(surface.elevated)) {
            children {
              sdk.MediaObject(id = "final-owner", label = "owner", gap = 10, width = 260, height = 52) { body { sdk.IconLabel(id = "final-owner-label", label = "Mina · on call", icon = "check", width = 240, height = 40) } }
              sdk.Sparkline(id = "final-spark", label = "throughput trend", values = [42, 45, 44, 51, 56, 60], width = 250, height = 44)
              sdk.StatusCard(id = "final-status", title = "All systems healthy", variant = "success", width = 250, height = 50)
            }
          }
        }
      }
      sdk.Caption(id = "final-cap", text = "Eight families · one coherent interface", x = 32, y = 380, width = 636, height = 16)
      timeline main {
        at 0 reveal final-h duration 180
        after final-h reveal final-bc duration 160
        after final-bc reveal final-tools duration 180
        after final-tools reveal final-split duration 240
        after final-split stagger targets [final-stat, final-metric, final-progress] step 90 duration 180
        after final-progress stagger targets [final-owner, final-spark, final-status] step 90 duration 180
        after final-status reveal final-cap duration 160
      }
    }
  }
}
