//! Chaptered teaching catalog for every registered generic SDK primitive.

explainer "SDK Generic Catalog" {
  id: "sdk-generic-catalog"
  route: "/sdk-generic-catalog"
  topic: "authoring"
  storagePrefix: "sdk-generic-catalog-explainer"
  classPrefix: "deck-sdk-generic-catalog"
  eyebrowLabel: "SDK GENERIC CATALOG"
  startGateTitle: "Generic component primitives"

  hub: {
    highlight: "Generic primitives"
    title: "53 primitives · eight families · one production path"
    description: "A chaptered visual reference that teaches every generic Flow SDK primitive through production expansion."
  }

  slide "Generic primitives, composed" {
    eyebrow: "SDK · GENERIC CATALOG"
    title: "A visual grammar for believable interfaces"
    lede: "Fifty-three production primitives, taught one at a time and then composed as a coherent interface."
    narration: "Use this deck as both a visual reference and an authoring guide. Every focused page invokes the production SDK primitive it teaches."
    caption: "Reference the contract · study the variants · compose with confidence."
    render: @scene {
      sdk.Header(id = "open-h", title = "GENERIC SDK CATALOG", caption = "53 primitives · 8 families", x = 18, y = 16, width = 664, height = 44, surfaceRole = theme(surface.secondary))
      sdk.Title(id = "open-title", text = "Small primitives. Clear contracts.", x = 54, y = 105, width = 430, height = 42, inkRole = theme(ink.primary))
      sdk.Paragraph(id = "open-copy", text = "Focused specimen, realistic variants,\nthen confident composition.", x = 54, y = 165, width = 330, height = 76, inkRole = theme(ink.secondary))
      sdk.Badge(id = "open-b1", label = "content", variant = "info", x = 54, y = 270, width = 92, height = 28)
      sdk.Badge(id = "open-b2", label = "status", variant = "success", x = 158, y = 270, width = 92, height = 28)
      sdk.Badge(id = "open-b3", label = "data", variant = "warning", x = 262, y = 270, width = 92, height = 28)
      sdk.Gauge(id = "open-g", label = "coverage", value = 1, x = 570, y = 120, width = 70, height = 72)
      sdk.Caption(id = "open-cap", text = "100% coverage", x = 550, y = 215, width = 110, height = 20)
      timeline main {
        at 0 reveal open-h duration 180
        after open-h reveal open-title duration 220
        after open-title reveal open-copy duration 220
        after open-copy stagger targets [open-b1, open-b2, open-b3] step 90 duration 160
        after open-b3 reveal open-g duration 220
        after open-g reveal open-cap duration 160
      }
    }
  }

  slide "Foundations and shapes" {
    eyebrow: "CHAPTER 1 · FOUNDATIONS"
    title: "Build the visible substrate"
    lede: "Shapes, text, imagery, connectors, and spacing establish the stage before specialized UI appears."
    narration: "The foundations family supplies the raw visual and spatial vocabulary used by every later composition."
    caption: "Nine primitives · form, ink, media, connection, space."
    render: @scene {
      sdk.Header(id = "c1-h", title = "FOUNDATIONS + SHAPES", caption = "01 / 08", x = 18, y = 16, width = 664, height = 44)
      sdk.Shape(id = "c1-shape", variant = "rounded", label = "surface", x = 70, y = 120, width = 220, height = 130, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Title(id = "c1-title", text = "FORM · SURFACE", x = 90, y = 270, width = 180, height = 24)
      sdk.Shape(id = "c1-target", variant = "rounded", label = "symbol target", x = 520, y = 130, width = 110, height = 70, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Arrow(id = "c1-arrow", label = "flow", from = { nodeId: "c1-shape", anchor: "e" }, to = { nodeId: "c1-target", anchor: "w" }, x = 290, y = 165, width = 230, height = 0, strokeRole = theme(accent.primary))
      sdk.Icon(id = "c1-icon", icon = "code", x = 551, y = 220, width = 48, height = 48, inkRole = theme(accent.primary))
      sdk.Caption(id = "c1-icon-l", text = "named icon", x = 520, y = 278, width = 110, height = 16)
      timeline main { at 0 reveal c1-h duration 180 after c1-h stagger targets [c1-shape, c1-target] step 80 duration 220 after c1-target reveal c1-title duration 160 after c1-title trace c1-arrow duration 260 after c1-arrow reveal c1-icon duration 180 after c1-icon reveal c1-icon-l duration 140 }
    }
  }

  slide "sdk.shape" {
    eyebrow: "FOUNDATIONS · SHAPE"
    title: "Shape defines silhouette and surface"
    lede: "Use semantic variants for rectangles, rounds, circles, ellipses, and authored paths."
    narration: "Shape is the general-purpose visual surface. A rounded inference-service tile anchors the page; a rectangle and a circle compare basic geometry."
    caption: "Choose geometry deliberately; keep paint semantic."
    render: @scene {
      sdk.Header(id = "shape-h", title = "SDK.SHAPE", caption = "surface primitive", x = 18, y = 16, width = 664, height = 44)
      sdk.Shape(id = "shape-hero", label = "Inference service", variant = "rounded", x = 44, y = 104, width = 350, height = 150, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Label(id = "shape-hero-l", text = "HERO · ROUNDED SERVICE SURFACE", x = 44, y = 270, width = 350, height = 18)
      sdk.Shape(id = "shape-v1", label = "rect", variant = "rect", x = 440, y = 112, width = 92, height = 70, surfaceRole = theme(surface.secondary))
      sdk.Shape(id = "shape-v2", label = "circle", variant = "circle", x = 560, y = 112, width = 70, height = 70, surfaceRole = theme(accent.primary))
      sdk.Label(id = "shape-v1-l", text = "RECT", x = 440, y = 198, width = 92, height = 18)
      sdk.Label(id = "shape-v2-l", text = "CIRCLE", x = 560, y = 198, width = 70, height = 18)
      sdk.Note(id = "shape-note", text = "Geometry is authored; theme roles own color.", x = 44, y = 320, width = 606, height = 30)
      timeline main { at 0 reveal shape-h duration 160 after shape-h reveal shape-hero duration 240 after shape-hero reveal shape-hero-l duration 140 after shape-hero-l stagger targets [shape-v1, shape-v2] step 100 duration 180 after shape-v2 stagger targets [shape-v1-l, shape-v2-l] step 80 duration 140 after shape-v2-l reveal shape-note duration 160 }
    }
  }

  slide "sdk.text" {
    eyebrow: "FOUNDATIONS · TEXT"
    title: "Text places direct, unadorned copy"
    lede: "Use text for short labels and values that need exact authored geometry."
    narration: "Text is the direct core text primitive. Here it anchors a latency value and compares primary and secondary ink."
    caption: "Keep direct text short, legible, and purposeful."
    render: @scene {
      sdk.Header(id = "text-h", title = "SDK.TEXT", caption = "direct copy", x = 18, y = 16, width = 664, height = 44)
      sdk.Text(id = "text-hero", text = "18.7 ms", x = 54, y = 120, width = 330, height = 80, inkRole = theme(accent.primary))
      sdk.Label(id = "text-hero-l", text = "HERO · P95 LATENCY", x = 54, y = 220, width = 330, height = 18)
      sdk.Text(id = "text-v1", text = "ready", x = 450, y = 125, width = 160, height = 28, inkRole = theme(ink.primary))
      sdk.Text(id = "text-v2", text = "updated 2m ago", x = 450, y = 180, width = 180, height = 28, inkRole = theme(ink.secondary))
      sdk.Label(id = "text-v1-l", text = "PRIMARY", x = 450, y = 160, width = 160, height = 16)
      sdk.Label(id = "text-v2-l", text = "SECONDARY", x = 450, y = 215, width = 180, height = 16)
      sdk.Note(id = "text-note", text = "Prefer specialized typography primitives for longer content.", x = 54, y = 310, width = 586, height = 30)
      timeline main { at 0 reveal text-h duration 160 after text-h reveal text-hero duration 240 after text-hero reveal text-hero-l duration 140 after text-hero-l reveal text-v1 duration 160 after text-v1 reveal text-v1-l duration 120 after text-v1-l reveal text-v2 duration 160 after text-v2 reveal text-v2-l duration 120 after text-v2-l reveal text-note duration 160 }
    }
  }

  slide "sdk.richText" {
    eyebrow: "FOUNDATIONS · RICH TEXT"
    title: "Rich text carries structured prose"
    lede: "Use rich text when hierarchy must live inside one bounded text region."
    narration: "Rich text demonstrates a compact release summary, while a tip and a status note show short instructional and operational copy."
    caption: "Bound the region first; let copy express hierarchy."
    render: @scene {
      sdk.Header(id = "rich-h", title = "SDK.RICHTEXT", caption = "structured prose", x = 18, y = 16, width = 664, height = 44)
      sdk.RichText(id = "rich-hero", text = "Release 2.4\nFaster routing with deterministic fallback.", x = 44, y = 105, width = 350, height = 120, inkRole = theme(ink.primary))
      sdk.Label(id = "rich-hero-l", text = "HERO · RELEASE SUMMARY", x = 44, y = 242, width = 350, height = 18)
      sdk.RichText(id = "rich-v1", text = "Tip\nPin the model revision.", x = 440, y = 108, width = 190, height = 62, inkRole = theme(accent.primary))
      sdk.RichText(id = "rich-v2", text = "Status\nAll regions healthy.", x = 440, y = 220, width = 190, height = 62, inkRole = theme(ink.secondary))
      sdk.Label(id = "rich-v1-l", text = "TIP", x = 440, y = 192, width = 190, height = 16)
      sdk.Label(id = "rich-v2-l", text = "STATUS", x = 440, y = 304, width = 190, height = 16)
      timeline main { at 0 reveal rich-h duration 160 after rich-h reveal rich-hero duration 240 after rich-hero reveal rich-hero-l duration 140 after rich-hero-l reveal rich-v1 duration 160 after rich-v1 reveal rich-v1-l duration 120 after rich-v1-l reveal rich-v2 duration 160 after rich-v2 reveal rich-v2-l duration 120 }
    }
  }

  slide "sdk.icon" {
    eyebrow: "FOUNDATIONS · ICON"
    title: "Icons compress familiar meaning"
    lede: "Use named icons as supporting signals, never as unexplained decoration."
    narration: "A server icon anchors the page, while check, warning, and lock icons show the built-in semantic vocabulary."
    caption: "Pair unfamiliar symbols with a visible label."
    render: @scene {
      sdk.Header(id = "icon-h", title = "SDK.ICON", caption = "named symbol", x = 18, y = 16, width = 664, height = 44)
      sdk.Icon(id = "icon-hero", icon = "server", x = 120, y = 110, width = 120, height = 120, inkRole = theme(accent.primary))
      sdk.Label(id = "icon-hero-l", text = "HERO · INFERENCE SERVER", x = 72, y = 250, width = 220, height = 18)
      sdk.Icon(id = "icon-v1", icon = "check", x = 430, y = 125, width = 42, height = 42, inkRole = theme(accent.green))
      sdk.Icon(id = "icon-v2", icon = "warning", x = 505, y = 125, width = 42, height = 42, inkRole = theme(accent.warning))
      sdk.Icon(id = "icon-v3", icon = "lock", x = 580, y = 125, width = 42, height = 42, inkRole = theme(ink.primary))
      sdk.Label(id = "icon-v1-l", text = "OK", x = 430, y = 178, width = 42, height = 16)
      sdk.Label(id = "icon-v2-l", text = "WARN", x = 505, y = 178, width = 42, height = 16)
      sdk.Label(id = "icon-v3-l", text = "SECURE", x = 580, y = 178, width = 50, height = 16)
      timeline main { at 0 reveal icon-h duration 160 after icon-h reveal icon-hero duration 240 after icon-hero reveal icon-hero-l duration 140 after icon-hero-l stagger targets [icon-v1, icon-v2, icon-v3] step 90 duration 180 after icon-v3 stagger targets [icon-v1-l, icon-v2-l, icon-v3-l] step 70 duration 140 }
    }
  }

  slide "sdk.image" {
    eyebrow: "FOUNDATIONS · IMAGE"
    title: "Images bring trusted media into scene IR"
    lede: "Use package-resolvable repository assets and select contain or cover intentionally."
    narration: "The NVIDIA symbol is rendered from an existing repository asset served by Vite, comparing contain and cover fitting side by side."
    caption: "A valid source is required; fitting is an authored choice."
    render: @scene {
      sdk.Header(id = "image-h", title = "SDK.IMAGE", caption = "repository media", x = 18, y = 16, width = 664, height = 44)
      sdk.Image(id = "image-hero", src = "/nvidia-symbol.svg", label = "NVIDIA symbol", variant = "contain", x = 44, y = 100, width = 350, height = 165)
      sdk.Label(id = "image-hero-l", text = "HERO · CONTAIN", x = 44, y = 280, width = 350, height = 18)
      sdk.Image(id = "image-v1", src = "/nvidia-symbol.svg", label = "contained mark", variant = "contain", x = 440, y = 110, width = 90, height = 90)
      sdk.Image(id = "image-v2", src = "/nvidia-symbol.svg", label = "covered mark", variant = "cover", x = 560, y = 110, width = 90, height = 90)
      sdk.Label(id = "image-v1-l", text = "CONTAIN", x = 440, y = 210, width = 90, height = 16)
      sdk.Label(id = "image-v2-l", text = "COVER", x = 560, y = 210, width = 90, height = 16)
      timeline main { at 0 reveal image-h duration 160 after image-h reveal image-hero duration 240 after image-hero reveal image-hero-l duration 140 after image-hero-l stagger targets [image-v1, image-v2] step 100 duration 180 after image-v2 stagger targets [image-v1-l, image-v2-l] step 80 duration 140 }
    }
  }

  slide "sdk.line" {
    eyebrow: "FOUNDATIONS · LINE"
    title: "Lines relate without implying direction"
    lede: "Use a line for association, alignment, and neutral linkage."
    narration: "A neutral line connects two paired regions; smaller lines compare restrained and emphasized strokes."
    caption: "If direction matters, choose an arrow."
    render: @scene {
      sdk.Header(id = "line-h", title = "SDK.LINE", caption = "neutral connector", x = 18, y = 16, width = 664, height = 44)
      sdk.Shape(id = "line-a", variant = "rounded", x = 54, y = 125, width = 110, height = 80, surfaceRole = theme(surface.elevated))
      sdk.Shape(id = "line-b", variant = "rounded", x = 290, y = 125, width = 110, height = 80, surfaceRole = theme(surface.elevated))
      sdk.Line(id = "line-hero", label = "related services", from = { x: 164, y: 165 }, to = { x: 290, y: 165 }, x = 164, y = 165, width = 126, height = 0, strokeRole = theme(accent.primary))
      sdk.Label(id = "line-hero-l", text = "HERO · PEER RELATION", x = 120, y = 230, width = 220, height = 18)
      sdk.Line(id = "line-v1", label = "quiet", from = { x: 450, y: 140 }, to = { x: 630, y: 140 }, x = 450, y = 140, width = 180, height = 0, strokeRole = theme(ink.secondary))
      sdk.Line(id = "line-v2", label = "active", from = { x: 450, y: 210 }, to = { x: 630, y: 210 }, x = 450, y = 210, width = 180, height = 0, strokeRole = theme(accent.primary))
      sdk.Label(id = "line-v1-l", text = "QUIET", x = 450, y = 155, width = 180, height = 16)
      sdk.Label(id = "line-v2-l", text = "ACTIVE", x = 450, y = 225, width = 180, height = 16)
      timeline main { at 0 reveal line-h duration 160 after line-h stagger targets [line-a, line-b] step 80 duration 180 after line-b trace line-hero duration 260 after line-hero reveal line-hero-l duration 140 after line-hero-l reveal line-v1 duration 160 after line-v1 reveal line-v1-l duration 120 after line-v1-l reveal line-v2 duration 160 after line-v2 reveal line-v2-l duration 120 }
    }
  }

  slide "sdk.arrow" {
    eyebrow: "FOUNDATIONS · ARROW"
    title: "Arrows make direction explicit"
    lede: "Use arrows for handoffs, progression, and one-way dependencies."
    narration: "An arrow shows a client dispatching a request to a server; smaller arrows distinguish forward progress from a descending transition."
    caption: "Arrowheads encode direction; labels explain intent."
    render: @scene {
      sdk.Header(id = "arrow-h", title = "SDK.ARROW", caption = "directional connector", x = 18, y = 16, width = 664, height = 44)
      sdk.Shape(id = "arrow-ha", variant = "rounded", label = "client", x = 48, y = 145, width = 70, height = 50, surfaceRole = theme(surface.elevated))
      sdk.Shape(id = "arrow-hb", variant = "rounded", label = "server", x = 360, y = 145, width = 70, height = 50, surfaceRole = theme(surface.elevated))
      sdk.Arrow(id = "arrow-hero", label = "dispatch request", from = { nodeId: "arrow-ha", anchor: "e" }, to = { nodeId: "arrow-hb", anchor: "w" }, x = 118, y = 170, width = 242, height = 0, strokeRole = theme(accent.primary))
      sdk.Label(id = "arrow-hero-l", text = "HERO · DISPATCH REQUEST", x = 100, y = 205, width = 260, height = 18)
      sdk.Shape(id = "arrow-v1a", variant = "rounded", label = "source", x = 440, y = 105, width = 44, height = 36, surfaceRole = theme(surface.elevated))
      sdk.Shape(id = "arrow-v1b", variant = "rounded", label = "target", x = 610, y = 105, width = 44, height = 36, surfaceRole = theme(surface.elevated))
      sdk.Arrow(id = "arrow-v1", label = "forward", from = { nodeId: "arrow-v1a", anchor: "e" }, to = { nodeId: "arrow-v1b", anchor: "w" }, x = 484, y = 123, width = 126, height = 0, strokeRole = theme(accent.green))
      sdk.Label(id = "arrow-v1-l", text = "FORWARD", x = 440, y = 150, width = 214, height = 16)
      sdk.Shape(id = "arrow-v2a", variant = "rounded", label = "source", x = 440, y = 185, width = 44, height = 36, surfaceRole = theme(surface.elevated))
      sdk.Shape(id = "arrow-v2b", variant = "rounded", label = "target", x = 610, y = 230, width = 44, height = 36, surfaceRole = theme(surface.elevated))
      sdk.Arrow(id = "arrow-v2", label = "handoff", from = { nodeId: "arrow-v2a", anchor: "e" }, to = { nodeId: "arrow-v2b", anchor: "w" }, x = 484, y = 203, width = 126, height = 45, strokeRole = theme(accent.warning))
      sdk.Label(id = "arrow-v2-l", text = "HANDOFF", x = 440, y = 280, width = 214, height = 16)
      timeline main { at 0 reveal arrow-h duration 160 after arrow-h stagger targets [arrow-ha, arrow-hb] step 80 duration 160 after arrow-hb trace arrow-hero duration 280 after arrow-hero reveal arrow-hero-l duration 140 after arrow-hero-l stagger targets [arrow-v1a, arrow-v1b] step 60 duration 140 after arrow-v1b trace arrow-v1 duration 180 after arrow-v1 reveal arrow-v1-l duration 120 after arrow-v1-l stagger targets [arrow-v2a, arrow-v2b] step 60 duration 140 after arrow-v2b trace arrow-v2 duration 180 after arrow-v2 reveal arrow-v2-l duration 120 }
    }
  }

  slide "sdk.spacer" {
    eyebrow: "FOUNDATIONS · SPACER"
    title: "Spacer reserves rhythm without visible chrome"
    lede: "Frame spacing specimens so invisible layout intent remains inspectable."
    narration: "The outlined sections expose three real spacer instances. The primitive remains empty while annotations make its reserved dimensions visible."
    caption: "Spacing is structure, not decoration."
    render: @scene {
      sdk.Header(id = "spacer-h", title = "SDK.SPACER", caption = "visible framing for invisible space", x = 18, y = 16, width = 664, height = 44)
      sdk.Section(id = "spacer-frame", title = "reserved hero gap", x = 54, y = 100, width = 340, height = 160, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary)) { children { sdk.Spacer(id = "spacer-hero", label = "96 px gap", width = 96, height = 96) } }
      sdk.Label(id = "spacer-hero-l", text = "HERO · 96 × 96 RESERVED", x = 54, y = 278, width = 340, height = 18)
      sdk.Section(id = "spacer-f1", title = "inline", x = 440, y = 110, width = 90, height = 90, strokeRole = theme(ink.secondary)) { children { sdk.Spacer(id = "spacer-v1", label = "24", width = 24, height = 24) } }
      sdk.Section(id = "spacer-f2", title = "section", x = 560, y = 110, width = 90, height = 90, strokeRole = theme(accent.green)) { children { sdk.Spacer(id = "spacer-v2", label = "48", width = 48, height = 48) } }
      sdk.Label(id = "spacer-v1-l", text = "24 PX", x = 440, y = 210, width = 90, height = 16)
      sdk.Label(id = "spacer-v2-l", text = "48 PX", x = 560, y = 210, width = 90, height = 16)
      timeline main { at 0 reveal spacer-h duration 160 after spacer-h reveal spacer-frame duration 220 after spacer-frame reveal spacer-hero-l duration 140 after spacer-hero-l stagger targets [spacer-f1, spacer-f2] step 100 duration 180 after spacer-f2 stagger targets [spacer-v1-l, spacer-v2-l] step 80 duration 140 }
    }
  }

  slide "sdk.inset" {
    eyebrow: "FOUNDATIONS · INSET"
    title: "Inset protects content with internal space"
    lede: "Wrap children in a semantic padded region instead of offsetting each child manually."
    narration: "An inset protects a deployment-ready message with generous padding; smaller insets compare compact and roomy gaps."
    caption: "Padding belongs to the container contract."
    render: @scene {
      sdk.Header(id = "inset-h", title = "SDK.INSET", caption = "padded container", x = 18, y = 16, width = 664, height = 44)
      sdk.Inset(id = "inset-hero", label = "deployment notice", gap = 24, x = 44, y = 100, width = 350, height = 150) { children { sdk.Alert(id = "inset-alert", title = "Deployment ready", variant = "success", width = 290, height = 76) } }
      sdk.Label(id = "inset-hero-l", text = "HERO · 24 PX INSET", x = 44, y = 268, width = 350, height = 18)
      sdk.Inset(id = "inset-v1", label = "compact", gap = 8, x = 440, y = 112, width = 90, height = 80) { children { sdk.Badge(id = "inset-b1", label = "8 px", variant = "info") } }
      sdk.Inset(id = "inset-v2", label = "roomy", gap = 20, x = 560, y = 112, width = 90, height = 80) { children { sdk.Badge(id = "inset-b2", label = "20 px", variant = "success") } }
      sdk.Label(id = "inset-v1-l", text = "COMPACT", x = 440, y = 202, width = 90, height = 16)
      sdk.Label(id = "inset-v2-l", text = "ROOMY", x = 560, y = 202, width = 90, height = 16)
      timeline main { at 0 reveal inset-h duration 160 after inset-h reveal inset-hero duration 240 after inset-hero reveal inset-hero-l duration 140 after inset-hero-l stagger targets [inset-v1, inset-v2] step 100 duration 180 after inset-v2 stagger targets [inset-v1-l, inset-v2-l] step 80 duration 140 }
    }
  }

  slide "Typography and rich content" {
    eyebrow: "CHAPTER 2 · TYPOGRAPHY"
    title: "Turn information into hierarchy"
    lede: "Titles, prose, captions, code, quotations, and structured lists make dense ideas scan quickly."
    narration: "Typography components encode common reading roles so each deck does not reinvent hierarchy."
    caption: "Eight primitives · hierarchy, prose, evidence, structure."
    render: @scene {
      sdk.Header(id = "c2-h", title = "TYPOGRAPHY + RICH CONTENT", caption = "02 / 08", x = 18, y = 16, width = 664, height = 44)
      sdk.Title(id = "c2-title", text = "Readable by design", x = 70, y = 115, width = 400, height = 40)
      sdk.Paragraph(id = "c2-copy", text = "The right text primitive makes purpose visible\nbefore every word is read.", x = 70, y = 175, width = 320, height = 80, inkRole = theme(ink.secondary))
      sdk.CodeBlock(id = "c2-code", text = "sdk.Title(...)", x = 550, y = 115, width = 100, height = 120)
      timeline main { at 0 reveal c2-h duration 180 after c2-h reveal c2-title duration 220 after c2-title reveal c2-copy duration 200 after c2-copy reveal c2-code duration 220 }
    }
  }

  slide "sdk.title" {
    eyebrow: "TYPOGRAPHY · TITLE"
    title: "Title establishes the reading entry point"
    lede: "Use titles for section-level hierarchy, not every label."
    narration: "A product heading leads an inference overview; smaller titles show a section heading and an attention-drawing heading."
    caption: "One strong title beats a field of competing headings."
    render: @scene {
      sdk.Header(id = "title-h", title = "SDK.TITLE", caption = "hierarchy anchor", x = 18, y = 16, width = 664, height = 44)
      sdk.Title(id = "title-hero", text = "Inference overview", x = 54, y = 120, width = 350, height = 52)
      sdk.Label(id = "title-hero-l", text = "HERO · PRODUCT VIEW", x = 54, y = 195, width = 350, height = 18)
      sdk.Title(id = "title-v1", text = "Traffic", x = 450, y = 115, width = 180, height = 32)
      sdk.Title(id = "title-v2", text = "Errors", x = 450, y = 180, width = 180, height = 32, inkRole = theme(accent.warning))
      sdk.Label(id = "title-v1-l", text = "SECTION", x = 450, y = 152, width = 180, height = 16)
      sdk.Label(id = "title-v2-l", text = "ATTENTION", x = 450, y = 218, width = 180, height = 16)
      timeline main { at 0 reveal title-h duration 160 after title-h reveal title-hero duration 240 after title-hero reveal title-hero-l duration 140 after title-hero-l reveal title-v1 duration 160 after title-v1 reveal title-v1-l duration 120 after title-v1-l reveal title-v2 duration 160 after title-v2 reveal title-v2-l duration 120 }
    }
  }

  slide "sdk.paragraph" {
    eyebrow: "TYPOGRAPHY · PARAGRAPH"
    title: "Paragraph explains in complete thoughts"
    lede: "Use paragraphs for concise prose with enough room to breathe."
