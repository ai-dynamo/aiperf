  slide "Deck composites" {
    eyebrow: "CHAPTER 8 · DECK COMPOSITES"
    title: "Compose whole slide shapes in one call"
    lede: "Dividers, step chains, big figures, compare and card grids, numbered sequences, timeline axes, and node trees capture recurring reference-deck layouts as single components."
    narration: "Each deck composite expands into many primitives at once: a takeaway grid of accented cells and an ordered row of arrow-linked step boxes both come from one authored line."
    caption: "Eight composites · dividers, chains, figures, grids, sequences, axes, trees."
    render: @scene {
      sdk.Header(id = "c8-h", title = "DECK COMPOSITES", caption = "08 / 08", x = 18, y = 16, width = 664, height = 44)
      sdk.CompareGrid(id = "c8-grid", columns = 3, items = [{ label: "One call", detail: "one authored line" }, { label: "Many nodes", detail: "expanded primitives" }, { label: "Deck-ready", detail: "brand layout" }], x = 6, y = 90)
      sdk.StepChain(id = "c8-chain", steps = [{ number: "01", label: "VALIDATE" }, { number: "02", label: "SCHEDULE" }, { number: "03", label: "EMIT" }], x = 52, y = 248)
      timeline main { at 0 reveal c8-h duration 180 after c8-h reveal c8-grid duration 240 after c8-grid reveal c8-chain duration 220 }
    }
  }

  slide "sdk.sectionDivider" {
    eyebrow: "DECK COMPOSITES · SDK.SECTIONDIVIDER"
    title: "Section divider opens a chapter"
    lede: "Use a section divider for the right-aligned chapter-break block that separates major parts of a deck."
    narration: "A large green monospace number sits above a bold black title and a gray subtitle, all aligned to the right edge, with a small green kicker above the number."
    caption: "One number, one title, one subtitle; alignment carries the weight."
