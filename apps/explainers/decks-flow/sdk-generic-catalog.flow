      timeline main { at 0 reveal chain-h duration 180 after chain-h reveal chain-demo duration 300 }
    }
  }

  slide "sdk.bigStat" {
    eyebrow: "DECK COMPOSITES · SDK.BIGSTAT"
    title: "Big stat headlines one figure"
    lede: "Use a big stat when a single number is the entire point of the slide."
    narration: "An oversized green figure fills the upper area, with a bold black title and a gray description stacked directly beneath it."
    caption: "The value dominates; the title and description explain it."
