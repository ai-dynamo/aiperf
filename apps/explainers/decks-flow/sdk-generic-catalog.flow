  slide "sdk.compareGrid" {
    eyebrow: "DECK COMPOSITES · SDK.COMPAREGRID"
    title: "Compare grid lines up peer takeaways"
    lede: "Use a compare grid for a row of equal-weight cells that should be read side by side."
    narration: "Three equal cells sit in a row, each with a green top accent, a bold label, and a line of gray detail beneath it."
    caption: "Columns are configurable; every cell shares the green top accent."
