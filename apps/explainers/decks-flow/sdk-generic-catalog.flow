  slide "Containers and composition" {
    eyebrow: "CHAPTER 7 · COMPOSITION"
    title: "Let structure hold the interface together"
    lede: "Sections, toolbars, split panes, and media objects organize child primitives into durable patterns."
    narration: "Composition primitives own layout relationships so child components remain focused on content."
    caption: "Four primitives · region, actions, panes, media + body."
    render: @scene {
      sdk.Header(id = "c7-h", title = "CONTAINERS + COMPOSITION", caption = "07 / 08", x = 18, y = 16, width = 664, height = 44)
      sdk.Section(id = "c7-section", title = "Run workspace", x = 60, y = 100, width = 580, height = 190, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary)) {
        children {
          sdk.Toolbar(id = "c7-toolbar", label = "actions", width = 520, height = 44) { children { sdk.Badge(id = "c7-b1", label = "RUN", variant = "success") sdk.Badge(id = "c7-b2", label = "EXPORT", variant = "info") } }
          sdk.MediaObject(id = "c7-media", label = "latest result", width = 520, height = 90) { body { sdk.Metric(id = "c7-m", title = "Latest result · P95 latency", items = ["18.7 ms", "within SLO"], width = 480, height = 72) } }
        }
      }
      timeline main { at 0 reveal c7-h duration 180 after c7-h reveal c7-section duration 240 after c7-section reveal c7-toolbar duration 200 after c7-toolbar reveal c7-media duration 220 }
    }
  }

  slide "sdk.section" {
    eyebrow: "COMPOSITION · SECTION"
    title: "Section gives related content a shared boundary"
    lede: "Use sections to group one coherent topic with its own internal layout."
    narration: "A section contains a benchmark summary with its own stats; smaller sections compare a neutral filter region and an emphasized warning region."
    caption: "A section should answer one clear question."
