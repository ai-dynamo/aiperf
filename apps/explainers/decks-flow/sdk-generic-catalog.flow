  slide "sdk.stepChain" {
    eyebrow: "DECK COMPOSITES · SDK.STEPCHAIN"
    title: "Step chain traces an ordered pipeline"
    lede: "Use a step chain when a fixed sequence of numbered stages hands off from one to the next."
    narration: "Three numbered boxes run left to right, each with a green top edge, a green number, a bold label, and a line of detail; a green arrow points from each box into the next."
    caption: "Direction row or column; every box carries a green accent edge."
