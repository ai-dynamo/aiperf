      sdk.MediaObject(id = "media-v2", label = "artifact", gap = 10, x = 430, y = 218, width = 220, height = 82) { leading { sdk.Icon(id = "media-file", icon = "file", x = 10, y = 12, width = 32, height = 32) } body { sdk.Caption(id = "media-file-c", text = "records.jsonl · 48 MB", x = 56, y = 16, width = 150, height = 18) } }
      sdk.Label(id = "media-v1-l", text = "SERVICE", x = 430, y = 184, width = 220, height = 16)
      sdk.Label(id = "media-v2-l", text = "ARTIFACT", x = 430, y = 307, width = 220, height = 16)
      timeline main { at 0 reveal media-h duration 160 after media-h reveal media-hero duration 240 after media-hero reveal media-hero-l duration 140 after media-hero-l reveal media-v1 duration 160 after media-v1 reveal media-v1-l duration 120 after media-v1-l reveal media-v2 duration 160 after media-v2 reveal media-v2-l duration 120 }
