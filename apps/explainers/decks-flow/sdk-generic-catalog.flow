      sdk.CompareGrid(id = "compare-demo", columns = 3, items = [{ label: "Deterministic", detail: "same seed, same run" }, { label: "Observable", detail: "every record captured" }, { label: "Composable", detail: "seams over monoliths" }], x = 6, y = 150)
