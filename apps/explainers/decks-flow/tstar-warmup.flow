  slide "Duration & window" {
    eyebrow: "Duration & window"
    title: "Max arrival defines the span; ratios scale the window"
    lede: "`trace_duration_us` is the max `arrival_offset_us` across nodes. The sampling window is `[trajectory_start_min_ratio, trajectory_start_max_ratio] × duration`."

    narration: "Before drawing t*, the runtime measures how long the recorded trajectory spans — the latest arrival across nodes, or zero when no node carries timing. Config ratios then scale that duration into a closed sampling window for the t* draw."

    term: {
      word: "trace_duration_us"
      meaning: "Largest arrival_offset_us across the resolved trace graph's nodes; zero when no node carries timing metadata."
    }

    points: [
      "`trace_duration_us` = max node `arrival_offset_us` (else `0.0`).",
      "Window bounds: `lo = trajectory_start_min_ratio × duration`, `hi = trajectory_start_max_ratio × duration`.",
      "Default ratios `[0, 0]` collapse the window to an exact instant at the start.",
      "Evidence: `rust/runtime/src/graph/tstar.rs` — `trace_duration_us`, `WindowTStarSampler`."
    ]

    caption: "duration = max arrival · window = ratios × duration."

