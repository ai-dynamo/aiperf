  slide "Corpus cursor" {
    eyebrow: "Corpus cursor"
    title: "Pressure → profiling continuity; single-pass may ignore"
    lede: "`corpus_cursor` is the next undrawn corpus index after pressure's last recycle draw. Bounded profiling continues the wrap from here; single-pass profiling (no stop conditions) deliberately ignores it for full-corpus coverage."

    narration: "One sampler is shared across pressure, handoff, and profiling draws. When profiling is bounded, freed lanes keep walking from the stamped cursor so they don't re-serve templates pressure just replayed. Unbounded single-pass profiling prefers covering the whole corpus over cursor continuity."

    term: {
      word: "corpus_cursor"
      meaning: "Next corpus draw index after pressure warmup; bounded profiling continues from it; single-pass profiling ignores it for full coverage."
    }

    points: [
      "Stamped at drain from the shared lane ledger cursor.",
