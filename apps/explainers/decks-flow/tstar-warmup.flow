          capability: "core.path"
          d: "M340 80 V300"
          layout: { x: 0, y: 0, width: 700, height: 400 }
          style: { fill: "none", stroke: @theme.accent.warning, strokeWidth: 3 }
        },
        {
          id: "s3-cut-l"
          capability: "core.text"
