  slide "Inputs & channels" {
    eyebrow: "Inputs & channels"
    title: "Drop requirements whose source was chopped"
    lede: "Survivors must not await `{src}_out` channels from dropped predecessors — that would deadlock `await_inputs`. The chop keeps only requirements whose source survives."

    narration: "Fan-in nodes wait on named output channels from their predecessors. After the chop, a dropped predecessor never writes that channel. The chop keeps only input requirements whose source still exists — a fully re-rooted node can end with no remaining inputs."

    term: {
      word: "survivor_out_channels"
      meaning: "The set of `{nid}_out` channels for nodes that survived the t* chop; only input requirements targeting those channels are kept."
    }

    points: [
      "Dropped predecessors never write `{src}_out` post-chop.",
      "Keep only `inputs` requirements whose channel is in the survivor out-set.",
      "A node re-rooted entirely from `START` may end with empty `inputs`.",
      "Evidence: `rust/runtime/src/graph/snapshot.rs` — `chop_node_inputs` / deadlock note."
    ]

