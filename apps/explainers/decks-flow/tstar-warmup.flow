  slide "What stays warm" {
    eyebrow: "What stays warm"
    title: "Server KV warms; the client still materializes the full prompt"
    lede: "Executed pre-`t*` turns leave KV on the server. The snapshot chop still keeps the full prompt segment path so the worker materializes the exact resume prompt."

    narration: "Warmup executes the prefix so the inference server holds KV for that history. On the client side, the snapshot chop leaves each survivor's prompt program unchanged — the pre-t* segments stay in the path so resume materializes the exact prompt, not a truncated one."

    term: {
      word: "prompt path unchanged"
      meaning: "After the trie chop, surviving nodes keep their full pre-t* segment program so BodyPlan materialization still rebuilds the exact resume prompt."
    }

    points: [
      "Server: KV for executed prefix turns stays warm across the handoff.",
      "Client: survivors keep the full prompt segment path — resume is exact, not truncated.",
      "Evidence: `rust/runtime/src/graph/snapshot.rs` — \"Leaves each surviving node's prompt segment program unchanged.\""
    ]

    caption: "Warm KV on the server · full prompt path on the client."

    render: @scene {
      roots: [
        {
          id: "s4-hdr"
          capability: "core.header"
          title: "SERVER KV · CLIENT PROMPT PATH"
          caption: "Warm KV on the server · full prompt path on the client."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s4-server"
          capability: "core.panel"
          title: "Inference server"
          detail: "KV for n0 · n1"
          layout: { x: 50, y: 110, width: 220, height: 100 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s4-kv"
          capability: "core.panel"
          title: "Warm KV"
          detail: "executed prefix"
          layout: { x: 80, y: 240, width: 160, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.green, strokeWidth: 1.6, radius: 8 }
        },
        {
          id: "s4-sv-link"
          capability: "core.route"
          from: { nodeId: "s4-server", anchor: "s" }
          to: { nodeId: "s4-kv", anchor: "n" }
          style: { stroke: @theme.accent.green, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s4-client"
          capability: "core.panel"
          title: "AIPerf worker"
          detail: "materialize resume"
          layout: { x: 400, y: 110, width: 240, height: 100 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s4-path"
          capability: "core.panel"
          title: "Full prompt path"
          detail: "pre-t* segments kept"
          layout: { x: 430, y: 240, width: 180, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.6, radius: 8 }
        },
        {
          id: "s4-cl-link"
          capability: "core.route"
          from: { nodeId: "s4-client", anchor: "s" }
          to: { nodeId: "s4-path", anchor: "n" }
          style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s4-bridge"
          capability: "core.connector"
          from: { nodeId: "s4-server", anchor: "e" }
          to: { nodeId: "s4-client", anchor: "w" }
          style: { stroke: @theme.accent.tertiary, strokeWidth: 2.2, fill: "none" }
        },
        {
