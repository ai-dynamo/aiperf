explainer "t* Warmup" {
  id: "tstar-warmup"
  route: "/tstar-warmup"
  topic: "graph-runtime"
  storagePrefix: "tstar-warmup-explainer"
  classPrefix: "deck-tstar-warmup"
  eyebrowLabel: "T* WARMUP"
  startGateTitle: "t* warmup & cache-pressure handoff"

  hub: {
    highlight: "t* warmup"
    title: "snapshot · pressure · handoff"
    description: "How graph runs warm KV via a deterministic t* chop, cache-pressure recycle, and resume handoff — vs ordinary request-count warmup."
  }

  slide "Why graph warmup" {
    eyebrow: "Why graph warmup"
    title: "Cold KV vs measuring a mid-trace resume"
    lede: "A recorded multi-turn trace arrives with cold prefix and cold KV. Graph warmup exists so profiling can measure from a mid-trace frontier — not from an empty cache."

    narration: "Graph runs often care about mid-trace resume, not cold-start TTFT. Without warmup, every lane starts with a cold prefix and empty server KV. Trajectory t* warmup builds that history first, then profiles from the live frontier."

    term: {
      word: "mid-trace resume"
      meaning: "Profiling starts after a deterministic prefix of a recorded trajectory has already executed, so the server holds KV for that history and the client resumes the remaining live nodes."
    }

    points: [
      "Cold start: empty server KV and a cold prompt prefix on every lane.",
      "Graph profiling often wants steady mid-trace behavior, not first-token cold start.",
      "Evidence: `rust/runtime/src/graph/tstar.rs` — t* splits firings into a warmup prefix and a profiled set."
    ]

    caption: "Warm history first; measure from the frontier."

    render: @scene {
      roots: [
        {
          id: "s1-hdr"
          capability: "core.header"
          title: "COLD START ≠ MID-TRACE"
          caption: "Warm history first; measure from the frontier."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s1-cold"
          capability: "core.panel"
          title: "Cold start"
          detail: "empty KV · cold prefix"
          layout: { x: 60, y: 110, width: 200, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1.5, radius: 10 }
        },
        {
          id: "s1-a1"
          capability: "core.connector"
          from: { nodeId: "s1-cold", anchor: "e" }
          to: { nodeId: "s1-warm", anchor: "w" }
          style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s1-warm"
          capability: "core.panel"
          title: "t* warmup"
          detail: "execute prefix"
          layout: { x: 320, y: 110, width: 160, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s1-a2"
          capability: "core.connector"
          from: { nodeId: "s1-warm", anchor: "e" }
          to: { nodeId: "s1-resume", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s1-resume"
          capability: "core.panel"
          title: "Mid-trace resume"
          detail: "warm KV · live set"
          layout: { x: 540, y: 110, width: 120, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s1-note"
          capability: "core.note"
          caption: "Profiling measures from the frontier, not from empty cache"
          layout: { x: 60, y: 260, width: 600, height: 28 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 6 }
        },
        {
          id: "s1-motion"
          capability: "motion.signal"
          from: { nodeId: "s1-cold", anchor: "center" }
          to: { nodeId: "s1-resume", anchor: "center" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none", opacity: 0.55 }
          accessibility: { label: "cold to resume" }
        }
      ]
      timeline: [
        { id: "s1-enter-hdr", at: 0, duration: 260, target: "s1-hdr", action: "enter" },
        { id: "s1-enter-cold", at: 180, duration: 280, target: "s1-cold", action: "enter" },
        { id: "s1-draw-a1", at: 420, duration: 320, target: "s1-a1", action: "draw" },
        { id: "s1-enter-warm", at: 560, duration: 280, target: "s1-warm", action: "enter" },
        { id: "s1-draw-a2", at: 780, duration: 320, target: "s1-a2", action: "draw" },
        { id: "s1-enter-resume", at: 920, duration: 280, target: "s1-resume", action: "enter" },
        { id: "s1-enter-note", at: 1140, duration: 280, target: "s1-note", action: "enter" },
        { id: "s1-draw-motion", at: 1400, duration: 900, target: "s1-motion", action: "draw" },
        { id: "s1-emph", at: 2200, duration: 400, target: "s1-resume", action: "emphasis" }
      ]
    }
  }

  slide "Ordinary warmup ≠ t*" {
    eyebrow: "Ordinary warmup ≠ t*"
    title: "Request-count phases vs a trajectory partition"
    lede: "Ordinary `--warmup-request-count` / duration phases burn requests and discard metrics. Trajectory `t*` partitions one recorded graph into a warmup prefix and a live profiling set."

    narration: "Ordinary warmup is a separate phase that sends N requests or runs for a duration, then throws those metrics away. Trajectory t* is different: it chops a recorded multi-turn graph at a deterministic instant so the same plan warms and profiles one trajectory."

    term: {
      word: "ordinary phase warmup"
      meaning: "Lifecycle warmup driven by `--warmup-request-count` or a duration stop; metrics from that phase are discarded before profiling begins."
    }

    points: [
      "`--warmup-request-count` / duration phases warm the system, then discard warmup metrics.",
      "`t*` partitions a recorded trajectory: arrivals before `t*` are history; arrivals at/after `t*` are the live set.",
      "Keep three ideas distinct: phase warmup, trajectory chop, and later cache-pressure handoff.",
      "Evidence: `docs/tutorials/warmup.md`; `rust/runtime/src/graph/tstar.rs`."
    ]

    caption: "Phase warmup burns requests; t* chops a trajectory."

    render: @scene {
      roots: [
        {
          id: "s2-hdr"
          capability: "core.header"
          title: "TWO DIFFERENT WARMUPS"
          caption: "Phase warmup burns requests; t* chops a trajectory."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s2-steps"
          capability: "core.stepper"
          steps: ["phase warmup", "t* chop", "handoff"]
          linked: true
          layout: { x: 80, y: 68, width: 540, height: 26 }
          style: { gap: 18 }
        },
        {
          id: "s2-ord"
          capability: "core.panel"
          title: "Ordinary phase warmup"
          detail: "count / duration · discard metrics"
          layout: { x: 40, y: 110, width: 280, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1.5, radius: 10 }
        },
        {
          id: "s2-ord-a"
          capability: "core.panel"
          title: "Warmup phase"
          detail: "N requests"
          layout: { x: 60, y: 250, width: 110, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.tertiary, strokeWidth: 1.3, radius: 8 }
        },
        {
          id: "s2-ord-b"
          capability: "core.panel"
          title: "Profiling"
          detail: "fresh metrics"
          layout: { x: 200, y: 250, width: 110, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.secondary, strokeWidth: 1.5, radius: 8 }
        },
        {
          id: "s2-ord-link"
          capability: "core.route"
          from: { nodeId: "s2-ord-a", anchor: "e" }
          to: { nodeId: "s2-ord-b", anchor: "w" }
          style: { stroke: @theme.ink.secondary, strokeWidth: 2, fill: "none" }
        },
        {
          id: "s2-div"
          capability: "core.divider"
          layout: { x: 350, y: 100, width: 2, height: 230 }
          axis: "y"
          style: { stroke: @theme.ink.tertiary, strokeWidth: 1.2, fill: "none", markerEnd: "none" }
          accessibility: { label: "column divider" }
        },
        {
          id: "s2-tstar"
          capability: "core.panel"
          title: "Trajectory t*"
          detail: "partition one recorded graph"
          layout: { x: 380, y: 110, width: 280, height: 110 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.warning, strokeWidth: 1.8, radius: 10 }
        },
        {
          id: "s2-ts-a"
          capability: "core.panel"
          title: "Prefix < t*"
          detail: "warmup history"
          layout: { x: 400, y: 250, width: 110, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.ink.secondary, strokeWidth: 1.3, radius: 8 }
        },
        {
          id: "s2-ts-b"
          capability: "core.panel"
          title: "Live ≥ t*"
          detail: "profile set"
          layout: { x: 540, y: 250, width: 110, height: 70 }
          style: { fill: @theme.surface.elevated, stroke: @theme.accent.primary, strokeWidth: 1.5, radius: 8 }
        },
        {
          id: "s2-ts-link"
          capability: "core.route"
          from: { nodeId: "s2-ts-a", anchor: "e" }
          to: { nodeId: "s2-ts-b", anchor: "w" }
          style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "s2-motion"
          capability: "motion.signal"
          from: { nodeId: "s2-ord", anchor: "center" }
          to: { nodeId: "s2-tstar", anchor: "center" }
          style: { stroke: @theme.accent.warning, strokeWidth: 2.2, fill: "none", opacity: 0.45 }
          accessibility: { label: "contrast signal" }
        }
      ]
      timeline: [
        { id: "s2-enter-hdr", at: 0, duration: 260, target: "s2-hdr", action: "enter" },
        { id: "s2-enter-steps", at: 80, duration: 200, action: "stagger", targets: ["s2-steps-step-0", "s2-steps-step-1", "s2-steps-step-2"], step: 70 },
        { id: "s2-enter-ord", at: 160, duration: 280, target: "s2-ord", action: "enter" },
        { id: "s2-enter-tstar", at: 280, duration: 280, target: "s2-tstar", action: "enter" },
        { id: "s2-draw-div", at: 480, duration: 200, target: "s2-div", action: "draw" },
        { id: "s2-enter-orda", at: 560, duration: 240, target: "s2-ord-a", action: "enter" },
        { id: "s2-draw-ordlink", at: 720, duration: 280, target: "s2-ord-link", action: "draw" },
        { id: "s2-enter-ordb", at: 820, duration: 240, target: "s2-ord-b", action: "enter" },
        { id: "s2-enter-tsa", at: 900, duration: 240, target: "s2-ts-a", action: "enter" },
        { id: "s2-draw-tslink", at: 1060, duration: 280, target: "s2-ts-link", action: "draw" },
        { id: "s2-enter-tsb", at: 1160, duration: 240, target: "s2-ts-b", action: "enter" },
        { id: "s2-draw-motion", at: 1400, duration: 800, target: "s2-motion", action: "draw" },
        { id: "s2-emph", at: 2100, duration: 400, target: "s2-tstar", action: "emphasis" }
      ]
    }
  }

  slide "The t* picture" {
    eyebrow: "The t* picture"
    title: "Four arrivals, one vertical cut"
    lede: "A toy four-turn trace (`n0…n3`) sits on a horizontal arrival timeline. A vertical `t*` rule chops history on the left from the live frontier on the right."

    narration: "Picture a recorded multi-turn graph as four nodes on an arrival timeline. t* is a vertical cut: arrivals before t* are warmup history; arrivals at or after t* are the live set that profiling will resume."

    term: {
      word: "t*"
      meaning: "A deterministic per-(trace, lane) sampling instant in microseconds that splits a trajectory into a warmup prefix and a profiled live set."
    }

    points: [
      "Motif: horizontal arrivals `n0…n3`; vertical `t*` rule in warning accent.",
      "Pre-`t*` history is muted; post-`t*` live nodes stay primary/green.",
      "Evidence: `rust/runtime/src/graph/snapshot.rs` — drop `arrival_offset_us < t*`, re-root survivors from `START`."
    ]

    caption: "n0 · n1 | t* | n2 · n3 — history left, live right."

    render: @scene {
      roots: [
        {
          id: "s3-hdr"
          capability: "core.header"
          title: "ARRIVALS TIMELINE · t* CUT"
          caption: "n0 · n1 | t* | n2 · n3 — history left, live right."
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "s3-n0"
          capability: "core.panel"
          title: "n0"
          detail: "turn 0"
          layout: { x: 40, y: 140, width: 100, height: 90 }
