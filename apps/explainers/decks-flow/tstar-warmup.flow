  slide "Why instance_id is reused" {
    eyebrow: "Why instance_id is reused"
    title: "Cache-bust marker continuity across the handoff"
    lede: "Profiling reuses the pressure `instance_id` verbatim so the per-instance cache-bust marker (`GraphCacheBust::marker` over the instance `trace_id`) stays continuous — KV transfers instead of cold-prefilling behind a fresh `.0`."

    narration: "The live pressure id at drain — e.g. t-1#0.p2 — becomes the resumed instance's id. That string feeds GraphCacheBust::marker. A fresh .0 id would look like a new instance to the server, forcing cold prefill and throwing away the KV built under pressure."

    term: {
      word: "GraphCacheBust::marker"
      meaning: "Per-instance cache-bust marker derived from a digest over the instance trace_id; continuous only when profiling reuses the pressure instance_id across the handoff."
    }

    points: [
      "Resume reuses pressure `instance_id` verbatim (`LaneResumeGraphTraceSource`).",
      "Marker is `GraphCacheBust::marker(trace_id)` — digests the instance id.",
      "Fresh `.0` would cold-prefill and discard pressure-built KV.",
      "Evidence: `rust/runtime/src/graph/warmup_handoff.rs` — `instance_id` docs; `graph_execution.rs` — `GraphCacheBust::marker`."
    ]

    caption: "Same id · same marker · warm KV transfers."

    render: @scene {
      sdk.Header(
        id = "s15-hdr",
        title = "REUSE THE PRESSURE ID",
        caption = "Same id · same marker · warm KV transfers.",
        x = 18, y = 16, width = 664, height = 44,
