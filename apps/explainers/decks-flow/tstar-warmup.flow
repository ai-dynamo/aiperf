  slide "Lanes with no handoff entry" {
    eyebrow: "Lanes with no handoff entry"
    title: "Completed-at-drain → fresh-start next cursor at t*=0"
    lede: "A lane index below `pressure_lane_count` with no entry in `lanes` completed exactly at drain. Profiling must fresh-start it: next cursor template, full `t*=0` replay — not a t* resume."

    narration: "Absence from the handoff map is load-bearing. Pressure already finished that lane's work; re-running a t* resume would duplicate executed history. Bounded profiling draws the next corpus template and dispatches the full original plan at t*=0 with a new instance id."

    term: {
      word: "completed-at-drain"
      meaning: "Lane index < pressure_lane_count with no LaneHandoff entry: profiling fresh-starts the next cursor template at full t*=0 replay."
    }

