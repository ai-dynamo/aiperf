  slide "What stays warm" {
    eyebrow: "What stays warm"
    title: "Server KV warms; the client still materializes the full prompt"
    lede: "Executed pre-`t*` turns leave KV on the server. The snapshot chop still keeps the full prompt segment path so the worker materializes the exact resume prompt."

    narration: "Warmup executes the prefix so the inference server holds KV for that history. On the client side, the snapshot chop leaves each survivor's prompt program unchanged — the pre-t* segments stay in the path so resume materializes the exact prompt, not a truncated one."

    term: {
      word: "prompt path unchanged"
      meaning: "After the trie chop, surviving nodes keep their full pre-t* segment program so BodyPlan materialization still rebuilds the exact resume prompt."
    }

    points: [
      "Server: KV for executed prefix turns stays warm across the handoff.",
      "Client: survivors keep the full prompt segment path — resume is exact, not truncated.",
      "Evidence: `rust/runtime/src/graph/snapshot.rs` — \"Leaves each surviving node's prompt segment program unchanged.\""
    ]

    caption: "Warm KV on the server · full prompt path on the client."

    render: @scene {
      sdk.Header(
        id = "s4-hdr",
        title = "SERVER KV · CLIENT PROMPT PATH",
        caption = "Warm KV on the server · full prompt path on the client.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s4-server",
        title = "Inference server",
        detail = "KV for n0 · n1",
        x = 50, y = 110, width = 220, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s4-kv",
        title = "Warm KV",
        detail = "executed prefix",
        x = 80, y = 240, width = 160, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Edge(
        id = "s4-sv-link",
