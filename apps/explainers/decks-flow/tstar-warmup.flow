  slide "Two phases, one plan" {
    eyebrow: "Two phases, one plan"
    title: "Warmup builds state; profiling resumes the same seeded t*"
    lede: "Warmup drains into a handoff payload. Both phases share the same seeded `t*` plan — profiling does not re-draw a new cut."

    narration: "Warmup executes the chopped prefix, pressure-recycles as configured, then builds a handoff payload. Profiling consumes that handoff once. Both phases share the same seeded t* plan and do not re-draw a new cut; the handoff still records the instance's t* instant plus frontier state the seed alone cannot reproduce."

    term: {
      word: "seeded t* plan"
      meaning: "Per-(trace, lane) t* drawn from WindowTStarSampler with a lane-salted SHA-256 seed; warmup and profiling share the same draw (not a new sample). LaneHandoff still records the instance's t_star_us plus frontier state the seed alone cannot reproduce."
    }

    points: [
      "Warmup builds `GraphWarmupHandoff`, whose per-lane `LaneHandoff` carries template, `instance_id`, `t_star_us`, executed nodes, and return walls.",
      "Same seed · not a new draw: both phases share the seeded t* plan; the handoff still records instance `t_star_us` plus frontier state the seed alone cannot reproduce.",
      "Profiling resumes at the recorded frontier; it does not sample a new t*.",
      "Evidence: `rust/runtime/src/graph/warmup_handoff.rs`; `rust/runtime/src/graph/tstar.rs`."
    ]

    caption: "Same seed · not a new draw · handoff records t_star_us + frontier."

    render: @scene {
      sdk.Header(
        id = "s5-hdr",
        title = "WARMUP → HANDOFF → PROFILE",
        caption = "Same seed · not a new draw · handoff records t_star_us + frontier.",
        x = 18, y = 16, width = 664, height = 44,
        surfaceRole = theme(surface.secondary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s5-warm",
        title = "Warmup phase",
        detail = "chop · execute · drain",
        x = 40, y = 120, width = 160, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s5-a1",
        mode = "connector",
        from = { nodeId: "s5-warm", anchor: "e" },
        to = { nodeId: "s5-hand", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "s5-hand",
        title = "Handoff",
        detail = "GraphWarmupHandoff payload",
        x = 260, y = 120, width = 160, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.tertiary)
      )
      sdk.Edge(
        id = "s5-a2",
        mode = "connector",
        from = { nodeId: "s5-hand", anchor: "e" },
        to = { nodeId: "s5-prof", anchor: "w" },
        style = { stroke: theme(accent.primary), strokeWidth: 2.2 }
      )
      sdk.Panel(
        id = "s5-prof",
        title = "Profiling",
        detail = "resume frontier",
        x = 480, y = 120, width = 160, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Panel(
        id = "s5-seed",
        title = "Shared seeded sampler",
        detail = "same t* · not re-drawn",
        x = 200, y = 260, width = 280, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.green)
      )
      sdk.Edge(
        id = "s5-seed-w",
        mode = "route",
        from = { nodeId: "s5-seed", anchor: "w" },
        to = { nodeId: "s5-warm", anchor: "s" },
        style = { stroke: theme(accent.green), strokeWidth: 2 }
      )
      sdk.Edge(
        id = "s5-seed-p",
        mode = "route",
        from = { nodeId: "s5-seed", anchor: "e" },
        to = { nodeId: "s5-prof", anchor: "s" },
        style = { stroke: theme(accent.green), strokeWidth: 2 }
      )
      sdk.Signal(
