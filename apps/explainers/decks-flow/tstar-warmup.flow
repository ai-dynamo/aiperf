        detail = "materialize resume",
        x = 400, y = 110, width = 240, height = 100,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Panel(
        id = "s4-path",
        title = "Full prompt path",
        detail = "pre-t* segments kept",
        x = 430, y = 240, width = 180, height = 70,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Edge(
        id = "s4-cl-link",
        mode = "route",
        from = { nodeId: "s4-client", anchor: "s" },
        to = { nodeId: "s4-path", anchor: "n" },
        style = { stroke: theme(accent.warning), strokeWidth: 2.2 }
      )
      sdk.Edge(
        id = "s4-bridge",
        mode = "connector",
        from = { nodeId: "s4-server", anchor: "e" },
        to = { nodeId: "s4-client", anchor: "w" },
        style = { stroke: theme(accent.tertiary), strokeWidth: 2.2 }
      )
      sdk.Signal(
        id = "s4-motion",
        from = { nodeId: "s4-kv", anchor: "center" },
        to = { nodeId: "s4-path", anchor: "center" },
        opacity = 0.5,
        strokeWidth = 2.2,
        label = "kv to prompt path",
        style = { stroke: theme(accent.tertiary) }
      )

      timeline main {
        at 0 reveal s4-hdr duration 260
        after s4-hdr reveal s4-server duration 280
        after s4-server trace s4-bridge duration 320
        after s4-bridge reveal s4-client duration 280
        after s4-client trace s4-sv-link duration 280
        after s4-sv-link reveal s4-kv duration 260
        after s4-kv trace s4-cl-link duration 280
        after s4-cl-link reveal s4-path duration 260
