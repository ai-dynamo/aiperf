        { id: "s4-enter-hdr", at: 0, duration: 260, target: "s4-hdr", action: "enter" },
        { id: "s4-enter-server", at: 180, duration: 280, target: "s4-server", action: "enter" },
        { id: "s4-draw-bridge", at: 420, duration: 320, target: "s4-bridge", action: "draw" },
        { id: "s4-enter-client", at: 560, duration: 280, target: "s4-client", action: "enter" },
        { id: "s4-draw-sv", at: 800, duration: 280, target: "s4-sv-link", action: "draw" },
        { id: "s4-enter-kv", at: 920, duration: 260, target: "s4-kv", action: "enter" },
        { id: "s4-draw-cl", at: 1100, duration: 280, target: "s4-cl-link", action: "draw" },
        { id: "s4-enter-path", at: 1220, duration: 260, target: "s4-path", action: "enter" },
        { id: "s4-draw-motion", at: 1500, duration: 900, target: "s4-motion", action: "draw" },
        { id: "s4-emph", at: 2300, duration: 400, target: "s4-path", action: "emphasis" }
      ]
    }
  }

  slide "Two phases, one plan" {
    eyebrow: "Two phases, one plan"
    title: "Warmup builds state; profiling resumes the same seeded t*"
    lede: "Warmup drains into a handoff payload. Both phases share the same seeded `t*` plan — profiling does not re-draw a new cut."

    narration: "Warmup executes the chopped prefix, pressure-recycles as configured, then builds a handoff payload. Profiling consumes that handoff once. Both phases share the same seeded t* plan and do not re-draw a new cut; the handoff still records the instance's t* instant plus frontier state the seed alone cannot reproduce."

    term: {
      word: "seeded t* plan"
      meaning: "Per-(trace, lane) t* drawn from WindowTStarSampler with a lane-salted SHA-256 seed; warmup and profiling share the same draw (not a new sample). LaneHandoff still records the instance's t_star_us plus frontier state the seed alone cannot reproduce."
    }

    points: [
