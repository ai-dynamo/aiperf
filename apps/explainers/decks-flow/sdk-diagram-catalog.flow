      sdk.Client(id = "variant-2", title = "Runner", detail = "scheduled execution", x = 279, y = 278, width = 152, height = 72, strokeRole = theme(accent.tertiary))
      sdk.Client(id = "variant-3", title = "Notebook", detail = "exploratory session", x = 505, y = 300, width = 137, height = 72, strokeRole = theme(accent.warning))
