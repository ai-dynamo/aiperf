  slide "Catalog composition" {
    eyebrow: "FINALE · COMPOSITION"
    title: "One architecture, many semantic roles"
    lede: "Compute, storage, messaging, control, and a trust boundary form one coherent benchmark path. Every node still expands through the production SDK used on its focused page."
    narration: "The field guide closes by composing families while preserving semantic references across nested boundary children."
    points: [
      "A trust boundary contains the measured request path and local result store.",
      "A health decision gates durable artifact publication."
    ]
    caption: "A small grammar scales from one specimen to a complete system."

