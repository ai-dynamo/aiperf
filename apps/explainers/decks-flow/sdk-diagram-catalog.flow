//! Chaptered visual catalog for every systems-diagram SDK primitive.

explainer "SDK Diagram Catalog" {
  id: "sdk-diagram-catalog"
  route: "/sdk-diagram-catalog"
  topic: "authoring"
  storagePrefix: "sdk-diagram-catalog-explainer"
  classPrefix: "deck-sdk-diagram-catalog"
  eyebrowLabel: "SDK DIAGRAM CATALOG"
  startGateTitle: "Systems-diagram component primitives"

  hub: {
    highlight: "Diagram primitives"
    title: "semantic nodes · production ports · composed systems"
    description: "A 49-slide field guide to every registered systems-diagram Flow SDK primitive."
  }

  slide "Diagram grammar" {
    eyebrow: "SDK · DIAGRAM"
    title: "A node grammar built for connection"
    lede: "Every primitive expands through the production SDK into a labeled node. Semantic ports connect roles such as read, producer, inbound, and branch.yes without naming generated children."
    narration: "The catalog begins with the shared grammar, then teaches each category through focused production examples."
    points: [
      "Stable instance IDs keep authored connections readable.",
      "Category ports preserve storage, messaging, network, and branch semantics."
    ]
    caption: "Connect intent, not generated geometry."

    render: @scene {
      sdk.Header(id = "header", title = "NODE GRAMMAR + SEMANTIC PORTS", caption = "One labeled grammar; category ports preserve meaning.", x = 18, y = 16, width = 664, height = 66, surfaceRole = theme(surface.secondary))
      sdk.Client(id = "source", title = "Author", detail = "component props", x = 40, y = 135, width = 140, height = 82, strokeRole = theme(accent.secondary))
      sdk.Service(id = "hero", title = "SDK node", detail = "stable instance id", x = 280, y = 120, width = 160, height = 110, strokeRole = theme(accent.green))
      sdk.Database(id = "sink", title = "Scene IR", detail = "validated output", x = 520, y = 135, width = 140, height = 82, strokeRole = theme(accent.tertiary))
      sdk.Edge(id = "edge-in", mode = "route", from = ref("source.output"), to = ref("hero.input"), style = { stroke: theme(accent.secondary), strokeWidth: 2.2, fill: "none" })
      sdk.Edge(id = "edge-out", mode = "route", from = ref("hero.output"), to = ref("sink.write"), style = { stroke: theme(accent.green), strokeWidth: 2.2, fill: "none" })
      sdk.Endpoint(id = "variant-1", title = "input", detail = "semantic ref", x = 70, y = 285, width = 140, height = 72)
      sdk.Queue(id = "variant-2", title = "producer", detail = "category port", x = 280, y = 285, width = 140, height = 72)
      sdk.Decision(id = "variant-3", title = "branch.yes", detail = "named outcome", x = 490, y = 280, width = 140, height = 68, branches = ["yes", "no"])
      timeline main {
        at 0 reveal header duration 160
        after header reveal hero duration 260
        after hero reveal source duration 180
        after source trace edge-in duration 220
        after edge-in reveal sink duration 180
        after sink trace edge-out duration 220
        after edge-out stagger targets [variant-1, variant-2, variant-3] step 120 duration 180
      }
    }
  }

  slide "Chapter 1: Actors and compute" {
    eyebrow: "CHAPTER 1 · 9 PRIMITIVES"
    title: "Actors and compute"
    lede: "Actors and compute primitives share a visual grammar while retaining their system-level meaning."
    narration: "Chapter 1 introduces actors and compute before the focused specimens."
    points: [
      "Three specimens preview the chapter’s shared visual grammar.",
      "Focused pages follow in a deliberate teaching sequence."
    ]
    caption: "9 primitives · focused examples follow."

    render: @scene {
      sdk.Header(id = "header", title = "ACTORS AND COMPUTE", caption = "Chapter 1 · 9 focused primitives", x = 18, y = 16, width = 664, height = 66, surfaceRole = theme(surface.secondary))
      sdk.User(id = "preview-user", title = "Run owner", detail = "starts a measured run", x = 80, y = 175, width = 140, height = 76, strokeRole = theme(ink.secondary))
      sdk.Service(id = "preview-service", title = "Inference API", detail = "owns request behavior", x = 285, y = 175, width = 140, height = 76, strokeRole = theme(accent.green))
      sdk.Cloud(id = "preview-cloud", title = "Remote region", detail = "hosts distributed cells", x = 490, y = 175, width = 140, height = 76, strokeRole = theme(ink.secondary))
      sdk.Label(id = "chapter-note", text = "actors and compute · one semantic role at a time", x = 100, y = 300, width = 500, height = 24, fontSize = 12, align = "middle")
      timeline main {
        at 0 reveal header duration 180
        after header reveal preview-service duration 240
        after preview-service stagger targets [preview-user, preview-cloud] step 140 duration 180
        after preview-cloud reveal chapter-note duration 160
      }
    }
  }

  slide "sdk.user" {
    eyebrow: "ACTORS AND COMPUTE · SDK.USER"
    title: "User: Run owner"
    lede: "Starts a measured run. The hero appears in a believable relationship while three quieter specimens compare concrete states."
    narration: "The User hero is followed by Analyst, SRE, and Researcher variants."
    points: [
      "Run owner anchors the primary user example.",
      "The surrounding nodes clarify who owns work before and after this compute role."
    ]
    caption: "Actors establish ownership before infrastructure begins."

    render: @scene {
      sdk.Header(id = "header", title = "USER", caption = "Actors establish ownership before infrastructure begins.", x = 18, y = 16, width = 664, height = 66, surfaceRole = theme(surface.secondary))
      sdk.Client(id = "source", title = "Workbench", detail = "upstream", x = 38, y = 140, width = 135, height = 72)
      sdk.User(id = "hero", title = "Run owner", detail = "starts a measured run", x = 265, y = 112, width = 180, height = 110, strokeRole = theme(accent.green))
      sdk.Service(id = "sink", title = "Profile API", detail = "downstream", x = 525, y = 140, width = 135, height = 72)
      sdk.Edge(id = "edge-in", mode = "route", from = ref("source.output"), to = ref("hero.input"), style = { stroke: theme(accent.secondary), strokeWidth: 2.2, fill: "none" })
      sdk.Edge(id = "edge-out", mode = "route", from = ref("hero.output"), to = ref("sink.input"), style = { stroke: theme(accent.green), strokeWidth: 2.2, fill: "none" })
      sdk.User(id = "variant-1", title = "Analyst", detail = "owns analysis", x = 58, y = 300, width = 142, height = 72, strokeRole = theme(ink.secondary))
      sdk.User(id = "variant-2", title = "SRE", detail = "guards production", x = 279, y = 278, width = 152, height = 72, strokeRole = theme(accent.tertiary))
      sdk.User(id = "variant-3", title = "Researcher", detail = "explores models", x = 505, y = 300, width = 137, height = 72, strokeRole = theme(accent.warning))
      timeline main {
        at 0 reveal header duration 160
        after header reveal hero duration 260
        after hero stagger targets [source, sink] step 100 duration 180
        after sink trace edge-in duration 220
        after edge-in trace edge-out duration 220
        after edge-out stagger targets [variant-2, variant-1, variant-3] step 120 duration 180
      }
    }
  }

  slide "sdk.client" {
