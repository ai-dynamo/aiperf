      sdk.Header(id = "header", title = "CATALOG COMPOSITION", caption = "Compute, storage, messaging, control, and trust compose without stand-ins.", x = 63.6, y = 43.2, width = 1792.8, height = 178.2, surfaceRole = theme(surface.secondary))
