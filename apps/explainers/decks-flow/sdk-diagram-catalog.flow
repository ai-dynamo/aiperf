  slide "Catalog composition" {
    eyebrow: "FINALE · COMPOSITION"
    title: "One architecture, many semantic roles"
    lede: "Compute, storage, messaging, control, and a trust boundary form one coherent benchmark path. Every node still expands through the production SDK used on its focused page."
    narration: "The field guide closes by composing families while preserving semantic references across nested boundary children."
    points: [
      "A trust boundary contains the measured request path and local result store.",
      "A health decision gates durable artifact publication."
    ]
    caption: "A small grammar scales from one specimen to a complete system."

    render: @scene {
      sdk.Header(id = "header", title = "CATALOG COMPOSITION", caption = "Compute, storage, messaging, control, and trust compose without stand-ins.", x = 18, y = 16, width = 664, height = 66, surfaceRole = theme(surface.secondary))
      sdk.TrustBoundary(id = "trust", title = "Benchmark trust boundary", x = 150, y = 92, width = 530, height = 180, strokeRole = theme(accent.green)) {
        children {
          sdk.Client(id = "client", title = "Load client", detail = "authors turns", x = 10, y = 62, width = 110, height = 68)
          sdk.Queue(id = "queue", title = "Ready queue", detail = "admitted", x = 145, y = 62, width = 110, height = 68)
          sdk.Service(id = "service", title = "Inference", detail = "dispatch", x = 280, y = 62, width = 110, height = 68)
          sdk.Database(id = "results", title = "Results", detail = "folded", x = 415, y = 62, width = 105, height = 68)
        }
      }
      sdk.User(id = "operator", title = "Operator", detail = "owns intent", x = 10, y = 145, width = 90, height = 72)
      sdk.Decision(id = "gate", title = "Healthy?", detail = "control gate", x = 300, y = 300, width = 130, height = 72, branches = ["no", "yes"], strokeRole = theme(accent.warning))
      sdk.Cloud(id = "archive", title = "Artifact cloud", detail = "durable outputs", x = 535, y = 300, width = 140, height = 72)
      sdk.Edge(id = "final-in", mode = "route", from = ref("operator.output"), to = ref("trust.child.0.input"), style = { stroke: theme(accent.secondary), strokeWidth: 2.2, fill: "none" })
      sdk.Edge(id = "final-flow-1", mode = "route", from = ref("trust.child.0.output"), to = ref("trust.child.1.producer"), style = { stroke: theme(accent.green), strokeWidth: 2.2, fill: "none" })
      sdk.Edge(id = "final-flow-2", mode = "route", from = ref("trust.child.1.consumer"), to = ref("trust.child.2.input"), style = { stroke: theme(accent.green), strokeWidth: 2.2, fill: "none" })
      sdk.Edge(id = "final-store", mode = "route", from = ref("trust.child.2.output"), to = ref("trust.child.3.write"), style = { stroke: theme(accent.secondary), strokeWidth: 2.2, fill: "none" })
      sdk.Edge(id = "final-gate-in", mode = "route", from = ref("trust.child.3.read"), to = ref("gate.input"), style = { stroke: theme(accent.warning), strokeWidth: 2.2, fill: "none" })
      sdk.Edge(id = "final-gate-out", mode = "route", from = ref("gate.branch.yes"), to = ref("archive.input"), style = { stroke: theme(accent.tertiary), strokeWidth: 2.2, fill: "none" })
      timeline main {
        at 0 reveal header duration 180
        after header reveal trust duration 260
        after trust reveal operator duration 180
        after operator trace final-in duration 220
        after final-in trace final-flow-1 duration 220
        after final-flow-1 trace final-flow-2 duration 220
        after final-flow-2 trace final-store duration 220
        after final-store reveal gate duration 180
        after gate reveal archive duration 180
        after archive trace final-gate-in duration 220
        after final-gate-in trace final-gate-out duration 220
      }
    }
  }

