  slide "Chapter 2: Storage" {
    eyebrow: "CHAPTER 2 · 6 PRIMITIVES"
    title: "Storage"
    lede: "Storage primitives share a visual grammar while retaining their system-level meaning."
    narration: "Chapter 2 introduces storage before the focused specimens."
    points: [
      "Three specimens preview the chapter’s shared visual grammar.",
      "Focused pages follow in a deliberate teaching sequence."
