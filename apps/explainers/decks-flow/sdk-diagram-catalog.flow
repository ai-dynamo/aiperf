      sdk.Edge(id = "edge-out", mode = "route", from = ref("hero.output"), to = ref("sink.input"), style = { stroke: theme(accent.green), strokeWidth: 5.94, fill: "none" })
      sdk.User(id = "variant-1", title = "Analyst", detail = "owns analysis", x = 171.6, y = 810, width = 383.4, height = 194.4, strokeRole = theme(ink.secondary))
      sdk.User(id = "variant-2", title = "SRE", detail = "guards production", x = 768.3, y = 750.6, width = 410.4, height = 194.4, strokeRole = theme(accent.tertiary))
      sdk.User(id = "variant-3", title = "Researcher", detail = "explores models", x = 1378.5, y = 810, width = 369.9, height = 194.4, strokeRole = theme(accent.warning))
      timeline main {
        at 0 reveal header duration 160
        after header reveal hero duration 260
        after hero stagger targets [source, sink] step 100 duration 180
        after sink trace edge-in duration 220
        after edge-in trace edge-out duration 220
        after edge-out stagger targets [variant-2, variant-1, variant-3] step 120 duration 180
      }
    }
  }

