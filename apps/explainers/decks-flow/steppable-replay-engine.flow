  }

  slide "The livelock guard: same_instant_control_steps" {
    eyebrow: "12 · Livelock guard"
    title: "made_progress must be true at every same-timestamp iteration, or the loop trips a 1024-iteration breaker"
    lede: "made_progress is the disjunction of five independent signals: a submission happened, the clock advanced, events were non-empty, in_flight changed, or next_event_ms itself changed. If none of those held at a fixed next_ms, same_instant_control_steps increments; hitting 1024 is a hard bail with a full liveness dump — engine_now, in_flight, is_idle, next_engine, next_ready."
    narration: "This guard exists precisely because of the balanced liveness contract documented in the mocker's offline replay module: an empty effects queue is not proof of quiescence while workers own unfinished requests, but repeatedly reporting an effect-free zero-duration pass at the same timestamp is livelock, not progress. The DynoSim driver enforces the caller side half of that contract independently of the mocker's own progress filtering — it has to, because it's now the one driving the clock."
    term: {
      word: "made_progress"
      meaning: "submitted || now_ms > before_ms || !outcome.events.is_empty() || after_in_flight != before_in_flight || after_event_ms != before_event_ms — any one of these being true resets the same-instant counter to zero."
    }
    points: [
      "Five independent OR'd signals — deliberately redundant so a change no single signal would catch (e.g. in_flight count shifting with zero emitted events) still counts as progress.",
      "same_instant_control_steps.saturating_add(1) on failure; ensure!(< 1_024, ...) is the trip point.",
      "Panic message dumps engine.now_ms(), in_flight(), is_idle(), next_event_ms(), and driver.next_ready_time_ms() — everything needed to diagnose a real deadlock vs. a false trip.",
      "This is the caller half of the balanced liveness contract; mocker's own made_progress filtering (PR #10919) is the callee half, inside drain_current_timestamp."
    ]
    caption: "same next_ms with no made_progress signal, 1024 times running → hard bail with full liveness state."

    render: @scene {
      sdk.Header(id = "s11-hdr", title = "LIVELOCK GUARD", caption = "same_instant_control_steps < 1_024", x = 48.6, y = 43.2, width = 1792.8, height = 118.8, surfaceRole = theme(surface.primary), inkRole = theme(ink.secondary))
      sdk.PropertyList(
        id = "s11-table",
        title = "made_progress signals (any resets the counter)",
        entries = [{ key: "submitted", value: "arrival popped this iteration" }, { key: "now_ms > before_ms", value: "clock actually advanced" }, { key: "!events.is_empty()", value: "emitted >= 1 EngineEvent" }, { key: "in_flight changed", value: "differs before/after step" }, { key: "next_event_ms changed", value: "engine lookahead moved" }],
        x = 54, y = 216, width = 1080, height = 460
      )
      sdk.Stat(id = "s11-gauge", title = "same_instant_control_steps", items = ["trip point: 1_024", "resets on any made_progress signal"], x = 54, y = 720, width = 480, height = 160)
      sdk.CodeBlock(
        id = "s11-code",
        text = "ensure!(same_instant_control_steps < 1_024, \"…\");",
        x = 570, y = 720, width = 500, height = 160,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.danger)
      )
      sdk.Callout(
        id = "s11-callout",
        text = "caller-side half of the balanced liveness contract; mocker's PR #10919 filtering is the callee-side half",
        x = 1104, y = 720, width = 762, height = 160,
        strokeRole = theme(accent.warning)
      )

      timeline main {
        at 0 reveal s11-hdr duration 220
        after s11-hdr reveal s11-table duration 320
        after s11-table reveal s11-gauge duration 220
        after s11-gauge reveal s11-code duration 300
        after s11-code reveal s11-callout duration 260
      }
    }
  }

  slide "Observer fan-out: one engine event, two independent sinks" {
    eyebrow: "13 · Consumer wiring"
    title: "CollectorObserver and NativeMetricsObserver both consume the same on_admit / on_classified_token / on_terminal stream"
    lede: "dynosim.rs builds one ObserverTee over a Vec<Rc<dyn RequestObserver>> — a CollectorObserver for aiperf's own report stack and a NativeMetricsObserver carrying per-request RequestMetricMetadata (conversation_id, turn_index, correlation_id) — and drives both from the identical EngineEvent stream the SteppableReplay engine emits."
    narration: "This is the payoff of the whole seam: AIPerf's own observability stack — its metrics, its collector, its report format — never has to know the mocker's scheduling internals. It only has to translate each engine event into its own arrival, admit, classified token, usage, and terminal calls, fan them out through the observer tee, and separately feed the equivalent output-token, complete, terminal, and release calls back into the workload driver so session and turn state advances in lockstep with what the engine actually emitted."
    term: {
      word: "ObserverTee"
      meaning: "Fan-out RequestObserver that forwards each event call to every delegate in its Vec<Rc<dyn RequestObserver>> — here, a CollectorObserver and a NativeMetricsObserver receiving the identical event stream derived from engine.step_until()'s outcome.events."
    }
    points: [
      "observer.on_arrival at submit time; observer.on_admit only once, gated by client.admitted, using engine.request_admission(uuid).",
      "event.token_id.is_some() -> driver.on_output_token + observer.on_classified_token(ObservedTokenKind::Output).",
      "event.terminal_status.is_some() -> observer.on_usage(ObservedUsage{prompt_tokens, completion_tokens}) then observer.on_terminal(map_terminal_status(status)).",
      "Terminal status also branches back into the driver: Completed -> on_complete, Rejected -> on_terminal(true), Canceled|Failed -> release_cap_slot — three different session-state transitions from one EngineEvent enum."
    ]
    caption: "one EngineEvent stream → ObserverTee fan-out (report + metrics) and → WorkloadDriver session/turn state, kept in lockstep."

    render: @scene {
      sdk.Header(id = "s12-hdr", title = "OBSERVER FAN-OUT", caption = "one EngineEvent stream, two independent sinks", x = 48.6, y = 43.2, width = 1792.8, height = 118.8, surfaceRole = theme(surface.primary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "s12-event", title = "EngineEvent", detail = "outcome.events", x = 702, y = 237.6, width = 405, height = 135, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.warning))
      sdk.Edge(id = "s12-a1", mode = "connector", from = { nodeId: "s12-event", anchor: "sw" }, to = { nodeId: "s12-tee", anchor: "n" }, style = { stroke: theme(accent.warning), strokeWidth: 5.4, fill: "none" })
      sdk.Edge(id = "s12-a2", mode = "connector", from = { nodeId: "s12-event", anchor: "se" }, to = { nodeId: "s12-driver", anchor: "n" }, style = { stroke: theme(accent.secondary), strokeWidth: 5.4, fill: "none" })
      sdk.EventBus(id = "s12-tee", label = "ObserverTee", x = 162, y = 453.6, width = 594, height = 118.8)
      sdk.Edge(id = "s12-a3", mode = "connector", from = { nodeId: "s12-tee", anchor: "sw" }, to = { nodeId: "s12-coll", anchor: "n" }, style = { stroke: theme(accent.primary), strokeWidth: 5.4, fill: "none" })
      sdk.Edge(id = "s12-a4", mode = "connector", from = { nodeId: "s12-tee", anchor: "se" }, to = { nodeId: "s12-metrics", anchor: "n" }, style = { stroke: theme(accent.primary), strokeWidth: 5.4, fill: "none" })
      sdk.DataStore(id = "s12-coll", label = "CollectorObserver", detail = "aiperf report stack", x = 54, y = 658.8, width = 378, height = 151.2)
      sdk.DataStore(id = "s12-metrics", label = "NativeMetricsObserver", detail = "RequestMetricMetadata", x = 486, y = 658.8, width = 378, height = 151.2)
      sdk.Panel(id = "s12-driver", title = "WorkloadDriver", detail = "on_output_token / on_complete\non_terminal / release_cap_slot", x = 1080, y = 453.6, width = 756, height = 226.8, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
      sdk.PropertyList(
        id = "s12-table",
        title = "terminal_status → driver call",
        entries = [{ key: "Completed", value: "on_complete(uuid, now_ms)" }, { key: "Rejected", value: "on_terminal(uuid, now_ms, true)" }, { key: "Canceled | Failed", value: "release_cap_slot(uuid, now_ms)" }],
        x = 1080, y = 707.4, width = 756, height = 259.2
      )

      timeline main {
