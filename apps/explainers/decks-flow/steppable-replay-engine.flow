  slide "Parity as the design invariant" {
    eyebrow: "14 · Closing invariant"
    title: "The seam's entire justification is one equivalence: externally-clocked stepping must byte-match run()"
    lede: "deadline_bounded_steps_preserve_request_measurements is the strongest test in the suite: it runs identical workloads through unbounded stepping and through repeated one-millisecond step_until calls, and asserts the serialized per_request records are byte-identical — not just equal counts, the full JSON serialization."
    narration: "Every mechanism in this deck exists to protect that one equivalence. The engine event's single construction point keeps the emitted-token flag truthful. The deferred-drive delta cycle split keeps external admission from landing one step late. The step-until deadline semantics keep an external discrete-event driver from perturbing batch composition. The livelock guard keeps the DynoSim driver's own outer loop honest about whether it actually made progress. None of it changes what the runtime computes — it only changes who owns the clock."
    term: {
      word: "byte-identical serialization"
      meaning: "serde_json::to_vec(&unbounded_report.per_request) == serde_json::to_vec(&bounded_report.per_request) — the test's actual assertion; not approximate equality, exact serialized bytes."
    }
    points: [
      "assert_eq! on num_requests, completed_requests, total_input_tokens, total_output_tokens, latency.ttft.mean_ms, latency.itl.distribution.mean_ms.",
      "assert_eq! on serde_json::to_vec(&per_request) for both reports — the strongest possible check.",
      "Test runs under tokio::runtime::Builder::new_current_thread().enable_time().start_paused(true) — paused virtual time, so wall-clock never leaks into the comparison.",
      "The invariant this protects: 'external idle checkpoints must not change per-request perf timestamps' — quoted directly from the test's own assertion message."
    ]
    caption: "unbounded stepping ≡ 1ms-clamped stepping, byte-for-byte — the whole seam exists to keep that true."

    render: @scene {
      sdk.Header(id = "s13-hdr", title = "PARITY INVARIANT", caption = "deadline_bounded_steps_preserve_request_measurements", x = 48.6, y = 43.2, width = 1792.8, height = 118.8, surfaceRole = theme(surface.primary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "s13-unb", title = "unbounded", detail = "while !idle { step() }", x = 81, y = 248.4, width = 540, height = 172.8, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
      sdk.Panel(id = "s13-bnd", title = "1ms-clamped", detail = "while !idle { step_until(now+1ms) }", x = 1171.8, y = 248.4, width = 540, height = 172.8, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.warning))
      sdk.Edge(id = "s13-a1", mode = "connector", from = { nodeId: "s13-unb", anchor: "s" }, to = { nodeId: "s13-eq", anchor: "nw" }, style = { stroke: theme(accent.secondary), strokeWidth: 6.48, fill: "none" })
      sdk.Edge(id = "s13-a2", mode = "connector", from = { nodeId: "s13-bnd", anchor: "s" }, to = { nodeId: "s13-eq", anchor: "ne" }, style = { stroke: theme(accent.warning), strokeWidth: 6.48, fill: "none" })
      sdk.Decision(id = "s13-eq", label = "serde_json::to_vec(per_request) ==", x = 540, y = 502.2, width = 702, height = 124.2)
      sdk.CodeBlock(
        id = "s13-code",
        text = "assert_eq!(to_vec(&unbounded.per_request), to_vec(&bounded.per_request), \"idle checkpoints must not change timestamps\");",
        x = 108, y = 664.2, width = 1593, height = 205.2,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )
      sdk.Badge(id = "s13-badge", text = "start_paused(true) — no wall-clock leakage", x = 540, y = 907.2, width = 702, height = 70.2, variant = "info")

      timeline main {
        at 0 reveal s13-hdr duration 220
        after s13-hdr reveal s13-unb duration 220
        after s13-unb reveal s13-bnd duration 220
        after s13-bnd trace s13-a1 duration 220
        after s13-a1 trace s13-a2 duration 220
        after s13-a2 reveal s13-eq duration 240
        after s13-eq reveal s13-code duration 320
        after s13-code reveal s13-badge duration 220
      }
    }
  }
