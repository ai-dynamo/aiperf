      sdk.LoadBalancer(id = "s4-router", label = "ReplayRouterMode", detail = "RoundRobin | KvRouter", x = 54, y = 405, width = 810, height = 145.8)
      sdk.Edge(id = "s4-a2", mode = "connector", from = { nodeId: "s4-router", anchor: "s" }, to = { nodeId: "s4-w1", anchor: "n" }, style = { stroke: theme(accent.secondary), strokeWidth: 5.4, fill: "none" })
