      sdk.Edge(id = "s6-a2", mode = "connector", from = { nodeId: "s6-prefill", anchor: "e" }, to = { nodeId: "s6-decode", anchor: "w" }, style = { stroke: theme(accent.warning), strokeWidth: 5.94, fill: "none" }, label = "KV handoff")
      sdk.Cluster(id = "s6-decode", label = "decode pool", detail = "decode_args × decode_workers", x = 920.7, y = 243, width = 445.5, height = 216)
      sdk.Edge(id = "s6-a3", mode = "connector", from = { nodeId: "s6-decode", anchor: "e" }, to = { nodeId: "s6-caller", anchor: "w" }, style = { stroke: theme(accent.secondary), strokeWidth: 5.94, fill: "none" })
      sdk.Panel(id = "s6-caller", title = "caller", detail = "decode-visible tokens only", x = 1468.8, y = 259.2, width = 324, height = 183.6, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
