  slide "step_until: deadline-bounded stepping without changing composition" {
    eyebrow: "8 · Deadlines"
    title: "Routed runtimes stop at the deadline; the direct wrapper cannot stop at all"
    lede: "step_until(until_ms) lets an external DES driver interleave arrivals and firing gates without changing batch composition — the routed engines' internal event heap can genuinely halt mid-sequence at a deadline, because their next unit of work is a heap pop, not an already-dispatched scheduler pass."
    narration: "The trait's default step-until body just calls step and bails on any finite deadline — that default is what the single-worker engine inherits, because a direct wrapper has no way to interrupt an execute pass once it starts. The aggregated and disaggregated wrappers override it: they forward to the runtime's own deadline-aware stepping, which can stop because their event-heap-driven loop can pause between heap pops. The deadline-bounded test is the proof: it runs the same workload once unbounded and once through repeated one-millisecond step-until calls, and asserts the resulting per-request timestamps serialize identically."
    term: {
      word: "step_until(until_ms)"
      meaning: "Advance at most through until_ms, emitting events at or before that deadline. Aggregated/disaggregated stop exactly at the deadline when their next internal event is later; the direct wrapper rejects any finite deadline outright."
    }
    points: [
      "Default trait body: if until_ms.is_finite() { bail!(...) } else { self.step() } — SteppableEngine uses this unmodified.",
      "SteppableAgg::step_until / SteppableDisagg::step_until: both forward to rt.step_dynamic_until(until_ms), which is genuinely deadline-aware.",
      "aggregate_step_until_never_crosses_external_deadline: steps to a 0.000001ms deadline and asserts outcome.end_ms <= deadline_ms and the engine stays non-idle.",
      "deadline_bounded_steps_preserve_request_measurements: unbounded vs. 1ms-clamped stepping produce byte-identical serialized per_request records — deadline clamping never perturbs scheduling outcomes."
    ]
    caption: "default body: step() + reject finite deadline. Routed engines override with a real heap-aware stop."

    render: @scene {
      sdk.Header(id = "s7-hdr", title = "STEP_UNTIL SEMANTICS", caption = "deadline-bounded, composition-preserving", x = 48.6, y = 43.2, width = 1792.8, height = 118.8, surfaceRole = theme(surface.primary), inkRole = theme(ink.secondary))
      sdk.PropertyList(
        id = "s7-cmp-left",
        title = "SteppableEngine (default body)",
        entries = [{ key: "finite deadline", value: "Err: cannot stop mid-pass" }, { key: "mechanism", value: "single execute_pass, uncuttable" }, { key: "infinite", value: "self.step()" }],
        x = 54, y = 248.4, width = 864, height = 307.8
      )
      sdk.PropertyList(
        id = "s7-cmp-right",
        title = "SteppableAgg / SteppableDisagg (override)",
        entries = [{ key: "finite deadline", value: "stops at until_ms exactly" }, { key: "mechanism", value: "event-heap pop, cuttable" }, { key: "infinite", value: "rt.step_dynamic_until(INF)" }],
        x = 972, y = 248.4, width = 864, height = 307.8
      )
      sdk.CodeBlock(
        id = "s7-code",
        text = "fn step_until(until_ms) { if until_ms.is_finite() { bail!(\"cannot stop at finite deadline\"); } self.step() }",
        x = 54, y = 594, width = 1080, height = 270,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Stat(id = "s7-stat", title = "test tolerance", items = ["0.000001ms", "aggregate_step_until_never_crosses_deadline"], x = 1188, y = 594, width = 648, height = 216)
      sdk.Callout(
        id = "s7-callout",
        text = "identical serialized per_request records: unbounded vs. 1ms-clamped stepping",
        x = 1188, y = 837, width = 648, height = 178.2,
        strokeRole = theme(accent.primary)
      )

      timeline main {
        at 0 reveal s7-hdr duration 220
        after s7-hdr reveal s7-cmp-left duration 260
        after s7-cmp-left reveal s7-cmp-right duration 260
        after s7-cmp-right reveal s7-code duration 300
        after s7-code reveal s7-stat duration 220
        after s7-stat reveal s7-callout duration 260
      }
    }
  }

  slide "next_event_ms: the caller's DES pump signal" {
    eyebrow: "9 · DES pump"
    title: "Three implementations of the same question: when can this engine next make progress?"
    lede: "next_event_ms is what turns a SteppableReplay into something a caller can drive as a discrete-event pump: min(next_pacer_deadline, engine.next_event_ms()) tells the caller exactly how far virtual time can safely advance before it must hand control back to the engine."
    narration: "For the single-worker engine, there's no event heap, so the answer collapses to a binary: now, if the worker holds any request, or nothing if it's empty. For the aggregated and disaggregated runtimes, the next-event query forwards to the runtime's own next timestamp — the runtime's own event heap, which is the minimum of the next arrival, the next scheduled engine event, and the next KV offload. The doc comment on the trait spells out the caller contract directly: advance virtual time to the earlier of the next pacer deadline and the next event, then step."
    term: {
      word: "next_timestamp"
      meaning: "AggRuntime/DisaggRuntime's own event-heap query: min(next_arrival, next_event, next_offload) — the earliest instant at which the routed runtime has anything to do."
    }
    points: [
      "SteppableEngine::next_event_ms: worker.is_empty() ? None : Some(now_ms) — no heap, no lookahead.",
      "SteppableAgg / SteppableDisagg::next_event_ms: self.rt.next_timestamp() — a real min-heap query over arrival/event/offload.",
      "Caller contract (trait doc): advance virtual time to min(next_pacer_deadline, next_event_ms()), then step.",
      "dynosim.rs composes this with its own driver's next_ready_time_ms() to compute one fused next_ms per outer loop iteration — the next slide."
    ]
    caption: "next_event_ms() is the engine half of a two-heap min; the caller supplies the other half."

    render: @scene {
      sdk.Header(id = "s8-hdr", title = "NEXT_EVENT_MS", caption = "the caller's DES pump signal", x = 48.6, y = 43.2, width = 1792.8, height = 118.8, surfaceRole = theme(surface.primary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "s8-single", title = "SteppableEngine", detail = "is_empty() ? None : Some(now_ms)", x = 54, y = 248.4, width = 810, height = 199.8, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
      sdk.Panel(id = "s8-routed", title = "SteppableAgg / SteppableDisagg", detail = "rt.next_timestamp() = min(arrival, event, offload)", x = 945, y = 248.4, width = 810, height = 199.8, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.warning))
      sdk.Edge(id = "s8-a1", mode = "connector", from = { nodeId: "s8-single", anchor: "s" }, to = { nodeId: "s8-caller", anchor: "nw" }, style = { stroke: theme(accent.secondary), strokeWidth: 5.4, fill: "none" })
      sdk.Edge(id = "s8-a2", mode = "connector", from = { nodeId: "s8-routed", anchor: "s" }, to = { nodeId: "s8-caller", anchor: "ne" }, style = { stroke: theme(accent.warning), strokeWidth: 5.4, fill: "none" })
      sdk.Panel(id = "s8-caller", title = "caller: min(pacer_deadline, next_event_ms())", detail = "then step", x = 405, y = 567, width = 999, height = 162, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.CodeBlock(
        id = "s8-code",
        text = "// caller advances to min(next_pacer_deadline, next_event_ms()), then steps\nfn next_event_ms(&mut self) -> Option<f64>;",
        x = 54, y = 810, width = 1701, height = 189,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.primary)
      )

      timeline main {
        at 0 reveal s8-hdr duration 220
        after s8-hdr reveal s8-single duration 240
        after s8-single reveal s8-routed duration 240
        after s8-routed trace s8-a1 duration 220
        after s8-a1 trace s8-a2 duration 220
        after s8-a2 reveal s8-caller duration 240
        after s8-caller reveal s8-code duration 260
      }
    }
  }

  slide "Read-after-completion facts: request_admission and actual_output_length" {
    eyebrow: "10 · Post-hoc reads"
    title: "The engine's own collector is the source of truth for admission time and true OSL"
    lede: "request_latencies/request_admission/actual_output_length exist so the caller never has to re-derive facts the runtime already measured internally — the caller stamps arrival/e2e from its own clock (identical to the engine's, since admission happens at the caller's advance_now_ms), and reads everything else back from the engine."
    narration: "The request admission query returns the first scheduler admission — its time and how many input tokens were reused — once known; it defaults to nothing, so topologies that don't track prefix cache reuse don't have to implement it. The actual output length query returns the output tokens truly emitted for a request, which the caller uses in preference to counting its own observed token events, because the engine's count is authoritative even if the caller missed an event ordering edge case."
    term: {
      word: "reused_input_tokens"
      meaning: "Part of request_admission's return value — the prompt tokens the scheduler served from prefix cache rather than recomputing, read back from the engine's own admission bookkeeping rather than estimated by the caller."
    }
    points: [
      "request_latencies(uuid) -> Option<(ttft_ms, mean_itl_ms)> — read on completion to build the caller's own per-request record.",
      "request_admission(uuid) -> Option<(at_ms, reused_input_tokens)> — trait-default None; topologies opt in.",
      "actual_output_length(uuid) -> Option<usize> — the authoritative OSL, used in dynosim.rs as completion_tokens.unwrap_or(client.observed_output_tokens).",
      "All three are collector pass-throughs: self.collector.request_latencies(uuid), etc. — no new bookkeeping in the steppable layer itself."
    ]
    caption: "the collector already measured this; the steppable seam just exposes it, it does not recompute it."

    render: @scene {
      sdk.Header(id = "s9-hdr", title = "POST-HOC READS", caption = "collector pass-throughs, not new bookkeeping", x = 48.6, y = 43.2, width = 1792.8, height = 118.8, surfaceRole = theme(surface.primary), inkRole = theme(ink.secondary))
      sdk.PropertyList(
        id = "s9-table",
        title = "Read methods → default",
        entries = [{ key: "request_latencies(uuid)", value: "collector pass-through" }, { key: "request_admission(uuid)", value: "None (opt-in)" }, { key: "actual_output_length(uuid)", value: "collector pass-through" }],
        x = 54, y = 248.4, width = 891, height = 291.6
      )
      sdk.CodeBlock(
        id = "s9-code",
        text = "trait default: fn request_admission(&self, _uuid) -> Option<(f64, usize)> { None }",
        x = 54, y = 567, width = 891, height = 432,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.warning)
      )
      sdk.Panel(id = "s9-usage", title = "dynosim.rs usage", detail = "completion_tokens = engine\n  .actual_output_length(uuid)\n  .unwrap_or(observed_output_tokens);", x = 999, y = 248.4, width = 837, height = 291.6, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Callout(
        id = "s9-callout",
        text = "caller's own clock stamps arrival/e2e; engine's collector stamps everything internal",
        x = 999, y = 567, width = 837, height = 243,
        strokeRole = theme(accent.secondary)
      )

      timeline main {
        at 0 reveal s9-hdr duration 220
        after s9-hdr reveal s9-table duration 300
        after s9-table reveal s9-code duration 300
        after s9-code reveal s9-usage duration 260
        after s9-usage reveal s9-callout duration 260
      }
    }
  }

  slide "aiperf's fused pump: min(next_ready, next_engine)" {
    eyebrow: "11 · Consumer: dynosim.rs"
    title: "run_trace_offline drives one outer loop with two independent heaps fused into one next_ms"
    lede: "aiperf's dynosim.rs owns a WorkloadDriver (trace/session/turn admission) alongside the SteppableReplay engine. Each outer-loop iteration computes next_ready from the driver, next_engine from the engine, takes the minimum, advances both clocks to it, pops ready arrivals, submits them, then steps the engine to whichever is sooner: the next external arrival or the engine's own next event."
    narration: "This is the whole point of the seam: AIPerf never touches the mocker's internal scheduling. It just asks two questions every iteration — when is my next trace arrival ready, and when can the engine next make progress — takes the earlier of the two, and steps. The driver's next-ready-time query and the engine's next-event query are genuinely symmetric: one models the trace's own admission clock, the other models the engine's own scheduling clock, and the DynoSim driver is the only thing that knows both exist."
    term: {
      word: "next_ms"
      meaning: "dynosim.rs's fused clock value for one outer-loop iteration: ready.min(engine) when both driver and engine have pending work, or whichever side is Some when only one does; None/None is a deadlock, reported with in_flight() count."
    }
    points: [
      "while !driver.is_drained() || !engine.is_idle() { ... } — the loop's own liveness condition, symmetric across both sides.",
      "next_ready = driver.next_ready_time_ms(); next_engine = engine.next_event_ms().or_else(|| (!engine.is_idle()).then_some(engine.now_ms())).",
      "now_ms = next_ready.min(next_engine) (or whichever exists) — then engine.advance_now_ms(now_ms) and clock.advance_to(...) together.",
      "deadline_ms = next_external.min(cap_ms); engine_due gates whether step_until(deadline_ms) runs at all this iteration."
    ]
    caption: "one outer loop, two independent event sources, one fused next_ms per iteration."

    render: @scene {
      sdk.Header(id = "s10-hdr", title = "FUSED DES PUMP", caption = "dynosim.rs :: run_trace_offline", x = 48.6, y = 43.2, width = 1792.8, height = 118.8, surfaceRole = theme(surface.primary), inkRole = theme(ink.secondary))
      sdk.Panel(id = "s10-driver", title = "WorkloadDriver", detail = "next_ready_time_ms() / pop_ready", x = 54, y = 243, width = 702, height = 189, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.primary))
      sdk.Panel(id = "s10-engine", title = "engine: SteppableReplay", detail = "next_event_ms() / step_until()", x = 1134, y = 243, width = 702, height = 189, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.warning))
      sdk.Edge(id = "s10-a1", mode = "connector", from = { nodeId: "s10-driver", anchor: "s" }, to = { nodeId: "s10-min", anchor: "nw" }, style = { stroke: theme(accent.primary), strokeWidth: 5.4, fill: "none" })
      sdk.Edge(id = "s10-a2", mode = "connector", from = { nodeId: "s10-engine", anchor: "s" }, to = { nodeId: "s10-min", anchor: "ne" }, style = { stroke: theme(accent.warning), strokeWidth: 5.4, fill: "none" })
      sdk.Decision(id = "s10-min", label = "next_ms = min(next_ready, next_engine)", x = 459, y = 507.6, width = 864, height = 124.2)
      sdk.Edge(id = "s10-a3", mode = "connector", from = { nodeId: "s10-min", anchor: "s" }, to = { nodeId: "s10-advance", anchor: "n" }, style = { stroke: theme(accent.secondary), strokeWidth: 5.4, fill: "none" })
      sdk.Panel(id = "s10-advance", title = "advance_now_ms + clock.advance_to", detail = "pop_ready → submit → step_until(deadline)", x = 297, y = 702, width = 1188, height = 135, surfaceRole = theme(surface.elevated), strokeRole = theme(accent.secondary))
      sdk.CodeBlock(
        id = "s10-code",
        text = "let next_ms = match (next_ready, next_engine) { (Some(r), Some(e)) => r.min(e), (None, None) => bail!(\"deadlocked\"), .. };",
        x = 54, y = 880.2, width = 1701, height = 151.2,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.danger)
      )

