      sdk.PropertyList(
        id = "s1-table",
        title = "ReplayTerminalStatus",
        entries = [{ key: "Completed", value: "max_output_tokens / eos" }, { key: "Rejected", value: "scheduler rejected" }, { key: "Canceled", value: "cancel() won the race" }, { key: "Failed", value: "backend error path" }],
        x = 950.4, y = 556.2, width = 858.6, height = 270
      )
      sdk.Callout(
        id = "s1-callout",
        text = "emitted_token = token_id.is_some() — never set independently",
        x = 81, y = 891, width = 864, height = 108,
        strokeRole = theme(accent.warning)
      )

      timeline main {
        at 0 reveal s1-hdr duration 240
        after s1-hdr reveal s1-code duration 340
        after s1-code reveal s1-fields duration 260
        after s1-fields reveal s1-table duration 260
        after s1-table reveal s1-callout duration 260
      }
    }
  }

  slide "The SteppableReplay trait surface" {
    eyebrow: "3 · Trait contract"
    title: "Ten methods, one uniform surface across three topologies"
    lede: "now_ms/advance_now_ms own the clock; submit/cancel own admission; step/step_until own progress; is_idle/in_flight/next_event_ms describe liveness for the caller's own DES pump; take_report drains; request_latencies/request_admission/actual_output_length are read-after-completion facts."
    narration: "The trait groups into four families: clock control, admission, stepping, and post hoc reads. Every method is implemented identically in spirit by the single engine, aggregated, and disaggregated wrappers — the only topology-specific behavior is what counts as an event and how the deadline-bounded step decides where to stop."
    term: {
      word: "next_event_ms"
      meaning: "The caller's DES pump signal: the next sim time at which the engine can make progress. Aggregated/disaggregated surface their event-heap next_timestamp (min of next arrival, next event, next offload); single-worker returns the current time while work remains, None when idle."
    }
    points: [
      "Clock: now_ms() / advance_now_ms(now_ms) — monotonic, a no-op at or before current time.",
      "Admission: submit(req) -> Uuid / cancel(uuid) -> Option<EngineEvent>.",
      "Stepping: step() / step_until(until_ms) — step_until has a default body that step()s and rejects any finite deadline unless overridden.",
      "Liveness: is_idle() / in_flight() / next_event_ms() — the caller's own event-loop condition.",
      "Reads: take_report(wall_ms), request_latencies(uuid), request_admission(uuid), actual_output_length(uuid)."
    ]
    caption: "clock · admission · stepping · liveness · reads — same ten methods, three backends."

    render: @scene {
      sdk.Header(id = "s2-hdr", title = "TRAIT SURFACE", caption = "10 methods · 4 families", x = 48.6, y = 43.2, width = 1792.8, height = 118.8, surfaceRole = theme(surface.primary), inkRole = theme(ink.secondary))
