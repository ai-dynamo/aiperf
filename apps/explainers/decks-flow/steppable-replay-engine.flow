      sdk.Edge(id = "s4-a4", mode = "connector", from = { nodeId: "s4-router", anchor: "s" }, to = { nodeId: "s4-w3", anchor: "n" }, style = { stroke: theme(accent.secondary), strokeWidth: 5.4, fill: "none" })
      sdk.Worker(id = "s4-w1", label = "worker 0", x = 54, y = 658.8, width = 243, height = 151.2)
      sdk.Worker(id = "s4-w2", label = "worker 1", x = 337.5, y = 658.8, width = 243, height = 151.2)
