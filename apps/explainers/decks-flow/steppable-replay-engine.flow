//! Steppable replay engine — the externally-clocked mocker seam.
//! Authored directly from dynamo lib/mocker source (loadgen/steppable.rs,
//! replay/offline/{agg,disagg}.rs) and aiperf rust/runtime/src/dynosim.rs.

explainer "Steppable replay engine" {
  id: "steppable-replay-engine"
  route: "/steppable-replay-engine"
  topic: "mocker-steppable-replay"
  storagePrefix: "steppable-replay-engine-explainer"
  classPrefix: "deck-steppable-replay"
  eyebrowLabel: "STEPPABLE REPLAY"
  startGateTitle: "Steppable replay engine"

  hub: {
    title: "the externally-clocked mocker seam"
    highlight: "Steppable replay engine"
    description: "How dynamo's lib/mocker exposes its own offline runtimes — single-engine, aggregated multi-worker + router, disaggregated prefill/decode — as a passive, dynamically-fed SteppableReplay trait, and how aiperf's dynosim.rs fuses that seam into its own discrete-event pump."
  }

  slide "The inversion: from self-driving to externally clocked" {
    eyebrow: "1 · Inversion"
    title: "The native runtime drives itself; SteppableReplay hands the wheel to the caller"
    lede: "run() owns a static arrival queue and its own loop. SteppableReplay keeps every scheduling behavior — batching, KV cache, prefix caching, chunked prefill, routing, disagg handoff — inside the runtime, and adds exactly one seam: the caller now owns the clock."
    narration: "The native offline runtimes drive themselves over a static arrival queue. Steppable replay inverts that. The caller owns the clock and the loop, submits requests as they emerge in a closed loop dataflow, and steps the runtime one logical timestamp at a time. Batching, KV cache, prefix caching, chunked prefill, routing, and disagg handoff stay the runtime's job — this adds nothing but the seam."
    term: {
      word: "SteppableReplay"
      meaning: "Tier-2 boundary trait from the engine-boundary spec: a real mocker offline runtime exposed as a passive, externally-clocked, dynamic-admission engine, uniform across every topology."
    }
    points: [
      "Static arrival queue (run()) → closed-loop submission (SteppableReplay::submit).",
      "Runtime-owned loop → caller-owned clock: advance_now_ms / step / step_until.",
      "Uniform across single / aggregated+router / disaggregated topologies — same trait, three impls.",
      "Source of truth: lib/mocker/src/loadgen/steppable.rs, module doc comment."
    ]
    caption: "run()'s self-clocked loop → caller-clocked step() seam, same scheduling core."

    render: @scene {
      sdk.Header(
        id = "s0-hdr",
        title = "PUSH → PULL INVERSION",
        caption = "static arrival queue vs. externally-clocked step()",
        x = 48.6, y = 43.2, width = 1792.8, height = 118.8,
        surfaceRole = theme(surface.primary),
        inkRole = theme(ink.secondary)
      )
      sdk.Panel(
        id = "s0-native",
        title = "run() — native offline",
        detail = "self-clocked loop, static arrival queue",
        x = 81, y = 270, width = 526.5, height = 270,
        surfaceRole = theme(surface.elevated),
        strokeRole = theme(accent.secondary)
      )
      sdk.Edge(
