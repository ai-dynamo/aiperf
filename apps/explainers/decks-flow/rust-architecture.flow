  slide "Scale-out" {
    eyebrow: "Scale-out"
    title: "Cellular mode adds controller and cells"
    lede: "`--cells N` promotes the run to a controller that partitions work, launches `aiperf --cell` children, merges records or folded stores over Velo, and writes one authoritative report. SLURM and Kubernetes reuse the same model."
    narration: "Cellular mode adds a controller, remote cells, Velo control traffic, and a single merged report."
    term: {
      word: "Cell partition"
      meaning: "Deterministic slice of the global request or conversation budget owned by one remote cell process."
    }
    points: [
      "Rank 0 or the controller owns merge and artifact shipping.",
      "Velo carries control only; HTTP and gRPC carry measured load.",
      "Bulk artifacts can use a separate HTTP/1 + zstd path."
    ]
    caption: "Same engine, more processes, partitioned ownership."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
        }
        {
          id: "label"
          capability: "core.text"
          text: "CELLULAR MODE"
          layout: { x: 38, y: 28, width: 260, height: 24 }
          style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
        }
        {
          id: "note"
          capability: "core.text"
          text: "controller + cells + Velo"
          layout: { x: 360, y: 28, width: 300, height: 24 }
          style: { fontSize: 12, fill: @theme.ink.secondary, textAnchor: "end" }
        }
        {
          id: "controller"
          capability: "core.rect"
          layout: { x: 70, y: 130, width: 150, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.warning, strokeWidth: 1.8 }
          children: [
            {
              id: "controller-title"
              capability: "core.text"
              text: "Controller"
              layout: { x: 70, y: 160, width: 150, height: 24 }
              style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            }
            {
              id: "controller-detail"
              capability: "core.text"
