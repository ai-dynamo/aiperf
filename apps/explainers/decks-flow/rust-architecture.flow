        { id: "t-label", at: 60, duration: 260, target: "label", action: "enter" }
        { id: "t-note", at: 100, duration: 260, target: "note", action: "enter" }
        { id: "t-binary", at: 280, duration: 360, target: "binary", action: "enter" }
        { id: "t-footer", at: 560, duration: 280, target: "footer", action: "enter" }
        { id: "t-cli", at: 760, duration: 280, target: "cli-hat", action: "enter" }
        { id: "t-a1", at: 980, duration: 320, target: "a1", action: "draw" }
        { id: "t-engine", at: 1200, duration: 280, target: "engine-hat", action: "enter" }
        { id: "t-pulse-a", at: 1500, duration: 400, target: "pulse-a", action: "enter" }
        { id: "t-pulse-b", at: 1680, duration: 400, target: "pulse-b", action: "enter" }
        { id: "t-motion-sig", at: 1580, duration: 1100, target: "motion-sig", action: "draw" }
        { id: "t-emphasis", at: 2500, duration: 480, target: "binary", action: "emphasis" }
      ]
    }
  }
  slide "Workspace map" {
    eyebrow: "Workspace map"
    title: "Six crates, one dependency direction"
    lede: "The Rust workspace is intentionally small. Capability flows cli → runtime → loadgen-core. Mock server and e2e are separate targets; pyext is packaging-only."
    narration: "The Rust workspace stays small. Capability flows from aiperf-cli into aiperf-runtime and then into loadgen-core."
    term: {
      word: "loadgen-core"
      meaning: "Transport-neutral observer and sink vocabulary with no HTTP, gRPC, or engine dependencies."
    }
    points: [
      "Members: loadgen-core, runtime, cli, mock-server, e2e, pyext.",
      "aiperf-cli depends on aiperf-runtime with the engine feature.",
      "aiperf-mock-server is a standalone benchmark target."
    ]
    caption: "cli → runtime → loadgen-core"
    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
