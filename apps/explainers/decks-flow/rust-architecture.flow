  slide "Startup order" {
    eyebrow: "Startup order"
    title: "Intercept internal modes, then dispatch"
    lede: "Every process starts the same way: initialize logging, check for hidden execution flags like `--execute`, `--cell`, or `--aggregator`, and only then route public subcommands."
    narration: "Startup always checks hidden execution modes first. Only after that does the process route public subcommands."
    term: {
      word: "execute_mode"
      meaning: "Hidden argv surface that runs protocol-v2 children before clap ever sees a public command."
    }
    points: [
      "`main.rs` calls `execute_mode::is_execution_mode`.",
      "Internal handlers never return to public dispatch.",
      "Everything else goes through `dispatch::run`."
    ]
    caption: "Hidden modes short-circuit; public commands fall through."

    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
        }
        {
          id: "label"
          capability: "core.text"
          text: "STARTUP ORDER"
          layout: { x: 38, y: 28, width: 280, height: 24 }
          style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
        }
        {
          id: "note"
          capability: "core.text"
          text: "execute_mode before dispatch"
          layout: { x: 340, y: 28, width: 320, height: 24 }
          style: { fontSize: 12, fill: @theme.ink.secondary, textAnchor: "end" }
        }
        {
          id: "logging"
          capability: "core.rect"
          layout: { x: 70, y: 130, width: 150, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1.3 }
          children: [
            {
              id: "logging-title"
              capability: "core.text"
              text: "1. Initialize logging"
              layout: { x: 70, y: 160, width: 150, height: 24 }
              style: { fontSize: 12, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            }
            {
              id: "logging-detail"
              capability: "core.text"
              text: "startup"
              layout: { x: 70, y: 184, width: 150, height: 20 }
              style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        }
        {
          id: "a1"
          capability: "core.line"
          from: { x: 220, y: 178 }
          to: { x: 260, y: 178 }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2 }
        }
        {
          id: "execute"
          capability: "core.rect"
          layout: { x: 260, y: 130, width: 150, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.warning, strokeWidth: 1.8 }
          children: [
            {
              id: "execute-title"
              capability: "core.text"
              text: "2. Check hidden modes"
              layout: { x: 260, y: 152, width: 150, height: 22 }
              style: { fontSize: 12, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            }
            {
              id: "execute-detail"
              capability: "core.text"
              text: "--execute · --cell · --aggregator"
              layout: { x: 260, y: 184, width: 150, height: 20 }
              style: { fontSize: 10, fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        }
        {
          id: "a2"
          capability: "core.line"
          from: { x: 410, y: 178 }
          to: { x: 450, y: 178 }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2 }
        }
        {
          id: "dispatch"
          capability: "core.rect"
          layout: { x: 450, y: 130, width: 170, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1.3 }
          children: [
            {
              id: "dispatch-title"
              capability: "core.text"
              text: "3. Dispatch public commands"
              layout: { x: 450, y: 152, width: 170, height: 22 }
              style: { fontSize: 11, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            }
            {
              id: "dispatch-detail"
              capability: "core.text"
              text: "dispatch::run"
              layout: { x: 450, y: 184, width: 170, height: 20 }
              style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        }

