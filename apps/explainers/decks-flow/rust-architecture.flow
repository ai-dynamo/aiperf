explainer "Rust Architecture" {
  id: "rust-architecture"
  route: "/rust-architecture"
  topic: "architecture"
  storagePrefix: "rust-arch-explainer"
  classPrefix: "rust-arch"
  eyebrowLabel: "RUST ARCHITECTURE"
  startGateTitle: "Rust architecture walkthrough"

  hub: {
    highlight: "Rust architecture"
    title: "from scratch"
    description: "Narrated walkthrough of the native workspace, self-execution seam, registry bootstrap, request lifecycle, workers, cellular mode, and feature gates."
  }

  slide "Product shell" {
    eyebrow: "Product shell"
    title: "One binary is both CLI and engine"
    lede: "AIPerf ships as a single native `aiperf` executable from crate `aiperf-cli`. There is no separate runner process—the same binary parses public commands and re-executes itself for benchmark runs."
    narration: "AIPerf ships as one native aiperf binary. That same executable is both the public command line and the hidden execution engine."
    term: {
      word: "aiperf-cli"
      meaning: "The product entry crate: public commands, Config v2 loading, and self-spawned execution over stdio."
    }
    points: [
      "`rust/cli` builds the `aiperf` binary.",
      "Global allocator is mimalloc on the hot path.",
      "Internal modes are intercepted before normal CLI parsing."
    ]
    caption: "One executable, two hats: operator CLI and execution child."
    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.header"
          title: "ONE BINARY"
          caption: "cli is entry + engine"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1, radius: 8 }
        },
        {
          id: "zone"
          capability: "core.band"
          layout: { x: 70, y: 100, width: 560, height: 160 }
          style: { fill: @theme.surface.secondary, opacity: 0.5 }
        },
        {
          id: "binary"
          capability: "core.panel"
          title: "aiperf binary"
          detail: "cli/src/main.rs"
          layout: { x: 250, y: 130, width: 200, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.primary, strokeWidth: 1.8 }
        },
        {
          id: "footer"
          capability: "core.text"
          text: "public CLI on the outside · execution child on the inside"
          layout: { x: 50, y: 270, width: 600, height: 24 }
          style: { fontSize: 13, fill: @theme.ink.secondary, textAnchor: "middle" }
        },
        {
          id: "cli-hat"
          capability: "core.panel"
          title: "public CLI"
          detail: "outside"
          layout: { x: 90, y: 310, width: 180, height: 55 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1.4 }
        },
        {
          id: "a1"
          capability: "core.route"
          from: { nodeId: "cli-hat", anchor: "e" }
          to: { nodeId: "engine-hat", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2, fill: "none" }
        },
        {
          id: "engine-hat"
          capability: "core.panel"
          title: "execution child"
          detail: "inside"
          layout: { x: 430, y: 310, width: 180, height: 55 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.primary, strokeWidth: 1.4 }
        },
        {
          id: "pulse-a"
          capability: "core.rect"
          layout: { x: 70, y: 150, width: 150, height: 80 }
          style: { fill: "none", stroke: @theme.accent.secondary, strokeWidth: 1.5, opacity: 0.4 }
          accessibility: { label: "motion pulse A" }
        }
        {
          id: "pulse-b"
          capability: "core.rect"
          layout: { x: 480, y: 150, width: 150, height: 80 }
          style: { fill: "none", stroke: @theme.accent.primary, strokeWidth: 1.5, opacity: 0.4 }
          accessibility: { label: "motion pulse B" }
        }
        {
          id: "motion-sig"
          capability: "motion.signal"
          d: "M170 190 H530"
          layout: { x: 0, y: 0, width: 700, height: 400 }
          style: { fill: "none", stroke: @theme.accent.primary, strokeWidth: 2.4, opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "t-header", at: 0, duration: 280, target: "header", action: "enter" }
        { id: "t-zone", at: 80, duration: 200, target: "zone", action: "enter" }
        { id: "t-binary", at: 280, duration: 360, target: "binary", action: "enter" }
        { id: "t-footer", at: 560, duration: 280, target: "footer", action: "enter" }
        { id: "t-cli", at: 760, duration: 280, target: "cli-hat", action: "enter" }
        { id: "t-a1", at: 980, duration: 320, target: "a1", action: "draw" }
        { id: "t-engine", at: 1200, duration: 280, target: "engine-hat", action: "enter" }
        { id: "t-pulse-a", at: 1500, duration: 400, target: "pulse-a", action: "enter" }
        { id: "t-pulse-b", at: 1680, duration: 400, target: "pulse-b", action: "enter" }
        { id: "t-motion-sig", at: 1580, duration: 1100, target: "motion-sig", action: "draw" }
        { id: "t-emphasis", at: 2500, duration: 480, target: "binary", action: "emphasis" }
      ]
    }
  }
  slide "Workspace map" {
    eyebrow: "Workspace map"
    title: "Six crates, one dependency direction"
    lede: "The Rust workspace is intentionally small. Capability flows cli → runtime → loadgen-core. Mock server and e2e are separate targets; pyext is packaging-only."
    narration: "The Rust workspace stays small. Capability flows from aiperf-cli into aiperf-runtime and then into loadgen-core."
    term: {
      word: "loadgen-core"
      meaning: "Transport-neutral observer and sink vocabulary with no HTTP, gRPC, or engine dependencies."
    }
    points: [
      "Members: loadgen-core, runtime, cli, mock-server, e2e, pyext.",
      "aiperf-cli depends on aiperf-runtime with the engine feature.",
      "aiperf-mock-server is a standalone benchmark target."
    ]
    caption: "cli → runtime → loadgen-core"
    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
        }
        {
          id: "label"
          capability: "core.text"
          text: "WORKSPACE CRATES"
          layout: { x: 38, y: 28, width: 320, height: 24 }
          style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
        }
        {
          id: "note"
          capability: "core.text"
          text: "cli → runtime → loadgen-core"
          layout: { x: 360, y: 28, width: 300, height: 24 }
          style: { fontSize: 12, fill: @theme.ink.secondary, textAnchor: "end" }
        },
        {
          id: "cli"
          capability: "core.panel"
          title: "aiperf-cli"
          detail: "commands + execute"
          layout: { x: 60, y: 130, width: 150, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1.8 }
        },
        {
          id: "a1"
          capability: "core.connector"
          from: { nodeId: "cli", anchor: "e" }
