          to: { x: 410, y: 175 }
          style: { stroke: @theme.accent.secondary, strokeWidth: 2.2 }
        },
        {
          id: "delegated"
          capability: "core.rect"
          layout: { x: 410, y: 120, width: 220, height: 110 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.orange, strokeWidth: 1.8 }
          children: [
            {
              id: "delegated-title"
              capability: "core.text"
