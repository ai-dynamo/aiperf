        { id: "t-label", at: 60, duration: 260, target: "label", action: "enter" }
        { id: "t-note", at: 100, duration: 260, target: "note", action: "enter" }
        { id: "t-cli", at: 280, duration: 320, target: "cli", action: "enter" }
        { id: "t-a1", at: 520, duration: 280, target: "a1", action: "draw" }
