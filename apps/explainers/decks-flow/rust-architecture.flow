explainer "Rust Architecture" {
  id: "rust-architecture"
  route: "/rust-architecture"
  topic: "architecture"
  storagePrefix: "rust-arch-explainer"
  classPrefix: "rust-arch"
  eyebrowLabel: "RUST ARCHITECTURE"
  startGateTitle: "Rust architecture walkthrough"

  hub: {
    highlight: "Rust architecture"
    title: "from scratch"
    description: "Narrated walkthrough of the native workspace, self-execution seam, registry bootstrap, request lifecycle, workers, cellular mode, and feature gates."
  }

  slide "Product shell" {
    eyebrow: "Product shell"
    title: "One binary is both CLI and engine"
    lede: "AIPerf ships as a single native `aiperf` executable from crate `aiperf-cli`. There is no separate runner process—the same binary parses public commands and re-executes itself for benchmark runs."
    narration: "AIPerf ships as one native aiperf binary. That same executable is both the public command line and the hidden execution engine."
    term: {
      word: "aiperf-cli"
      meaning: "The product entry crate: public commands, Config v2 loading, and self-spawned execution over stdio."
    }
    points: [
      "`rust/cli` builds the `aiperf` binary.",
      "Global allocator is mimalloc on the hot path.",
      "Internal modes are intercepted before normal CLI parsing."
    ]
    caption: "One executable, two hats: operator CLI and execution child."
    render: @scene {
      sdk.Header(id = "header", title = "ONE BINARY", caption = "cli is entry + engine", x = 18, y = 16, width = 664, height = 44, surfaceRole = "@theme.surface.secondary")
      sdk.Panel(id = "binary", title = "aiperf binary", detail = "cli/src/main.rs", x = 250, y = 70, width = 200, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Label(id = "footer", text = "public CLI on the outside · execution child on the inside", x = 50, y = 210, width = 600, height = 24, fontSize = 13, align = "middle", inkRole = "@theme.ink.secondary")
      sdk.Panel(id = "cli-hat", title = "public CLI", detail = "outside", x = 90, y = 240, width = 180, height = 55, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a1", mode = "route", from = { nodeId: "cli-hat", anchor: "e" }, to = { nodeId: "engine-hat", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2, fill: "none" })
      sdk.Panel(id = "engine-hat", title = "execution child", detail = "inside", position = { relativeTo: "cli-hat", anchor: "n", dx: 250 }, width = 180, height = 55, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "binary", anchor: "w" }, to = { nodeId: "binary", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal binary duration 360
        after binary reveal footer duration 280
        after footer reveal cli-hat duration 280
        after cli-hat reveal engine-hat duration 280
        after engine-hat trace a1 duration 320
        after binary trace motion-sig duration 1100
      }
    }
  }
  slide "Workspace map" {
    eyebrow: "Workspace map"
    title: "Six crates, one dependency direction"
    lede: "The Rust workspace is intentionally small. Capability flows cli → runtime → loadgen-core. Mock server and e2e are separate targets; pyext is packaging-only."
    narration: "The Rust workspace stays small. Capability flows from aiperf-cli into aiperf-runtime and then into loadgen-core."
    term: {
      word: "loadgen-core"
      meaning: "Transport-neutral observer and sink vocabulary with no HTTP, gRPC, or engine dependencies."
    }
    points: [
      "Members: loadgen-core, runtime, cli, mock-server, e2e, pyext.",
      "aiperf-cli depends on aiperf-runtime with the engine feature.",
      "aiperf-mock-server is a standalone benchmark target."
    ]
    caption: "cli → runtime → loadgen-core"
    render: @scene {
      sdk.Header(id = "header", title = "WORKSPACE CRATES", caption = "cli \u2192 runtime \u2192 loadgen-core", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "cli", title = "aiperf-cli", detail = "commands + execute", x = 60, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a1", mode = "connector", from = { nodeId: "cli", anchor: "e" }, to = { nodeId: "runtime", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "runtime", title = "aiperf-runtime", detail = "engine + transports", x = 250, y = 130, width = 170, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a2", mode = "connector", from = { nodeId: "runtime", anchor: "e" }, to = { nodeId: "loadgen", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "loadgen", title = "loadgen-core", detail = "observer seam", x = 460, y = 130, width = 180, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Panel(id = "mock", title = "mock-server", detail = "separate target", x = 520, y = 280, width = 120, height = 58, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "cli", anchor: "e" }, to = { nodeId: "loadgen", anchor: "w" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal cli duration 320
        after cli reveal runtime duration 320
        after runtime trace a1 duration 280
        after a1 reveal loadgen duration 320
        after loadgen reveal mock duration 300
        after loadgen trace a2 duration 280
        after loadgen trace motion-sig duration 1100
      }
    }
  }
  slide "Startup order" {
    eyebrow: "Startup order"
    title: "Intercept internal modes, then dispatch"
    lede: "Every process starts the same way: initialize logging, check for hidden execution flags like `--execute`, `--cell`, or `--aggregator`, and only then route public subcommands."
    narration: "Startup always checks hidden execution modes first. Only after that does the process route public subcommands."
    term: {
      word: "execute_mode"
      meaning: "Hidden argv surface that runs protocol-v2 children before clap ever sees a public command."
    }
    points: [
      "`main.rs` calls `execute_mode::is_execution_mode`.",
      "Internal handlers never return to public dispatch.",
      "Everything else goes through `dispatch::run`."
    ]
    caption: "Hidden modes short-circuit; public commands fall through."
    render: @scene {
      sdk.Header(id = "header", title = "STARTUP ORDER", caption = "execute_mode before dispatch", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "logging", title = "logging", detail = "startup", x = 70, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a1", mode = "connector", from = { nodeId: "logging", anchor: "e" }, to = { nodeId: "execute", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "execute", title = "execute_mode?", detail = "hidden argv", x = 260, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Edge(id = "a2", mode = "connector", from = { nodeId: "execute", anchor: "e" }, to = { nodeId: "dispatch", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "dispatch", title = "dispatch::run", detail = "startup", x = 450, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "logging", anchor: "e" }, to = { nodeId: "dispatch", anchor: "w" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal logging duration 320
        after logging reveal execute duration 360
        after execute trace a1 duration 280
        after a1 reveal dispatch duration 320
        after dispatch trace a2 duration 280
        after dispatch trace motion-sig duration 1100
      }
    }
  }
  slide "Command surface" {
    eyebrow: "Command surface"
    title: "Native benchmark commands stay in Rust"
    lede: "`profile`, `config`, cellular roles, `slurm run`, and several utility commands are native. Most operational tooling still delegates to the Python package unless built with pyo3-embed."
    narration: "Core benchmark commands stay native in Rust. Most operational tooling still delegates to Python unless the build embeds it."
    term: {
      word: "delegate"
      meaning: "Lean builds shell out to `python -m aiperf`; pyo3-embed runs the same entrypoint in-process."
    }
    points: [
      "`dispatch.rs` matches the first argv token.",
      "Unknown commands delegate to Python.",
      "Feature gates select gRPC, cellular, dynosim, parquet, and embed modes."
    ]
    caption: "Benchmark hot path native; extended surface delegated."
    render: @scene {
      sdk.Header(id = "header", title = "COMMAND DISPATCH", caption = "native profile/config/cell", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "native", title = "Native commands", detail = "profile · config · cell", x = 70, y = 120, width = 220, height = 110, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "split", mode = "connector", from = { nodeId: "native", anchor: "e" }, to = { nodeId: "delegated", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      sdk.Panel(id = "delegated", title = "Delegated commands", detail = "python -m aiperf", x = 410, y = 120, width = 220, height = 110, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.orange")
      sdk.Label(id = "footer", text = "dispatch.rs chooses the path from argv[0]", x = 50, y = 280, width = 600, height = 24, fontSize = 13, align = "middle", inkRole = "@theme.ink.secondary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "native", anchor: "w" }, to = { nodeId: "delegated", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal native duration 360
        after native reveal delegated duration 360
        after delegated reveal footer duration 300
        after delegated trace split duration 280
        after delegated trace motion-sig duration 1100
      }
    }
  }
  slide "Configuration" {
    eyebrow: "Configuration"
    title: "Config v2 resolves into BenchmarkRun"
    lede: "`aiperf profile --config` reads YAML, expands env vars and Jinja, applies CLI overrides, and materializes a strict `BenchmarkRun` object—the wire payload for execution."
    narration: "Profile reads Config v2, expands it, and resolves a strict BenchmarkRun object that describes the whole benchmark."
    term: {
      word: "BenchmarkRun"
      meaning: "The authored protocol-v2 request describing workload, transport, endpoints, artifacts, and runtime facts."
    }
    points: [
      "`yaml.rs` handles substitution and alias normalization.",
      "`load.rs` and `model/` build the typed run object.",
      "`config init|validate|expand` are native helpers."
    ]
    caption: "YAML in → validated BenchmarkRun out."
    render: @scene {
      sdk.Header(id = "header", title = "CONFIG V2", caption = "BenchmarkRun wire object", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "yaml", title = "benchmark.yaml", detail = "Config v2", x = 50, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a1", mode = "connector", from = { nodeId: "yaml", anchor: "e" }, to = { nodeId: "load", anchor: "w" }, style = { stroke: "@theme.accent.secondary", strokeWidth: 2.2 })
      sdk.Panel(id = "load", title = "yaml + load", detail = "expand + validate", x = 250, y = 130, width = 170, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a2", mode = "connector", from = { nodeId: "load", anchor: "e" }, to = { nodeId: "run", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "run", title = "BenchmarkRun", detail = "typed wire object", x = 470, y = 130, width = 180, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "yaml", anchor: "w" }, to = { nodeId: "run", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal yaml duration 320
        after yaml reveal load duration 320
        after load trace a1 duration 280
        after a1 reveal run duration 360
        after run trace a2 duration 280
        after run trace motion-sig duration 1100
      }
    }
  }
  slide "Self execution" {
    eyebrow: "Self execution"
    title: "profile spawns aiperf --execute"
    lede: "Each run is a fresh child of the same binary. Parent writes JSON to stdin; child returns one terminal JSONL envelope on stdout while stderr carries diagnostics."
    narration: "Each profile run spawns a fresh child of the same binary with aiperf execute over stdio."
    term: {
      word: "stdio seam"
      meaning: "The deliberate parent/child boundary that keeps operator UX separate from execution isolation."
    }
    points: [
      "`execute::run_once` spawns `current_exe()` with hidden flags.",
      "Stdout stays reserved for protocol traffic.",
      "Panics in the child become typed failure envelopes."
    ]
    caption: "Same binary, new process, protocol on stdio."
    render: @scene {
      sdk.Header(id = "header", title = "SELF EXECUTE", caption = "spawn current_exe()", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "parent", title = "profile parent", detail = "operator process", x = 70, y = 130, width = 170, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a1", mode = "connector", from = { nodeId: "parent", anchor: "e" }, to = { nodeId: "spawn", anchor: "w" }, style = { stroke: "@theme.accent.warning", strokeWidth: 2.2 })
      sdk.Panel(id = "spawn", title = "spawn child", detail = "current_exe()", x = 290, y = 130, width = 170, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Edge(id = "a2", mode = "connector", from = { nodeId: "spawn", anchor: "e" }, to = { nodeId: "execute", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "execute", title = "--execute", detail = "stdio JSON", x = 510, y = 130, width = 120, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "parent", anchor: "w" }, to = { nodeId: "execute", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal parent duration 320
        after parent reveal spawn duration 320
        after spawn trace a1 duration 280
        after a1 reveal execute duration 360
        after execute trace a2 duration 280
        after execute trace motion-sig duration 1100
      }
    }
  }
  slide "Wire contract" {
    eyebrow: "Wire contract"
    title: "Protocol v2 wraps the bare run"
    lede: "The child accepts protocol version 2 only. It composes a stock `Application` once, then `handle_v2` validates, prepares, executes, and persists results."
    narration: "Protocol version two wraps the run, composes Application once, and returns one terminal envelope."
    term: {
      word: "Application"
      meaning: "Frozen runtime composition: registry, coordinator, and factories selected at bootstrap."
    }
    points: [
      "`protocol_v2.rs` defines strict authored types.",
      "Unknown fields fail closed at serde boundaries.",
      "Factory-owned config stays opaque until registry decode."
    ]
    caption: "Envelope v2 in → terminal envelope out."
    render: @scene {
      sdk.Header(id = "header", title = "PROTOCOL V2", caption = "Application::handle_v2", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "envelope", title = "Envelope v2", detail = "protocol boundary", x = 90, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a1", mode = "connector", from = { nodeId: "envelope", anchor: "e" }, to = { nodeId: "app", anchor: "w" }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "app", title = "Application", detail = "stock composition", x = 290, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a2", mode = "connector", from = { nodeId: "app", anchor: "e" }, to = { nodeId: "terminal", anchor: "w" }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 2.2 })
      sdk.Panel(id = "terminal", title = "terminal", detail = "JSONL out", x = 490, y = 130, width = 120, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "envelope", anchor: "w" }, to = { nodeId: "terminal", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal envelope duration 320
        after envelope reveal app duration 360
        after app trace a1 duration 280
        after a1 reveal terminal duration 320
        after terminal trace a2 duration 280
        after terminal trace motion-sig duration 1100
      }
    }
  }
  slide "Bootstrap" {
    eyebrow: "Bootstrap"
    title: "AIPerfRegistry freezes capabilities"
    lede: "At startup one registry is built transactionally from explicit extensions: loaders, samplers, endpoints, transports, workloads, exporters, and actuators. There is no runtime plugin scanning."
    narration: "At bootstrap, AIPerfRegistry freezes loaders, samplers, endpoints, transports, workloads, and exporters."
    term: {
      word: "AIPerfExtension"
      meaning: "Compile-time registration hook that adds implementations into the shared registry during Application construction."
    }
    points: [
      "Built-ins register HTTP, gRPC, dry_run, dynosim when features are on.",
      "Duplicate identifiers are rejected.",
      "Unknown transport or workload IDs fail closed."
    ]
    caption: "Capabilities are frozen before the first request."
    render: @scene {
      sdk.Header(id = "header", title = "REGISTRY BOOTSTRAP", caption = "frozen capabilities", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "registry", title = "AIPerfRegistry", detail = "transactional build", x = 250, y = 90, width = 200, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "loaders", title = "loaders", detail = "registered", x = 80, y = 220, width = 110, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "samplers", title = "samplers", detail = "registered", x = 220, y = 220, width = 110, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Panel(id = "endpoints", title = "endpoints", detail = "registered", x = 360, y = 220, width = 110, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.FanOut(id = "registry-fan", from = { nodeId: "registry", anchor: "s" }, to = [
            { nodeId: "loaders", anchor: "n" },
            { nodeId: "samplers", anchor: "n" },
            { nodeId: "endpoints", anchor: "n" },
            { nodeId: "transports", anchor: "n" }
          ], axis = "y", junction = { x: 350, y: 190 }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2 })
      sdk.Panel(id = "transports", title = "transports", detail = "registered", x = 500, y = 220, width = 110, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      timeline primary {
        at 0 reveal header duration 280
        after header reveal registry duration 360
        after registry trace registry-fan duration 900
        after registry-fan reveal loaders duration 260
        after loaders reveal samplers duration 260
        after samplers reveal endpoints duration 260
        after endpoints reveal transports duration 260
        after transports trace registry-fan duration 1100
      }
    }
  }
  slide "Composition root" {
    eyebrow: "Composition root"
    title: "Coordinator validates, prepares, executes, persists"
    lede: "`Coordinator::handle` is the orchestration spine: validate envelope and endpoint profiles, prepare dataset and sidecars, execute the selected program shape, write `native-v2.json`, then run exporters best-effort."
    narration: "Coordinator is the composition root: validate, prepare, execute, persist native-v2.json, then run exporters."
    term: {
      word: "Coordinator"
      meaning: "Engine composition root that owns validate → prepare → execute → persist for a single BenchmarkRun."
    }
    points: [
      "Sidecar collectors start only on the primary cell when needed.",
      "Exporter failures are logged, not run-fatal.",
      "Cellular and graph runs branch inside the same coordinator."
    ]
    caption: "One coordinator owns the whole run lifecycle."
    render: @scene {
      sdk.Header(id = "header", title = "COORDINATOR", caption = "validate \u2192 prepare \u2192 execute", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "validate", title = "validate", detail = "coordinator", x = 40, y = 130, width = 130, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a1", mode = "line", from = { x: 170, y: 178 }, to = { x: 200, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "prepare", title = "prepare", detail = "coordinator", x = 200, y = 130, width = 130, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a2", mode = "line", from = { x: 330, y: 178 }, to = { x: 360, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "execute", title = "execute", detail = "coordinator", x = 360, y = 130, width = 130, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a3", mode = "line", from = { x: 490, y: 178 }, to = { x: 520, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "persist", title = "persist", detail = "coordinator", x = 520, y = 130, width = 130, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "validate", anchor: "w" }, to = { nodeId: "persist", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal validate duration 300
        after validate trace a1 duration 240
        after a1 reveal prepare duration 300
        after prepare trace a2 duration 240
        after a2 reveal execute duration 300
        after execute trace a3 duration 240
        after a3 reveal persist duration 300
        after persist trace motion-sig duration 1100
      }
    }
  }
  slide "Time seam" {
    eyebrow: "Time seam"
    title: "Every schedule uses Clock"
    lede: "Hot paths never call wall-clock APIs directly. `RealClock` drives online HTTP and gRPC; `SimClock` drives dynosim and graph co-simulation with deterministic ordering."
    narration: "All timing goes through Clock. RealClock drives online traffic; SimClock drives deterministic simulation."
    term: {
      word: "Clock"
      meaning: "Injectable time source used for scheduling, measurement gates, backoff, and simulation driving."
    }
    points: [
      "Measurement must not use `Instant::now` on hot paths.",
      "Virtual clocks expose integer-nanosecond time.",
      "Transport retry backoff is clock-driven too."
    ]
    caption: "Real time online, virtual time in simulation."
    render: @scene {
      sdk.Header(id = "header", title = "CLOCK SEAM", caption = "RealClock / SimClock", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "real", title = "RealClock", detail = "HTTP / gRPC online", x = 120, y = 130, width = 180, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "split", mode = "line", from = { x: 300, y: 178 }, to = { x: 400, y: 178 }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 2.2 })
      sdk.Panel(id = "sim", title = "SimClock", detail = "dynosim + graph", x = 400, y = 130, width = 180, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Label(id = "footer", text = "scheduling, backoff, and measurement all route through Clock", x = 50, y = 280, width = 600, height = 24, fontSize = 13, align = "middle", inkRole = "@theme.ink.secondary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "real", anchor: "w" }, to = { nodeId: "sim", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal real duration 340
        after real trace split duration 280
        after split reveal sim duration 340
        after sim reveal footer duration 300
        after footer trace motion-sig duration 1100
      }
    }
  }
  slide "Inputs" {
    eyebrow: "Inputs"
    title: "Dataset flows load → sample → materialize"
    lede: "Loaders ingest files and traces, conversations intern into a BLAKE3-addressed segment pool, samplers choose turns, and materializers build wire payloads per endpoint dialect."
    narration: "Datasets load, sample, and materialize into endpoint-ready requests through one shared substrate."
    term: {
      word: "Segment pool"
      meaning: "Content-addressed conversation storage shared read-only across worker threads via Arc."
    }
    points: [
      "LoaderRegistry and SamplerRegistry live in the frozen registry.",
      "Synthetic, JSONL, graph, and trace formats share one substrate.",
      "Prompt materialization stays endpoint-aware."
    ]
    caption: "Inputs become endpoint-ready requests once, then reuse handles."
    render: @scene {
      sdk.Header(id = "header", title = "DATASET PIPELINE", caption = "load \u2192 sample \u2192 materialize", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "load", title = "load", detail = "dataset", x = 40, y = 130, width = 120, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a1", mode = "line", from = { x: 160, y: 178 }, to = { x: 190, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "compose", title = "compose", detail = "dataset", x = 190, y = 130, width = 120, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a2", mode = "line", from = { x: 310, y: 178 }, to = { x: 340, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "sample", title = "sample", detail = "dataset", x = 340, y = 130, width = 120, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a3", mode = "line", from = { x: 460, y: 178 }, to = { x: 490, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "materialize", title = "materialize", detail = "dataset", x = 490, y = 130, width = 120, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "load", anchor: "w" }, to = { nodeId: "materialize", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal load duration 300
        after load trace a1 duration 240
        after a1 reveal compose duration 300
        after compose trace a2 duration 240
        after a2 reveal sample duration 300
        after sample trace a3 duration 240
        after a3 reveal materialize duration 300
        after materialize trace motion-sig duration 1100
      }
    }
  }
  slide "Work generation" {
    eyebrow: "Work generation"
    title: "Workloads and phases drive turns"
    lede: "Scheduled workloads—request rate, concurrency, user-centric, fixed schedule—emit turn schedules. Phase runtime applies warmup, profiling, ramp, drain, and cancellation policy before transport ever sends."
    narration: "Workloads and phase runtime decide when turns fire. Transports only send and observe the wire path."
    term: {
      word: "phase_runtime"
      meaning: "Shared lifecycle orchestration that connects schedulers to turn dispatch and terminal drain behavior."
    }
    points: [
      "Graph programs use the separate DAG executor.",
      "`scheduled.rs` bridges Workload to TurnDispatcher.",
      "Cancellation and grace propagate through shared phase code."
    ]
    caption: "Scheduling decides when; transport decides how to send."
    render: @scene {
      sdk.Header(id = "header", title = "WORKLOAD + PHASES", caption = "scheduled + phase_runtime", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "workload", title = "Workload", detail = "request-rate / graph", x = 80, y = 120, width = 180, height = 110, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a1", mode = "line", from = { x: 260, y: 175 }, to = { x: 310, y: 175 }, style = { stroke: "@theme.accent.warning", strokeWidth: 2.2 })
      sdk.Panel(id = "phase", title = "phase_runtime", detail = "warmup · drain", x = 310, y = 120, width = 180, height = 110, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Edge(id = "a2", mode = "line", from = { x: 490, y: 175 }, to = { x: 540, y: 175 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "turns", title = "Turns", detail = "dispatch", x = 540, y = 120, width = 90, height = 110, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "workload", anchor: "w" }, to = { nodeId: "turns", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal workload duration 340
        after workload trace a1 duration 280
        after a1 reveal phase duration 340
        after phase trace a2 duration 280
        after a2 reveal turns duration 340
        after turns trace motion-sig duration 1100
      }
    }
  }
  slide "Observation seam" {
    eyebrow: "Observation seam"
    title: "loadgen-core keeps transport neutral"
    lede: "Transports implement `RequestSink`; observers receive arrival, admission, token, usage, and terminal events. TTFT is the first token observation—there is no separate first-token event."
    narration: "loadgen-core defines the neutral observer seam. Transports implement RequestSink; measurement stays shared."
    term: {
      word: "RequestObserver"
      meaning: "Worker-local callback surface with no Send bound, allowing LocalSet-friendly state."
    }
    points: [
      "HTTP and gRPC share reduction in `transport::reduce`.",
      "Measurement accumulates in `transport::measure`.",
      "Endpoint usage is captured verbatim when present."
    ]
    caption: "Transport sends; observer measures; sink owns the lifecycle."
    render: @scene {
      sdk.Header(id = "header", title = "OBSERVER SEAM", caption = "RequestSink + Observer", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "dispatcher", title = "TurnDispatcher", detail = "scheduler side", x = 70, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Edge(id = "a1", mode = "line", from = { x: 220, y: 178 }, to = { x: 270, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "sink", title = "RequestSink", detail = "transport side", x = 270, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a2", mode = "line", from = { x: 420, y: 178 }, to = { x: 470, y: 178 }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 2.2 })
      sdk.Panel(id = "observer", title = "RequestObserver", detail = "measurement", x = 470, y = 130, width = 160, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "dispatcher", anchor: "w" }, to = { nodeId: "observer", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal dispatcher duration 320
        after dispatcher trace a1 duration 280
        after a1 reveal sink duration 320
        after sink trace a2 duration 280
        after a2 reveal observer duration 320
        after observer trace motion-sig duration 1100
      }
    }
  }
  slide "Parallelism" {
    eyebrow: "Parallelism"
    title: "Thread-per-core workers, not mutex hot paths"
    lede: "When `workers == 1`, scheduler and sink co-locate on a current-thread runtime. When `workers > 1`, each OS thread runs a self-contained sub-cell with its own LocalSet and transport sink."
    narration: "Parallelism is thread-per-core. Each worker owns local scheduling, transport, and capture without hot-path mutexes."
    term: {
      word: "Sub-cell"
      meaning: "A worker thread that owns scheduling, admission, transport, capture, and local measurement without cross-thread locks on the request path."
    }
    points: [
      "Read-only Arc data crosses thread boundaries.",
      "Per-worker state stays local and merges at boundaries.",
      "Hyper and SSE paths rely on LocalSet because clients are not Send."
    ]
    caption: "Scale out by adding worker threads, not shared mutable hot state."
    render: @scene {
      sdk.Header(id = "header", title = "WORKER MODEL", caption = "thread-per-core sub-cells", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "coord", title = "Coordinator thread", detail = "workers > 1", x = 250, y = 90, width = 200, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Panel(id = "w0", title = "Worker 0", detail = "sub-cell", x = 120, y = 220, width = 110, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Panel(id = "w1", title = "Worker 1", detail = "sub-cell", x = 290, y = 220, width = 110, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.FanOut(id = "worker-fan", from = { nodeId: "coord", anchor: "s" }, to = [
            { nodeId: "w0", anchor: "n" },
            { nodeId: "w1", anchor: "n" },
            { nodeId: "w2", anchor: "n" }
          ], axis = "y", junction = { x: 350, y: 190 }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2 })
      sdk.Panel(id = "w2", title = "Worker 2", detail = "sub-cell", x = 460, y = 220, width = 110, height = 70, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      timeline primary {
        at 0 reveal header duration 280
        after header reveal coord duration 340
        after coord trace worker-fan duration 900
        after worker-fan reveal w0 duration 260
        after w0 reveal w1 duration 260
        after w1 reveal w2 duration 260
        after w2 trace worker-fan duration 1100
      }
    }
  }
  slide "Scale-out" {
    eyebrow: "Scale-out"
    title: "Cellular mode adds controller and cells"
    lede: "`--cells N` promotes the run to a controller that partitions work, launches `aiperf --cell` children, merges records or folded stores over Velo, and writes one authoritative report. SLURM and Kubernetes reuse the same model."
    narration: "Cellular mode adds a controller, remote cells, Velo control traffic, and a single merged report."
    term: {
      word: "Cell partition"
      meaning: "Deterministic slice of the global request or conversation budget owned by one remote cell process."
    }
    points: [
      "Rank 0 or the controller owns merge and artifact shipping.",
      "Velo carries control only; HTTP and gRPC carry measured load.",
      "Bulk artifacts can use a separate HTTP/1 + zstd path."
    ]
    caption: "Same engine, more processes, partitioned ownership."
    render: @scene {
      sdk.Header(id = "header", title = "CELLULAR MODE", caption = "controller + cells + Velo", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "controller", title = "Controller", detail = "rank 0", x = 70, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.warning")
      sdk.Edge(id = "a1", mode = "line", from = { x: 220, y: 178 }, to = { x: 270, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "velo", title = "Velo", detail = "control plane", x = 270, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Edge(id = "a2", mode = "line", from = { x: 420, y: 178 }, to = { x: 470, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "cells", title = "Cells", detail = "load + results", x = 470, y = 130, width = 160, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.secondary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "controller", anchor: "w" }, to = { nodeId: "cells", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal controller duration 340
        after controller trace a1 duration 280
        after a1 reveal velo duration 340
        after velo trace a2 duration 280
        after a2 reveal cells duration 340
        after cells trace motion-sig duration 1100
      }
    }
  }
  slide "Outputs & gates" {
    eyebrow: "Outputs & gates"
    title: "Metrics merge, exporters fan out, features opt in"
    lede: "Workers accumulate metrics locally; the report plane writes `native-v2.json` as authoritative truth, then exporters emit JSON, CSV, Parquet, OTLP, and more. Cargo features gate gRPC, cellular, parquet, dynosim, and pyo3-embed."
    narration: "Metrics merge into native-v2.json, exporters fan out artifacts, and Cargo features opt into gRPC, cellular, dynosim, and more."
    term: {
      word: "native-v2.json"
      meaning: "Authoritative merged report for a run before optional exporter side outputs."
    }
    points: [
      "Sketch mode uses mergeable t-digests for approximate percentiles.",
      "`--steady-state` derives a measurement window from concurrency crossings.",
      "Mock server stays outside profile supervision for deterministic tests."
    ]
    caption: "Measure locally, merge once, export many formats."
    render: @scene {
      sdk.Header(id = "header", title = "METRICS + FEATURES", caption = "native-v2.json + exporters", x = 18, y = 16, width = 664, height = 44)
      sdk.Panel(id = "workers", title = "Workers", detail = "local metrics", x = 60, y = 130, width = 130, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.ink.secondary")
      sdk.Edge(id = "a1", mode = "line", from = { x: 190, y: 178 }, to = { x: 240, y: 178 }, style = { stroke: "@theme.accent.tertiary", strokeWidth: 2.2 })
      sdk.Panel(id = "report", title = "native-v2.json", detail = "authoritative", x = 240, y = 130, width = 150, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.tertiary")
      sdk.Edge(id = "a2", mode = "line", from = { x: 390, y: 178 }, to = { x: 440, y: 178 }, style = { stroke: "@theme.accent.primary", strokeWidth: 2.2 })
      sdk.Panel(id = "exporters", title = "Exporters", detail = "JSON · CSV · Parquet", x = 440, y = 130, width = 200, height = 96, surfaceRole = "@theme.surface.primary", strokeRole = "@theme.accent.primary")
      sdk.Label(id = "footer", text = "features: grpc · cellular · dynosim · parquet · pyo3-embed", x = 50, y = 280, width = 600, height = 24, fontSize = 13, align = "middle", inkRole = "@theme.ink.secondary")
      sdk.Signal(id = "motion-sig", from = { nodeId: "workers", anchor: "w" }, to = { nodeId: "exporters", anchor: "e" }, style = { fill: "none", stroke: "@theme.accent.primary", strokeWidth: 2.4, opacity: 0.55 })
      timeline primary {
        at 0 reveal header duration 280
        after header reveal workers duration 320
        after workers trace a1 duration 280
        after a1 reveal report duration 340
        after report trace a2 duration 280
        after a2 reveal exporters duration 340
        after exporters reveal footer duration 300
        after footer trace motion-sig duration 1100
      }
    }
  }
}
