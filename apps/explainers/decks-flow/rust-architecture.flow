        {
          id: "pulse-a"
          capability: "core.rect"
          layout: { x: 70, y: 150, width: 150, height: 80 }
          style: { fill: "none", stroke: @theme.accent.secondary, strokeWidth: 1.5, opacity: 0.45 }
          accessibility: { label: "motion pulse A" }
        }
        {
          id: "pulse-b"
          capability: "core.rect"
          layout: { x: 480, y: 150, width: 150, height: 80 }
          style: { fill: "none", stroke: @theme.accent.primary, strokeWidth: 1.5, opacity: 0.45 }
          accessibility: { label: "motion pulse B" }
        }
        {
          id: "motion-sig-dot"
          capability: "core.dot"
          layout: { x: 345, y: 195, width: 10, height: 10 }
          style: { r: 5, fill: @theme.accent.primary }
        }
{
