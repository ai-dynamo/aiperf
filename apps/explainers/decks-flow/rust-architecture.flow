explainer "Rust Architecture" {
  id: "rust-architecture"
  route: "/rust-architecture"
  topic: "architecture"
  storagePrefix: "rust-arch-explainer"
  classPrefix: "rust-arch"
  eyebrowLabel: "RUST ARCHITECTURE"
  startGateTitle: "Rust architecture walkthrough"

  hub: {
    highlight: "Rust architecture"
    title: "from scratch"
    description: "Narrated walkthrough of the native workspace, self-execution seam, registry bootstrap, request lifecycle, workers, cellular mode, and feature gates."
  }

  slide "Product shell" {
    eyebrow: "Product shell"
    title: "One binary is both CLI and engine"
    lede: "AIPerf ships as a single native `aiperf` executable from crate `aiperf-cli`. There is no separate runner process—the same binary parses public commands and re-executes itself for benchmark runs."
    narration: "AIPerf ships as one native aiperf binary. That same executable is both the public command line and the hidden execution engine."
    term: {
      word: "aiperf-cli"
      meaning: "The product entry crate: public commands, Config v2 loading, and self-spawned execution over stdio."
    }
    points: [
      "`rust/cli` builds the `aiperf` binary.",
      "Global allocator is mimalloc on the hot path.",
      "Internal modes are intercepted before normal CLI parsing."
    ]
    caption: "One executable, two hats: operator CLI and execution child."
    render: @scene {
      roots: [
        {
          id: "header"
          capability: "core.rect"
          layout: { x: 18, y: 16, width: 664, height: 44 }
          style: { fill: @theme.surface.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
        }
        {
          id: "label"
          capability: "core.text"
          text: "ONE BINARY"
          layout: { x: 38, y: 28, width: 320, height: 24 }
          style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary }
        }
        {
          id: "note"
          capability: "core.text"
          text: "cli is entry + engine"
          layout: { x: 360, y: 28, width: 300, height: 24 }
          style: { fontSize: 12, fill: @theme.ink.secondary, textAnchor: "end" }
        },
        {
          id: "binary"
          capability: "core.rect"
          layout: { x: 250, y: 130, width: 200, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.primary, strokeWidth: 1.8 }
          children: [
            {
              id: "binary-title"
              capability: "core.text"
              text: "aiperf binary"
              layout: { x: 250, y: 154, width: 200, height: 22 }
              style: { fontSize: 14, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            }
            {
              id: "binary-detail"
              capability: "core.text"
              text: "cli/src/main.rs"
              layout: { x: 250, y: 178, width: 200, height: 18 }
              style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        },
        {
          id: "footer"
          capability: "core.text"
          text: "public CLI on the outside · execution child on the inside"
          layout: { x: 50, y: 270, width: 600, height: 24 }
          style: { fontSize: 13, fill: @theme.ink.secondary, textAnchor: "middle" }
        },
        {
          id: "cli-hat"
          capability: "core.rect"
          layout: { x: 90, y: 310, width: 180, height: 55 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.secondary, strokeWidth: 1.4 }
          children: [
            {
              id: "cli-hat-title"
              capability: "core.text"
              text: "public CLI"
              layout: { x: 90, y: 326, width: 180, height: 20 }
              style: { fontSize: 13, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            }
            {
              id: "cli-hat-detail"
              capability: "core.text"
              text: "outside"
              layout: { x: 90, y: 346, width: 180, height: 16 }
              style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        },
        {
          id: "a1"
          capability: "core.line"
          from: { x: 270, y: 337 }
          to: { x: 430, y: 337 }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2 }
        },
        {
          id: "engine-hat"
          capability: "core.rect"
          layout: { x: 430, y: 310, width: 180, height: 55 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.primary, strokeWidth: 1.4 }
          children: [
            {
              id: "engine-hat-title"
              capability: "core.text"
              text: "execution child"
              layout: { x: 430, y: 326, width: 180, height: 20 }
              style: { fontSize: 13, fontWeight: "bold", fill: @theme.ink.primary, textAnchor: "middle" }
            }
            {
              id: "engine-hat-detail"
              capability: "core.text"
              text: "inside"
              layout: { x: 430, y: 346, width: 180, height: 16 }
              style: { fontSize: 11, fill: @theme.ink.secondary, textAnchor: "middle" }
            }
          ]
        },
        {
          id: "pulse-a"
          capability: "core.rect"
          layout: { x: 70, y: 150, width: 150, height: 80 }
          style: { fill: "none", stroke: @theme.accent.secondary, strokeWidth: 1.5, opacity: 0.4 }
          accessibility: { label: "motion pulse A" }
        }
        {
          id: "pulse-b"
