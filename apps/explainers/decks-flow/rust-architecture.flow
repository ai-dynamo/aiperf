          layout: { x: 50, y: 300, width: 600, height: 24 }
          style: { fontSize: 13, fill: @theme.ink.secondary, textAnchor: "middle" }
        }

        {
          id: "chip-mimalloc"
          capability: "core.rect"
          layout: { x: 250, y: 330, width: 200, height: 42 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1.2 }
          children: [
            {
              id: "chip-mimalloc-title"
