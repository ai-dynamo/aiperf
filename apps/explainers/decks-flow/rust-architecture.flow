          style: { fill: "none", stroke: @theme.accent.primary, strokeWidth: 2.4, opacity: 0.55 }
          accessibility: { label: "motion signal" }
        }
      ]
      timeline: [
        { id: "t-header", at: 0, duration: 280, target: "header", action: "enter" }
        { id: "t-label", at: 60, duration: 260, target: "label", action: "enter" }
        { id: "t-note", at: 100, duration: 260, target: "note", action: "enter" }
        { id: "t-binary", at: 280, duration: 360, target: "binary", action: "enter" }
        { id: "t-cli-inner", at: 480, duration: 280, target: "cli-inner", action: "enter" }
        { id: "t-engine-inner", at: 620, duration: 280, target: "engine-inner", action: "enter" }
        { id: "t-cli", at: 780, duration: 320, target: "cli-hat", action: "enter" }
        { id: "t-a1", at: 960, duration: 280, target: "a1", action: "draw" }
        { id: "t-engine", at: 1140, duration: 320, target: "engine-hat", action: "enter" }
        { id: "t-a2", at: 1320, duration: 280, target: "a2", action: "draw" }
        { id: "t-footer", at: 1500, duration: 320, target: "footer", action: "enter" }
        { id: "t-chip-mimalloc", at: 1600, duration: 280, target: "chip-mimalloc", action: "enter" }
        { id: "t-pulse-a", at: 720, duration: 400, target: "pulse-a", action: "enter" }
