          layout: { x: 250, y: 130, width: 170, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.primary, strokeWidth: 1.8 }
        },
        {
          id: "a2"
          capability: "core.connector"
          from: { nodeId: "runtime", anchor: "e" }
          to: { nodeId: "loadgen", anchor: "w" }
          style: { stroke: @theme.accent.primary, strokeWidth: 2.2 }
        },
        {
          id: "loadgen"
          capability: "core.panel"
          title: "loadgen-core"
          detail: "observer seam"
          layout: { x: 460, y: 130, width: 180, height: 96 }
          style: { fill: @theme.surface.primary, stroke: @theme.accent.tertiary, strokeWidth: 1.8 }
        },
        {
          id: "mock"
          capability: "core.panel"
          title: "mock-server"
          detail: "separate target"
          layout: { x: 520, y: 280, width: 120, height: 58 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 1.3 }
        },
        {
          id: "pulse-a"
          capability: "core.rect"
          layout: { x: 78, y: 150, width: 150, height: 80 }
          style: { fill: "none", stroke: @theme.accent.secondary, strokeWidth: 1.5, opacity: 0.4 }
          accessibility: { label: "motion pulse A" }
        }
        {
