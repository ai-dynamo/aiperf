flow "Cinematic foundation" as cinematic-foundation {
  language 1
  require core.rect "^1.0.0"
  require core.text "^1.0.0"
  require core.connector "^1.0.0"
  token accent = "#68a8ff"
  token evidence = "#dbeafe"

  scene "Request execution" as request-execution {
    summary "A request moves from clock-aware admission through a worker-local sink while stable evidence preserves each causal boundary."

    rect admission {
      x 80
      y 96
      width 220
      height 96
      fill "#13243a"
      label "Admission queue"
      role "img"
      description "The clock-aware admission boundary."
      fallback "Admission queue"
    }

    rect worker {
      x 500
      y 96
      width 220
      height 96
      fill "#163a32"
      label "Worker sink"
      role "img"
      description "The worker-local request transport."
      fallback "Worker sink"
    }

    connector dispatch {
      from admission
      to worker
      label "dispatch request"
      stroke token(accent)
      fallback "Admission dispatches a request to the worker sink."
    }

    rect ev-arrival-request-execution {
      x 80
      y 240
      width 220
      height 72
      fill token(evidence)
      label "Arrival evidence"
      role "note"
      description "Stable evidence ev-arrival-request-execution records the request at the clock-aware admission boundary."
      fallback "ev-arrival-request-execution: request arrival at admission."
    }

    rect ev-dispatch-request-execution {
      x 500
      y 240
      width 220
      height 72
      fill token(evidence)
      label "Dispatch evidence"
      role "note"
      description "Stable evidence ev-dispatch-request-execution records dispatch from admission to the worker-local sink."
      fallback "ev-dispatch-request-execution: admission dispatches to the worker sink."
    }

    camera primary {
      at 0 frame admission,ev-arrival-request-execution zoom 1.1
      at 600 frame admission,worker zoom 1
      at 1600 frame worker,ev-dispatch-request-execution zoom 1.1
    }

    timeline arrival {
      at 0 reveal admission duration 400
      at 400 reveal ev-arrival-request-execution duration 200
    }

    timeline dispatch-request {
      at 600 trace dispatch duration 800
      at 1400 reveal ev-dispatch-request-execution duration 200
    }

    timeline worker-ready {
      at 1600 reveal worker duration 400
    }

    interaction inspect-admission {
      on select admission
      do inspect admission
    }

    interaction inspect-worker {
      on select worker
      do inspect worker
    }

    interaction inspect-arrival-evidence {
      on select ev-arrival-request-execution
      do inspect ev-arrival-request-execution
    }

    interaction inspect-dispatch-evidence {
      on select ev-dispatch-request-execution
      do inspect ev-dispatch-request-execution
    }

    responsive compact when width < 720 {
      set worker.x = 80
      set worker.y = 260
      set ev-arrival-request-execution.x = 320
      set ev-arrival-request-execution.y = 96
      set ev-dispatch-request-execution.x = 320
      set ev-dispatch-request-execution.y = 260
    }

    narrate "Arrival enters the clock-aware admission boundary. Dispatch then crosses the stable relation into the worker-local sink. The arrival and dispatch evidence remain inspectable at every replay position."
    reading-order admission,ev-arrival-request-execution,dispatch,worker,ev-dispatch-request-execution
    fallback "A request arrives at clock-aware admission and dispatches through a worker-local sink. Stable arrival and dispatch evidence remain available for inspection."
  }
}
