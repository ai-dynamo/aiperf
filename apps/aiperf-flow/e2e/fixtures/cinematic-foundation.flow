flow "Cinematic foundation" as cinematic-foundation {
  language 1
  require core.rect "^1.0.0"
  require core.text "^1.0.0"
  require core.connector "^1.0.0"
  token accent = "#68a8ff"

  scene "Request execution" as request-execution {
    summary "A request moves from admission through a worker-local sink."

    rect admission {
      x 80
      y 96
      width 220
      height 96
      fill "#13243a"
      label "Admission queue"
      role "img"
      description "The clock-aware admission boundary."
      fallback "Admission queue"
    }

    rect worker {
      x 500
      y 96
      width 220
      height 96
      fill "#163a32"
      label "Worker sink"
      role "img"
      description "The worker-local request transport."
      fallback "Worker sink"
    }

    connector dispatch {
      from admission
      to worker
      label "dispatch request"
      stroke token(accent)
      fallback "Admission dispatches a request to the worker sink."
    }

    camera primary {
      at 0 frame admission,worker zoom 1
      at 1600 frame worker zoom 1.2
    }

    timeline lesson {
      at 0 reveal admission duration 400
      at 600 trace dispatch duration 800
      at 1600 reveal worker duration 400
    }

    interaction inspect-admission {
      on select admission
      do inspect admission
    }

    interaction inspect-worker {
      on select worker
      do inspect worker
    }

    responsive compact when width < 720 {
      set worker.x = 80
      set worker.y = 260
    }

    narrate "Admission follows the shared clock, then dispatches through a worker-local sink."
    reading-order admission,worker,dispatch
    fallback "Admission dispatches a request through a worker-local sink."
  }
}
