explainer "Minimal Explainer" {
  id: "minimal-explainer"
  route: "/minimal-explainer"
  topic: "test"
  storagePrefix: "minimal-explainer"
  classPrefix: "minimal"
  eyebrowLabel: "MINIMAL"
  startGateTitle: "Minimal explainer walkthrough"

  hub: {
    title: "from scratch"
    highlight: "Minimal explainer"
    description: "Golden one-slide deck for compiler lowering to DeckPackage."
  }

  slide "One box" {
    eyebrow: "One box"
    title: "A single animated rectangle"
    lede: "The smallest diagram slide that still exercises scene IR and timeline."
    narration: "This slide shows one rectangle entering the scene."
    points: [
      "One core.rect node",
      "One timeline enter cue"
    ]
    caption: "Minimal scene with enter cue"

    render: @scene {
      roots: [
        {
          id: "box"
          capability: "core.rect"
          layout: { x: 80, y: 120, width: 160, height: 72 }
          style: { fill: "#3FA266" }
        }
      ]
      timeline: [
        {
          id: "enter-box"
          at: 0
          duration: 400
          target: "box"
          action: "enter"
        }
      ]
    }
  }
}
