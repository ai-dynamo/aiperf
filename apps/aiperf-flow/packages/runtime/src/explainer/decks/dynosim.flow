flow "Dynosim: Discrete-event simulation for AIPerf" as dynosim-explainer {
  language 1

  require core.rect "^1.0.0"
  require core.connector "^1.0.0"
  require core.camera "^1.0.0"
  require core.timeline "^1.0.0"
  require core.inspect "^1.0.0"
  require viz.queue "^1.0.0"
  require viz.timeline "^1.0.0"

  token background = "#07111f"
  token surface = "#12233b"
  token surface-strong = "#1d3557"
  token dynosim = "#10b981"
  token clock = "#8b5cf6"
  token engine = "#ec4899"
  token transport = "#38bdf8"
  token observer = "#f472b6"
  token event = "#fbbf24"
  token evidence = "#dbeafe"
  token relation = "#6b8db5"

  scene "Why Dynosim" as why-dynosim {
    summary "Co-simulation without a live inference server. Dynosim runs AIPerf's full workload loop against Dynamo's passive mock engine in-process."

    rect title-panel {
      x 80
      y 100
      width 1200
      height 120
      fill token(surface-strong)
      label "Why Dynosim: No serving socket on the hot path"
      role "heading"
      description "Dynosim enables co-simulation with Dynamo's passive engine in-process, eliminating HTTP sockets from measurement."
      fallback "Dynosim: co-simulation without live inference server."
    }

    rect aiperf-box {
      x 100
      y 280
      width 280
      height 200
      fill token(dynosim)
      label "AIPerf workload"
      role "group"
      description "AIPerf owns scheduling, Clock, RequestObserver, and report merge."
      fallback "AIPerf: workload scheduling and observation."
    }

    rect dynamo-box {
      x 500
      y 280
      width 280
      height 200
      fill token(engine)
      label "Dynamo mocker"
      role "group"
      description "Dynamo mocker owns scheduler and performance-model state behind SteppableReplay."
      fallback "Dynamo: passive engine with performance models."
    }

    rect metrics-box {
      x 900
      y 280
      width 280
      height 200
      fill token(observer)
      label "Metrics & reports"
      role "group"
      description "Same metric vocabulary as online runs when configured for parity."
      fallback "Metrics: same as online execution."
    }

    connector flow1 {
      from aiperf-box
      to dynamo-box
      label "dispatch"
      stroke token(relation)
      fallback "AIPerf dispatches to Dynamo mocker."
    }

    connector flow2 {
      from dynamo-box
      to metrics-box
      label "events"
      stroke token(relation)
      fallback "Dynamo emits events to metrics system."
    }

    rect term-box {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Term: dynosim"
      role "note"
      description "Feature-gated transport family (dynosim_offline, dynosim_online) that replaces native HTTP execution with SteppableReplay-driven co-simulation."
      fallback "dynosim: feature-gated transport using SteppableReplay co-simulation."
    }

    camera scene-camera {
      at 0 frame title-panel,aiperf-box,dynamo-box,metrics-box zoom 1.0
    }

    timeline reveal {
      at 0 reveal title-panel duration 300
      at 400 reveal aiperf-box duration 300
      at 800 reveal dynamo-box duration 300
      at 1200 reveal metrics-box duration 300
      at 1600 reveal flow1,flow2 duration 400
      at 2100 reveal term-box duration 250
    }

    narrate "Dynosim lets AIPerf benchmark without a live inference server. The workload loop and observers stay native; Dynamo's passive engine supplies timing and token events in-process."
    reading-order title-panel,aiperf-box,flow1,dynamo-box,flow2,metrics-box,term-box
    fallback "Dynosim: AIPerf's workload scheduler, clock, and observers run natively against Dynamo's in-process mock engine. Same metrics as live HTTP execution; no serving sockets needed."
  }

  scene "Feature gate" as feature-gate {
    summary "Cargo feature dynosim pulls the native crates and exposes transport IDs."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Feature gating: dynosim is opt-in"
      role "heading"
      description "The dynosim Cargo feature gates the transport implementations."
      fallback "dynosim feature enables dynosim_offline and dynosim_online transports."
    }

    rect no-feature {
      x 100
      y 260
      width 260
      height 180
      fill token(surface)
      label "Lean build"
      role "group"
      description "Ordinary lean HTTP builds omit dynosim entirely."
      fallback "No dynosim feature: HTTP only."
    }

    rect with-feature {
      x 500
      y 260
      width 260
      height 180
      fill token(dynosim)
      label "With --features dynosim"
      role "group"
      description "Enabling the dynosim feature links dynamo-mocker and exposes transport IDs."
      fallback "With dynosim feature: dynosim_offline and dynosim_online available."
    }

    rect registry {
      x 900
      y 260
      width 280
      height 180
      fill token(transport)
      label "Registry"
      role "group"
      description "Registry registers dynosim transports only when the feature is on."
      fallback "Registry: dynosim transports frozen at bootstrap."
    }

    rect build-cmd {
      x 100
      y 500
      width 1080
      height 100
      fill token(surface)
      label "Build command: cargo build -p aiperf-cli --features dynosim"
      role "code"
      description "Enable dynosim with the feature flag at compile time."
      fallback "Use --features dynosim to enable the transport family."
    }

    camera scene-camera {
      at 0 frame header,no-feature,with-feature,registry zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal no-feature duration 300
      at 800 reveal with-feature duration 300
      at 1200 reveal registry duration 300
      at 1600 reveal build-cmd duration 250
    }

    narrate "Dynosim is behind the dynosim Cargo feature. When enabled, the registry exposes dynosim offline and online transport identifiers alongside HTTP and gRPC."
    reading-order header,no-feature,with-feature,registry,build-cmd
    fallback "dynosim is a Cargo feature. Enable it to expose dynosim_offline and dynosim_online transport IDs in the registry."
  }

  scene "Config seam" as config-seam {
    summary "One BenchmarkRun configuration; transport selects the clock."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Config seam: one BenchmarkRun; transport picks real vs. virtual time"
      role "heading"
      description "The same Config v2 envelope serves both HTTP and dynosim transports."
      fallback "Config is shared; transport picks the clock."
    }

    rect config-box {
      x 100
      y 260
      width 360
      height 200
      fill token(surface)
      label "Config v2"
      role "group"
      description "Shared BenchmarkRun with workload, endpoints, and artifact settings."
      fallback "Config: workload, endpoints, artifacts."
    }

    rect http-path {
      x 550
      y 260
      width 200
      height 200
      fill token(transport)
      label "HTTP"
      role "group"
      description "transport.type: http → RealClock + native HTTP execution."
      fallback "HTTP: RealClock, native transports."
    }

    rect dynosim-offline {
      x 850
      y 260
      width 200
      height 200
      fill token(clock)
      label "dynosim_offline"
      role "group"
      description "transport.type: dynosim_offline → SimClock + virtual pump."
      fallback "dynosim_offline: SimClock, virtual time."
    }

    rect dynosim-online {
      x 1150
      y 260
      width 200
      height 200
      fill token(event)
      label "dynosim_online"
      role "group"
      description "transport.type: dynosim_online → RealClock + wall-time replay."
      fallback "dynosim_online: RealClock, wall time."
    }

    connector to-http {
      from config-box
      to http-path
      label "transport: http"
      stroke token(relation)
      fallback "Config routes to HTTP transport."
    }

    connector to-offline {
      from config-box
      to dynosim-offline
      label "transport: dynosim_offline"
      stroke token(relation)
      fallback "Config routes to dynosim_offline."
    }

    connector to-online {
      from config-box
      to dynosim-online
      label "transport: dynosim_online"
      stroke token(relation)
      fallback "Config routes to dynosim_online."
    }

    camera scene-camera {
      at 0 frame header,config-box,http-path,dynosim-offline,dynosim-online zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal config-box duration 300
      at 800 reveal http-path duration 250
      at 1100 reveal dynosim-offline duration 250
      at 1400 reveal dynosim-online duration 250
      at 1700 reveal to-http,to-offline,to-online duration 400
    }

    narrate "You author one benchmark configuration. The transport field chooses offline simulation with a virtual clock, or online replay against wall time."
    reading-order header,config-box,to-http,http-path,to-offline,dynosim-offline,to-online,dynosim-online
    fallback "Single Config v2 envelope; transport field selects HTTP, dynosim_offline, or dynosim_online."
  }

  scene "Routing" as routing {
    summary "Factory bypasses native HTTP execution when dynosim transport is selected."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Routing: dynosim factory, not HTTP stack"
      role "heading"
      description "Transport ID routes dynosim runs down a dedicated factory path."
      fallback "Dynosim transport ID bypasses HTTP client construction."
    }

    rect bootstrap {
      x 100
      y 260
      width 300
      height 200
      fill token(surface)
      label "Bootstrap"
      role "group"
      description "Application freeze includes dynosim factories when feature-gated."
      fallback "Bootstrap: Application freezes transport factories."
    }

    rect routing-decision {
      x 500
      y 260
      width 300
      height 200
      fill token(transport)
      label "Transport routing"
      role "group"
      description "Validate rejects dynosim IDs on builds without the feature."
      fallback "Routing: transport ID selects HTTP or dynosim path."
    }

    rect execution {
      x 900
      y 260
      width 300
      height 200
      fill token(dynosim)
      label "Execution"
      role "group"
      description "HTTP/gRPC code paths are not entered for dynosim transport IDs."
      fallback "Execution: dedicated dynosim sink and engine."
    }

    rect note {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "HTTP and gRPC clients are never constructed for dynosim runs; the factory produces EngineHost and DynosimSink instead."
      role "note"
      description "Key invariant: dynosim transport IDs skip HTTP initialization entirely."
      fallback "Invariant: native HTTP stack skipped for dynosim."
    }

    camera scene-camera {
      at 0 frame header,bootstrap,routing-decision,execution zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal bootstrap duration 300
      at 800 reveal routing-decision duration 300
      at 1200 reveal execution duration 300
      at 1600 reveal note duration 250
    }

    narrate "Registry routing sends dynosim runs down a dedicated factory path. Native HTTP and gRPC clients are never constructed for these transport identifiers."
    reading-order header,bootstrap,routing-decision,execution,note
    fallback "Routing: dynosim factory produces ExecutionSinkBuilder and WorkerSink; HTTP paths not entered."
  }

  scene "Composition" as composition {
    summary "EngineHost and DynosimSink implement RequestSink and share the same RequestObserver pipeline."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Composition: same observer seam, different dispatch"
      role "heading"
      description "Transport-neutral observation vocabulary bridges replay engine and metrics."
      fallback "Observer seam is transport-neutral."
    }

    rect engine-host {
      x 100
      y 260
      width 280
      height 200
      fill token(engine)
      label "EngineHost"
      role "group"
      description "Wraps SteppableReplay and bridges DirectRequest submission."
      fallback "EngineHost: wraps replay engine."
    }

    rect dynosim-sink {
      x 500
      y 260
      width 280
      height 200
      fill token(dynosim)
      label "DynosimSink"
      role "group"
      description "Worker-local sink implementing RequestSink and forwarding events."
      fallback "DynosimSink: implements RequestSink."
    }

    rect observer {
      x 900
      y 260
      width 280
      height 200
      fill token(observer)
      label "RequestObserver"
      role "group"
      description "Callbacks match online semantics: token, usage, terminal events."
      fallback "RequestObserver: receives lifecycle events."
    }

    rect contract {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Contract: RequestObserver and RequestSink are transport-neutral. TTFT is first-token observation; terminal coalescing policy matches HTTP streaming."
      role "note"
      description "Transport-neutral vocabulary ensures parity across HTTP and dynosim."
      fallback "Observer contract: TTFT + terminal + usage events; same vocabulary as HTTP."
    }

    camera scene-camera {
      at 0 frame header,engine-host,dynosim-sink,observer zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal engine-host duration 300
      at 800 reveal dynosim-sink duration 300
      at 1200 reveal observer duration 300
      at 1600 reveal contract duration 250
    }

    narrate "EngineHost wraps the replay engine. DynosimSink implements the same RequestSink and RequestObserver contract as HTTP transports."
    reading-order header,engine-host,dynosim-sink,observer,contract
    fallback "EngineHost+DynosimSink composition: same observer vocabulary, different execution backend."
  }

  scene "Offline mode" as offline-mode {
    summary "dynosim_offline owns SimClock: virtual time with deterministic ordering."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Offline: SimClock and deterministic virtual time"
      role "heading"
      description "Offline runs use virtual nanoseconds advancing under the sim pump."
      fallback "dynosim_offline: SimClock with virtual time."
    }

    rect simclock {
      x 100
      y 260
      width 280
      height 200
      fill token(clock)
      label "SimClock"
      role "group"
      description "Integer-nanosecond virtual time with deterministic event ordering."
      fallback "SimClock: virtual nanoseconds."
    }

    rect pump {
      x 500
      y 260
      width 280
      height 200
      fill token(dynosim)
      label "Sim pump"
      role "group"
      description "Advances virtual time until workload completes or source quiesces."
      fallback "Pump: advances virtual time."
    }

    rect reproducible {
      x 900
      y 260
      width 280
      height 200
      fill token(event)
      label "Reproducible"
      role "group"
      description "Runs are reproducible when inputs and seeds are fixed."
      fallback "Reproducible: same inputs → same outputs."
    }

    rect note {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Arrivals, phase gates, backoff, and engine steps all use SimClock. No wall-clock APIs on hot paths."
      role "note"
      description "Deterministic virtual time enables reproducible benchmarking."
      fallback "Virtual time: reproducible, no wall-clock calls on measurement paths."
    }

    camera scene-camera {
      at 0 frame header,simclock,pump,reproducible zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal simclock duration 300
      at 800 reveal pump duration 300
      at 1200 reveal reproducible duration 300
      at 1600 reveal note duration 250
    }

    narrate "Offline dynosim runs on SimClock. Virtual nanoseconds advance under the sim pump until the workload completes."
    reading-order header,simclock,pump,reproducible,note
    fallback "Offline: SimClock drives virtual time for deterministic, reproducible runs."
  }

  scene "Online mode" as online-mode {
    summary "dynosim_online keeps RealClock: wall time between engine steps."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Online: RealClock with wall-time replay"
      role "heading"
      description "Online replay uses RealClock to validate live integration paths."
      fallback "dynosim_online: RealClock with wall time."
    }

    rect realclock {
      x 100
      y 260
      width 280
      height 200
      fill token(event)
      label "RealClock"
      role "group"
      description "Wall-time Clock used for HTTP, gRPC, and dynosim_online execution."
      fallback "RealClock: wall time."
    }

    rect replay {
      x 500
      y 260
      width 280
      height 200
      fill token(transport)
      label "SteppableReplay"
      role "group"
      description "Engine steps driven by wall-clock pacing, not virtual scheduling."
      fallback "Replay: wall-clock driven."
    }

    rect validation {
      x 900
      y 260
      width 280
      height 200
      fill token(dynosim)
      label "Integration"
      role "group"
      description "Same coordinator path as HTTP; useful when timing reflects scheduler latency."
      fallback "Integration: same metrics merge."
    }

    rect note {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "drive_real_with_source is the wall-clock twin of drive_sim_with_source. Metric merge and artifacts follow the same coordinator path."
      role "note"
      description "Online dynosim validates live paths while preserving replay semantics."
      fallback "Online: wall-clock paced, same metrics and coordinator."
    }

    camera scene-camera {
      at 0 frame header,realclock,replay,validation zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal realclock duration 300
      at 800 reveal replay duration 300
      at 1200 reveal validation duration 300
      at 1600 reveal note duration 250
    }

    narrate "Online dynosim uses RealClock. The same replay engine runs, but virtual scheduling gives way to wall-clock pacing."
    reading-order header,realclock,replay,validation,note
    fallback "Online: RealClock drives replay engine for wall-time paced benchmarks."
  }

  scene "Clock compare" as clock-compare {
    summary "RealClock vs SimClock: one Clock trait, two time domains."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Clock abstraction: one trait, two time domains"
      role "heading"
      description "Measurement code routes through Clock in both real and virtual modes."
      fallback "Clock trait: RealClock vs SimClock."
    }

    rect realclock {
      x 100
      y 260
      width 280
      height 180
      fill token(event)
      label "RealClock"
      role "group"
      description "Tracks system time. Now() returns wall-clock nanoseconds."
      fallback "RealClock: system time."
    }

    rect simclock {
      x 500
      y 260
      width 280
      height 180
      fill token(clock)
      label "SimClock"
      role "group"
      description "Advances only when driver pumps events. Now() returns virtual nanoseconds."
      fallback "SimClock: virtual time."
    }

    rect practice {
      x 900
      y 260
      width 280
      height 180
      fill token(dynosim)
      label "Practice"
      role "group"
      description "Never call Instant::now on request hot paths; use Clock::now_ns."
      fallback "Best practice: use Clock, not Instant::now."
    }

    rect rules {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Invariants: SimClock tie-breaks favor scheduled arrivals before engine passes at equal t. RealClock online runs behave like ordinary profile executions."
      role "note"
      description "Both clock implementations preserve parity and determinism."
      fallback "Clock rules: tie-breaks for determinism; same semantics for both."
    }

    camera scene-camera {
      at 0 frame header,realclock,simclock,practice zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal realclock duration 300
      at 800 reveal simclock duration 300
      at 1200 reveal practice duration 300
      at 1600 reveal rules duration 250
    }

    narrate "RealClock tracks wall time. SimClock advances only when the driver pumps events. All measurement must go through the Clock abstraction in both modes."
    reading-order header,realclock,simclock,practice,rules
    fallback "Clock abstraction: both implement Clock trait with now_ns and timer registration."
  }

  scene "Event queues" as event-queues {
    summary "Two queues compete: SimClock ready timers and engine external events."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Event queues: clock vs engine events"
      role "heading"
      description "Two virtual queues feed the pump; earliest timestamp wins."
      fallback "Two queues: clock and engine events."
    }

    rect clock-queue {
      x 100
      y 260
      width 300
      height 200
      fill token(clock)
      label "Clock queue"
      role "group"
      description "Arrivals, phase transitions, grace timers. Ready when now >= scheduled time."
      fallback "Clock queue: arrivals and timers."
    }

    rect source-queue {
      x 500
      y 260
      width 300
      height 200
      fill token(engine)
      label "Source queue"
      role "group"
      description "SteppableReplay engine passes and token timing. Passive external events."
      fallback "Source queue: engine events."
    }

    rect resolution {
      x 900
      y 260
      width 300
      height 200
      fill token(dynosim)
      label "Resolution"
      role "group"
      description "Driver picks earliest timestamp. Clock wins ties at the same t."
      fallback "Resolution: earliest event; clock wins ties."
    }

    rect note {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "SimEventSource exposes next_event_ns and step bounds. Tie-breaking ensures arrival-before-pass invariant for deterministic batching."
      role "note"
      description "Deterministic ordering requires clock-wins-ties rule."
      fallback "Queue resolution: clock-wins-ties preserves determinism."
    }

    camera scene-camera {
      at 0 frame header,clock-queue,source-queue,resolution zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal clock-queue duration 300
      at 800 reveal source-queue duration 300
      at 1200 reveal resolution duration 300
      at 1600 reveal note duration 250
    }

    narrate "Two virtual queues feed the pump: SimClock timers and the replay engine's next event. The driver always picks the earliest timestamp."
    reading-order header,clock-queue,source-queue,resolution,note
    fallback "Event queues: clock and engine; earliest timestamp wins; clock wins ties."
  }

  scene "Sim pump" as sim-pump {
    summary "Poll workload to quiescence, then advance time. Repeat until Ready."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Sim pump loop: poll, idle, advance, repeat"
      role "heading"
      description "The drive_sim_with_source loop alternates polling and virtual time advancement."
      fallback "Pump loop: poll → idle → advance → poll."
    }

    rect poll {
      x 100
      y 260
      width 260
      height 180
      fill token(dynosim)
      label "Poll"
      role "group"
      description "Poll workload future on current-thread runtime. If Poll::Ready, go to drain."
      fallback "Poll: workload future."
    }

    rect idle-check {
      x 450
      y 260
      width 260
      height 180
      fill token(transport)
      label "Idle?"
      role "group"
      description "If Pending and idle (no new wakes), move to advance. Wakes re-enter without advancing time."
      fallback "Idle check: pending status."
    }

    rect advance {
      x 800
      y 260
      width 260
      height 180
      fill token(clock)
      label "Advance"
      role "group"
      description "Advance to earliest clock or source event time. May complete source step."
      fallback "Advance: virtual time step."
    }

    rect drain {
      x 1100
      y 260
      width 120
      height 180
      fill token(event)
      label "Drain"
      role "group"
      description "When workload is Ready, drain source events and exit."
      fallback "Drain: final source events."
    }

    rect loop-note {
      x 100
      y 480
      width 1120
      height 120
      fill token(surface)
      label "Loop: poll → Pending+Idle → advance → repeat. Deadlock detection triggers if neither queue has a future event."
      role "note"
      description "Pump runs until workload completes or deadlock is detected."
      fallback "Pump: repeats poll-idle-advance until completion or deadlock."
    }

    camera scene-camera {
      at 0 frame header,poll,idle-check,advance,drain zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal poll duration 300
      at 800 reveal idle-check duration 300
      at 1200 reveal advance duration 300
      at 1600 reveal drain duration 200
      at 1900 reveal loop-note duration 250
    }

    narrate "The sim pump polls the workload future. When idle, it advances virtual time to the next clock or engine event and repeats until completion."
    reading-order header,poll,idle-check,advance,drain,loop-note
    fallback "Pump: poll-idle-advance loop until workload Ready or deadlocked."
  }

  scene "Ordering rule" as ordering-rule {
    summary "Earliest event selection; clock wins ties for deterministic batching."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Ordering: arrival-before-pass invariant"
      role "heading"
      description "Clock-wins-ties ensures deterministic batching backend-independent."
      fallback "Ordering: clock wins ties."
    }

    rect arrival-event {
      x 100
      y 260
      width 280
      height 180
      fill token(clock)
      label "Request arrival"
      role "group"
      description "Clock event: scheduled by request-rate workload. Time: t1."
      fallback "Arrival: clock event at time t."
    }

    rect engine-pass {
      x 500
      y 260
      width 280
      height 180
      fill token(engine)
      label "Engine pass"
      role "group"
      description "Source event: SteppableReplay produces output tokens. Time: t1 (same)."
      fallback "Pass: engine event at same time."
    }

    rect rule {
      x 900
      y 260
      width 280
      height 180
      fill token(dynosim)
      label "Clock wins"
      role "group"
      description "When timestamps tie, clock event fires before engine observes batch."
      fallback "Rule: clock event first."
    }

    rect invariant {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Invariant: arrival-before-pass. Accepting source steps that jump past parked clock events would make batching backend-dependent."
      role "note"
      description "Deterministic ordering preserved."
      fallback "Invariant: clock-wins-ties preserves arrival-before-pass."
    }

    camera scene-camera {
      at 0 frame header,arrival-event,engine-pass,rule zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal arrival-event duration 300
      at 800 reveal engine-pass duration 300
      at 1200 reveal rule duration 300
      at 1600 reveal invariant duration 250
    }

    narrate "When timestamps tie, the clock queue wins. That preserves arrival-before-pass ordering required for deterministic batching."
    reading-order header,arrival-event,engine-pass,rule,invariant
    fallback "Clock-wins-ties rule: preserves deterministic batching independent of backend."
  }

  scene "Step bounds" as step-bounds {
    summary "Engine steps respect virtual interval limits for monotonic time."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Step bounds: monotonic time with overshoot protection"
      role "heading"
      description "Each source.step(at_ns) returns SimStep with end_ns guards."
      fallback "Step bounds: monotonic time enforcement."
    }

    rect step-call {
      x 100
      y 260
      width 280
      height 180
      fill token(engine)
      label "source.step(at_ns)"
      role "group"
      description "Call engine to advance from current time. Engine responds with SimStep."
      fallback "Call: source.step."
    }

    rect simstep {
      x 500
      y 260
      width 280
      height 180
      fill token(transport)
      label "SimStep response"
      role "group"
      description "Contains end_ns, made_progress, optional terminal metadata for the pump."
      fallback "Response: SimStep with metadata."
    }

    rect validation {
      x 900
      y 260
      width 280
      height 180
      fill token(clock)
      label "Validation"
      role "group"
      description "Pump checks: no time regression, no overshoot past next clock timer."
      fallback "Checks: monotonic, no overshoot."
    }

    rect guards {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Guards: TimeRegression if end_ns < now. OvershotClockEvent if end_ns passes sooner clock timer. Stall detection after MAX_NO_PROGRESS_STEPS."
      role "note"
      description "Multiple safety checks ensure monotonic virtual time."
      fallback "Guards: regression, overshoot, and stall detection."
    }

    camera scene-camera {
      at 0 frame header,step-call,simstep,validation zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal step-call duration 300
      at 800 reveal simstep duration 300
      at 1200 reveal validation duration 300
      at 1600 reveal guards duration 250
    }

    narrate "Engine steps declare an end time. The pump rejects regressions and overshoots that would skip a parked clock event."
    reading-order header,step-call,simstep,validation,guards
    fallback "Step bounds: engine declares end_ns; pump validates monotonicity and no-overshoot."
  }

  scene "Submission" as submission {
    summary "DirectRequest and waiter mailboxes bridge workload to engine."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Submission: DirectRequest and mailbox completion"
      role "heading"
      description "Turns become DirectRequest values; completion signals flow through mailboxes."
      fallback "Submission: DirectRequest and mailboxes."
    }

    rect workload {
      x 100
      y 260
      width 280
      height 180
      fill token(dynosim)
      label "Workload"
      role "group"
      description "Dispatches turn to DynosimSink. No HTTP encoding."
      fallback "Workload: dispatches turn."
    }

    rect directreq {
      x 500
      y 260
      width 280
      height 180
      fill token(transport)
      label "DirectRequest"
      role "group"
      description "Request descriptor with prompt, decode budget, routing hints."
      fallback "DirectRequest: turn descriptor."
    }

    rect engine-proc {
      x 900
      y 260
      width 280
      height 180
      fill token(engine)
      label "SteppableReplay"
      role "group"
      description "Engine processes DirectRequest and emits token/usage/terminal events."
      fallback "Engine: processes request."
    }

    rect mailbox {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Waiter mailboxes bridge async engine state to LocalSet-friendly sinks. No HTTP encoding on the path."
      role "note"
      description "In-process messaging for engine completion signals."
      fallback "Mailboxes: async bridge, no HTTP."
    }

    camera scene-camera {
      at 0 frame header,workload,directreq,engine-proc zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal workload duration 300
      at 800 reveal directreq duration 300
      at 1200 reveal engine-proc duration 300
      at 1600 reveal mailbox duration 250
    }

    narrate "Turns become DirectRequest values submitted to the replay engine. Waiter mailboxes bridge completion back into the sink without HTTP."
    reading-order header,workload,directreq,engine-proc,mailbox
    fallback "Submission: turn → DirectRequest → engine; completion via mailboxes."
  }

  scene "Token path" as token-path {
    summary "Engine events become RequestObserver callbacks."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Token path: engine events → observer callbacks"
      role "heading"
      description "SteppableReplay events translate into RequestObserver vocabulary."
      fallback "Token path: events become callbacks."
    }

    rect token-event {
      x 100
      y 260
      width 280
      height 180
      fill token(event)
      label "Token event"
      role "group"
      description "Engine emits token. First token sets TTFT."
      fallback "Token event: sets TTFT."
    }

    rect usage-event {
      x 500
      y 260
      width 280
      height 180
      fill token(observer)
      label "Usage event"
      role "group"
      description "Engine emits usage fields. Absent when omitted by engine."
      fallback "Usage event: optional fields."
    }

    rect terminal-event {
      x 900
      y 260
      width 280
      height 180
      fill token(transport)
      label "Terminal event"
      role "group"
      description "Engine signals completion. Closes sink lifecycle."
      fallback "Terminal: closes lifecycle."
    }

    rect contract {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Contract: TTFT is first token observation. Usage fields stay absent when engine omits them. Terminal coalescing policy matches HTTP reduction."
      role "note"
      description "Observer seam is transport-neutral."
      fallback "Contract: observer vocabulary matches HTTP reduction."
    }

    camera scene-camera {
      at 0 frame header,token-event,usage-event,terminal-event zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal token-event duration 300
      at 800 reveal usage-event duration 300
      at 1200 reveal terminal-event duration 300
      at 1600 reveal contract duration 250
    }

    narrate "Replay engine events translate into RequestObserver callbacks: tokens, usage, and terminal status match the HTTP reduction path."
    reading-order header,token-event,usage-event,terminal-event,contract
    fallback "Observer seam: engine events map to TTFT, usage, and terminal callbacks."
  }

  scene "Metrics" as metrics {
    summary "TTFT, ITL batches, usage, and terminal merge like online runs."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Metrics: observer events → measurement records"
      role "heading"
      description "NativeMetricsObserver accumulates per-record timing from events."
      fallback "Metrics: events to records."
    }

    rect ttft {
      x 100
      y 260
      width 260
      height 180
      fill token(clock)
      label "TTFT"
      role "group"
      description "Time to first token from first token observation."
      fallback "TTFT: first token timing."
    }

    rect itl {
      x 450
      y 260
      width 260
      height 180
      fill token(event)
      label "ITL batches"
      role "group"
      description "Inter-token spacing from subsequent observations. Excludes terminal."
      fallback "ITL: inter-token spacing."
    }

    rect usage {
      x 800
      y 260
      width 260
      height 180
      fill token(observer)
      label "Usage"
      role "group"
      description "Mirrors endpoint usage_* when present."
      fallback "Usage: token counts."
    }

    rect mode {
      x 1150
      y 260
      width 120
      height 180
      fill token(transport)
      label "Mode"
      role "group"
      description "Exact or sketch."
      fallback "Mode: exact/sketch."
    }

    rect note {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Sketch mode merges digests; exact mode retains records. Phase windows and steady-state derive from same curves as HTTP."
      role "note"
      description "Metrics accumulation follows online semantics."
      fallback "Metrics: same plane as online; source is replay."
    }

    camera scene-camera {
      at 0 frame header,ttft,itl,usage,mode zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal ttft duration 300
      at 800 reveal itl duration 300
      at 1200 reveal usage duration 300
      at 1600 reveal mode duration 200
      at 1900 reveal note duration 250
    }

    narrate "Metrics accumulate from observer events: time to first token, inter-token spacing, usage fields, and terminal status merge like online runs."
    reading-order header,ttft,itl,usage,mode,note
    fallback "Metrics: TTFT, ITL, usage, terminal; same plane as HTTP."
  }

  scene "Delivery modes" as delivery-modes {
    summary "Incremental tokens vs terminal coalescing."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Delivery: incremental vs coalesced"
      role "heading"
      description "Streaming configuration selects token delivery policy."
      fallback "Delivery: incremental or coalesced."
    }

    rect incremental {
      x 100
      y 260
      width 380
      height 200
      fill token(transport)
      label "Incremental"
      role "group"
      description "Each engine token → observer token event. Per-token streaming observations."
      fallback "Incremental: per-token events."
    }

    rect coalesced {
      x 600
      y 260
      width 380
      height 200
      fill token(event)
      label "Terminal coalescing"
      role "group"
      description "Sink batches tokens until terminal. Single emission at end."
      fallback "Coalesced: terminal batch."
    }

    rect policy {
      x 100
      y 520
      width 880
      height 120
      fill token(surface)
      label "Policy is endpoint/streaming config, not dynosim-specific. Dynosim honors the same flags as HTTP streaming paths."
      role "note"
      description "Delivery shape follows config, not transport family."
      fallback "Policy: config-driven, transport-neutral."
    }

    camera scene-camera {
      at 0 frame header,incremental,coalesced zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal incremental duration 300
      at 800 reveal coalesced duration 300
      at 1600 reveal policy duration 250
    }

    narrate "Streaming policy controls incremental token events versus terminal coalescing. Dynosim honors the same flags as HTTP streaming paths."
    reading-order header,incremental,coalesced,policy
    fallback "Delivery: incremental or coalesced per config."
  }

  scene "Completion" as completion {
    summary "Drain, stall, and deadlock detection."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Completion: drain, stall, and deadlock"
      role "heading"
      description "Terminal conditions and error handling."
      fallback "Completion: terminal states."
    }

    rect ready {
      x 100
      y 260
      width 280
      height 180
      fill token(dynosim)
      label "Workload Ready"
      role "group"
      description "Pump drains remaining source events then exits."
      fallback "Ready: drain and exit."
    }

    rect stall {
      x 500
      y 260
      width 280
      height 180
      fill token(event)
      label "Stall"
      role "group"
      description "Repeated no-progress steps. Guard prevents infinite idle loops."
      fallback "Stall: no progress."
    }

    rect deadlock {
      x 900
      y 260
      width 280
      height 180
      fill token(clock)
      label "Deadlock"
      role "group"
      description "Neither queue has future event; workload still pending."
      fallback "Deadlock: stuck."
    }

    rect outcomes {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "RunOutcome: carries deadlocked flag when virtual time cannot advance. Clean termination with explicit stall signals."
      role "note"
      description "Safety: detect stalls and deadlocks."
      fallback "Outcomes: Ready, Stalled, or Deadlocked."
    }

    camera scene-camera {
      at 0 frame header,ready,stall,deadlock zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal ready duration 300
      at 800 reveal stall duration 300
      at 1200 reveal deadlock duration 300
      at 1600 reveal outcomes duration 250
    }

    narrate "On completion the pump drains remaining engine events. Stall and deadlock detection prevent infinite idle loops when no progress is possible."
    reading-order header,ready,stall,deadlock,outcomes
    fallback "Completion: drain on Ready; detect Stall and Deadlock."
  }

  scene "Recap" as recap {
    summary "Offline vs online parity and artifacts."

    rect header {
      x 80
      y 100
      width 1200
      height 100
      fill token(surface-strong)
      label "Recap: dynosim modes and artifact parity"
      role "heading"
      description "Both modes write same reports through same Coordinator path."
      fallback "Recap: offline vs online."
    }

    rect offline-box {
      x 100
      y 260
      width 280
      height 180
      fill token(clock)
      label "Offline"
      role "group"
      description "SimClock + drive_sim_with_source. Deterministic sweeps and co-simulation."
      fallback "Offline: SimClock."
    }

    rect online-box {
      x 500
      y 260
      width 280
      height 180
      fill token(event)
      label "Online"
      role "group"
      description "RealClock + drive_real_with_source. Wall-clock fidelity."
      fallback "Online: RealClock."
    }

    rect artifacts {
      x 900
      y 260
      width 280
      height 180
      fill token(transport)
      label "Artifacts"
      role "group"
      description "native-v2.json through Coordinator. Exporters and cellular orthogonal."
      fallback "Artifacts: shared path."
    }

    rect summary {
      x 100
      y 520
      width 1080
      height 120
      fill token(surface)
      label "Pick the clock; keep the rest of AIPerf unchanged. Same native-v2.json report. Exporters and cellular modes are orthogonal to dynosim choice."
      role "note"
      description "Clock selection is the only axis; everything else shared."
      fallback "Summary: clock choice; everything else unchanged."
    }

    camera scene-camera {
      at 0 frame header,offline-box,online-box,artifacts zoom 1.0
    }

    timeline show {
      at 0 reveal header duration 300
      at 400 reveal offline-box duration 300
      at 800 reveal online-box duration 300
      at 1200 reveal artifacts duration 300
      at 1600 reveal summary duration 250
    }

    narrate "Offline dynosim gives deterministic virtual time. Online dynosim keeps wall clocks. Both produce the same native report and configured artifacts through the coordinator."
    reading-order header,offline-box,online-box,artifacts,summary
    fallback "Recap: offline (SimClock) or online (RealClock); same artifacts and coordinator path."
  }
}
