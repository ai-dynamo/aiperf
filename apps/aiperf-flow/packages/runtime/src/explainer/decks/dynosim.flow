//! Dynosim Explainer Deck
//! Discrete-event co-simulation: SimClock, SteppableReplay, EngineHost, and the offline/online split.

flow "Dynosim: Discrete-event simulation for AIPerf" as dynosim-explainer {
  language 1

  explainer "dynosim" {
  route: "/explainers/dynosim"
  topic: "simulation"
  eyebrowLabel: "Discrete-Event Simulation"
  startGateTitle: "Ready to learn Dynosim?"

  slide "Why Dynosim" {
    eyebrow: "Dynosim"
    title: "Why Dynosim"
    lede: "Co-simulation without a live inference server. Dynosim runs AIPerf's full workload loop against Dynamo's passive mock engine in-process."
    narration: "Dynosim lets AIPerf benchmark without a live inference server. The workload loop and observers stay native; Dynamo's passive engine supplies timing and token events in-process."
    points: []
    caption: ""
    render: @scene {
    "roots": [
        {
            "capability": "core.rect",
            "layout": {
                "x": 80,
                "y": 100,
                "width": 1200,
                "height": 120
            },
            "style": {
                "fill": "#1d3557",
