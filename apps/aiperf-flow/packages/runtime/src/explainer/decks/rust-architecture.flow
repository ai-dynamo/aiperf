                }
              ]
            },
            {
              id: "delegated-box"
              capability: "core.rect"
              layout: { x: 230, y: 60, width: 160, height: 180 }
              style: { fill: @theme.accent.secondary, stroke: @theme.ink.secondary, strokeWidth: 2 }
              children: [
                {
                  id: "delegated-title"
                  capability: "core.text"
                  text: "Delegated (Python)"
                  layout: { x: 240, y: 70, width: 140, height: 20 }
                  style: { fontSize: 12, fontWeight: "bold", fill: @theme.ink.primary }
