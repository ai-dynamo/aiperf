explainer "Rust Architecture" {
  id: "rust-architecture"
  route: "/explainers/rust-architecture"
  topic: "architecture"

  hub: {
    title: "Rust Architecture"
    highlight: "Explore AIPerf's native execution engine and composition model"
    description: "Deep dive into the Rust workspace, module organization, execution model, and scaling patterns that power AIPerf benchmarks."
  }

  eyebrowLabel: "Architecture"
  startGateTitle: "Ready to explore AIPerf's Rust architecture?"

  slide "Product shell" {
    eyebrow: "Product shell"
    title: "One binary is both CLI and engine"
    lede: "AIPerf ships as a single native `aiperf` executable from crate `aiperf-cli`. There is no separate runner process—the same binary parses public commands and re-executes itself for benchmark runs."

    narration: "AIPerf ships as one native aiperf binary. That same executable is both the public command line and the hidden execution engine."

    term: {
      word: "aiperf-cli"
      meaning: "The product entry crate: public commands, Config v2 loading, and self-spawned execution over stdio."
    }

    points: [
      "`rust/cli` builds the `aiperf` binary.",
      "Global allocator is mimalloc on the hot path.",
      "Internal modes are intercepted before normal CLI parsing."
    ]

    caption: "One executable, two hats: operator CLI and execution child."

    render: @scene {
      roots: [
        {
          id: "product-shell-box"
          capability: "core.rect"
          layout: { x: 50, y: 50, width: 400, height: 200 }
          style: { fill: @theme.surface.primary, stroke: @theme.ink.secondary, strokeWidth: 2 }
          children: [
            {
              id: "binary-label"
              capability: "core.text"
              text: "aiperf binary"
              layout: { x: 60, y: 60, width: 380, height: 40 }
              style: { fontSize: 20, fontWeight: "bold", fill: @theme.ink.primary }
            },
            {
              id: "cli-box"
              capability: "core.rect"
              layout: { x: 60, y: 110, width: 160, height: 60 }
              style: { fill: @theme.accent.primary, stroke: @theme.ink.secondary, strokeWidth: 1 }
              children: [
                {
                  id: "cli-text"
                  capability: "core.text"
                  text: "CLI Shell"
                  layout: { x: 70, y: 125, width: 140, height: 30 }
                  style: { fontSize: 14, fill: @theme.ink.primary }
                }
              ]
            },
            {
              id: "engine-box"
              capability: "core.rect"
              layout: { x: 230, y: 110, width: 160, height: 60 }
              style: { fill: @theme.accent.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
              children: [
                {
                  id: "engine-text"
                  capability: "core.text"
                  text: "Execution Engine"
                  layout: { x: 240, y: 125, width: 140, height: 30 }
                  style: { fontSize: 14, fill: @theme.ink.primary }
                }
              ]
            }
          ]
        }
      ]
    }
  }

  slide "Workspace map" {
    eyebrow: "Workspace map"
    title: "Six crates, one dependency direction"
    lede: "The Rust workspace is intentionally small. Capability flows cli → runtime → loadgen-core. Mock server and e2e are separate targets; pyext is packaging-only."

    narration: "The Rust workspace stays small. Capability flows from aiperf-cli into aiperf-runtime and then into loadgen-core."

    term: {
      word: "loadgen-core"
      meaning: "Transport-neutral observer and sink vocabulary with no HTTP, gRPC, or engine dependencies."
    }

    points: [
      "Members: loadgen-core, runtime, cli, mock-server, e2e, pyext.",
      "aiperf-cli depends on aiperf-runtime with the engine feature.",
      "aiperf-mock-server is a standalone benchmark target."
    ]

    caption: "cli → runtime → loadgen-core"

    render: @scene {
      roots: [
        {
          id: "workspace-diagram"
          capability: "core.rect"
          layout: { x: 50, y: 50, width: 400, height: 250 }
          style: { fill: @theme.surface.primary }
          children: [
            {
              id: "loadgen-core-box"
              capability: "core.rect"
              layout: { x: 60, y: 190, width: 140, height: 50 }
              style: { fill: @theme.accent.tertiary, stroke: @theme.ink.secondary, strokeWidth: 2 }
              children: [
                {
                  id: "loadgen-text"
                  capability: "core.text"
                  text: "loadgen-core"
                  layout: { x: 70, y: 205, width: 120, height: 20 }
                  style: { fontSize: 12, fill: @theme.ink.primary }
                }
              ]
            },
            {
              id: "runtime-box"
              capability: "core.rect"
              layout: { x: 210, y: 130, width: 140, height: 50 }
              style: { fill: @theme.accent.secondary, stroke: @theme.ink.secondary, strokeWidth: 2 }
              children: [
                {
                  id: "runtime-text"
                  capability: "core.text"
                  text: "aiperf-runtime"
                  layout: { x: 220, y: 145, width: 120, height: 20 }
                  style: { fontSize: 12, fill: @theme.ink.primary }
                }
              ]
            },
            {
              id: "cli-box-wm"
              capability: "core.rect"
              layout: { x: 360, y: 70, width: 140, height: 50 }
              style: { fill: @theme.accent.primary, stroke: @theme.ink.secondary, strokeWidth: 2 }
              children: [
                {
                  id: "cli-text-wm"
                  capability: "core.text"
                  text: "aiperf-cli"
                  layout: { x: 370, y: 85, width: 120, height: 20 }
                  style: { fontSize: 12, fill: @theme.ink.primary }
                }
              ]
            },
            {
              id: "arrow1"
              capability: "core.line"
              from: { x: 280, y: 165 }
              to: { x: 350, y: 95 }
              style: { stroke: @theme.ink.secondary, strokeWidth: 2 }
            },
            {
              id: "arrow2"
              capability: "core.line"
              from: { x: 210, y: 160 }
              to: { x: 140, y: 195 }
              style: { stroke: @theme.ink.secondary, strokeWidth: 2 }
            }
          ]
        }
      ]
    }
  }

  slide "Startup order" {
    eyebrow: "Startup order"
    title: "Intercept internal modes, then dispatch"
    lede: "Every process starts the same way: initialize logging, check for hidden execution flags like `--execute`, `--cell`, or `--aggregator`, and only then route public subcommands."

    narration: "Startup always checks hidden execution modes first. Only after that does the process route public subcommands."

    term: {
      word: "execute_mode"
      meaning: "Hidden argv surface that runs protocol-v2 children before clap ever sees a public command."
    }

    points: [
      "`main.rs` calls `execute_mode::is_execution_mode`.",
      "Internal handlers never return to public dispatch.",
      "Everything else goes through `dispatch::run`."
    ]

    caption: "Hidden modes short-circuit; public commands fall through."

    render: @scene {
      roots: [
        {
          id: "startup-timeline"
          capability: "core.rect"
          layout: { x: 50, y: 50, width: 400, height: 250 }
          style: { fill: @theme.surface.primary }
          children: [
            {
              id: "init-box"
              capability: "core.rect"
              layout: { x: 60, y: 60, width: 380, height: 40 }
              style: { fill: @theme.accent.primary, stroke: @theme.ink.secondary, strokeWidth: 1 }
              children: [
                {
                  id: "init-text"
                  capability: "core.text"
                  text: "1. Initialize logging"
                  layout: { x: 70, y: 70, width: 360, height: 20 }
                  style: { fontSize: 12, fill: @theme.ink.primary }
                }
              ]
            },
            {
              id: "check-box"
              capability: "core.rect"
              layout: { x: 60, y: 110, width: 380, height: 40 }
              style: { fill: @theme.accent.secondary, stroke: @theme.ink.secondary, strokeWidth: 1 }
              children: [
                {
                  id: "check-text"
                  capability: "core.text"
                  text: "2. Check hidden modes (--execute, --cell, --aggregator)"
                  layout: { x: 70, y: 120, width: 360, height: 20 }
                  style: { fontSize: 12, fill: @theme.ink.primary }
                }
              ]
            },
            {
              id: "dispatch-box"
              capability: "core.rect"
              layout: { x: 60, y: 160, width: 380, height: 40 }
              style: { fill: @theme.accent.tertiary, stroke: @theme.ink.secondary, strokeWidth: 1 }
              children: [
                {
                  id: "dispatch-text"
                  capability: "core.text"
                  text: "3. Dispatch public commands"
                  layout: { x: 70, y: 170, width: 360, height: 20 }
                  style: { fontSize: 12, fill: @theme.ink.primary }
                }
              ]
            }
          ]
        }
      ]
    }
  }

  slide "Command surface" {
    eyebrow: "Command surface"
    title: "Native benchmark commands stay in Rust"
    lede: "`profile`, `config`, cellular roles, `slurm run`, and several utility commands are native. Most operational tooling still delegates to the Python package unless built with pyo3-embed."

    narration: "Core benchmark commands stay native in Rust. Most operational tooling still delegates to Python unless the build embeds it."

    term: {
      word: "delegate"
      meaning: "Lean builds shell out to `python -m aiperf`; pyo3-embed runs the same entrypoint in-process."
    }

    points: [
      "`dispatch.rs` matches the first argv token.",
      "Unknown commands delegate to Python.",
      "Feature gates select gRPC, cellular, dynosim, parquet, and embed modes."
    ]

    caption: "Benchmark hot path native; extended surface delegated."

    render: @scene {
      roots: [
        {
          id: "command-surface"
          capability: "core.rect"
          layout: { x: 50, y: 50, width: 400, height: 250 }
          style: { fill: @theme.surface.primary }
          children: [
