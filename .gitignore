.vscode
*.jsonl
# Bundled template data (sample mooncake-trace files) is intentionally tracked.
!src/aiperf/config/templates/data/*.jsonl
!tests/fixtures/**/*.jsonl
# Golden-parity trace inputs. Their goldens are tracked, so the inputs must be too
# or the parity tests cannot run from a clean clone.
!tools/parity/**/*.jsonl
# The speed-bench fixture run dirs live under an `artifacts/` path, which the
# blanket `artifacts/` rule above would otherwise swallow.
!tools/parity/speed_bench/artifacts/
!tools/parity/speed_bench/artifacts/**
!tests/unit/plot/fixtures/**/*.jsonl
coverage.xml
*.egg-info/
coverage.json
.cache/

# Generated plugin stubs (not committed, regenerate with: make generate-plugin-enums)
src/aiperf/plugin/enums.pyi

# Generated at wheel-build time by the nightly CI pipeline; never committed.
src/aiperf/_build_info.py

# Agent Skills (open standard, agentskills.io)
.agents/*
!.agents/skills/

# Skills installed into the shared skills dir by an external installer rather than
# authored here. They are not this project's skills and their contents are managed
# elsewhere, so they stay untracked while `.agents/skills/` itself remains checked in.
.agents/skills/.rix-skills-version
.agents/skills/docx/
.agents/skills/pdf/
.agents/skills/pdf-reading/
.agents/skills/pptx/
.agents/skills/xlsx/

# Claude Code - ignore user settings, keep agents and the skills symlink
.claude/*
!.claude/agents/
!.claude/skills

# Codex - ignore user settings
.codex/*

# Cursor - ignore user settings
.cursor/*
!.cursor/rules/
.worktrees/

# Chaos/adversarial test run artifacts
tests/scripts/.chaos_runs/

# Rust build artifacts
target/

# Canonical recorded-agent corpus is supplied separately; only its manifest and
# digest index are committed under this fixture root.
rust/runtime/tests/fixtures/recorded_agent_replay/recordings/

# Node.js dependencies
node_modules/

.venv*/

# cargo build output for ad-hoc deploy targets
.deploy-target*/

dynamo-aiperf-native

# superpowers plans/specs scratch (kept locally, not tracked)
docs/superpowers/
plans/
.superpowers

# Generated contest adjudication ledgers, rewritten in place while a contest
# runs. The spec they adjudicate is the tracked artifact, not these.
docs/specs/*.contest.md

**/.vite/
