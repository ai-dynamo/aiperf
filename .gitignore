*.pyc
# personal ops runbooks belong in ~/.claude/workflows/, not the repo
.workflows/
.coverage
__pycache__/
.venv/
htmlcov/
.pytest_cache/
.ruff_cache/
.pre-commit-cache/
.mypy_cache/
.hypothesis/
.kiro/
.env
.env.*
*.log
artifacts/
test-results/
dist/
.DS_Store
uv.lock
