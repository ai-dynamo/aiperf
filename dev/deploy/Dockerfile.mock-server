# AIPerf Mock Server image for testing in Kubernetes
FROM python:3.13-slim-bookworm

# Install build dependencies for numpy and other packages
# Ensure non-interactive apt so dpkg conffile prompts don't block kaniko builds.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    -o Dpkg::Options::="--force-confdef" \
    -o Dpkg::Options::="--force-confold" \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:0.6 /uv /uvx /bin/

WORKDIR /app

# Create virtual environment explicitly (ensures console scripts exist in /app/.venv/bin)
RUN uv venv /app/.venv --python 3.13 --clear

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Layer 1: Install dependencies only (cached unless pyproject.toml / uv.lock change)
COPY pyproject.toml uv.lock ./
RUN uv sync --active --no-dev --no-install-project --frozen

# Layer 2: Copy mock server source (changes less frequently than aiperf src)
COPY tests/aiperf_mock_server/ ./aiperf_mock_server/

# Layer 3: Copy aiperf source and install (changes most frequently)
COPY README.md LICENSE ./
COPY src/ ./src/
RUN uv sync --active --no-dev --frozen \
    && uv pip install -e ./aiperf_mock_server \
    && uv pip install "uvicorn[standard]>=0.24.0"

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Expose default port
EXPOSE 8000

# Run mock server - bind to 0.0.0.0 for Kubernetes
ENTRYPOINT ["python", "-m", "aiperf_mock_server"]
CMD ["--host", "0.0.0.0", "--fast", "--no-tokenizer"]
