{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiperf.nvidia.com/contracts/native-k8s/v1/controller-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "runId", "namespace", "jobId", "imageDigest", "imageReference", "cells", "artifactRoot", "configRef", "controllerAddress", "roles", "cellBootstraps"],
  "properties": {
    "contractVersion": { "const": "native-k8s/v1" },
    "runId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "namespace": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "jobId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "imageReference": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+@sha256:[0-9a-f]{64}$" },
    "cells": { "type": "integer", "minimum": 1 },
    "artifactRoot": { "type": "string", "maxLength": 1024, "pattern": "^/results(?:/[A-Za-z0-9_-][A-Za-z0-9._-]{0,62})*$" },
    "configRef": { "$ref": "#/$defs/reference" },
    "controllerAddress": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/role" },
      "allOf": [
        { "contains": { "properties": { "name": { "const": "controller" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "cell" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "results-sidecar" } }, "required": ["name"] } }
      ]
    },
    "cellBootstraps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cellBootstrap" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "role", "mountPath", "sha256"],
      "properties": {
        "secretName": { "type": "string", "minLength": 1 },
        "role": { "enum": ["controller", "cell", "results-sidecar"] },
        "mountPath": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cellBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellId", "secretName", "mountPath", "sha256"],
      "properties": {
        "cellId": { "type": "integer", "minimum": 0 },
        "secretName": { "type": "string", "minLength": 1 },
        "role": { "const": "cell" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "argv", "environment"],
      "properties": {
        "name": { "enum": ["controller", "cell", "results-sidecar"] },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "argv": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "bootstrap": { "$ref": "#/$defs/bootstrap" }
      },
      "allOf": [
        { "if": { "properties": { "name": { "const": "controller" } } }, "then": { "required": ["bootstrap"], "properties": { "bootstrap": { "properties": { "role": { "const": "controller" } } } } } },
        { "if": { "properties": { "name": { "const": "cell" } } }, "then": { "not": { "required": ["bootstrap"] } } },
        { "if": { "properties": { "name": { "const": "results-sidecar" } } }, "then": { "required": ["bootstrap"], "properties": { "bootstrap": { "properties": { "role": { "const": "results-sidecar" } } } } } }
      ]
    }
  }
}
