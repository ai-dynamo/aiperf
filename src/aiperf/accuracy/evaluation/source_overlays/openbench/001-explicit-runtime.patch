new file mode 100644
index 0000000..73af93c
--- /dev/null
+++ b/runtime/inspect_session.py
@@ -0,0 +1,23 @@
+"""Fail-closed public Inspect entry point for one explicit OpenBench task."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from inspect_ai import eval_async
+from inspect_ai.extensions import entry_point_loading
+
+
+async def eval_async_hosted(**kwargs: Any) -> Any:
+    """Run ``inspect_ai.eval_async`` with installed entry points denied.
+
+    Callers must pass an explicitly constructed ``Task`` and ``Model``. The
+    wrapper intentionally exposes no task-name registry, CLI display, recorder
+    mutation, provider URL, or installed-plugin fallback.
+    """
+    if "tasks" not in kwargs or isinstance(kwargs["tasks"], str):
+        raise TypeError("hosted OpenBench requires an explicit Inspect Task")
+    if "model" not in kwargs or isinstance(kwargs["model"], str):
+        raise TypeError("hosted OpenBench requires an explicit Inspect Model")
+    with entry_point_loading("deny"):
+        return await eval_async(**kwargs)
