+"""Public Inspect ``ModelAPI`` adapter for an inherited evaluation host."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from inspect_ai.model import ModelAPI, ModelCall, ModelCallContext, ModelOutput, modelapi
+
+from openbench.runtime.host import EvaluationHost, ModelEffect
+
+
+@modelapi(name="aiperf-pipe")
+class AiperfPipeModelAPI(ModelAPI):
+    """Model API with no URL, credential, client, retry, batch, or cache."""
+
+    def __init__(
+        self,
+        *,
+        host: EvaluationHost,
+        service_id: str = "candidate",
+        purpose: str = "primary",
+    ) -> None:
+        if not service_id or not purpose:
+            raise ValueError("logical service and purpose cannot be empty")
+        super().__init__(
+            model_name=f"aiperf/{service_id}",
+            base_url=None,
+            api_key=None,
+            api_key_vars=[],
+        )
+        self._host = host
+        self._service_id = service_id
+        self._purpose = purpose
+
+    async def generate(
+        self,
+        input: list[Any],
+        tools: list[Any],
+        tool_choice: Any,
+        config: Any,
+    ) -> tuple[ModelOutput, ModelCall]:
+        identity = ModelCallContext.current().claim_call()
+        payload = {
+            "messages": [_dump(item) for item in input],
+            "tools": [_dump(item) for item in tools],
+            "tool_choice": _dump(tool_choice),
+            "config": _dump(config),
+        }
+        raw = await self._host.model_generate(
+            ModelEffect(
+                task_name=identity.task_name,
+                task_id=identity.task_id,
+                run_id=identity.run_id,
+                sample_id=identity.sample_id,
+                epoch=identity.epoch,
+                semantic_attempt=identity.semantic_attempt,
+                call_ordinal=identity.call_ordinal,
+                service_id=self._service_id,
+                purpose=self._purpose,
+                payload=payload,
+            )
+        )
+        output = ModelOutput.model_validate(raw)
+        return output, ModelCall(request=payload, response=_dump(output))
+
+    def should_retry(self, ex: Exception) -> bool:
+        del ex
+        return False
+
+    def allows_cache(self) -> bool:
+        return False
+
+
+def _dump(value: Any) -> Any:
+    if value is None:
+        return None
+    dump = getattr(value, "model_dump", None)
+    if callable(dump):
+        return dump(mode="json", exclude_none=True)
+    if isinstance(value, str | int | float | bool | list | dict):
+        return value
+    raise TypeError(f"unsupported Inspect value {type(value).__name__}")
