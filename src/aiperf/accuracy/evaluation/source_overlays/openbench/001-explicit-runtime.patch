@@ -0,0 +1,132 @@
+"""Declared nondeterministic normalization for restricted Inspect logs."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def _dump(value: Any) -> Any:
+    if value is None or isinstance(value, str | int | float | bool):
+        return value
+    if isinstance(value, dict):
+        return {key: _dump(child) for key, child in value.items()}
+    if isinstance(value, list | tuple):
+        return [_dump(child) for child in value]
+    dump = getattr(value, "model_dump", None)
+    if callable(dump):
+        return _dump(dump(mode="json", exclude_none=True))
+    return value
+
+
+def _error(value: Any) -> Any:
+    if value is None:
+        return None
+    raw = _dump(value)
+    if not isinstance(raw, dict):
+        return raw
+    return {key: raw[key] for key in ("message", "type") if key in raw}
+
+
+def _messages(value: Any) -> list[Any]:
+    """Remove only Inspect-generated top-level message UUIDs."""
+    raw = _dump(value)
+    if not isinstance(raw, list):
+        return raw
+    return [
+        {key: child for key, child in item.items() if key != "id"}
+        if isinstance(item, dict)
+        else item
+        for item in raw
+    ]
+
+
+def _model_output(value: Any) -> Any:
+    """Remove output timing and generated message UUIDs, preserving semantics."""
+    raw = _dump(value)
+    if not isinstance(raw, dict):
+        return raw
+    result = {key: child for key, child in raw.items() if key != "time"}
+    choices = result.get("choices")
+    if isinstance(choices, list):
+        result["choices"] = []
+        for choice in choices:
+            if not isinstance(choice, dict):
+                result["choices"].append(choice)
+                continue
+            normalized = dict(choice)
+            message = normalized.get("message")
+            if isinstance(message, dict):
+                normalized["message"] = {
+                    key: child for key, child in message.items() if key != "id"
+                }
+            result["choices"].append(normalized)
+    return result
+
+
+def normalize_eval_log(log: Any) -> dict[str, Any]:
+    """Return the complete semantic result after named normalization.
+
+    Wall-clock timestamps, durations, UUIDs, filesystem locations, event
+    timing, and tracebacks are deliberately excluded. Inputs, targets,
+    messages, typed score trees, epoch reductions, named metrics, errors, and
+    model outputs remain restricted and participate in parity digests.
+    """
+    results = None
+    if log.results is not None:
+        scores = sorted(
+            (_dump(score) for score in log.results.scores),
+            key=lambda item: (
+                str(item.get("scorer", "")),
+                str(item.get("reducer", "")),
+                str(item.get("name", "")),
+            ),
+        )
+        results = {
+            "total_samples": log.results.total_samples,
+            "completed_samples": log.results.completed_samples,
+            "scores": scores,
+            "metadata": _dump(log.results.metadata),
+        }
+    samples = []
+    for sample in log.samples or []:
+        samples.append(
+            {
+                "id": sample.id,
+                "epoch": sample.epoch,
+                "input": _dump(sample.input),
+                "target": _dump(sample.target),
+                "choices": _dump(sample.choices),
+                "messages": _messages(sample.messages),
+                "output": _model_output(sample.output),
+                "scores": {
+                    key: _dump(value)
+                    for key, value in sorted((sample.scores or {}).items())
+                },
+                "metadata": _dump(sample.metadata),
+                "store": _dump(sample.store),
+                "error": _error(sample.error),
+                "error_retries": [_error(item) for item in sample.error_retries or []],
+                "limit": _dump(sample.limit),
+            }
+        )
+    samples.sort(key=lambda item: (item["epoch"], str(item["id"])))
+    reductions = sorted(
+        (_dump(item) for item in log.reductions or []),
+        key=lambda item: (str(item.get("scorer", "")), str(item.get("reducer", ""))),
+    )
+    return {
+        "normalization": "openbench-inspect-semantic-v1",
+        "version": log.version,
+        "status": log.status,
+        "eval": {
+            "task": log.eval.task,
+            "dataset": _dump(log.eval.dataset),
+            "model": log.eval.model,
+            "config": _dump(log.eval.config),
+        },
+        "plan": _dump(log.plan),
+        "results": results,
+        "error": _error(log.error),
+        "samples": samples,
+        "reductions": reductions,
+    }
