+"""Provider-neutral host contracts for the programmatic OpenBench runtime."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Protocol, runtime_checkable
+
+
+@dataclass(frozen=True)
+class ModelEffect:
+    """One correlated model effect emitted by an Inspect ``ModelAPI``."""
+
+    task_name: str
+    task_id: str
+    run_id: str
+    sample_id: str | int
+    epoch: int
+    semantic_attempt: int
+    call_ordinal: int
+    service_id: str
+    purpose: str
+    payload: dict[str, Any]
+
+
+@runtime_checkable
+class EvaluationHost(Protocol):
+    """Effect host implemented by standalone, recording, or pipe runtimes."""
+
+    async def model_generate(self, effect: ModelEffect) -> dict[str, Any]:
+        """Return a serialized public Inspect ``ModelOutput``."""
+        ...
+
+
+class RecordingEvaluationHost:
+    """Record exact operations/purposes while returning scripted outputs."""
+
+    def __init__(self, outputs: list[dict[str, Any]]) -> None:
+        self._outputs = list(outputs)
+        self.effects: list[ModelEffect] = []
+
+    async def model_generate(self, effect: ModelEffect) -> dict[str, Any]:
+        self.effects.append(effect)
+        if not self._outputs:
+            raise RuntimeError("recording host has no scripted model result")
+        return self._outputs.pop(0)
