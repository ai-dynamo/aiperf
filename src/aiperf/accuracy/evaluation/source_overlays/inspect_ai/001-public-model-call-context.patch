@@ -0,0 +1,137 @@
+"""Public task-local identity for model calls made while evaluating a sample."""
+
+from __future__ import annotations
+
+from contextvars import ContextVar, Token
+from dataclasses import dataclass
+from types import TracebackType
+from typing import Self
+
+
+@dataclass(frozen=True)
+class ModelCallIdentity:
+    """Immutable identity assigned to one model call."""
+
+    task_name: str
+    task_id: str
+    run_id: str
+    sample_id: str | int
+    epoch: int
+    semantic_attempt: int
+    call_ordinal: int
+
+
+class ModelCallContext:
+    """Read-only sample identity and monotonic call allocator.
+
+    Inspect activates one context around all solver and scorer work for a
+    sample attempt. Custom ``ModelAPI`` implementations can use ``current``
+    and ``claim_call`` without importing private task state. A claimed context
+    cannot be reused after its sample scope exits.
+    """
+
+    _CURRENT: ContextVar[ModelCallContext | None] = ContextVar(
+        "inspect_model_call_context", default=None
+    )
+
+    def __init__(
+        self,
+        *,
+        task_name: str,
+        task_id: str,
+        run_id: str,
+        sample_id: str | int,
+        epoch: int,
+        semantic_attempt: int,
+    ) -> None:
+        if not task_name or not task_id or not run_id:
+            raise ValueError("model-call context task/run identity cannot be empty")
+        if isinstance(epoch, bool) or epoch < 1:
+            raise ValueError("model-call context epoch must be positive")
+        if isinstance(semantic_attempt, bool) or semantic_attempt < 0:
+            raise ValueError("model-call context semantic attempt cannot be negative")
+        self._task_name = task_name
+        self._task_id = task_id
+        self._run_id = run_id
+        self._sample_id = sample_id
+        self._epoch = epoch
+        self._semantic_attempt = semantic_attempt
+        self._next_ordinal = 0
+        self._active = False
+        self._token: Token[ModelCallContext | None] | None = None
+
+    @classmethod
+    def activate(
+        cls,
+        *,
+        task_name: str,
+        task_id: str,
+        run_id: str,
+        sample_id: str | int,
+        epoch: int,
+        semantic_attempt: int,
+    ) -> ModelCallContext:
+        """Create a single-use sync/async context manager for one attempt."""
+        return cls(
+            task_name=task_name,
+            task_id=task_id,
+            run_id=run_id,
+            sample_id=sample_id,
+            epoch=epoch,
+            semantic_attempt=semantic_attempt,
+        )
+
+    @classmethod
+    def current(cls) -> ModelCallContext:
+        """Return the active sample context or fail before provider I/O."""
+        context = cls._CURRENT.get()
+        if context is None or not context._active:
+            raise RuntimeError("model call has no active sample context")
+        return context
+
+    def claim_call(self) -> ModelCallIdentity:
+        """Claim the next call ordinal exactly once within this sample attempt."""
+        if not self._active or self._CURRENT.get() is not self:
+            raise RuntimeError("model-call context is absent, stale, or reused")
+        ordinal = self._next_ordinal
+        self._next_ordinal += 1
+        return ModelCallIdentity(
+            task_name=self._task_name,
+            task_id=self._task_id,
+            run_id=self._run_id,
+            sample_id=self._sample_id,
+            epoch=self._epoch,
+            semantic_attempt=self._semantic_attempt,
+            call_ordinal=ordinal,
+        )
+
+    def __enter__(self) -> Self:
+        if self._active or self._token is not None:
+            raise RuntimeError("model-call context cannot be reused")
+        self._active = True
+        self._token = self._CURRENT.set(self)
+        return self
+
+    def __exit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        traceback: TracebackType | None,
+    ) -> None:
+        del exc_type, exc, traceback
+        token = self._token
+        if token is None:
+            raise RuntimeError("model-call context was not entered")
+        self._active = False
+        self._CURRENT.reset(token)
+
+    async def __aenter__(self) -> Self:
+        return self.__enter__()
+
+    async def __aexit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        traceback: TracebackType | None,
+    ) -> None:
+        self.__exit__(exc_type, exc, traceback)
