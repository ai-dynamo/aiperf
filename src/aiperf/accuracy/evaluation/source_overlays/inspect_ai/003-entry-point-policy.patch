+from contextlib import contextmanager
+from contextvars import ContextVar
 from importlib.metadata import entry_points
 from logging import getLogger
+from typing import Iterator, Literal
 
 logger = getLogger(__name__)
 
+EntryPointPolicy = Literal["allow", "deny"]
+_entry_point_policy: ContextVar[EntryPointPolicy] = ContextVar(
+    "inspect_entry_point_policy", default="allow"
+)
+
+
+@contextmanager
+def entry_point_loading(policy: EntryPointPolicy) -> Iterator[None]:
+    """Select installed extension discovery policy for the current task tree.
+
+    ``allow`` preserves standalone Inspect behavior. ``deny`` prevents both
+    enumeration and loading while still permitting explicitly constructed or
+    registered objects.
+    """
+    if policy not in ("allow", "deny"):
+        raise ValueError(f"unknown Inspect entry-point policy: {policy!r}")
+    token = _entry_point_policy.set(policy)
+    try:
+        yield
+    finally:
+        _entry_point_policy.reset(token)
+
 
 def ensure_entry_points(package: str | None = None) -> None:
+    if _entry_point_policy.get() == "deny":
+        return None
+
     # have we already loaded all entry points?
     global _inspect_ai_eps_loaded_all
     if _inspect_ai_eps_loaded_all:
