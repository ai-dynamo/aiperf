+async def run_evaluation(
+    env: EvalEnvironment,
+    solver: Solver,
+    n_repeats: int = 1,
+    max_problems: int | None = None,
+    config: dict[str, Any] | None = None,
+    progress: ProgressTracker | None = None,
+    problem_range: tuple[int, int] | None = None,
+    max_concurrent: int = DEFAULT_MAX_CONCURRENT,
+    judge_client: Any = None,
+    sandbox_manager: SandboxManager | None = None,
+    model_url: str | None = None,
+    step_log_dir: Path | None = None,
+    resume: bool = False,
+    skip_failed: bool = False,
+    max_system_retries: int = 3,
+    shard_info: tuple[int, int] | None = None,
+    instruction_template: Path | None = None,
+    shuffle_seed: int | None = None,
+    model_traffic_store: ModelTrafficStore | None = None,
+    evaluation_host: Any = None,
+) -> dict[str, Any]:
+    """Run a provider session through an injected effect host.
+
+    With no explicit host this compatibility entry point constructs the local
+    implementation, preserving the public API and every existing ``nel`` CLI
+    caller. Hosted runtimes can inject a recording or inherited-pipe host.
+    """
+    from nemo_evaluator.engine.host import evaluation_host_scope
+
+    if evaluation_host is None:
+        from nemo_evaluator.hosts.local import LocalEvaluationHost
+
+        evaluation_host = LocalEvaluationHost()
+    async with evaluation_host:
+        with evaluation_host_scope(evaluation_host):
+            return await _run_evaluation(
+                env=env,
+                solver=solver,
+                n_repeats=n_repeats,
+                max_problems=max_problems,
+                config=config,
+                progress=progress,
+                problem_range=problem_range,
+                max_concurrent=max_concurrent,
+                judge_client=judge_client,
+                sandbox_manager=sandbox_manager,
+                model_url=model_url,
+                step_log_dir=step_log_dir,
+                resume=resume,
+                skip_failed=skip_failed,
+                max_system_retries=max_system_retries,
+                shard_info=shard_info,
+                instruction_template=instruction_template,
+                shuffle_seed=shuffle_seed,
+                model_traffic_store=model_traffic_store,
+            )
+
