@@ -0,0 +1,128 @@
+"""Standalone HTTP implementation of the neutral evaluator host."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import random
+from dataclasses import dataclass
+from typing import Any
+
+import aiohttp
+
+from nemo_evaluator.engine.host import ModelOperation
+from nemo_evaluator.errors import InfraError
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class _ClientState:
+    semaphore: asyncio.Semaphore
+    session: aiohttp.ClientSession
+
+
+class LocalEvaluationHost:
+    """Preserve standalone endpoint, retry, and connection-pool behavior."""
+
+    def __init__(self) -> None:
+        self._clients: dict[int, _ClientState] = {}
+
+    async def __aenter__(self) -> LocalEvaluationHost:
+        return self
+
+    async def __aexit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        traceback: object | None,
+    ) -> None:
+        del exc_type, exc, traceback
+        sessions = [state.session for state in self._clients.values()]
+        self._clients.clear()
+        for session in sessions:
+            if not session.closed:
+                await session.close()
+
+    def _state(self, operation: ModelOperation) -> _ClientState:
+        state = self._clients.get(operation.client_id)
+        if state is not None:
+            return state
+        headers = {"Content-Type": "application/json"}
+        if operation.api_key:
+            headers["Authorization"] = f"Bearer {operation.api_key}"
+        state = _ClientState(
+            semaphore=asyncio.Semaphore(operation.max_concurrent),
+            session=aiohttp.ClientSession(
+                timeout=aiohttp.ClientTimeout(total=operation.timeout),
+                connector=aiohttp.TCPConnector(
+                    limit=operation.max_concurrent * 2,
+                    limit_per_host=operation.max_concurrent,
+                ),
+                headers=headers,
+            ),
+        )
+        self._clients[operation.client_id] = state
+        return state
+
+    async def execute_model(self, operation: ModelOperation) -> dict[str, Any]:
+        """Execute the exact legacy JSON request under local ownership."""
+        state = self._state(operation)
+        retry = operation.retry
+        last_exc: Exception | None = None
+        url = f"{operation.base_url}{operation.path}"
+        for attempt in range(retry.max_retries + 1):
+            async with state.semaphore:
+                try:
+                    async with state.session.post(url, json=operation.payload) as response:
+                        if (
+                            response.status in retry.retry_on_status
+                            and attempt < retry.max_retries
+                        ):
+                            delay = self._backoff_delay(retry, attempt)
+                            body = await response.text()
+                            logger.warning(
+                                "Retryable status %d on attempt %d/%d, sleeping %.1fs | body: %.500s",
+                                response.status,
+                                attempt + 1,
+                                retry.max_retries + 1,
+                                delay,
+                                body,
+                            )
+                            await asyncio.sleep(delay)
+                            continue
+                        response.raise_for_status()
+                        value = await response.json()
+                        if not isinstance(value, dict):
+                            raise InfraError("Model response JSON root is not an object")
+                        return value
+                except asyncio.TimeoutError as error:
+                    last_exc = error
+                    if attempt < retry.max_retries:
+                        await asyncio.sleep(self._backoff_delay(retry, attempt))
+                        continue
+                    raise InfraError(
+                        f"Model request timed out after {retry.max_retries} retries"
+                    ) from error
+                except aiohttp.ClientResponseError as error:
+                    raise InfraError(
+                        f"Model returned HTTP {error.status} after retries: {error.message}"
+                    ) from error
+                except InfraError:
+                    raise
+                except Exception as error:
+                    last_exc = error
+                    if attempt < retry.max_retries:
+                        await asyncio.sleep(self._backoff_delay(retry, attempt))
+                        continue
+                    raise InfraError(
+                        f"Model endpoint unreachable after {retry.max_retries} retries: {error}"
+                    ) from error
+        raise last_exc or InfraError("All retries exhausted")
+
+    @staticmethod
+    def _backoff_delay(retry: Any, attempt: int) -> float:
+        delay = min(retry.base_delay * (2**attempt), retry.max_delay)
+        if retry.jitter:
+            delay *= 0.5 + random.random()
+        return delay
