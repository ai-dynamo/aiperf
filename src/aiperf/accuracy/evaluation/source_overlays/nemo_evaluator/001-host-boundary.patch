+"""Provider-neutral effect host used by NeMo Evaluator sessions."""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from typing import Any, Iterator, Protocol, runtime_checkable
+
+from nemo_evaluator.schemas import RetryConfig
+
+
+@dataclass(frozen=True)
+class ModelOperation:
+    """One typed model operation requested by a solver-facing client."""
+
+    client_id: int
+    semantic_operation_id: str
+    service_id: str
+    purpose: str
+    base_url: str
+    api_key: str | None
+    timeout: float
+    max_concurrent: int
+    retry: RetryConfig
+    path: str
+    payload: dict[str, Any]
+
+
+@runtime_checkable
+class EvaluationHost(Protocol):
+    """Effect boundary supplied to one evaluation session."""
+
+    async def __aenter__(self) -> EvaluationHost:
+        """Start host-owned resources."""
+        ...
+
+    async def __aexit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        traceback: object | None,
+    ) -> None:
+        """Quiesce all host-owned resources."""
+        ...
+
+    async def execute_model(self, operation: ModelOperation) -> dict[str, Any]:
+        """Execute one typed model operation to a terminal result."""
+        ...
+
+
+_CURRENT_HOST: ContextVar[EvaluationHost | None] = ContextVar(
+    "nemo_evaluator_host", default=None
+)
+
+
+def current_evaluation_host() -> EvaluationHost:
+    """Return the active host or fail before an external effect."""
+    host = _CURRENT_HOST.get()
+    if host is None:
+        raise RuntimeError("model operation has no active EvaluationHost")
+    return host
+
+
+@contextmanager
+def evaluation_host_scope(host: EvaluationHost) -> Iterator[None]:
+    """Activate one host for the current evaluation task tree."""
+    token = _CURRENT_HOST.set(host)
+    try:
+        yield
+    finally:
+        _CURRENT_HOST.reset(token)
+
+
+class RecordingEvaluationHost:
+    """Record every operation/purpose and delegate without changing semantics."""
+
+    def __init__(self, delegate: EvaluationHost) -> None:
+        self.delegate = delegate
+        self.operations: list[ModelOperation] = []
+
+    async def __aenter__(self) -> RecordingEvaluationHost:
+        await self.delegate.__aenter__()
+        return self
+
+    async def __aexit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        traceback: object | None,
+    ) -> None:
+        await self.delegate.__aexit__(exc_type, exc, traceback)
+
+    async def execute_model(self, operation: ModelOperation) -> dict[str, Any]:
+        self.operations.append(operation)
+        return await self.delegate.execute_model(operation)
